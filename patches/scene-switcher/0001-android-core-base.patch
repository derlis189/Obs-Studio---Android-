diff --git a/lib/advanced-scene-switcher.cpp b/lib/advanced-scene-switcher.cpp
index f4709ea..3507998 100644
--- a/lib/advanced-scene-switcher.cpp
+++ b/lib/advanced-scene-switcher.cpp
@@ -703,6 +703,17 @@ static void LoadPlugins()
 {
 	QFileInfo libPath(
 		QString(obs_get_module_binary_path(obs_current_module())));
+	#ifdef __ANDROID__
+	// APK native libraries are extracted together in the linker namespace.
+	auto base = new QLibrary(libPath.absolutePath() + "/libadvanced-scene-switcher-base.so");
+	if (!base->load()) {
+		blog(LOG_ERROR, "[adv-ss] Android base: %s", base->errorString().toUtf8().constData());
+		switcher->loadFailureLibs << base->fileName();
+	} else {
+		blog(LOG_INFO, "[adv-ss] Android base loaded");
+	}
+	return;
+#endif
 	QString pluginDir(libPath.absolutePath() + "/" ADVSS_PLUGIN_FOLDER);
 #ifdef _WIN32
 	QString libPattern = "*.dll";
@@ -841,7 +852,11 @@ extern "C" EXPORT void InitSceneSwitcher(obs_module_t *module,
 	obs_frontend_add_event_callback(OBSEvent, nullptr);
 
 	QAction *action = (QAction *)obs_frontend_add_tools_menu_qaction(
+		#ifdef __ANDROID__
+		"Configurar Director automático...");
+#else
 		obs_module_text("AdvSceneSwitcher.pluginName"));
+#endif
 	action->connect(action, &QAction::triggered, OpenSettingsWindow);
 }
 
