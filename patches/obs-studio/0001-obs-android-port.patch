+using RequestTextInputFn = bool (*)(int64_t, const char *, const char *, bool,
+				    void (*)(int64_t, bool, const char *));
+
+RequestTextInputFn g_requestTextInput = nullptr;
+std::atomic<int64_t> g_textReqSeq{0};
+QPointer<QLineEdit> g_activeLineEdit;
+int64_t g_activeReqId = 0;
+bool g_textDialogOpen = false;
