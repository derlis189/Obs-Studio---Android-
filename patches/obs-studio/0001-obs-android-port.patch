+void HardenAndroidDock(QDockWidget *dock)
+{
+	if (!dock)
+		return;
+	dock->setMinimumSize(56, 42);
+	dock->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Ignored);
+	dock->setFeatures(dock->features() & ~QDockWidget::DockWidgetFloatable);
+	if (dock->isFloating())
+		dock->setFloating(false);
+	if (!dock->property("androidDockHardened").toBool()) {
+		dock->setProperty("androidDockHardened", true);
+		dock->installEventFilter(new AndroidDockDragFilter(dock));
+		QObject::connect(dock, &QDockWidget::topLevelChanged, dock, [dock](bool floating) {
+			if (floating)
+				QTimer::singleShot(0, dock, [dock] { dock->setFloating(false); });
+		});
+		QObject::connect(dock, &QDockWidget::visibilityChanged, dock, [dock](bool) {
+			if (QWidget *win = dock->window()) {
+				QTimer::singleShot(0, win, [win]() { ClampMainWindowToScreen(win); });
+			}
+		});
+	}
+	if (QWidget *content = dock->widget()) {
+		const QString name = dock->objectName();
+		if ((name == "controlsDock" || name == "transitionsDock" || name == "statsDock" ||
+		     name == "advss-status-dock") &&
+		    !qobject_cast<QScrollArea *>(content)) {
+			auto *scroll = new DockScrollArea();
+			scroll->setMinimumSize(56, 42);
+			scroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAsNeeded);
+			scroll->setWidget(content);
+			dock->setWidget(scroll);
+		} else {
+			content->setMinimumSize(std::min(content->minimumWidth(), 64),
+						std::min(content->minimumHeight(), 48));
+		}
+	}
+}
