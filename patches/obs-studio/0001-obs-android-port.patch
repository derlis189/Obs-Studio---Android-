+void system_info(GoLiveApi::Capabilities &capabilities)
+{
+	const AndroidHardwareProfile hw = QueryAndroidHardwareProfile();
+
+	auto &cpu = capabilities.cpu;
+	cpu.physical_cores = hw.cpu_cores;
+	cpu.logical_cores = hw.cpu_cores;
+	if (hw.max_freq_mhz > 0)
+		cpu.speed = static_cast<uint32_t>(hw.max_freq_mhz);
+	cpu.name = hw.soc_name + " · " + hw.cpu_clusters;
+
+	auto &memory = capabilities.memory;
+	memory.total = hw.ram_total_mb > 0 ? static_cast<uint64_t>(hw.ram_total_mb) * 1024ULL * 1024ULL
+					   : os_get_sys_total_size();
+	memory.free = hw.ram_avail_mb > 0 ? static_cast<uint64_t>(hw.ram_avail_mb) * 1024ULL * 1024ULL
+					  : os_get_sys_free_size();
+
+	GoLiveApi::Gpu gpu_info{};
+	gpu_info.model = hw.gpu_renderer;
+	gpu_info.vendor_id = 0;
+	gpu_info.device_id = 0;
+	gpu_info.dedicated_video_memory = 0;
+	gpu_info.shared_system_memory = memory.total;
+	if (!hw.gles_version.empty())
+		gpu_info.driver_version = hw.gles_version;
+	capabilities.gpu = std::vector<GoLiveApi::Gpu>{gpu_info};
+
+	auto &system_data = capabilities.system;
+	system_data.name = "Android";
+	system_data.bits = 64;
+	system_data.arm = true;
+	system_data.armEmulation = false;
+	system_data.build = hw.sdk_int;
+	system_data.release = hw.android_release;
+	system_data.revision = hw.device_name;
+	system_data.version = "Android " + hw.android_release + " (" + hw.device_name + ")";
+}
