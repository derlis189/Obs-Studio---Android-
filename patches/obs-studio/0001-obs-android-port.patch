+	QObject::connect(closeBtn, &QPushButton::clicked, &dlg, &QDialog::accept);
+	root->addWidget(closeBtn);
+
+	auto selectedVSceneName = [=]() -> std::string {
+		auto *it = vSceneList->currentItem();
+		return it ? it->data(Qt::UserRole).toString().toStdString() : std::string();
+	};
+
+	auto refreshLinkSelection = [=]() {
+		const std::string main = cbMainScene->currentData().toString().toStdString();
+		const auto link = g_verticalSceneLinks.find(main);
+		const QString value = link == g_verticalSceneLinks.end() ? QStringLiteral("__FOLLOW__")
+									 : QString::fromStdString(link->second);
+		cbLinkedVert->setCurrentIndex(std::max(0, cbLinkedVert->findData(value)));
+	};
+
+	auto refreshPreview = [=]() {
+		const std::string sel = selectedVSceneName();
+		OBSSource source = previewCache->Resolve(true, sel);
+		monitor->SetSource(source.Get());
+		{
+			const std::lock_guard<std::mutex> lock(monitor->mutex);
+			monitor->fill = true;
+			monitor->guides = guides->isChecked();
+		}
+		btnActivateV->setEnabled(!sel.empty());
+		btnDelV->setEnabled(!sel.empty());
+		btnEditV->setEnabled(!sel.empty());
+		btnLinkPreview->setEnabled(!sel.empty() && cbMainScene->count() > 0);
+		btnSaveLink->setEnabled(cbMainScene->count() > 0);
+		const std::string labelName = sel.empty() ? g_verticalFollowScene : sel;
+		previewLabel->setText(labelName.empty()
+					      ? QStringLiteral("Vista 9:16 · Programa")
+					      : QStringLiteral("%1 · %2")
+							.arg(labelName == g_verticalFollowScene
+								     ? QStringLiteral("En salida")
+								     : QStringLiteral("Vista previa"),
+							     QString::fromStdString(labelName)));
+	};
+
+	auto refreshAll = [=]() {
+		const QString selected = vSceneList->currentItem() ? vSceneList->currentItem()->data(Qt::UserRole).toString()
+								   : QString();
+		const QVariant selectedMain = cbMainScene->currentData();
+		const QSignalBlocker sceneSignals(vSceneList);
+		const QSignalBlocker mainSignals(cbMainScene);
+		vSceneList->clear();
+		auto vScenes = GetAllObsSceneNames(true, false);
+		for (const auto &nm : vScenes) {
+			const bool act = (nm == g_verticalFollowScene);
+			auto *item = new QListWidgetItem(QString::fromStdString(act ? ("EN SALIDA · " + nm) : nm), vSceneList);
+			item->setData(Qt::UserRole, QString::fromStdString(nm));
+			if (item->data(Qt::UserRole) == selected || (selected.isEmpty() && act))
+				vSceneList->setCurrentItem(item);
+		}
+		cbMainScene->clear();
+		auto mScenes = GetAllObsSceneNames(false, true);
+		for (const auto &nm : mScenes)
+			cbMainScene->addItem(QString::fromStdString(nm), QString::fromStdString(nm));
+		const int mainIndex = cbMainScene->findData(selectedMain);
+		if (mainIndex >= 0)
+			cbMainScene->setCurrentIndex(mainIndex);
+
+		cbLinkedVert->clear();
+		cbLinkedVert->addItem(QStringLiteral("(Seguir Programa)"), QStringLiteral("__FOLLOW__"));
+		cbLinkedVert->addItem(QStringLiteral("(Sin vincular - mantener actual)"), QStringLiteral("__UNLINKED__"));
+		for (const auto &nm : vScenes)
+			cbLinkedVert->addItem(QString::fromStdString(nm), QString::fromStdString(nm));
+
+		linkList->clear();
+		for (const auto &nm : mScenes) {
+			std::string target = "(Seguir Programa)";
+			auto it = g_verticalSceneLinks.find(nm);
+			if (it != g_verticalSceneLinks.end() && !it->second.empty()) {
+				if (it->second == "__UNLINKED__")
+					target = "(Sin vincular)";
+				else if (it->second == "__FOLLOW__")
+					target = "(Seguir Programa)";
+				else
+					target = it->second;
+			}
+			linkList->addItem(QString::fromStdString(nm + "  ->  " + target));
+		}
+		if (!vSceneList->currentItem() && vSceneList->count())
+			vSceneList->setCurrentRow(0);
+		refreshLinkSelection();
+		refreshPreview();
+	};
+
+	QObject::connect(cbMainScene, &QComboBox::currentIndexChanged, &dlg, [=]() { refreshLinkSelection(); });
+	QObject::connect(vSceneList, &QListWidget::currentItemChanged, &dlg, [=]() { refreshPreview(); });
+	QObject::connect(guides, &QCheckBox::toggled, &dlg, [=]() { refreshPreview(); });
+	QObject::connect(mode, &QCheckBox::toggled, &dlg, [=](bool enabled) {
+		(*cfg)["vertical"]["autoLinks"] = enabled;
+		if (!enabled)
+			(*cfg)["vertical"]["scene"] = g_verticalFollowScene;
+		SaveMultiConfig(*cfg);
+		SyncVerticalToCurrentMainScene();
+		refreshAll();
+	});
+	QObject::connect(btnFollowProgram, &QPushButton::clicked, &dlg, [=]() {
+		(*cfg)["vertical"]["scene"] = "";
+		(*cfg)["vertical"]["autoLinks"] = true;
+		const QSignalBlocker modeSignals(mode);
+		mode->setChecked(true);
+		SaveMultiConfig(*cfg);
+		SyncVerticalToCurrentMainScene();
+		refreshAll();
+	});
+	QObject::connect(btnCreateV, &QPushButton::clicked, &dlg, [=, &dlg]() {
+		QString raw = edNewVScene->text().trimmed();
+		if (raw.isEmpty())
+			raw = QStringLiteral("Escena %1").arg(vSceneList->count() + 1);
+		std::string full = raw.startsWith(QStringLiteral("[V] ")) ? raw.toStdString()
+									 : ("[V] " + raw.toStdString());
+		if (obs_source_t *ex = obs_get_source_by_name(full.c_str())) {
+			obs_source_release(ex);
+			OBSMessageBox::warning(&dlg, QStringLiteral("Escenas Verticales"),
+					       QStringLiteral("Ya existe una escena con ese nombre."));
+			return;
+		}
+		if (obs_scene_t *sc = obs_scene_create(full.c_str())) {
+			obs_scene_release(sc);
+			(*cfg)["vertical"]["scenes"].push_back(full);
+			SaveMultiConfig(*cfg);
+			SaveAllObsStateOnGuiThread();
+			edNewVScene->clear();
+			refreshAll();
+		}
+	});
+	QObject::connect(btnDupFromMain, &QPushButton::clicked, &dlg, [=]() {
+		obs_source_t *cur = obs_frontend_get_current_scene();
+		if (!cur)
+			return;
+		std::string baseName = obs_source_get_name(cur) ? obs_source_get_name(cur) : "Escena";
+		QString raw = edNewVScene->text().trimmed();
+		std::string full = raw.isEmpty() ? ("[V] " + baseName) : ("[V] " + raw.toStdString());
+		if (obs_source_t *ex = obs_get_source_by_name(full.c_str())) {
+			obs_source_release(ex);
+			full += "_" + std::to_string(QDateTime::currentSecsSinceEpoch() % 1000);
+		}
+		if (obs_scene_t *srcScene = obs_scene_from_source(cur)) {
+			if (obs_scene_t *dup = obs_scene_duplicate(srcScene, full.c_str(), OBS_SCENE_DUP_REFS)) {
+				obs_scene_release(dup);
+				(*cfg)["vertical"]["scenes"].push_back(full);
+				SaveMultiConfig(*cfg);
+				SaveAllObsStateOnGuiThread();
+				edNewVScene->clear();
+			}
+		}
+		obs_source_release(cur);
+		refreshAll();
+	});
+	QObject::connect(btnEditV, &QPushButton::clicked, &dlg, [=, &dlg]() {
+		const auto name = selectedVSceneName();
+		if (!name.empty()) {
+			if (preview->GetDisplay())
+				obs_display_set_enabled(preview->GetDisplay(), false);
+			monitor->SetSource(nullptr);
+			OpenVerticalSourceEditor(&dlg, name);
+			if (preview->GetDisplay())
+				obs_display_set_enabled(preview->GetDisplay(), true);
+		}
+		refreshPreview();
+	});
+	QObject::connect(btnActivateV, &QPushButton::clicked, &dlg, [=]() {
+		std::string nm = selectedVSceneName();
+		if (nm.empty())
+			return;
+		(*cfg)["vertical"]["fit"] = 1;
+		(*cfg)["vertical"]["scene"] = nm;
+		(*cfg)["vertical"]["autoLinks"] = false;
+		const QSignalBlocker modeSignals(mode);
+		mode->setChecked(false);
+		SaveMultiConfig(*cfg);
+		g_verticalFollowScene = nm;
+		ApplyVerticalSceneByName(nm);
+		refreshAll();
+	});
+	QObject::connect(btnDelV, &QPushButton::clicked, &dlg, [=, &dlg]() {
+		std::string nm = selectedVSceneName();
+		if (nm.empty())
+			return;
+		if (QMessageBox::question(&dlg, QStringLiteral("Eliminar escena vertical"),
+					  QStringLiteral("¿Eliminar %1 y sus vínculos?").arg(QString::fromStdString(nm)),
+					  QMessageBox::Yes | QMessageBox::No, QMessageBox::No) != QMessageBox::Yes)
+			return;
+		if (obs_source_t *s = obs_get_source_by_name(nm.c_str())) {
+			obs_source_remove(s);
+			obs_source_release(s);
+		}
+		auto &arr = (*cfg)["vertical"]["scenes"];
+		for (auto it = arr.begin(); it != arr.end();)
+			it = (it->is_string() && it->get<std::string>() == nm) ? arr.erase(it) : ++it;
+		auto &links = (*cfg)["vertical"]["links"];
+		for (auto it = links.begin(); it != links.end();)
+			it = (it.value() == nm) ? links.erase(it) : ++it;
+		if ((*cfg)["vertical"].value("scene", "") == nm)
+			(*cfg)["vertical"]["scene"] = "";
+		SaveMultiConfig(*cfg);
+		SyncVerticalToCurrentMainScene();
+		SaveAllObsStateOnGuiThread();
+		refreshAll();
+	});
+	QObject::connect(btnSaveLink, &QPushButton::clicked, &dlg, [=]() {
+		std::string mainSc = cbMainScene->currentData().toString().toStdString();
+		std::string vertSc = cbLinkedVert->currentData().toString().toStdString();
+		if (mainSc.empty())
+			return;
+		(*cfg)["vertical"]["links"][mainSc] = vertSc;
+		SaveMultiConfig(*cfg);
+		SyncVerticalToCurrentMainScene();
+		refreshAll();
+	});
+	QObject::connect(btnLinkPreview, &QPushButton::clicked, &dlg, [=]() {
+		const QString target = QString::fromStdString(selectedVSceneName());
+		const int index = cbLinkedVert->findData(target);
+		if (index >= 0) {
+			cbLinkedVert->setCurrentIndex(index);
+			btnSaveLink->click();
+		}
+	});
+	QObject::connect(vSceneList, &QListWidget::itemDoubleClicked, &dlg, [=]() { btnActivateV->click(); });
+
+	refreshAll();
+	dlg.exec();
+	monitor->SetSource(nullptr);
+}
