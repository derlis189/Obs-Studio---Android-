+		refreshVertPreviewAndControls();
+	});
+	QObject::connect(btnSaveClip, &QPushButton::clicked, dlg, [=]() {
+		const QString saved = SaveVerticalBacktrackClip(dlg);
+		if (!saved.isEmpty()) {
+			vStatus->setText(QStringLiteral("Clip 9:16 guardado: %1").arg(saved));
+		}
+	});
+
+	tabs->addTab(vertTab, QStringLiteral("Captura Vertical 9:16"));
+
+	// ==================== TAB 2: MULTISTREAMING RTMP ====================
+	auto *multiTab = new QWidget(tabs);
+	activeMultiTab = multiTab;
+	auto *multiLayout = new QVBoxLayout(multiTab);
+
+	auto *listWidget = new QListWidget(multiTab);
+	multiLayout->addWidget(listWidget, 1);
+
+	auto refreshList = [=]() {
+		int prevRow = listWidget->currentRow();
+		listWidget->clear();
+		for (const auto &t : (*cfg)["targets"]) {
+			std::string id = t.value("id", "");
+			std::string name = t.value("name", "Destino");
+			std::string srv = t.value("server", "");
+			int br = t.value("bitrate", 4000);
+			bool useVert = t.value("vertical", false);
+			bool active = fnIsMulti && fnIsMulti(id.c_str());
+			bool recon = fnIsMultiRecon && fnIsMultiRecon(id.c_str());
+			QString line = QStringLiteral("[%1]  %2  [%3 kbps | %4]  -  %5")
+					       .arg(recon ? QStringLiteral("RECONECTANDO")
+							  : (active ? QStringLiteral("EN VIVO") : QStringLiteral("Inactivo")))
+					       .arg(QString::fromStdString(name))
+					       .arg(br)
+					       .arg(useVert ? QStringLiteral("Vertical 9:16") : QStringLiteral("Horizontal 16:9"))
+					       .arg(QString::fromStdString(srv));
+			listWidget->addItem(line);
+		}
+		if (prevRow >= 0 && prevRow < listWidget->count())
+			listWidget->setCurrentRow(prevRow);
+	};
+
+	auto *multiBtns = new QHBoxLayout();
+	auto *btnToggleOne = new QPushButton(QStringLiteral("Iniciar / Detener seleccionado"), multiTab);
+	auto *btnStartAll = new QPushButton(QStringLiteral("Iniciar todos"), multiTab);
+	auto *btnStopAll = new QPushButton(QStringLiteral("Detener todos"), multiTab);
+	auto *btnRemove = new QPushButton(QStringLiteral("Eliminar"), multiTab);
+	multiBtns->addWidget(btnToggleOne);
+	multiBtns->addWidget(btnStartAll);
+	multiBtns->addWidget(btnStopAll);
+	multiBtns->addWidget(btnRemove);
+	multiLayout->addLayout(multiBtns);
+
+	auto *addForm = new QFormLayout();
+	auto *edName = new QLineEdit(multiTab);
+	edName->setPlaceholderText(QStringLiteral("Ej: YouTube, Twitch, TikTok, Kick..."));
+	auto *edServer = new QLineEdit(multiTab);
+	edServer->setPlaceholderText(QStringLiteral("rtmp://a.rtmp.youtube.com/live2"));
+	auto *edKey = new QLineEdit(multiTab);
+	edKey->setEchoMode(QLineEdit::Password);
+	edKey->setPlaceholderText(QStringLiteral("Clave de retransmisión"));
+	auto *cbFeed = new QComboBox(multiTab);
+	cbFeed->addItem(QStringLiteral("Programa Horizontal (16:9)"), false);
+	cbFeed->addItem(QStringLiteral("Captura Vertical (9:16)"), true);
+	auto *spBitrate = new QSpinBox(multiTab);
+	spBitrate->setRange(500, 12000);
+	spBitrate->setSingleStep(500);
+	spBitrate->setValue(4000);
+	auto *btnAdd = new QPushButton(QStringLiteral("Agregar destino RTMP"), multiTab);
+
+	addForm->addRow(QStringLiteral("Nombre:"), edName);
+	addForm->addRow(QStringLiteral("Servidor RTMP/RTMPS:"), edServer);
+	addForm->addRow(QStringLiteral("Clave:"), edKey);
+	addForm->addRow(QStringLiteral("Formato:"), cbFeed);
+	addForm->addRow(QStringLiteral("Bitrate (kbps):"), spBitrate);
+	multiLayout->addLayout(addForm);
+	multiLayout->addWidget(btnAdd);
+
+	auto startTarget = [=](const nlohmann::json &t) -> bool {
+		if (!fnStartMultiEx)
+			return false;
+		const auto &vcfg = (*cfg)["vertical"];
+		int vw = vcfg.value("res", 0) == 1 ? 1080 : 720;
+		int vh = vcfg.value("res", 0) == 1 ? 1920 : 1280;
+		PushVerticalParamsToBackend();
+		const std::string backendScene = ResolveVerticalBackendSceneName(g_verticalFollowScene);
+		return fnStartMultiEx(t.value("id", "").c_str(), t.value("server", "").c_str(), t.value("key", "").c_str(),
+				      t.value("bitrate", 4000), t.value("vertical", false), vw, vh,
+				      backendScene.c_str(), g_verticalFitMode);
+	};
+
+	QObject::connect(btnAdd, &QPushButton::clicked, dlg, [=]() {
+		QString nm = edName->text().trimmed();
+		QString sv = edServer->text().trimmed();
+		QString ky = edKey->text().trimmed();
+		if (sv.isEmpty()) {
+			OBSMessageBox::warning(dlg, QStringLiteral("Multistreaming"),
+					       QStringLiteral("Ingresa la URL del servidor RTMP/RTMPS."));
+			return;
+		}
+		if (nm.isEmpty())
+			nm = QStringLiteral("Destino %1").arg((*cfg)["targets"].size() + 1);
+		std::string id = "ms_" + std::to_string(QDateTime::currentMSecsSinceEpoch());
+		(*cfg)["targets"].push_back({{"id", id},
+					     {"name", nm.toStdString()},
+					     {"server", sv.toStdString()},
+					     {"key", ky.toStdString()},
+					     {"vertical", cbFeed->currentData().toBool()},
+					     {"bitrate", spBitrate->value()}});
+		SaveMultiConfig(*cfg);
+		edName->clear();
+		edServer->clear();
+		edKey->clear();
+		refreshList();
+	});
+
+	QObject::connect(btnToggleOne, &QPushButton::clicked, dlg, [=]() {
+		int row = listWidget->currentRow();
+		if (row < 0 || row >= int((*cfg)["targets"].size()))
+			return;
+		const auto &t = (*cfg)["targets"][row];
+		std::string id = t.value("id", "");
+		if (fnIsMulti && fnIsMulti(id.c_str())) {
+			if (fnStopMulti)
+				fnStopMulti(id.c_str());
+		} else if (!startTarget(t)) {
+			OBSMessageBox::warning(dlg, QStringLiteral("Multistreaming"),
+					       QStringLiteral("No se pudo iniciar la transmisión al destino seleccionado."));
+		}
+		refreshList();
+	});
+
+	QObject::connect(btnStartAll, &QPushButton::clicked, dlg, [=]() {
+		for (const auto &t : (*cfg)["targets"]) {
+			std::string id = t.value("id", "");
+			if (fnIsMulti && fnIsMulti(id.c_str()))
+				continue;
+			startTarget(t);
+		}
+		refreshList();
+	});
+
+	QObject::connect(btnStopAll, &QPushButton::clicked, dlg, [=]() {
+		for (const auto &t : (*cfg)["targets"]) {
+			std::string id = t.value("id", "");
+			if (fnStopMulti)
+				fnStopMulti(id.c_str());
+		}
+		refreshList();
+	});
+
+	QObject::connect(btnRemove, &QPushButton::clicked, dlg, [=]() {
+		int row = listWidget->currentRow();
+		if (row < 0 || row >= int((*cfg)["targets"].size()))
+			return;
+		std::string id = (*cfg)["targets"][row].value("id", "");
+		if (fnStopMulti)
+			fnStopMulti(id.c_str());
+		(*cfg)["targets"].erase((*cfg)["targets"].begin() + row);
+		SaveMultiConfig(*cfg);
+		refreshList();
+	});
+
+	refreshList();
+	tabs->addTab(multiTab, QStringLiteral("Multistreaming RTMP"));
+	if (openMultistream)
+		tabs->setCurrentWidget(multiTab);
+
+	QObject::connect(tabs, &QTabWidget::currentChanged, dlg, [=]() {
+		refreshVertPreviewAndControls();
+		if (tabs->currentWidget() == multiTab)
+			refreshList();
+	});
+
+	auto *syncTimer = new QTimer(dlg);
+	syncTimer->setInterval(1000);
+	QObject::connect(syncTimer, &QTimer::timeout, dlg, [=, lastStream = false, lastRec = false, lastBt = false]() mutable {
+		const bool st = IsVerticalStreamingActive();
+		const bool rc = IsVerticalRecordingActive();
+		const bool bt = IsVerticalBacktrackActive();
+		if (st || rc || bt || st != lastStream || rc != lastRec || bt != lastBt ||
+		    *lastObservedVersion != g_verticalConfigVersion) {
+			lastStream = st;
+			lastRec = rc;
+			lastBt = bt;
+			if (*lastObservedVersion != g_verticalConfigVersion)
+				*cfg = LoadMultiConfig();
+			refreshVertPreviewAndControls();
+		}
+	});
+	syncTimer->start();
+
+	refreshVertPreviewAndControls();
+
+	auto *closeBtn = new QPushButton(QStringLiteral("Cerrar"), dlg);
+	QObject::connect(closeBtn, &QPushButton::clicked, dlg, &QDialog::accept);
+	rootLayout->addWidget(closeBtn);
+
+	dlg->show();
+}
