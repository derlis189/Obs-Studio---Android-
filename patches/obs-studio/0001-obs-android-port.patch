+void InstallAndroidToolsAndRemote(QWidget *mainWindow, QMenu *toolsMenu)
+{
+	SyncVerticalRuntimeFromConfig(LoadMultiConfig());
+	if (auto *window = qobject_cast<QMainWindow *>(mainWindow)) {
+		InstallBugBar(window);
+		obs_frontend_add_save_callback(SaveBugSlots, nullptr);
+	}
+
+	void *jni = FindAndroidJni();
+	if (jni) {
+		using RegRemoteFn = void (*)(bool (*)(char *, size_t), bool (*)(const char *, char *, size_t));
+		auto reg = reinterpret_cast<RegRemoteFn>(dlsym(jni, "obs_android_register_remote_handlers"));
+		if (reg)
+			reg(&RemoteGetStateBridge, &RemoteExecuteActionBridge);
+
+		using RegSaveFn = void (*)(void (*)());
+		auto regSave = reinterpret_cast<RegSaveFn>(dlsym(jni, "obs_android_register_save_handler"));
+		if (regSave)
+			regSave(&SaveAllObsStateBridge);
+	}
+
+	obs_frontend_add_event_callback(&OnFrontendEventAndroid, nullptr);
+
+	// Periodic safety auto-save every 15 seconds so Android process eviction never loses edits
+	if (mainWindow) {
+		// Periodic safety auto-save every 25 seconds so Android process eviction never loses edits
+		// (skip while modal dialogs/wizards like AutoConfig TestMode are open)
+		auto *autoSaveTimer = new QTimer(mainWindow);
+		autoSaveTimer->setInterval(25000);
+		QObject::connect(autoSaveTimer, &QTimer::timeout, mainWindow, []() {
+			if (QApplication::activeModalWidget() != nullptr)
+				return;
+			SaveAllObsStateOnGuiThread();
+		});
+		autoSaveTimer->start();
+
+		// Live Android thermal + battery monitor in status bar + keepalive watchdog
+		if (auto *win = qobject_cast<QMainWindow *>(mainWindow)) {
+			if (auto *sb = win->statusBar()) {
+				auto *healthLabel = new QLabel(win);
+				healthLabel->setStyleSheet(QStringLiteral("padding: 0 6px; color: #cbd5e1; font-size: 11px;"));
+				sb->addPermanentWidget(healthLabel);
+				auto *healthTimer = new QTimer(win);
+				healthTimer->setInterval(3000);
+				auto updateHealth = [healthLabel]() {
+					SyncBroadcastKeepalive();
+					void *h = FindAndroidJni();
+					if (!h)
+						return;
+					using HealthFn = bool (*)(char *, size_t);
+					auto fn = reinterpret_cast<HealthFn>(dlsym(h, "obs_android_get_device_health"));
+					if (!fn)
+						return;
+					char buf[256] = {};
+					if (!fn(buf, sizeof(buf)) || !buf[0])
+						return;
+					try {
+						const auto j = nlohmann::json::parse(buf);
+						const int thermal = j.value("thermal", 0);
+						const double tempC = j.value("temp_c", 0.0);
+						const int bat = j.value("battery", -1);
+						const bool chg = j.value("charging", false);
+						healthLabel->setToolTip(QStringLiteral(
+							"Ahorro automático: vistas previas hasta %1 FPS; navegador hasta %2 FPS según su configuración. "
+							"Los FPS y la resolución de transmisión/grabación se conservan. La temperatura mostrada es de la batería.")
+							.arg(j.value("preview_fps_limit", 15)).arg(j.value("browser_fps_limit", 60)));
+						QString text;
+						if (bat >= 0)
+							text += QStringLiteral("Bat %1%%2").arg(bat).arg(chg ? "+" : "");
+						if (tempC > 0.1) {
+							if (!text.isEmpty())
+								text += QStringLiteral(" · ");
+							text += QStringLiteral("%1°C").arg(QString::number(tempC, 'f', 1));
+						}
+						if (thermal >= 3) {
+							healthLabel->setText(QStringLiteral("ALERTA TÉRMICA · %1").arg(text));
+							healthLabel->setStyleSheet(
+								QStringLiteral("padding: 1px 6px; background: #dc2626; color: white; font-weight: bold; border-radius: 4px; font-size: 11px;"));
+						} else if (thermal == 2) {
+							healthLabel->setText(QStringLiteral("Calor moderado · %1").arg(text));
+							healthLabel->setStyleSheet(
+								QStringLiteral("padding: 1px 6px; background: #d97706; color: white; font-weight: bold; border-radius: 4px; font-size: 11px;"));
+						} else {
+							healthLabel->setText(text);
+							healthLabel->setStyleSheet(
+								QStringLiteral("padding: 0 6px; color: #cbd5e1; font-size: 11px;"));
+						}
+					} catch (...) {
+					}
+				};
+				QObject::connect(healthTimer, &QTimer::timeout, win, updateHealth);
+				healthTimer->start();
+				QTimer::singleShot(1000, win, updateHealth);
+			}
+		}
+
+		// Register independent control dock panels (accessible in Paneles / Docks menu)
+		obs_frontend_add_dock_by_id("obs_android_dock_vertical", "Vertical 9:16", CreateVerticalDockWidget(mainWindow));
+		obs_frontend_add_dock_by_id("obs_android_dock_scoreboard", "Control: Marcador", CreateScoreboardDockWidget());
+		obs_frontend_add_dock_by_id("obs_android_dock_lowerthird", "Control: Lower Third", CreateLowerThirdDockWidget());
+		obs_frontend_add_dock_by_id("obs_android_dock_timer", "Control: Cronometro", CreateTimerDockWidget());
+		obs_frontend_add_dock_by_id("obs_android_dock_bible", "Control: Biblia", CreateBibleDockWidget());
+
+		// Install Undo button below Settings + compact touch resize handles + ensure visible Movies/OBS Studio recording folder
+		InstallUndoButtonAndTouchDocks(mainWindow);
+		QTimer::singleShot(550, mainWindow, []() { EnsureVisibleRecordingFolder(); });
+	}
+
+	if (toolsMenu) {
+		toolsMenu->addSeparator();
+		auto *dockLayout = toolsMenu->addAction(QStringLiteral("Recuperar paneles en pantalla"));
+		QObject::connect(dockLayout, &QAction::triggered, mainWindow, [mainWindow] {
+			auto *window = qobject_cast<QMainWindow *>(mainWindow);
+			if (!window) return;
+			ClampMainWindowToScreen(window);
+			QList<QDockWidget *> leftDocks, rightDocks, bottomDocks;
+			for (auto *dock : window->findChildren<QDockWidget *>()) {
+				HardenAndroidDock(dock);
+				const auto name = dock->objectName();
+				if (name == "scenesDock" || name == "sourcesDock" || name == "mixerDock" ||
+				    name == "transitionsDock" || name == "controlsDock")
+					dock->show();
+				if (!dock->isVisible()) continue;
+				const auto area = window->dockWidgetArea(dock);
+				if (area == Qt::LeftDockWidgetArea) leftDocks.append(dock);
+				else if (area == Qt::RightDockWidgetArea) rightDocks.append(dock);
+				else if (area == Qt::BottomDockWidgetArea) bottomDocks.append(dock);
+			}
+			const int w = std::max(640, window->width());
+			const int h = std::max(360, window->height());
+			if (!leftDocks.isEmpty()) {
+				QList<int> widths(leftDocks.size(), std::clamp(w * 19 / 100, 150, 230));
+				window->resizeDocks(leftDocks, widths, Qt::Horizontal);
+			}
+			if (!rightDocks.isEmpty()) {
+				QList<int> widths(rightDocks.size(), std::clamp(w * 20 / 100, 160, 250));
+				window->resizeDocks(rightDocks, widths, Qt::Horizontal);
+			}
+			if (!bottomDocks.isEmpty()) {
+				QList<int> heights(bottomDocks.size(), std::clamp(h * 24 / 100, 110, 165));
+				window->resizeDocks(bottomDocks, heights, Qt::Vertical);
+			}
+			ClampMainWindowToScreen(window);
+			window->updateGeometry();
+		});
+
+		QAction *actRemote = toolsMenu->addAction(QStringLiteral("Control Remoto Web (QR)..."));
+		QObject::connect(actRemote, &QAction::triggered, mainWindow, []() {
+			if (void *h = FindAndroidJni()) {
+				using OpenQrFn = void (*)();
+				auto fn = reinterpret_cast<OpenQrFn>(dlsym(h, "obs_android_open_web_remote_qr"));
+				if (fn)
+					fn();
+			}
+		});
+
+		QAction *actGfx = toolsMenu->addAction(
+			QStringLiteral("Control de Graficos (Marcador / Lower Third / Cronometro / Biblia)..."));
+		QObject::connect(actGfx, &QAction::triggered, mainWindow, []() {
+			if (void *h = FindAndroidJni()) {
+				using OpenGfxFn = void (*)();
+				auto fn = reinterpret_cast<OpenGfxFn>(dlsym(h, "obs_android_open_graphics_panel"));
+				if (fn)
+					fn();
+			}
+		});
+
+		QAction *actVertical = toolsMenu->addAction(QStringLiteral("Captura Vertical (9:16)..."));
+		QObject::connect(actVertical, &QAction::triggered, mainWindow, [mainWindow]() {
+			OpenMultistreamAndVerticalDialog(mainWindow, false);
+		});
+
+		QAction *actMulti = toolsMenu->addAction(QStringLiteral("Multistreaming RTMP..."));
+		QObject::connect(actMulti, &QAction::triggered, mainWindow, [mainWindow]() {
+			OpenMultistreamAndVerticalDialog(mainWindow, true);
+		});
+
+		QAction *actSrt = toolsMenu->addAction(QStringLiteral("Salida SRT (Wi-Fi / Datos moviles)..."));
+		QObject::connect(actSrt, &QAction::triggered, mainWindow, [mainWindow]() {
+			OpenSrtOutputDialog(mainWindow);
+		});
+
+		QAction *actAudioPro = toolsMenu->addAction(QStringLiteral("Audio Pro (Voz limpia en 1 toque)..."));
+		QObject::connect(actAudioPro, &QAction::triggered, mainWindow, [mainWindow]() {
+			OpenAudioProPresetDialog(mainWindow);
+		});
+
+		QAction *actBackup = toolsMenu->addAction(QStringLiteral("Respaldar / Restaurar configuración OBS..."));
+		QObject::connect(actBackup, &QAction::triggered, mainWindow, [mainWindow]() {
+			OpenBackupRestoreDialog(mainWindow);
+		});
+
+		QAction *actFloat = toolsMenu->addAction(QStringLiteral("Boton flotante de escenas (activar / desactivar)"));
+		QObject::connect(actFloat, &QAction::triggered, mainWindow, []() {
+			if (void *h = FindAndroidJni()) {
+				using ToggleFloatFn = void (*)();
+				auto fn = reinterpret_cast<ToggleFloatFn>(dlsym(h, "obs_android_toggle_floating_overlay"));
+				if (fn)
+					fn();
+			}
+		});
+	}
+}
