+bool AutoConfigTestPage::TestAndroidHardwareEncoding(bool forRecording)
+{
+	wiz->androidHw = QueryAndroidHardwareProfile();
+	const auto &hw = wiz->androidHw;
+	wiz->thermalAdjustmentNote.clear();
+	wiz->measuredEncodeFps = 0.0;
+
+	const bool useHevc = forRecording && wiz->androidHevcAvailable && hw.hevc_hw;
+	const char *vencId = useHevc ? "android_mediacodec_hevc" : "android_mediacodec_h264";
+	const char *aencId = EncoderAvailable("android_mediacodec_aac") ? "android_mediacodec_aac" : "ffmpeg_aac";
+
+	int baseCX = wiz->baseResolutionCX;
+	int baseCY = wiz->baseResolutionCY;
+	CalcBaseRes(baseCX, baseCY);
+	const long double aspect = (baseCY > 0) ? ((long double)baseCX / (long double)baseCY) : (16.0l / 9.0l);
+
+	// Thermal & power-save ceiling: protect phone from overheating
+	const bool thermalCap30 = (hw.thermal_status >= 2 || hw.battery_temp_c >= 41.0 || hw.power_save);
+	if (thermalCap30) {
+		wiz->thermalAdjustmentNote = hw.power_save
+						     ? "Limitado a 30 FPS por modo Ahorro de energía activo"
+						     : "Limitado a 30 FPS para proteger temperatura actual del teléfono";
+	}
+
+	// Tier-based maximum resolution & FPS ceiling
+	int maxHeightTier = 1080;
+	int maxFpsTier = 60;
+	if (hw.tier >= 4) {
+		maxHeightTier = 1080;
+		maxFpsTier = thermalCap30 ? 30 : 60;
+	} else if (hw.tier == 3) {
+		maxHeightTier = 1080;
+		maxFpsTier = thermalCap30 ? 30 : (forRecording ? 60 : 60);
+	} else if (hw.tier == 2) {
+		maxHeightTier = 720;
+		maxFpsTier = (forRecording && !thermalCap30 && hw.ram_total_mb >= 4500) ? 60 : 30;
+	} else {
+		maxHeightTier = 720;
+		maxFpsTier = 30;
+	}
+
+	struct Candidate {
+		int cy;
+		int fps_num;
+		int fps_den;
+		bool force;
+	};
+	std::vector<Candidate> rawList;
+	if (wiz->specificFPSNum > 0 && wiz->specificFPSDen > 0) {
+		int reqFps = std::max(1, wiz->specificFPSNum / std::max(1, wiz->specificFPSDen));
+		if (thermalCap30 && reqFps > 30 && wiz->fpsType != AutoConfig::FPSType::UseCurrent)
+			reqFps = 30;
+		rawList = {{1080, reqFps, 1, false}, {720, reqFps, 1, false}, {540, reqFps, 1, false}, {360, 30, 1, true}};
+	} else if (wiz->preferHighFPS) {
+		rawList = {{1080, 60, 1, false}, {720, 60, 1, false}, {1080, 30, 1, false},
+			   {720, 30, 1, false},  {540, 30, 1, false}, {360, 30, 1, true}};
+	} else {
+		rawList = {{1080, 60, 1, false}, {1080, 30, 1, false}, {720, 60, 1, false},
+			   {720, 30, 1, false},  {540, 30, 1, false},  {360, 30, 1, true}};
+	}
+
+	// Filter candidates against MediaCodec hardware caps, tier ceiling, and streaming bitrate
+	std::vector<Result> candidates;
+	for (const auto &c : rawList) {
+		if (!c.force) {
+			if (c.cy > baseCY || c.cy > maxHeightTier)
+				continue;
+			if (c.fps_num > maxFpsTier)
+				continue;
+			// On Tier 3 streaming, prefer 1080p30 or 720p60 rather than pushing 1080p60 sustained
+			if (!forRecording && hw.tier == 3 && c.cy >= 1080 && c.fps_num > 30)
+				continue;
+		}
+		int cx = int(std::lround(aspect * (long double)c.cy)) & ~1;
+		int cy = c.cy & ~1;
+		if (cx < 320)
+			cx = 320;
+		if (cy < 180)
+			cy = 180;
+
+		if (!c.force && !hw.SupportsHardwareEncode(useHevc, cx, cy, c.fps_num))
+			continue;
+
+		if (!c.force && !forRecording) {
+			// Realistic hardware MediaCodec H.264 minimum bitrate thresholds:
+			// 1080p60: ~5200 kbps, 1080p30: ~3400 kbps, 720p60: ~3200 kbps, 720p30: ~2000 kbps
+			int minBr = int(EstimateMinBitrate(cx, cy, c.fps_num, c.fps_den) * 0.90l);
+			if (wiz->idealBitrate < minBr)
+				continue;
+		}
+		candidates.emplace_back(cx, cy, c.fps_num, c.fps_den);
+		if (candidates.size() >= 3)
+			break;
+	}
+	if (candidates.empty()) {
+		candidates.emplace_back(1280, 720, 30, 1);
+	}
+
+	// Run real live GPU + MediaCodec Surface benchmark using TestMode + null_output
+	TestMode testMode;
+	Result chosen = candidates.back();
+	double bestMeasuredFps = 0.0;
+
+	for (size_t idx = 0; idx < candidates.size(); ++idx) {
+		const Result &cand = candidates[idx];
+		const bool isLastFallback = (idx + 1 == candidates.size());
+		const int pct = int(((idx + 1) * 90) / candidates.size());
+		QMetaObject::invokeMethod(this, &AutoConfigTestPage::Progress, pct);
+
+		const double targetFps = double(cand.fps_num) / double(std::max(1, cand.fps_den));
+		QMetaObject::invokeMethod(
+			this, &AutoConfigTestPage::UpdateMessage,
+			QStringLiteral("Probando GPU MediaCodec (%1): %2x%3 @ %4 FPS...")
+				.arg(useHevc ? QStringLiteral("HEVC") : QStringLiteral("H.264"),
+				     QString::number(cand.cx), QString::number(cand.cy),
+				     QString::number(int(std::lround(targetFps)))));
+
+		testMode.SetVideo(cand.cx, cand.cy, cand.fps_num, cand.fps_den);
+
+		OBSEncoderAutoRelease vencoder = obs_video_encoder_create(vencId, "android_bench_venc", nullptr, nullptr);
+		OBSEncoderAutoRelease aencoder =
+			obs_audio_encoder_create(aencId, "android_bench_aenc", nullptr, 0, nullptr);
+		OBSOutputAutoRelease output = obs_output_create("null_output", "android_bench_null", nullptr, nullptr);
+
+		if (!vencoder || !aencoder || !output) {
+			if (isLastFallback) {
+				chosen = cand;
+				break;
+			}
+			continue;
+		}
+
+		OBSDataAutoRelease vset = obs_data_create();
+		OBSDataAutoRelease aset = obs_data_create();
+		const int testBr = forRecording ? (cand.cy >= 1080 ? 10000 : 6000) : std::max(1500, wiz->idealBitrate);
+		obs_data_set_int(vset, "bitrate", testBr);
+		obs_data_set_int(vset, "bitrate_mode", forRecording ? 1 : 2);
+		obs_data_set_int(vset, "keyint_sec", 2);
+		obs_data_set_bool(vset, "hardware", true);
+		obs_data_set_int(aset, "bitrate", 128);
+
+		obs_encoder_update(vencoder, vset);
+		obs_encoder_update(aencoder, aset);
+		obs_encoder_set_video(vencoder, obs_get_video());
+		obs_encoder_set_audio(aencoder, obs_get_audio());
+		obs_output_set_video_encoder(output, vencoder);
+		obs_output_set_audio_encoder(output, aencoder, 0);
+		obs_output_set_media(output, obs_get_video(), obs_get_audio());
+
+		bool deactivated = false;
+		auto on_deactivated = [&]() {
+			unique_lock<mutex> lock(m);
+			deactivated = true;
+			cv.notify_one();
+		};
+		using on_deact_t = decltype(on_deactivated);
+		auto pre_deact = [](void *data, calldata_t *) {
+			(*static_cast<on_deact_t *>(data))();
+		};
+		signal_handler *sh = obs_output_get_signal_handler(output);
+		signal_handler_connect(sh, "deactivate", pre_deact, &on_deactivated);
+
+		uint32_t skippedBefore = video_output_get_skipped_frames(obs_get_video());
+		{
+			unique_lock<mutex> ul(m);
+			if (cancel)
+				return false;
+		}
+
+		if (!obs_output_start(output)) {
+			signal_handler_disconnect(sh, "deactivate", pre_deact, &on_deactivated);
+			if (isLastFallback) {
+				chosen = cand;
+				break;
+			}
+			continue;
+		}
+
+		{
+			unique_lock<mutex> ul(m);
+			cv.wait_for(ul, chrono::milliseconds(1600), [&]() { return cancel || deactivated; });
+			if (cancel) {
+				ul.unlock();
+				obs_output_force_stop(output);
+				signal_handler_disconnect(sh, "deactivate", pre_deact, &on_deactivated);
+				return false;
+			}
+		}
+
+		const double activeFps = obs_get_active_fps();
+		const uint32_t skippedAfter = video_output_get_skipped_frames(obs_get_video());
+		const int skippedDelta = int(skippedAfter >= skippedBefore ? (skippedAfter - skippedBefore) : 0);
+
+		obs_output_stop(output);
+		{
+			unique_lock<mutex> ul(m);
+			cv.wait_for(ul, chrono::milliseconds(1500), [&]() { return deactivated; });
+		}
+		signal_handler_disconnect(sh, "deactivate", pre_deact, &on_deactivated);
+
+		const bool sustained = (skippedDelta <= 4) && (activeFps <= 1.0 || activeFps >= targetFps * 0.84);
+		blog(LOG_INFO,
+		     "[Android AutoConfig] Benchmarked %s %dx%d@%.0ffps -> skipped=%d activeFps=%.1f sustained=%d",
+		     vencId, cand.cx, cand.cy, targetFps, skippedDelta, activeFps, int(sustained));
+
+		if (sustained || isLastFallback) {
+			chosen = cand;
+			bestMeasuredFps = activeFps > 1.0 ? activeFps : targetFps;
+			break;
+		}
+	}
+
+	QMetaObject::invokeMethod(this, &AutoConfigTestPage::Progress, 100);
+
+	wiz->idealResolutionCX = chosen.cx;
+	wiz->idealResolutionCY = chosen.cy;
+	wiz->idealFPSNum = chosen.fps_num;
+	wiz->idealFPSDen = chosen.fps_den;
+	wiz->measuredEncodeFps = bestMeasuredFps;
+	wiz->idealScaleType = (hw.tier >= 3) ? "bicubic" : "bilinear";
+	wiz->idealAudioBitrate = (hw.tier >= 3) ? 160 : 128;
+
+	// If user didn't explicitly pick a custom base canvas and output is <= 720p on mid/low tier,
+	// match base canvas to output resolution to eliminate extra GPU downscale pass!
+	if (!wiz->userChangedBaseRes && chosen.cy <= 720 && hw.tier <= 2) {
+		wiz->baseResolutionCX = chosen.cx;
+		wiz->baseResolutionCY = chosen.cy;
+	}
+
+	if (!forRecording) {
+		// Clamp streaming bitrate to sensible upper bound for chosen resolution/FPS
+		long double fUpper = EstimateUpperBitrate(chosen.cx, chosen.cy, chosen.fps_num, chosen.fps_den) * 1.14l;
+		int upperBitrate = std::max(1500, int(floor(fUpper / 50.0l) * 50.0l));
+		if (hw.h264_max_bitrate_kbps > 1000)
+			upperBitrate = std::min(upperBitrate, hw.h264_max_bitrate_kbps);
+		if (wiz->idealBitrate > upperBitrate)
+			wiz->idealBitrate = upperBitrate;
+	}
+
+	androidHwBenchmarked = true;
+	return true;
+}
