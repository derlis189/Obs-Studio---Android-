+void OBSQTDisplay::AndroidPresentAHBCallback(void *opaque, void *ahbPtr, uint32_t width, uint32_t height)
+{
+	auto *br = static_cast<AndroidDisplayBridge *>(opaque);
+	auto *ahb = static_cast<AHardwareBuffer *>(ahbPtr);
+	if (!ahb)
+		return;
+	if (!br || br->destroying.load(std::memory_order_acquire) || !br->appActive.load(std::memory_order_acquire) ||
+	    !width || !height) {
+		AHardwareBuffer_release(ahb);
+		return;
+	}
+	OBSQTDisplay *targetWidget = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(br->frameMutex);
+		if (br->destroying.load(std::memory_order_acquire)) {
+			AHardwareBuffer_release(ahb);
+			return;
+		}
+		if (br->pendingAhb)
+			AHardwareBuffer_release(br->pendingAhb);
+		br->pendingAhb = ahb;
+		br->pendingAhbW = width;
+		br->pendingAhbH = height;
+		targetWidget = br->widget.data();
+	}
+	// libobs now limits the auxiliary display before rendering it. Queue each
+	// resulting frame once instead of applying a second, jitter-sensitive cap here.
+	bool expected = false;
+	if (targetWidget && br->updateQueued.compare_exchange_strong(expected, true)) {
+		QMetaObject::invokeMethod(
+			targetWidget,
+			[br]() {
+				br->updateQueued.store(false);
+				if (br->destroying.load(std::memory_order_acquire) || !br->widget)
+					return;
+				if (!br->appActive.load(std::memory_order_acquire) || !br->widget->isVisible())
+					return;
+				QWidget *top = br->widget->window();
+				if (top && top->windowHandle() && !top->windowHandle()->isExposed())
+					return;
+				br->widget->update();
+			},
+			Qt::QueuedConnection);
+	}
+}
+
+void OBSQTDisplay::AndroidPresentCallback(void *opaque, const uint8_t *rgba, uint32_t width, uint32_t height)
+{
+	auto *br = static_cast<AndroidDisplayBridge *>(opaque);
+	if (!br || br->destroying.load(std::memory_order_acquire) || !rgba || !width || !height)
+		return;
+	OBSQTDisplay *targetWidget = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(br->frameMutex);
+		if (br->destroying.load(std::memory_order_acquire))
+			return;
+		if (br->presentedFrame.width() != (int)width || br->presentedFrame.height() != (int)height ||
+		    br->presentedFrame.format() != QImage::Format_RGBA8888) {
+			br->presentedFrame = QImage((int)width, (int)height, QImage::Format_RGBA8888);
+		}
+		const size_t rowBytes = (size_t)width * 4;
+		for (uint32_t y = 0; y < height; ++y) {
+			std::memcpy(br->presentedFrame.scanLine((int)y), rgba + (size_t)y * rowBytes, rowBytes);
+		}
+		targetWidget = br->widget.data();
+	}
+	bool expected = false;
+	if (targetWidget && br->updateQueued.compare_exchange_strong(expected, true)) {
+		QMetaObject::invokeMethod(
+			targetWidget,
+			[br]() {
+				br->updateQueued.store(false);
+				if (!br->destroying.load(std::memory_order_acquire) && br->widget)
+					br->widget->update();
+			},
+			Qt::QueuedConnection);
+	}
+}
