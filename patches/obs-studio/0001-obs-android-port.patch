+class AndroidScreenClampFilter : public QObject {
+public:
+	explicit AndroidScreenClampFilter(QMainWindow *mw) : QObject(mw), mainWin(mw) {}
+
+protected:
+	bool eventFilter(QObject *obj, QEvent *ev) override
+	{
+		if (obj == mainWin && mainWin) {
+			const QEvent::Type t = ev->type();
+			if (t == QEvent::Resize || t == QEvent::Show || t == QEvent::LayoutRequest) {
+				if (!clamping) {
+					clamping = true;
+					ClampMainWindowToScreen(mainWin);
+					clamping = false;
+				}
+			}
+		}
+		return QObject::eventFilter(obj, ev);
+	}
+
+private:
+	QPointer<QMainWindow> mainWin;
+	bool clamping = false;
+};
