+std::string GetSysProp(const char *name)
+{
+	char buf[PROP_VALUE_MAX] = {};
+	int len = __system_property_get(name, buf);
+	return len > 0 ? std::string(buf, static_cast<size_t>(len)) : std::string();
+}
+
+void *FindJniBridgeHandle()
+{
+	void *h = dlopen("libobs-android-jni.so", RTLD_NOW | RTLD_NOLOAD);
+	if (!h) {
+		const char *libs = obs_android_libraries_path();
+		if (!libs || !*libs)
+			libs = getenv("OBS_ANDROID_LIBRARIES_PATH");
+		if (libs && *libs) {
+			std::string full = std::string(libs) + "/libobs-android-jni.so";
+			h = dlopen(full.c_str(), RTLD_NOW | RTLD_NOLOAD);
+		}
+	}
+	return h;
