+
+static double ReadAndroidGpuUsagePercent()
+{
+	static const char *kPaths[] = {
+		"/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage",
+		"/sys/class/misc/mali0/device/utilisation",
+		"/sys/kernel/gpu/gpu_busy",
+	};
+	for (const char *path : kPaths) {
+		FILE *f = std::fopen(path, "r");
+		if (!f)
+			continue;
+		char buf[64] = {};
+		size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+		std::fclose(f);
+		if (n > 0) {
+			double val = -1.0;
+			if (std::sscanf(buf, "%lf", &val) == 1 && val >= 0.0 && val <= 100.0)
+				return val;
+		}
+	}
+	// Fallback: real OBS render frame time vs frame budget
+	struct obs_video_info ovi = {};
+	if (obs_get_video_info(&ovi) && ovi.fps_num > 0 && ovi.fps_den > 0) {
+		double frameBudgetNs = (1e9 * double(ovi.fps_den)) / double(ovi.fps_num);
+		double avgFrameNs = double(obs_get_average_frame_time_ns());
+		if (frameBudgetNs > 0.0)
+			return std::clamp((avgFrameNs / frameBudgetNs) * 100.0, 0.0, 100.0);
+	}
+	return 0.0;
+}
+#endif
