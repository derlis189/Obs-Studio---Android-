+	scroll->setWidget(inner);
+	root->addWidget(scroll, 1);
+
+	auto *lblStatus = new QLabel(QStringLiteral("Estado: Detenido"), dlg);
+	lblStatus->setWordWrap(true);
+	lblStatus->setStyleSheet(QStringLiteral("background:rgba(15,23,42,0.55); padding:6px; border-radius:6px; font-weight:bold;"));
+	root->addWidget(lblStatus);
+
+	auto *btnRow = new QHBoxLayout();
+	auto *btnStart = new QPushButton(QStringLiteral("Iniciar Salida SRT"), dlg);
+	auto *btnStop = new QPushButton(QStringLiteral("Detener"), dlg);
+	auto *btnRefreshIp = new QPushButton(QStringLiteral("Actualizar IPs"), dlg);
+	auto *btnClose = new QPushButton(QStringLiteral("Cerrar"), dlg);
+	btnRow->addWidget(btnStart);
+	btnRow->addWidget(btnStop);
+	btnRow->addWidget(btnRefreshIp);
+	btnRow->addWidget(btnClose);
+	root->addLayout(btnRow);
+
+	auto refreshIps = [=]() {
+		void *h = FindAndroidJni();
+		if (!h)
+			return;
+		using ListFn = bool (*)(int, int, char *, size_t);
+		auto fn = reinterpret_cast<ListFn>(dlsym(h, "obs_android_list_srt_local_urls"));
+		if (!fn)
+			return;
+		char buf[4096] = {};
+		if (fn(spPort->value(), spLat->value(), buf, sizeof(buf)) && buf[0]) {
+			urlsBox->setPlainText(QString::fromUtf8(buf));
+		} else {
+			urlsBox->setPlainText(QStringLiteral("Sin interfaces de red activas detectadas. Activa Wi-Fi, Hotspot o datos moviles."));
+		}
+	};
+
+	auto refreshStatus = [=]() {
+		void *h = FindAndroidJni();
+		if (!h)
+			return;
+		using StFn = bool (*)(char *, size_t);
+		auto fn = reinterpret_cast<StFn>(dlsym(h, "obs_android_srt_output_status"));
+		if (!fn)
+			return;
+		char buf[1024] = {};
+		if (!fn(buf, sizeof(buf)))
+			return;
+		try {
+			auto j = nlohmann::json::parse(buf);
+			bool act = j.value("active", false);
+			std::string st = j.value("state", "Detenido");
+			std::string det = j.value("detail", "");
+			double kbps = j.value("kbps", 0.0);
+			double rtt = j.value("rtt", 0.0);
+			long long lost = j.value("lost", 0LL);
+			long long ret = j.value("retrans", 0LL);
+			unsigned long long up = j.value("uptime", 0ULL);
+			if (act) {
+				lblStatus->setText(QStringLiteral("Estado: %1 (%2) | %3 kbps | RTT %4 ms | Perd:%5 Retr:%6 | %7s")
+							   .arg(QString::fromStdString(st))
+							   .arg(QString::fromStdString(det))
+							   .arg(int(kbps))
+							   .arg(QString::number(rtt, 'f', 1))
+							   .arg(lost)
+							   .arg(ret)
+							   .arg(up));
+			} else {
+				lblStatus->setText(QStringLiteral("Estado: Detenido"));
+			}
+			btnStart->setEnabled(!act);
+			btnStop->setEnabled(act);
+		} catch (...) {}
+	};
+
+	QObject::connect(btnRefreshIp, &QPushButton::clicked, dlg, refreshIps);
+	QObject::connect(spPort, qOverload<int>(&QSpinBox::valueChanged), dlg, [=](int) { refreshIps(); });
+	QObject::connect(spLat, qOverload<int>(&QSpinBox::valueChanged), dlg, [=](int) { refreshIps(); });
+	QObject::connect(btnStart, &QPushButton::clicked, dlg, [=]() {
+		std::string mode = cbMode->currentData().toString().toStdString();
+		std::string host = edHost->text().trimmed().toStdString();
+		int port = spPort->value();
+		int lat = spLat->value();
+		int br = spBitrate->value();
+		std::string sid = edStreamId->text().trimmed().toStdString();
+		std::string pass = edPass->text().toStdString();
+
+		SaveSrtConfig({{"mode", mode}, {"host", host}, {"port", port}, {"latency_ms", lat},
+			       {"bitrate_kbps", br}, {"streamid", sid}, {"passphrase", pass}});
+
+		if (mode == "caller" && host.empty()) {
+			lblStatus->setText(QStringLiteral("Error: ingresa una IP o URL SRT destino para modo Caller."));
+			return;
+		}
+		void *h = FindAndroidJni();
+		if (!h)
+			return;
+		using StartFn = bool (*)(const char *, const char *, int, int, const char *, const char *, int);
+		auto fn = reinterpret_cast<StartFn>(dlsym(h, "obs_android_srt_output_start"));
+		if (fn && fn(mode.c_str(), host.c_str(), port, lat, sid.c_str(), pass.c_str(), br)) {
+			refreshStatus();
+		} else {
+			lblStatus->setText(QStringLiteral("Error al iniciar Salida SRT. Verifica la red y parametros."));
+		}
+	});
+	QObject::connect(btnStop, &QPushButton::clicked, dlg, [=]() {
+		if (void *h = FindAndroidJni()) {
+			using StopFn = void (*)();
+			auto fn = reinterpret_cast<StopFn>(dlsym(h, "obs_android_srt_output_stop"));
+			if (fn)
+				fn();
+		}
+		refreshStatus();
+	});
+	QObject::connect(btnClose, &QPushButton::clicked, dlg, &QDialog::accept);
+
+	auto *tmr = new QTimer(dlg);
+	tmr->setInterval(1000);
+	QObject::connect(tmr, &QTimer::timeout, dlg, refreshStatus);
+	tmr->start();
+
+	refreshIps();
+	refreshStatus();
+	dlg->show();
+}
