+void AddAndroidCustomBrowserDock(const QString &title, const QString &url, const QString &uuidIn, bool desktopMode,
+				 bool showNow)
+{
+	QString uuid = uuidIn;
+	if (uuid.isEmpty()) {
+		uuid = QUuid::createUuid().toString(QUuid::WithoutBraces);
+		uuid.remove('-');
+	}
+
+	AndroidBrowserDockEntry entry;
+	entry.nativeId = g_nextBrowserDockId++;
+	entry.uuid = uuid;
+	entry.dockObjId = QStringLiteral("obs_android_webdock_") + uuid;
+	entry.title = title.trimmed().isEmpty() ? QStringLiteral("Panel Web") : title.trimmed();
+	entry.url = url.trimmed();
+	entry.desktopMode = desktopMode;
+
+	QWidget *container = new QWidget();
+	container->setMinimumSize(64, 76);
+	container->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Ignored);
+	auto *vbox = new QVBoxLayout(container);
+	vbox->setContentsMargins(0, 0, 0, 0);
+	vbox->setSpacing(0);
+
+	auto *barScroll = new QScrollArea(container);
+	barScroll->setFrameShape(QFrame::NoFrame);
+	barScroll->setWidgetResizable(true);
+	barScroll->setFixedHeight(28);
+	barScroll->setMinimumWidth(0);
+	barScroll->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	barScroll->setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	barScroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	barScroll->setStyleSheet(QStringLiteral("background-color: #1f232c; border-bottom: 1px solid #303645;"));
+
+	auto *bar = new QWidget(barScroll);
+	bar->setStyleSheet(QStringLiteral("background-color: #1f232c;"));
+	auto *hbox = new QHBoxLayout(bar);
+	hbox->setContentsMargins(3, 2, 3, 2);
+	hbox->setSpacing(3);
+
+	auto makeMiniBtn = [bar](const QString &txt, const QString &tip) {
+		auto *b = new QPushButton(txt, bar);
+		b->setToolTip(tip);
+		b->setFixedHeight(22);
+		b->setMinimumWidth(20);
+		b->setStyleSheet(QStringLiteral(
+			"QPushButton { background: #2c3240; color: #e2e8f0; border: 1px solid #3e4659; "
+			"border-radius: 4px; padding: 0 5px; font-size: 11px; }"
+			"QPushButton:pressed { background: #3b82f6; }"));
+		return b;
+	};
+
+	const int64_t nid = entry.nativeId;
+	QPushButton *btnBack = makeMiniBtn(QStringLiteral("<"), QStringLiteral("Atrás"));
+	QPushButton *btnFwd = makeMiniBtn(QStringLiteral(">"), QStringLiteral("Adelante"));
+	QPushButton *btnReload = makeMiniBtn(QStringLiteral("Rec."), QStringLiteral("Recargar"));
+	QPushButton *btnZoomOut = makeMiniBtn(QStringLiteral("A-"), QStringLiteral("Reducir zoom"));
+	QPushButton *btnZoomIn = makeMiniBtn(QStringLiteral("A+"), QStringLiteral("Aumentar zoom"));
+	QPushButton *btnDesktop = makeMiniBtn(desktopMode ? QStringLiteral("PC") : QStringLiteral("Movil"),
+					      QStringLiteral("Alternar vista PC / Movil"));
+	QPushButton *btnEdit = makeMiniBtn(QStringLiteral("Editar"), QStringLiteral("Administrar paneles personalizados"));
+
+	hbox->addWidget(btnBack);
+	hbox->addWidget(btnFwd);
+	hbox->addWidget(btnReload);
+	hbox->addWidget(btnZoomOut);
+	hbox->addWidget(btnZoomIn);
+	hbox->addWidget(btnDesktop);
+	hbox->addStretch(1);
+	hbox->addWidget(btnEdit);
+	barScroll->setWidget(bar);
+	vbox->addWidget(barScroll);
+
+	auto *webSlot = new QLabel(QStringLiteral("Panel web activo"), container);
+	webSlot->setAlignment(Qt::AlignCenter);
+	webSlot->setMinimumSize(64, 48);
+	webSlot->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Ignored);
+	webSlot->setStyleSheet(QStringLiteral("background-color: #14171f; color: #64748b; font-size: 11px;"));
+	vbox->addWidget(webSlot, 1);
+
+	QObject::connect(btnBack, &QPushButton::clicked, container, [nid]() { BrowserDockCallNavigate(nid, 1); });
+	QObject::connect(btnFwd, &QPushButton::clicked, container, [nid]() { BrowserDockCallNavigate(nid, 2); });
+	QObject::connect(btnReload, &QPushButton::clicked, container, [nid]() { BrowserDockCallNavigate(nid, 0); });
+	QObject::connect(btnZoomOut, &QPushButton::clicked, container, [nid]() { BrowserDockCallNavigate(nid, 5); });
+	QObject::connect(btnZoomIn, &QPushButton::clicked, container, [nid]() { BrowserDockCallNavigate(nid, 4); });
+	QObject::connect(btnDesktop, &QPushButton::clicked, container, [nid, btnDesktop]() {
+		for (auto &it : g_browserDocks) {
+			if (it.nativeId == nid) {
+				it.desktopMode = !it.desktopMode;
+				btnDesktop->setText(it.desktopMode ? QStringLiteral("PC") : QStringLiteral("Movil"));
+				BrowserDockCallNavigate(nid, 3);
+				SaveAndroidCustomBrowserDocks();
+				break;
+			}
+		}
+	});
+	QObject::connect(btnEdit, &QPushButton::clicked, container, []() { OpenManageCustomBrowserDocksDialog(); });
+	QObject::connect(container, &QObject::destroyed, container, [nid]() { BrowserDockCallDestroy(nid); });
+
+	entry.webSlot = webSlot;
+	entry.desktopBtn = btnDesktop;
+
+	const QByteArray idUtf8 = entry.dockObjId.toUtf8();
+	const QByteArray titleUtf8 = entry.title.toUtf8();
+	obs_frontend_add_dock_by_id(idUtf8.constData(), titleUtf8.constData(), container);
+
+	g_browserDocks.push_back(entry);
+	BrowserDockCallUpsert(entry.nativeId, entry.url, entry.desktopMode);
+
+	if (g_browserDockMainWin) {
+		if (auto *dock = g_browserDockMainWin->findChild<QDockWidget *>(entry.dockObjId)) {
+			HardenAndroidDock(dock);
+			if (showNow) {
+				dock->show();
+				dock->raise();
+			}
+		}
+		ClampMainWindowToScreen(g_browserDockMainWin);
+	}
+
+	if (g_browserDockSyncTimer && !g_browserDockSyncTimer->isActive()) {
+		g_browserDockSyncTimer->start();
+	}
+	QTimer::singleShot(80, []() { SyncAllAndroidBrowserDocks(); });
+}
+
+void OpenManageCustomBrowserDocksDialog()
+{
+	QWidget *parent = g_browserDockMainWin ? g_browserDockMainWin.data() : QApplication::activeWindow();
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Paneles de navegador personalizados"));
+	QSize maxDlg(700, 440);
+	if (QScreen *scr = (parent && parent->screen()) ? parent->screen() : QGuiApplication::primaryScreen()) {
+		maxDlg = maxDlg.boundedTo(scr->availableGeometry().size() - QSize(24, 24));
+	}
+	dlg.resize(maxDlg);
+	dlg.setModal(true);
+
+	auto *root = new QVBoxLayout(&dlg);
+	auto *info = new QLabel(
+		QStringLiteral("Agrega paneles web interactivos (chat de Twitch, YouTube, Kick, StreamElements, "
+			       "alertas, etc.). Quedan acoplables en OBS y guardan tu sesión automáticamente."),
+		&dlg);
+	info->setWordWrap(true);
+	info->setStyleSheet(QStringLiteral("color: #cbd5e1; font-size: 12px;"));
+	root->addWidget(info);
+
+	auto *scroll = new QScrollArea(&dlg);
+	scroll->setWidgetResizable(true);
+	auto *rowsHost = new QWidget(scroll);
+	auto *rowsLayout = new QVBoxLayout(rowsHost);
+	rowsLayout->setContentsMargins(4, 4, 4, 4);
+	rowsLayout->setSpacing(6);
+	scroll->setWidget(rowsHost);
+	root->addWidget(scroll, 1);
+
+	struct RowWidgets {
+		QString existingUuid;
+		QWidget *rowWidget = nullptr;
+		QLineEdit *titleEdit = nullptr;
+		QLineEdit *urlEdit = nullptr;
+		QCheckBox *desktopCheck = nullptr;
+		bool removed = false;
+	};
+	auto rows = std::make_shared<std::vector<RowWidgets>>();
+
+	auto addRowUi = [rows, rowsHost, rowsLayout](const QString &uuid, const QString &title, const QString &url,
+						     bool desktop) {
+		RowWidgets rw;
+		rw.existingUuid = uuid;
+		rw.rowWidget = new QWidget(rowsHost);
+		auto *h = new QHBoxLayout(rw.rowWidget);
+		h->setContentsMargins(2, 2, 2, 2);
+		h->setSpacing(6);
+
+		rw.titleEdit = new QLineEdit(title, rw.rowWidget);
+		rw.titleEdit->setPlaceholderText(QStringLiteral("Nombre (ej. Chat Twitch)"));
+		rw.titleEdit->setMinimumWidth(140);
+
+		rw.urlEdit = new QLineEdit(url, rw.rowWidget);
+		rw.urlEdit->setPlaceholderText(QStringLiteral("https://..."));
+
+		rw.desktopCheck = new QCheckBox(QStringLiteral("PC"), rw.rowWidget);
+		rw.desktopCheck->setToolTip(QStringLiteral("Solicitar versión de escritorio"));
+		rw.desktopCheck->setChecked(desktop);
+
+		auto *delBtn = new QPushButton(QStringLiteral("X"), rw.rowWidget);
+		delBtn->setFixedWidth(30);
+		delBtn->setToolTip(QStringLiteral("Eliminar panel"));
+
+		h->addWidget(rw.titleEdit, 2);
+		h->addWidget(rw.urlEdit, 4);
+		h->addWidget(rw.desktopCheck, 0);
+		h->addWidget(delBtn, 0);
+
+		const size_t idx = rows->size();
+		rows->push_back(rw);
+		rowsLayout->insertWidget(std::max(0, rowsLayout->count() - 1), rw.rowWidget);
+
+		QObject::connect(delBtn, &QPushButton::clicked, rw.rowWidget, [rows, idx]() {
+			if (idx < rows->size() && !(*rows)[idx].removed) {
+				(*rows)[idx].removed = true;
+				if ((*rows)[idx].rowWidget)
+					(*rows)[idx].rowWidget->hide();
+			}
+		});
+	};
+
+	rowsLayout->addStretch(1);
+	for (const auto &e : g_browserDocks) {
+		addRowUi(e.uuid, e.title, e.url, e.desktopMode);
+	}
+	addRowUi(QString(), QString(), QString(), false);
+
+	// Quick template buttons
+	auto *tplRow = new QHBoxLayout();
+	auto *lblTpl = new QLabel(QStringLiteral("Atajos:"), &dlg);
+	tplRow->addWidget(lblTpl);
+	auto addTplBtn = [&](const QString &label, const QString &defTitle, const QString &defUrl, bool desk) {
+		auto *b = new QPushButton(label, &dlg);
+		QObject::connect(b, &QPushButton::clicked, &dlg, [=]() {
+			addRowUi(QString(), defTitle, defUrl, desk);
+		});
+		tplRow->addWidget(b);
+	};
+	addTplBtn(QStringLiteral("+ Nuevo vacío"), QString(), QString(), false);
+	addTplBtn(QStringLiteral("+ Twitch Chat"), QStringLiteral("Chat Twitch"),
+		  QStringLiteral("https://www.twitch.tv/popout/TU_CANAL/chat?darkpopout"), false);
+	addTplBtn(QStringLiteral("+ YouTube Chat"), QStringLiteral("Chat YouTube"),
+		  QStringLiteral("https://studio.youtube.com/live_chat?is_popout=1"), true);
+	addTplBtn(QStringLiteral("+ StreamElements"), QStringLiteral("Actividad SE"),
+		  QStringLiteral("https://streamelements.com/dashboard/activity-feed"), true);
+	tplRow->addStretch(1);
+	root->addLayout(tplRow);
+
+	auto *btns = new QDialogButtonBox(QDialogButtonBox::Apply | QDialogButtonBox::Close, &dlg);
+	if (auto *applyBtn = btns->button(QDialogButtonBox::Apply))
+		applyBtn->setText(QStringLiteral("Aplicar"));
+	if (auto *closeBtn = btns->button(QDialogButtonBox::Close))
+		closeBtn->setText(QStringLiteral("Cerrar"));
+	root->addWidget(btns);
+
+	auto applyChanges = [rows]() {
+		// 1) Remove deleted docks
+		std::vector<QString> keepUuids;
+		for (const auto &rw : *rows) {
+			if (!rw.removed && !rw.existingUuid.isEmpty())
+				keepUuids.push_back(rw.existingUuid);
+		}
+		for (auto it = g_browserDocks.begin(); it != g_browserDocks.end();) {
+			if (std::find(keepUuids.begin(), keepUuids.end(), it->uuid) == keepUuids.end()) {
+				const int64_t nid = it->nativeId;
+				const QByteArray objId = it->dockObjId.toUtf8();
+				it = g_browserDocks.erase(it);
+				BrowserDockCallDestroy(nid);
+				obs_frontend_remove_dock(objId.constData());
+			} else {
+				++it;
+			}
+		}
+
+		// 2) Update existing or create new docks
+		for (auto &rw : *rows) {
+			if (rw.removed || !rw.titleEdit || !rw.urlEdit)
+				continue;
+			const QString title = rw.titleEdit->text().trimmed();
+			const QString url = rw.urlEdit->text().trimmed();
+			const bool desktop = rw.desktopCheck && rw.desktopCheck->isChecked();
+			if (title.isEmpty() || url.isEmpty())
+				continue;
+
+			if (!rw.existingUuid.isEmpty()) {
+				for (auto &e : g_browserDocks) {
+					if (e.uuid == rw.existingUuid) {
+						if (e.title != title) {
+							e.title = title;
+							if (g_browserDockMainWin) {
+								if (auto *d = g_browserDockMainWin->findChild<QDockWidget *>(
+									    e.dockObjId)) {
+									d->setWindowTitle(title);
+									if (auto *act = d->toggleViewAction())
+										act->setText(title);
+								}
+							}
+						}
+						if (e.url != url || e.desktopMode != desktop) {
+							e.url = url;
+							e.desktopMode = desktop;
+							if (e.desktopBtn)
+								e.desktopBtn->setText(
+									desktop ? QStringLiteral("PC")
+										: QStringLiteral("Móvil"));
+							BrowserDockCallUpsert(e.nativeId, e.url, e.desktopMode);
+						}
+						break;
+					}
+				}
+			} else {
+				QString newUuid = QUuid::createUuid().toString(QUuid::WithoutBraces);
+				newUuid.remove('-');
+				rw.existingUuid = newUuid;
+				AddAndroidCustomBrowserDock(title, url, newUuid, desktop, true);
+			}
+		}
+
+		SaveAndroidCustomBrowserDocks();
+		if (g_browserDocks.empty() && g_browserDockSyncTimer) {
+			g_browserDockSyncTimer->stop();
+		}
+		SyncAllAndroidBrowserDocks();
+	};
+
+	if (auto *applyBtn = btns->button(QDialogButtonBox::Apply)) {
+		QObject::connect(applyBtn, &QPushButton::clicked, &dlg, applyChanges);
+	}
+	QObject::connect(btns, &QDialogButtonBox::rejected, &dlg, [&]() {
+		applyChanges();
+		dlg.accept();
+	});
+
+	BrowserDockCallSuspended(true);
+	g_lastBrowserDocksSuspended = true;
+	dlg.exec();
+	QTimer::singleShot(60, []() { SyncAllAndroidBrowserDocks(); });
+}
+} // namespace
+
+void InstallAndroidCustomBrowserDocks(QWidget *mainWindow, QMenu *docksMenu, QAction *beforeAction)
+{
+	g_browserDockMainWin = mainWindow;
+	if (!g_browserDockSyncTimer && mainWindow) {
+		g_browserDockSyncTimer = new QTimer(mainWindow);
+		g_browserDockSyncTimer->setInterval(70);
+		QObject::connect(g_browserDockSyncTimer, &QTimer::timeout, mainWindow,
+				 []() { SyncAllAndroidBrowserDocks(); });
+	}
+
+	if (docksMenu) {
+		QString label = QTStr("Basic.MainMenu.Docks.CustomBrowserDocks");
+		if (label.isEmpty() || label == QStringLiteral("Basic.MainMenu.Docks.CustomBrowserDocks")) {
+			label = QStringLiteral("Paneles de navegador personalizados...");
+		}
+		QAction *act = new QAction(label, mainWindow);
+		if (beforeAction) {
+			docksMenu->insertAction(beforeAction, act);
+			docksMenu->insertSeparator(beforeAction);
+		} else {
+			docksMenu->addAction(act);
+			docksMenu->addSeparator();
+		}
+		QObject::connect(act, &QAction::triggered, mainWindow, []() { OpenManageCustomBrowserDocksDialog(); });
+	}
+
+	const char *jsonStr = config_get_string(App()->GetUserConfig(), "BasicWindow", "ExtraBrowserDocks");
+	if (jsonStr && *jsonStr) {
+		try {
+			auto parsed = nlohmann::json::parse(jsonStr);
+			if (parsed.is_array()) {
+				for (const auto &item : parsed) {
+					if (!item.is_object())
+						continue;
+					const QString title = QString::fromStdString(item.value("title", ""));
+					const QString url = QString::fromStdString(item.value("url", ""));
+					const QString uuid = QString::fromStdString(item.value("uuid", ""));
+					const bool desktop = item.value("desktop", false);
+					if (!title.isEmpty() && !url.isEmpty()) {
+						AddAndroidCustomBrowserDock(title, url, uuid, desktop, false);
+					}
+				}
+			}
+		} catch (...) {
+		}
+	}
+}
