+void OnFrontendEventAndroid(enum obs_frontend_event event, void *)
+{
+	if (event == OBS_FRONTEND_EVENT_EXIT) {
+		ClearBugLayer();
+		if (void *jni = FindAndroidJni()) {
+			using KeepaliveFn = void (*)(bool);
+			if (auto fn = reinterpret_cast<KeepaliveFn>(dlsym(jni, "obs_android_set_broadcast_keepalive")))
+				fn(false);
+		}
+	} else if (event == OBS_FRONTEND_EVENT_STREAMING_STARTED ||
+		   event == OBS_FRONTEND_EVENT_STREAMING_STOPPED ||
+		   event == OBS_FRONTEND_EVENT_RECORDING_STARTED ||
+		   event == OBS_FRONTEND_EVENT_RECORDING_STOPPED ||
+		   event == OBS_FRONTEND_EVENT_REPLAY_BUFFER_STARTED ||
+		   event == OBS_FRONTEND_EVENT_REPLAY_BUFFER_STOPPED) {
+		SyncBroadcastKeepalive();
+	} else if (event == OBS_FRONTEND_EVENT_SCENE_CHANGED) {
+		SyncVerticalToCurrentMainScene();
+		SaveAllObsStateOnGuiThread();
+	} else if (event == OBS_FRONTEND_EVENT_SCENE_LIST_CHANGED ||
+		   event == OBS_FRONTEND_EVENT_SCENE_COLLECTION_CHANGED ||
+		   event == OBS_FRONTEND_EVENT_PROFILE_CHANGED ||
+		   event == OBS_FRONTEND_EVENT_STUDIO_MODE_ENABLED ||
+		   event == OBS_FRONTEND_EVENT_STUDIO_MODE_DISABLED ||
+		   event == OBS_FRONTEND_EVENT_FINISHED_LOADING) {
+		RefreshBugButtons();
+		if (event == OBS_FRONTEND_EVENT_FINISHED_LOADING) {
+			EnsureVisibleRecordingFolder();
+			SyncVerticalRuntimeFromConfig(LoadMultiConfig());
+			SyncVerticalToCurrentMainScene();
+			if (!bugScene && LoadBugSlotsFromDisk())
+				RestoreAllBugSlots();
+			else
+				RefreshBugButtons();
+		} else {
+			SaveAllObsStateOnGuiThread();
+		}
+	}
+}
