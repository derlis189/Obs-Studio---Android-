+void OpenBackupRestoreDialog(QWidget *parent)
+{
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Respaldar / Restaurar configuración OBS"));
+	dlg.resize(QSize(560, 400).boundedTo(parent->screen()->availableGeometry().size()));
+
+	const char *filesRoot = obs_android_files_path();
+	const QString obsCfgRoot = filesRoot ? (QString::fromUtf8(filesRoot) + "/obs-studio") : QString();
+	const QString backupRoot = QString::fromStdString(GetDefaultVideoSavePath()) + "/Backups";
+	QDir().mkpath(backupRoot);
+
+	auto *root = new QVBoxLayout(&dlg);
+	root->setSpacing(8);
+	auto *info = new QLabel(
+		QStringLiteral("Guarda todas tus escenas, perfiles, ajustes de Captura Vertical 9:16, fondos y gráficos en:\n%1\n(Sobrevive desinstalaciones y podés copiarlo a otro celular).")
+			.arg(backupRoot),
+		&dlg);
+	info->setWordWrap(true);
+	info->setStyleSheet(QStringLiteral("color: #94a3b8; font-size: 12px;"));
+	root->addWidget(info);
+
+	auto *list = new QListWidget(&dlg);
+	root->addWidget(list, 1);
+
+	auto *statusLbl = new QLabel(&dlg);
+	statusLbl->setWordWrap(true);
+	root->addWidget(statusLbl);
+
+	auto *btnRow = new QHBoxLayout();
+	auto *btnCreate = new QPushButton(QStringLiteral("Crear respaldo ahora"), &dlg);
+	btnCreate->setMinimumHeight(38);
+	btnCreate->setStyleSheet(QStringLiteral("QPushButton { background: #1d4ed8; color: white; font-weight: bold; border-radius: 6px; }"));
+	auto *btnRestore = new QPushButton(QStringLiteral("Restaurar seleccionado"), &dlg);
+	btnRestore->setMinimumHeight(38);
+	auto *btnClose = new QPushButton(QStringLiteral("Cerrar"), &dlg);
+	btnRow->addWidget(btnCreate, 1);
+	btnRow->addWidget(btnRestore, 1);
+	btnRow->addWidget(btnClose);
+	root->addLayout(btnRow);
+
+	auto refreshBackups = [&]() {
+		list->clear();
+		QDir d(backupRoot);
+		const auto dirs = d.entryList(QDir::Dirs | QDir::NoDotAndDotDot, QDir::Name | QDir::Reversed);
+		for (const QString &nm : dirs)
+			list->addItem(nm);
+		if (list->count() > 0)
+			list->setCurrentRow(0);
+		btnRestore->setEnabled(list->count() > 0);
+	};
+
+	QObject::connect(btnCreate, &QPushButton::clicked, &dlg, [&]() {
+		if (obsCfgRoot.isEmpty())
+			return;
+		SaveAllObsStateOnGuiThread();
+		const QString folderName =
+			QStringLiteral("OBS_Backup_%1")
+				.arg(QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd_HH-mm-ss")));
+		const QString dst = backupRoot + "/" + folderName;
+		QDir().mkpath(dst);
+		bool ok = true;
+		if (QDir(obsCfgRoot + "/basic").exists())
+			ok = CopyDirRecursive(obsCfgRoot + "/basic", dst + "/basic") && ok;
+		if (QDir(obsCfgRoot + "/vertical").exists())
+			CopyDirRecursive(obsCfgRoot + "/vertical", dst + "/vertical");
+		if (QDir(obsCfgRoot + "/overlay-media").exists())
+			CopyDirRecursive(obsCfgRoot + "/overlay-media", dst + "/overlay-media");
+		QDir cfgDir(obsCfgRoot);
+		const auto files = cfgDir.entryInfoList(QStringList{"*.ini", "*.json"}, QDir::Files);
+		for (const QFileInfo &fi : files) {
+			QFile::copy(fi.absoluteFilePath(), dst + "/" + fi.fileName());
+		}
+		refreshBackups();
+		statusLbl->setStyleSheet(ok ? QStringLiteral("color: #22c55e; font-weight: bold;")
+					    : QStringLiteral("color: #f59e0b; font-weight: bold;"));
+		statusLbl->setText(ok ? QStringLiteral("Respaldo creado: %1").arg(folderName)
+				      : QStringLiteral("Respaldo creado con avisos en: %1").arg(folderName));
+	});
+
+	QObject::connect(btnRestore, &QPushButton::clicked, &dlg, [&]() {
+		auto *it = list->currentItem();
+		if (!it || obsCfgRoot.isEmpty())
+			return;
+		const QString src = backupRoot + "/" + it->text();
+		if (QMessageBox::question(
+			    &dlg, QStringLiteral("Restaurar respaldo"),
+			    QStringLiteral("¿Restaurar '%1'? Reemplazará tus escenas y ajustes actuales.").arg(it->text()),
+			    QMessageBox::Yes | QMessageBox::No, QMessageBox::No) != QMessageBox::Yes)
+			return;
+		bool ok = true;
+		if (QDir(src + "/basic").exists())
+			ok = CopyDirRecursive(src + "/basic", obsCfgRoot + "/basic") && ok;
+		if (QDir(src + "/vertical").exists())
+			CopyDirRecursive(src + "/vertical", obsCfgRoot + "/vertical");
+		if (QDir(src + "/overlay-media").exists())
+			CopyDirRecursive(src + "/overlay-media", obsCfgRoot + "/overlay-media");
+		QDir srcDir(src);
+		const auto files = srcDir.entryInfoList(QStringList{"*.ini", "*.json"}, QDir::Files);
+		for (const QFileInfo &fi : files) {
+			const QString dstFile = obsCfgRoot + "/" + fi.fileName();
+			if (QFile::exists(dstFile))
+				QFile::remove(dstFile);
+			QFile::copy(fi.absoluteFilePath(), dstFile);
+		}
+		SyncVerticalRuntimeFromConfig(LoadMultiConfig());
+		SyncVerticalToCurrentMainScene();
+		statusLbl->setStyleSheet(ok ? QStringLiteral("color: #22c55e; font-weight: bold;")
+					    : QStringLiteral("color: #ef4444; font-weight: bold;"));
+		statusLbl->setText(
+			ok ? QStringLiteral("Respaldo restaurado. Cierra y vuelve a abrir OBS para cargar las escenas restauradas.")
+			   : QStringLiteral("Error al restaurar algunos archivos del respaldo."));
+	});
+	QObject::connect(btnClose, &QPushButton::clicked, &dlg, &QDialog::accept);
+
+	refreshBackups();
+	dlg.exec();
+}
