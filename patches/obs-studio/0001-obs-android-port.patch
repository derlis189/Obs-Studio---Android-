+
+	auto *bDelP = new QPushButton(QStringLiteral("Borrar preset seleccionado"), w);
+	bDelP->setMinimumWidth(0);
+
+	v->addWidget(edBadge);
+	v->addWidget(edTitle);
+	v->addWidget(edSub);
+	v->addWidget(cbStyle);
+	v->addLayout(btnGrid);
+	v->addWidget(lblPresets);
+	v->addWidget(presetsList);
+	v->addWidget(bDelP);
+	v->addStretch();
+
+	auto lastPresetsSig = std::make_shared<std::string>();
+	auto initialized = std::make_shared<bool>(false);
+	auto syncUi = [=](bool fillEdits) {
+		auto st = GfxGetState();
+		if (!st.contains("lowerthird"))
+			return;
+		const auto &lt = st["lowerthird"];
+		bVis->setText(lt.value("visible", true) ? QStringLiteral("Ocultar") : QStringLiteral("Mostrar"));
+		if (fillEdits || !(*initialized)) {
+			*initialized = true;
+			edBadge->setText(QString::fromStdString(lt.value("badge", "")));
+			edTitle->setText(QString::fromStdString(lt.value("title", "")));
+			edSub->setText(QString::fromStdString(lt.value("subtitle", "")));
+			cbStyle->blockSignals(true);
+			cbStyle->setCurrentIndex(std::clamp(lt.value("style", 0), 0, 8));
+			cbStyle->blockSignals(false);
+		}
+		std::string sig;
+		if (lt.contains("presets") && lt["presets"].is_array())
+			sig = lt["presets"].dump();
+		if (sig != *lastPresetsSig) {
+			*lastPresetsSig = sig;
+			int prevRow = presetsList->currentRow();
+			presetsList->blockSignals(true);
+			presetsList->clear();
+			if (lt.contains("presets") && lt["presets"].is_array()) {
+				for (const auto &pr : lt["presets"]) {
+					std::string title = pr.value("title", "Preset");
+					std::string sub = pr.value("subtitle", "");
+					std::string line = sub.empty() ? title : (title + " - " + sub);
+					presetsList->addItem(QString::fromStdString(line));
+				}
+			}
+			if (prevRow >= 0 && prevRow < presetsList->count())
+				presetsList->setCurrentRow(prevRow);
+			presetsList->blockSignals(false);
+		}
+	};
+
+	QObject::connect(bApply, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "lt_update"},
+			    {"badge", edBadge->text().trimmed().toStdString()},
+			    {"title", edTitle->text().trimmed().toStdString()},
+			    {"subtitle", edSub->text().trimmed().toStdString()}});
+		syncUi(false);
+	});
+	QObject::connect(bVis, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "lt_toggle"}});
+		syncUi(false);
+	});
+	QObject::connect(bSave, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "lt_update"},
+			    {"badge", edBadge->text().trimmed().toStdString()},
+			    {"title", edTitle->text().trimmed().toStdString()},
+			    {"subtitle", edSub->text().trimmed().toStdString()}});
+		GfxExecute({{"action", "lt_save_preset"}});
+		syncUi(false);
+	});
+	QObject::connect(cbStyle, qOverload<int>(&QComboBox::currentIndexChanged), w, [=](int idx) {
+		GfxExecute({{"action", "lt_update"}, {"style", idx}});
+	});
+	QObject::connect(bLaunchP, &QPushButton::clicked, w, [=]() {
+		int rowIdx = presetsList->currentRow();
+		if (rowIdx >= 0) {
+			GfxExecute({{"action", "lt_apply_preset"}, {"index", rowIdx}});
+			syncUi(true);
+		}
+	});
+	QObject::connect(presetsList, &QListWidget::itemDoubleClicked, w, [=](QListWidgetItem *) {
+		int rowIdx = presetsList->currentRow();
+		if (rowIdx >= 0) {
+			GfxExecute({{"action", "lt_apply_preset"}, {"index", rowIdx}});
+			syncUi(true);
+		}
+	});
+	QObject::connect(bDelP, &QPushButton::clicked, w, [=]() {
+		int rowIdx = presetsList->currentRow();
+		if (rowIdx >= 0) {
+			GfxExecute({{"action", "lt_delete_preset"}, {"index", rowIdx}});
+			syncUi(false);
+		}
+	});
+
+	auto *tmr = new QTimer(w);
+	tmr->setInterval(1200);
+	QObject::connect(tmr, &QTimer::timeout, w, [=]() {
+		if (w->isVisible())
+			syncUi(false);
+	});
+	tmr->start();
+	QTimer::singleShot(700, w, [=]() { syncUi(true); });
+	return WrapDockScroll(w);
+}
