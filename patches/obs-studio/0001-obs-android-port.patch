+class AndroidDockDropOverlay : public QWidget {
+public:
+	explicit AndroidDockDropOverlay(QWidget *parent) : QWidget(parent)
+	{
+		setAttribute(Qt::WA_TransparentForMouseEvents, true);
+		setAttribute(Qt::WA_NoSystemBackground, true);
+		setAttribute(Qt::WA_TranslucentBackground, true);
+		hide();
+	}
+
+	void setIndicator(const QRect &target, const QString &actionText, const QString &draggedTitle,
+			  const QPoint &cursorPos)
+	{
+		targetRect = target;
+		labelText = actionText;
+		draggingText = draggedTitle;
+		fingerPos = cursorPos;
+		update();
+	}
+
+protected:
+	void paintEvent(QPaintEvent *) override
+	{
+		QPainter p(this);
+		p.setRenderHint(QPainter::Antialiasing, true);
+
+		// Subtle dimming outside drop target so available zones stand out
+		p.fillRect(rect(), QColor(10, 14, 24, 70));
+
+		if (targetRect.isValid() && targetRect.width() > 8 && targetRect.height() > 8) {
+			p.setPen(QPen(QColor(59, 130, 246, 240), 3));
+			p.setBrush(QColor(37, 99, 235, 95));
+			p.drawRoundedRect(targetRect.adjusted(2, 2, -2, -2), 8, 8);
+
+			if (!labelText.isEmpty()) {
+				QFont f = p.font();
+				f.setPointSize(11);
+				f.setBold(true);
+				p.setFont(f);
+				QFontMetrics fm(f);
+				QRect textBox = fm.boundingRect(labelText).adjusted(-12, -6, 12, 6);
+				textBox.moveCenter(targetRect.center());
+				textBox.moveLeft(std::clamp(textBox.left(), 8, std::max(8, width() - textBox.width() - 8)));
+				textBox.moveTop(std::clamp(textBox.top(), 8, std::max(8, height() - textBox.height() - 8)));
+				p.setPen(QPen(QColor(147, 197, 253, 230), 1));
+				p.setBrush(QColor(15, 23, 42, 230));
+				p.drawRoundedRect(textBox, 6, 6);
+				p.setPen(Qt::white);
+				p.drawText(textBox, Qt::AlignCenter, labelText);
+			}
+		}
+
+		if (!draggingText.isEmpty()) {
+			QFont f = p.font();
+			f.setPointSize(10);
+			f.setBold(true);
+			p.setFont(f);
+			QString pill = QStringLiteral("Moviendo: ") + draggingText;
+			if (!targetRect.isValid()) {
+				pill += QStringLiteral("  (arrastra sobre un borde u otro panel)");
+			}
+			QFontMetrics fm(f);
+			QRect pillRect = fm.boundingRect(pill).adjusted(-10, -5, 10, 5);
+			int px = std::clamp(fingerPos.x() - pillRect.width() / 2, 8, std::max(8, width() - pillRect.width() - 8));
+			int py = std::clamp(fingerPos.y() - pillRect.height() - 18, 8, std::max(8, height() - pillRect.height() - 8));
+			pillRect.moveTopLeft(QPoint(px, py));
+			p.setPen(QPen(QColor(96, 165, 250, 230), 1));
+			p.setBrush(QColor(15, 23, 42, 225));
+			p.drawRoundedRect(pillRect, 6, 6);
+			p.setPen(QColor(226, 232, 240));
+			p.drawText(pillRect, Qt::AlignCenter, pill);
+		}
+	}
+
+private:
+	QRect targetRect;
+	QString labelText;
+	QString draggingText;
+	QPoint fingerPos;
+};
+
+QPointer<AndroidDockDropOverlay> g_dockDropOverlay;
+
+struct AndroidDockDropPlan {
+	enum Kind { None, Tabify, SplitAbove, SplitBelow, SplitLeft, SplitRight, Area } kind = None;
+	QPointer<QDockWidget> targetDock;
+	Qt::DockWidgetArea area = Qt::RightDockWidgetArea;
+	QRect highlightRect;
+	QString label;
+};
+
+AndroidDockDropPlan ComputeAndroidDockDropPlan(QMainWindow *mw, QDockWidget *dragged, const QPoint &pt)
+{
+	AndroidDockDropPlan plan;
+	if (!mw || !dragged)
+		return plan;
+
+	// 1) Check if finger is over another visible dock
+	QDockWidget *bestDock = nullptr;
+	QRect bestRect;
+	for (QDockWidget *other : mw->findChildren<QDockWidget *>()) {
+		if (!other || other == dragged || !other->isVisible() || other->isFloating())
+			continue;
+		if (other->visibleRegion().isEmpty() || other->width() < 24 || other->height() < 24)
+			continue;
+		QRect r(other->mapTo(mw, QPoint(0, 0)), other->size());
+		if (r.contains(pt)) {
+			bestDock = other;
+			bestRect = r;
+			break;
+		}
+	}
+
+	if (bestDock) {
+		const QString otherName = bestDock->windowTitle().isEmpty() ? bestDock->objectName() : bestDock->windowTitle();
+		const double rx = double(pt.x() - bestRect.left()) / std::max(1, bestRect.width());
+		const double ry = double(pt.y() - bestRect.top()) / std::max(1, bestRect.height());
+		plan.targetDock = bestDock;
+		if (ry < 0.24) {
+			plan.kind = AndroidDockDropPlan::SplitAbove;
+			plan.highlightRect = QRect(bestRect.left(), bestRect.top(), bestRect.width(), bestRect.height() / 2);
+			plan.label = QStringLiteral("Arriba de ") + otherName;
+		} else if (ry > 0.76) {
+			plan.kind = AndroidDockDropPlan::SplitBelow;
+			plan.highlightRect = QRect(bestRect.left(), bestRect.top() + bestRect.height() / 2, bestRect.width(),
+						   bestRect.height() - bestRect.height() / 2);
+			plan.label = QStringLiteral("Abajo de ") + otherName;
+		} else if (rx < 0.24) {
+			plan.kind = AndroidDockDropPlan::SplitLeft;
+			plan.highlightRect = QRect(bestRect.left(), bestRect.top(), bestRect.width() / 2, bestRect.height());
+			plan.label = QStringLiteral("Izquierda de ") + otherName;
+		} else if (rx > 0.76) {
+			plan.kind = AndroidDockDropPlan::SplitRight;
+			plan.highlightRect = QRect(bestRect.left() + bestRect.width() / 2, bestRect.top(),
+						   bestRect.width() - bestRect.width() / 2, bestRect.height());
+			plan.label = QStringLiteral("Derecha de ") + otherName;
+		} else {
+			plan.kind = AndroidDockDropPlan::Tabify;
+			plan.highlightRect = bestRect;
+			plan.label = QStringLiteral("Agrupar con ") + otherName;
+		}
+		return plan;
+	}
+
+	// 2) Otherwise check outer edge dock zones (skip dropping back on dragged itself)
+	QRect draggedRect(dragged->mapTo(mw, QPoint(0, 0)), dragged->size());
+	if (draggedRect.contains(pt))
+		return plan;
+
+	const int w = std::max(1, mw->width());
+	const int h = std::max(1, mw->height());
+	const int topOff = mw->menuBar() ? mw->menuBar()->height() : 0;
+	const int botOff = (mw->statusBar() && mw->statusBar()->isVisible()) ? mw->statusBar()->height() : 0;
+	const int bodyH = std::max(1, h - topOff - botOff);
+
+	if (pt.x() < w * 0.24) {
+		plan.kind = AndroidDockDropPlan::Area;
+		plan.area = Qt::LeftDockWidgetArea;
+		plan.highlightRect = QRect(0, topOff, w * 22 / 100, bodyH);
+		plan.label = QStringLiteral("Mover a la izquierda");
+	} else if (pt.x() > w * 0.76) {
+		plan.kind = AndroidDockDropPlan::Area;
+		plan.area = Qt::RightDockWidgetArea;
+		const int rw = w * 22 / 100;
+		plan.highlightRect = QRect(w - rw, topOff, rw, bodyH);
+		plan.label = QStringLiteral("Mover a la derecha");
+	} else if (pt.y() > topOff + bodyH * 0.66) {
+		plan.kind = AndroidDockDropPlan::Area;
+		plan.area = Qt::BottomDockWidgetArea;
+		const int bh = bodyH * 28 / 100;
+		plan.highlightRect = QRect(0, topOff + bodyH - bh, w, bh);
+		plan.label = QStringLiteral("Mover abajo");
+	} else if (pt.y() < topOff + bodyH * 0.22) {
+		plan.kind = AndroidDockDropPlan::Area;
+		plan.area = Qt::TopDockWidgetArea;
+		const int th = bodyH * 24 / 100;
+		plan.highlightRect = QRect(0, topOff, w, th);
+		plan.label = QStringLiteral("Mover arriba");
+	}
+	return plan;
+}
+
+void ApplyAndroidDockDropPlan(QMainWindow *mw, QDockWidget *dragged, const AndroidDockDropPlan &plan)
+{
+	if (!mw || !dragged || plan.kind == AndroidDockDropPlan::None)
+		return;
+
+	dragged->setFloating(false);
+	switch (plan.kind) {
+	case AndroidDockDropPlan::Tabify:
+		if (plan.targetDock && plan.targetDock != dragged) {
+			mw->tabifyDockWidget(plan.targetDock, dragged);
+			dragged->show();
+			dragged->raise();
+		}
+		break;
+	case AndroidDockDropPlan::SplitBelow:
+		if (plan.targetDock && plan.targetDock != dragged) {
+			mw->addDockWidget(mw->dockWidgetArea(plan.targetDock), dragged);
+			mw->splitDockWidget(plan.targetDock, dragged, Qt::Vertical);
+			dragged->show();
+			dragged->raise();
+		}
+		break;
+	case AndroidDockDropPlan::SplitAbove:
+		if (plan.targetDock && plan.targetDock != dragged) {
+			mw->addDockWidget(mw->dockWidgetArea(plan.targetDock), dragged);
+			mw->splitDockWidget(plan.targetDock, dragged, Qt::Vertical);
+			mw->splitDockWidget(dragged, plan.targetDock, Qt::Vertical);
+			dragged->show();
+			dragged->raise();
+		}
+		break;
+	case AndroidDockDropPlan::SplitRight:
+		if (plan.targetDock && plan.targetDock != dragged) {
+			mw->addDockWidget(mw->dockWidgetArea(plan.targetDock), dragged);
+			mw->splitDockWidget(plan.targetDock, dragged, Qt::Horizontal);
+			dragged->show();
+			dragged->raise();
+		}
+		break;
+	case AndroidDockDropPlan::SplitLeft:
+		if (plan.targetDock && plan.targetDock != dragged) {
+			mw->addDockWidget(mw->dockWidgetArea(plan.targetDock), dragged);
+			mw->splitDockWidget(plan.targetDock, dragged, Qt::Horizontal);
+			mw->splitDockWidget(dragged, plan.targetDock, Qt::Horizontal);
+			dragged->show();
+			dragged->raise();
+		}
+		break;
+	case AndroidDockDropPlan::Area:
+		mw->addDockWidget(plan.area, dragged);
+		dragged->show();
+		dragged->raise();
+		break;
+	case AndroidDockDropPlan::None:
+		break;
+	}
+	ClampMainWindowToScreen(mw);
+	SaveAndroidDockLayoutNow(mw);
+}
+
+void ShowAndroidDockMoveMenu(QMainWindow *mw, QDockWidget *dock, const QPoint &globalPos)
+{
+	if (!mw || !dock || IsAndroidDocksLocked(mw))
+		return;
+	SuspendAndroidBrowserDocksForDrag(true);
+
+	QMenu menu(mw);
+	const QString title = dock->windowTitle().isEmpty() ? dock->objectName() : dock->windowTitle();
+	QAction *hdr = menu.addAction(QStringLiteral("Mover panel: ") + title);
+	hdr->setEnabled(false);
+	menu.addSeparator();
+
+	auto addAreaAct = [&](const QString &label, Qt::DockWidgetArea area) {
+		QAction *a = menu.addAction(label);
+		QObject::connect(a, &QAction::triggered, mw, [mw, dock, area]() {
+			AndroidDockDropPlan p;
+			p.kind = AndroidDockDropPlan::Area;
+			p.area = area;
+			ApplyAndroidDockDropPlan(mw, dock, p);
+		});
+	};
+	addAreaAct(QStringLiteral("Mover a la izquierda"), Qt::LeftDockWidgetArea);
+	addAreaAct(QStringLiteral("Mover a la derecha"), Qt::RightDockWidgetArea);
+	addAreaAct(QStringLiteral("Mover abajo"), Qt::BottomDockWidgetArea);
+	addAreaAct(QStringLiteral("Mover arriba"), Qt::TopDockWidgetArea);
+
+	const QList<QDockWidget *> peers = mw->tabifiedDockWidgets(dock);
+	if (!peers.isEmpty()) {
+		menu.addSeparator();
+		QAction *untab = menu.addAction(QStringLiteral("Separar de pestañas"));
+		QObject::connect(untab, &QAction::triggered, mw, [mw, dock, peer = QPointer<QDockWidget>(peers.first())]() {
+			if (!peer)
+				return;
+			const auto area = mw->dockWidgetArea(dock);
+			const Qt::Orientation ori =
+				(area == Qt::LeftDockWidgetArea || area == Qt::RightDockWidgetArea) ? Qt::Vertical
+												    : Qt::Horizontal;
+			mw->splitDockWidget(peer, dock, ori);
+			dock->show();
+			dock->raise();
+			ClampMainWindowToScreen(mw);
+			SaveAndroidDockLayoutNow(mw);
+		});
+	}
+
+	QMenu *tabMenu = menu.addMenu(QStringLiteral("Agrupar en pestañas con..."));
+	int tabCount = 0;
+	for (QDockWidget *other : mw->findChildren<QDockWidget *>()) {
+		if (!other || other == dock || !other->isVisible() || other->isFloating())
+			continue;
+		const QString otherTitle = other->windowTitle().isEmpty() ? other->objectName() : other->windowTitle();
+		QAction *a = tabMenu->addAction(otherTitle);
+		QPointer<QDockWidget> otherPtr(other);
+		QObject::connect(a, &QAction::triggered, mw, [mw, dock, otherPtr]() {
+			if (!otherPtr)
+				return;
+			AndroidDockDropPlan p;
+			p.kind = AndroidDockDropPlan::Tabify;
+			p.targetDock = otherPtr;
+			ApplyAndroidDockDropPlan(mw, dock, p);
+		});
+		tabCount++;
+	}
+	if (tabCount == 0) {
+		tabMenu->setEnabled(false);
+	}
+
+	if (dock->features() & QDockWidget::DockWidgetClosable) {
+		menu.addSeparator();
+		QAction *hideAct = menu.addAction(QStringLiteral("Ocultar panel"));
+		QObject::connect(hideAct, &QAction::triggered, dock, [dock]() { dock->close(); });
+	}
+
+	menu.exec(globalPos);
+	QTimer::singleShot(60, []() { SuspendAndroidBrowserDocksForDrag(false); });
+}
+
+class AndroidDockDragFilter : public QObject {
+public:
+	explicit AndroidDockDragFilter(QDockWidget *dock) : QObject(dock), targetDock(dock)
+	{
+		longPressTimer = new QTimer(this);
+		longPressTimer->setSingleShot(true);
+		longPressTimer->setInterval(450);
+		QObject::connect(longPressTimer, &QTimer::timeout, this, [this]() {
+			if (!pressing || dragging || !targetDock)
+				return;
+			pressing = false;
+			if (auto *mw = qobject_cast<QMainWindow *>(targetDock->window())) {
+				ShowAndroidDockMoveMenu(mw, targetDock, pressGlobal);
+			}
+		});
+	}
+
+protected:
+	bool isTitleBarHit(QDockWidget *dock, const QPoint &localPos) const
+	{
+		if (!dock || dock->isFloating())
+			return false;
+		int titleH = 26;
+		if (QWidget *w = dock->widget()) {
+			titleH = std::max(24, w->geometry().top());
+		}
+		if (localPos.y() < 0 || localPos.y() > titleH)
+			return false;
+		// Keep close button on the far right clickable
+		if ((dock->features() & QDockWidget::DockWidgetClosable) && localPos.x() >= dock->width() - 28)
+			return false;
+		return true;
+	}
+
+	AndroidDockDropOverlay *ensureOverlay(QMainWindow *mw)
+	{
+		if (!mw)
+			return nullptr;
+		if (!g_dockDropOverlay || g_dockDropOverlay->parentWidget() != mw) {
+			delete g_dockDropOverlay;
+			g_dockDropOverlay = new AndroidDockDropOverlay(mw);
+			g_dockDropOverlay->setObjectName(QStringLiteral("androidDockDropOverlay"));
+		}
+		g_dockDropOverlay->setGeometry(mw->rect());
+		g_dockDropOverlay->raise();
+		return g_dockDropOverlay;
+	}
+
+	bool eventFilter(QObject *obj, QEvent *ev) override
+	{
+		if (obj != targetDock || !targetDock)
+			return QObject::eventFilter(obj, ev);
+		auto *mw = qobject_cast<QMainWindow *>(targetDock->window());
+		if (!mw)
+			return QObject::eventFilter(obj, ev);
+
+		const QEvent::Type t = ev->type();
+		if (t == QEvent::MouseButtonPress) {
+			auto *me = static_cast<QMouseEvent *>(ev);
+			if (me->button() == Qt::LeftButton && !IsAndroidDocksLocked(mw) &&
+			    isTitleBarHit(targetDock, me->position().toPoint())) {
+				pressing = true;
+				dragging = false;
+				pressGlobal = me->globalPosition().toPoint();
+				lastPlan = {};
+				longPressTimer->start();
+				return true;
+			}
+			if (me->button() == Qt::RightButton && !IsAndroidDocksLocked(mw) &&
+			    isTitleBarHit(targetDock, me->position().toPoint())) {
+				ShowAndroidDockMoveMenu(mw, targetDock, me->globalPosition().toPoint());
+				return true;
+			}
+		} else if (t == QEvent::MouseButtonDblClick) {
+			auto *me = static_cast<QMouseEvent *>(ev);
+			if (me->button() == Qt::LeftButton && !IsAndroidDocksLocked(mw) &&
+			    isTitleBarHit(targetDock, me->position().toPoint())) {
+				longPressTimer->stop();
+				pressing = false;
+				dragging = false;
+				ShowAndroidDockMoveMenu(mw, targetDock, me->globalPosition().toPoint());
+				return true;
+			}
+		} else if (t == QEvent::MouseMove && pressing) {
+			auto *me = static_cast<QMouseEvent *>(ev);
+			const QPoint curGlobal = me->globalPosition().toPoint();
+			if (!dragging && (curGlobal - pressGlobal).manhattanLength() >= 10) {
+				longPressTimer->stop();
+				dragging = true;
+				SuspendAndroidBrowserDocksForDrag(true);
+				if (auto *ov = ensureOverlay(mw)) {
+					ov->show();
+				}
+			}
+			if (dragging) {
+				const QPoint pt = mw->mapFromGlobal(curGlobal);
+				lastPlan = ComputeAndroidDockDropPlan(mw, targetDock, pt);
+				if (auto *ov = ensureOverlay(mw)) {
+					const QString title = targetDock->windowTitle().isEmpty()
+								      ? targetDock->objectName()
+								      : targetDock->windowTitle();
+					ov->setIndicator(lastPlan.highlightRect, lastPlan.label, title, pt);
+				}
+			}
+			return true;
+		} else if (t == QEvent::MouseButtonRelease && pressing) {
+			longPressTimer->stop();
+			const bool wasDragging = dragging;
+			pressing = false;
+			dragging = false;
+			if (g_dockDropOverlay) {
+				g_dockDropOverlay->hide();
+			}
+			if (wasDragging) {
+				ApplyAndroidDockDropPlan(mw, targetDock, lastPlan);
+				QTimer::singleShot(80, []() { SuspendAndroidBrowserDocksForDrag(false); });
+			}
+			return true;
+		} else if ((t == QEvent::Hide || t == QEvent::WindowDeactivate) && (pressing || dragging)) {
+			longPressTimer->stop();
+			pressing = false;
+			dragging = false;
+			if (g_dockDropOverlay) {
+				g_dockDropOverlay->hide();
+			}
+			SuspendAndroidBrowserDocksForDrag(false);
+		}
+		return QObject::eventFilter(obj, ev);
+	}
