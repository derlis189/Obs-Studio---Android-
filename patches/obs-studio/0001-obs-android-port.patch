+
+void OpenMultistreamAndVerticalDialog(QWidget *parent, bool openMultistream = false);
+
+std::string MultiConfigFilePath()
+{
+	const char *files = obs_android_files_path();
+	if (!files || !*files)
+		files = getenv("OBS_ANDROID_FILES_PATH");
+	std::string dir = files ? (std::string(files) + "/obs-studio") : "/data/local/tmp";
+	QDir().mkpath(QString::fromStdString(dir));
+	return dir + "/android-multistream.json";
+}
+
+nlohmann::json LoadMultiConfig()
+{
+	nlohmann::json cfg = {{"targets", nlohmann::json::array()},
+			      {"vertical",
+			       {{"server", ""},
+				{"key", ""},
+				{"res", 0},
+				{"bitrate", 3500},
+				{"scene", ""},
+				{"fit", 1},
+				{"background", ""},
+				{"cropX", 0},
+				{"posX", 0},
+				{"posY", 0},
+				{"scale", 100},
+				{"blur", 65},
+				{"backtrackSecs", 30},
+				{"scenes", nlohmann::json::array()},
+				{"links", nlohmann::json::object()}}}};
+	std::ifstream f(MultiConfigFilePath());
+	if (f.is_open()) {
+		try {
+			auto parsed = nlohmann::json::parse(f);
+			if (parsed.contains("targets") && parsed["targets"].is_array())
+				cfg["targets"] = parsed["targets"];
+			if (parsed.contains("vertical") && parsed["vertical"].is_object())
+				cfg["vertical"].update(parsed["vertical"]);
+		} catch (...) {
+		}
+	}
+	if (!cfg["vertical"].contains("scenes") || !cfg["vertical"]["scenes"].is_array())
+		cfg["vertical"]["scenes"] = nlohmann::json::array();
+	if (!cfg["vertical"].contains("links") || !cfg["vertical"]["links"].is_object())
+		cfg["vertical"]["links"] = nlohmann::json::object();
+	return cfg;
+}
+
+void SyncVerticalRuntimeFromConfig(const nlohmann::json &cfg)
+{
+	const auto &vc = cfg["vertical"];
+	g_verticalManualScene = vc.value("scene", "");
+	g_verticalAutoLinks = vc.value("autoLinks", true);
+	const int rawFit = vc.value("fit", 1);
+	g_verticalFitMode = (rawFit >= 1 && rawFit <= 3) ? rawFit : (rawFit == 0 ? 2 : 1);
+	g_verticalBackground = vc.value("background", "");
+	g_verticalCropX = std::clamp(vc.value("cropX", 0), -100, 100);
+	g_verticalPosX = std::clamp(vc.value("posX", 0), -100, 100);
+	g_verticalPosY = std::clamp(vc.value("posY", 0), -100, 100);
+	g_verticalScale = std::clamp(vc.value("scale", 100), 25, 180);
+	g_verticalBlur = std::clamp(vc.value("blur", 65), 15, 100);
+	g_verticalFollowProgram = g_verticalManualScene.empty();
+	g_verticalManagedScenes.clear();
+	if (vc.contains("scenes") && vc["scenes"].is_array()) {
+		for (const auto &s : vc["scenes"]) {
+			if (s.is_string())
+				g_verticalManagedScenes.push_back(s.get<std::string>());
+		}
+	}
+	g_verticalSceneLinks.clear();
+	if (vc.contains("links") && vc["links"].is_object()) {
+		for (auto it = vc["links"].begin(); it != vc["links"].end(); ++it) {
+			if (it.value().is_string())
+				g_verticalSceneLinks[it.key()] = it.value().get<std::string>();
+		}
+	}
+	++g_verticalConfigVersion;
+}
+
+bool WriteConfigAtomically(const std::string &path, const nlohmann::json &config)
+{
+	const std::string contents = config.dump(2);
+	QSaveFile file(QString::fromStdString(path));
+	return file.open(QIODevice::WriteOnly) &&
+	       file.write(contents.data(), static_cast<qint64>(contents.size())) ==
+		       static_cast<qint64>(contents.size()) &&
+	       file.commit();
+}
+
+void SaveMultiConfig(const nlohmann::json &cfg)
+{
+	SyncVerticalRuntimeFromConfig(cfg);
+	if (!WriteConfigAtomically(MultiConfigFilePath(), cfg))
+		blog(LOG_WARNING, "Could not save Android multistream configuration");
+}
+
+bool IsVerticalSceneName(const std::string &name)
+{
+	if (name.rfind("[V] ", 0) == 0)
+		return true;
+	return std::find(g_verticalManagedScenes.begin(), g_verticalManagedScenes.end(), name) !=
+	       g_verticalManagedScenes.end();
+}
+
+std::vector<std::string> GetAllObsSceneNames(bool onlyVertical, bool onlyMain)
+{
+	std::vector<std::string> out;
+	struct obs_frontend_source_list sl = {};
+	obs_frontend_get_scenes(&sl);
+	for (size_t i = 0; i < sl.sources.num; ++i) {
+		const char *nm = obs_source_get_name(sl.sources.array[i]);
+		if (!nm || !*nm)
+			continue;
+		std::string s(nm);
+		bool isV = IsVerticalSceneName(s);
+		if (onlyVertical && !isV)
+			continue;
+		if (onlyMain && isV)
+			continue;
+		out.push_back(s);
+	}
+	obs_frontend_source_list_free(&sl);
+	return out;
+}
+
+bool ShouldUseCustomVerticalScene(const std::string &sceneName)
+{
+	if (g_verticalFitMode != 1 || sceneName.empty())
+		return false;
+	return IsVerticalSceneName(sceneName) || (!g_verticalFollowProgram && sceneName == g_verticalManualScene);
+}
+
+std::string ResolveVerticalBackendSceneName(const std::string &sceneName)
+{
+	return ShouldUseCustomVerticalScene(sceneName) ? sceneName : std::string();
+}
+
+void PushVerticalParamsToBackend()
+{
+	void *jni = FindAndroidJni();
+	if (!jni)
+		return;
+	using BackgroundFn = void (*)(const char *);
+	if (auto setBackground = reinterpret_cast<BackgroundFn>(dlsym(jni, "obs_android_vertical_set_background")))
+		setBackground(g_verticalBackground.c_str());
+	using TransformFn = void (*)(int, int, int, int, int);
+	if (auto setTransform = reinterpret_cast<TransformFn>(dlsym(jni, "obs_android_vertical_set_transform"))) {
+		setTransform(g_verticalCropX, g_verticalPosX, g_verticalPosY, g_verticalScale, g_verticalBlur);
+	} else {
+		using ParamsFn = void (*)(int, int, int);
+		if (auto setParams = reinterpret_cast<ParamsFn>(dlsym(jni, "obs_android_vertical_set_params")))
+			setParams(g_verticalCropX, g_verticalPosY, g_verticalBlur);
+	}
+}
+
+void ApplyVerticalSceneByName(const std::string &sceneName)
+{
+	void *jni = FindAndroidJni();
+	if (!jni)
+		return;
+	PushVerticalParamsToBackend();
+	const std::string backendScene = ResolveVerticalBackendSceneName(sceneName);
+	using VertSetSceneFn = void (*)(const char *, int);
+	if (auto fn = reinterpret_cast<VertSetSceneFn>(dlsym(jni, "obs_android_vertical_set_scene")))
+		fn(backendScene.c_str(), g_verticalFitMode);
+}
+
+void SyncVerticalToCurrentMainScene()
+{
+	OBSSourceAutoRelease cur = obs_frontend_get_current_scene();
+	const char *name = cur ? obs_source_get_name(cur) : nullptr;
+	const std::string mainName = name ? name : "";
+	std::string target = g_verticalFollowProgram ? mainName : g_verticalManualScene;
+	if (!mainName.empty() && !IsVerticalSceneName(mainName) && g_verticalAutoLinks) {
+		auto it = g_verticalSceneLinks.find(mainName);
+		if (it != g_verticalSceneLinks.end()) {
+			if (it->second == "__UNLINKED__" && !g_verticalFollowScene.empty())
+				return;
+			if (it->second == "__FOLLOW__") {
+				target = mainName;
+			} else {
+				OBSSourceAutoRelease linked = obs_get_source_by_name(it->second.c_str());
+				if (linked && obs_scene_from_source(linked))
+					target = it->second;
+			}
+		}
+	}
+	g_verticalFollowScene = target;
+	ApplyVerticalSceneByName(target);
+}
+
+struct VerticalPreviewCache {
+	OBSSource programSource;
+
+	OBSSource Resolve(bool visible, const std::string &explicitScene = std::string())
+	{
+		if (!visible)
+			return {};
+		const std::string candidate = explicitScene.empty() ? g_verticalFollowScene : explicitScene;
+		if (!explicitScene.empty() && g_verticalFitMode == 1) {
+			OBSSourceAutoRelease src = obs_get_source_by_name(explicitScene.c_str());
+			if (src)
+				return OBSSource(src.Get());
+		} else if (ShouldUseCustomVerticalScene(candidate)) {
+			OBSSourceAutoRelease src = obs_get_source_by_name(candidate.c_str());
+			if (src)
+				return OBSSource(src.Get());
+		}
+		void *jni = FindAndroidJni();
+		if (!jni)
+			return {};
+		if (!programSource) {
+			using CreateFn = obs_source_t *(*)(int, const char *);
+			if (auto createFn = reinterpret_cast<CreateFn>(dlsym(jni, "obs_android_vertical_preview_create"))) {
+				OBSSourceAutoRelease created = createFn(g_verticalFitMode, g_verticalBackground.c_str());
+				programSource = created.Get();
+			}
+		}
+		if (programSource) {
+			using UpdateExFn = void (*)(obs_source_t *, int, const char *, int, int, int, int, int);
+			if (auto updateEx = reinterpret_cast<UpdateExFn>(
+				    dlsym(jni, "obs_android_vertical_preview_update_ex"))) {
+				updateEx(programSource.Get(), g_verticalFitMode, g_verticalBackground.c_str(),
+					 g_verticalCropX, g_verticalPosX, g_verticalPosY, g_verticalScale,
+					 g_verticalBlur);
+			} else {
+				using UpdateFn = void (*)(obs_source_t *, int, const char *, int, int, int);
+				if (auto updateFn = reinterpret_cast<UpdateFn>(
+					    dlsym(jni, "obs_android_vertical_preview_update"))) {
+					updateFn(programSource.Get(), g_verticalFitMode, g_verticalBackground.c_str(),
+						 g_verticalCropX, g_verticalPosY, g_verticalBlur);
+				}
+			}
+		}
+		return programSource;
+	}
+};
