+		void *h = dlopen("libobs-android-jni.so", RTLD_NOW | RTLD_NOLOAD);
+		if (!h) {
+			const char *libs = getenv("OBS_ANDROID_LIBRARIES_PATH");
+			if (libs && *libs) {
+				QByteArray full = QByteArray(libs) + "/libobs-android-jni.so";
+				h = dlopen(full.constData(), RTLD_NOW | RTLD_NOLOAD);
+			}
+		}
+		if (!h) {
+			OBSMessageBox::warning(this, QStringLiteral("Instalador de plugins"),
+					       QStringLiteral("No se encontró el puente nativo de Android."));
+			return;
+		}
+		using InstallFn = bool (*)(const char *, char *, size_t);
+		auto fn = reinterpret_cast<InstallFn>(dlsym(h, "obs_android_install_plugin"));
+		if (!fn) {
+			OBSMessageBox::warning(this, QStringLiteral("Instalador de plugins"),
+					       QStringLiteral("Instalador nativo no disponible."));
+			return;
+		}
+		char outBuf[4096] = {};
+		QByteArray pathUtf8 = picked.toUtf8();
+		fn(pathUtf8.constData(), outBuf, sizeof(outBuf));
+		QString res = QString::fromUtf8(outBuf);
+		QStringList parts = res.split(QChar('\t'));
+		if (parts.isEmpty() || parts[0] != QStringLiteral("OK") || parts.size() < 4) {
+			QString err = parts.size() >= 2 ? parts[1]
+							: QStringLiteral("No se pudo instalar el archivo seleccionado.");
+			OBSMessageBox::warning(this, QStringLiteral("No se pudo instalar el plugin"), err);
+			return;
+		}
+
+		QString pluginName = parts[1];
+		QString binPath = parts[2];
+		QString dataPath = parts[3];
+		QString extraWarn = parts.size() >= 5 ? parts[4] : QString();
+
+		obs_module_t *mod = nullptr;
+		QByteArray binUtf8 = binPath.toUtf8();
+		QByteArray dataUtf8 = dataPath.toUtf8();
+		int rc = obs_open_module(&mod, binUtf8.constData(), dataUtf8.constData());
+		if (rc == MODULE_SUCCESS && mod) {
+			if (obs_init_module(mod)) {
+				obs_post_load_modules();
+				const char *disp = obs_get_module_name(mod);
+				const char *mid = obs_get_module_id(mod);
+				const char *ver = obs_get_module_version(mod);
+				std::string modName = pluginName.toStdString();
+				auto it = std::find_if(modules_.begin(), modules_.end(),
+						       [&](const ModuleInfo &m) { return m.module_name == modName; });
+				if (it == modules_.end()) {
+					modules_.push_back({disp ? disp : modName, modName, mid ? mid : "",
+							    ver ? ver : "1.0.0", true, true});
+				} else {
+					it->display_name = disp ? disp : modName;
+					it->enabled = true;
+					it->enabledAtLaunch = true;
+				}
+				OBSMessageBox::information(
+					this, QStringLiteral("Plugin instalado"),
+					QStringLiteral("El plugin '%1' se instaló y cargó correctamente%2.\n\n"
+						       "Sus nuevas fuentes/filtros ya están disponibles (o reinicia OBS si agrega paneles).")
+						.arg(pluginName, extraWarn));
+				accept();
+				return;
+			}
+			OBSMessageBox::warning(
+				this, QStringLiteral("Plugin instalado con aviso"),
+				QStringLiteral("El plugin '%1' se instaló en OBS, pero obs_module_load() devolvió error. Reinicia OBS y revisa el registro.")
+					.arg(pluginName));
+		} else {
+			const char *dlErr = dlerror();
+			QString detail = dlErr ? QString::fromUtf8(dlErr) : QString::number(rc);
+			OBSMessageBox::warning(
+				this, QStringLiteral("Plugin instalado (error al cargar)"),
+				QStringLiteral("El plugin '%1' se copió correctamente%2, pero no se pudo cargar (código %3: %4).")
+					.arg(pluginName, extraWarn, QString::number(rc), detail));
+		}
+	});
+#endif
 }
 
