+void OpenMultistreamAndVerticalDialog(QWidget *parent, bool openMultistream)
+{
+	static QPointer<QDialog> activeDialog;
+	static QPointer<QTabWidget> activeTabs;
+	static QPointer<QWidget> activeVerticalTab;
+	static QPointer<QWidget> activeMultiTab;
+	if (activeDialog) {
+		if (activeTabs) {
+			if (openMultistream && activeMultiTab)
+				activeTabs->setCurrentWidget(activeMultiTab);
+			else if (!openMultistream && activeVerticalTab)
+				activeTabs->setCurrentWidget(activeVerticalTab);
+		}
+		activeDialog->raise();
+		activeDialog->activateWindow();
+		return;
+	}
+
+	void *jni = FindAndroidJni();
+	using StartMultiExFn = bool (*)(const char *, const char *, const char *, int, bool, int, int, const char *, int);
+	using StopMultiFn = bool (*)(const char *);
+	using IsMultiActiveFn = bool (*)(const char *);
+
+	auto fnStartMultiEx = jni ? reinterpret_cast<StartMultiExFn>(dlsym(jni, "obs_android_multistream_start_target_ex")) : nullptr;
+	auto fnStopMulti = jni ? reinterpret_cast<StopMultiFn>(dlsym(jni, "obs_android_multistream_stop_target")) : nullptr;
+	auto fnIsMulti = jni ? reinterpret_cast<IsMultiActiveFn>(dlsym(jni, "obs_android_multistream_is_active")) : nullptr;
