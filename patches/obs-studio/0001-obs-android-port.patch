+void SuspendAndroidBrowserDocksForDrag(bool suspend);
+
+void SaveAndroidDockLayoutNow(QMainWindow *mw)
+{
+	if (!mw)
+		return;
+	if (config_t *cfg = App()->GetUserConfig()) {
+		config_set_string(cfg, "BasicWindow", "DockState", mw->saveState().toBase64().constData());
+		config_save_safe(cfg, "tmp", nullptr);
+	}
+}
+
+bool IsAndroidDocksLocked(QMainWindow *mw)
+{
+	if (!mw)
+		return false;
+	if (QAction *lockAct = mw->findChild<QAction *>(QStringLiteral("lockDocks"))) {
+		return lockAct->isChecked();
+	}
+	return false;
+}
