+
+void SyncBroadcastKeepalive()
+{
+	static int lastState = -1;
+	const auto st = GetVerticalStatsJson();
+	const bool anyActive = obs_frontend_streaming_active() || obs_frontend_recording_active() ||
+			       obs_frontend_replay_buffer_active() || st.value("any_active", false);
+	if (int(anyActive) == lastState)
+		return;
+	lastState = int(anyActive);
+	if (void *jni = FindAndroidJni()) {
+		using KeepaliveFn = void (*)(bool);
+		if (auto fn = reinterpret_cast<KeepaliveFn>(dlsym(jni, "obs_android_set_broadcast_keepalive")))
+			fn(anyActive);
+	}
+}
