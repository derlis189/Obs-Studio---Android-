+
+AndroidHardwareProfile QueryAndroidHardwareProfile()
+{
+	AndroidHardwareProfile p;
+	PopulateNativeFallbacks(p);
+
+	void *jni = FindJniBridgeHandle();
+	if (!jni)
+		return p;
+
+	using HwFn = bool (*)(char *, size_t);
+	auto fn = reinterpret_cast<HwFn>(dlsym(jni, "obs_android_get_hardware_profile"));
+	if (!fn)
+		return p;
+
+	std::string buf(8192, '\0');
+	if (!fn(buf.data(), buf.size()) || !buf[0])
+		return p;
+
+	try {
+		const auto j = nlohmann::json::parse(buf.c_str());
+		p.manufacturer = j.value("manufacturer", p.manufacturer);
+		p.model = j.value("model", p.model);
+		p.device_name = j.value("device_name", p.device_name);
+		p.android_release = j.value("android_release", p.android_release);
+		p.sdk_int = j.value("sdk_int", p.sdk_int);
+
+		p.soc_name = j.value("soc_name", p.soc_name);
+		p.soc_model = j.value("soc_model", p.soc_model);
+		p.cpu_cores = j.value("cpu_cores", p.cpu_cores);
+		p.big_cores = j.value("big_cores", p.big_cores);
+		p.perf_cores = j.value("perf_cores", p.perf_cores);
+		p.max_freq_mhz = j.value("max_freq_mhz", p.max_freq_mhz);
+		p.cpu_clusters = j.value("cpu_clusters", p.cpu_clusters);
+
+		p.gpu_renderer = j.value("gpu_renderer", p.gpu_renderer);
+		p.gpu_vendor = j.value("gpu_vendor", p.gpu_vendor);
+		p.gles_version = j.value("gles_version", p.gles_version);
+
+		p.ram_total_mb = j.value("ram_total_mb", p.ram_total_mb);
+		p.ram_avail_mb = j.value("ram_avail_mb", p.ram_avail_mb);
+		p.low_memory = j.value("low_memory", p.low_memory);
+
+		p.screen_width = j.value("screen_width", p.screen_width);
+		p.screen_height = j.value("screen_height", p.screen_height);
+		p.refresh_hz = j.value("refresh_hz", p.refresh_hz);
