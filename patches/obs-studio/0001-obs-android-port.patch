+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+struct AndroidHardwareProfile {
+	std::string manufacturer;
+	std::string model;
+	std::string device_name{"Dispositivo Android ARM64"};
+	std::string android_release{"15"};
+	int sdk_int = 35;
+
+	std::string soc_name{"ARM64 SoC"};
+	std::string soc_model;
+	int cpu_cores = 8;
+	int big_cores = 2;
+	int perf_cores = 4;
+	int max_freq_mhz = 2400;
+	std::string cpu_clusters{"8 núcleos"};
+
+	std::string gpu_renderer{"OpenGL ES 3.2 GPU"};
+	std::string gpu_vendor;
+	std::string gles_version{"OpenGL ES 3.2"};
+
+	int64_t ram_total_mb = 6144;
+	int64_t ram_avail_mb = 2048;
+	bool low_memory = false;
+
+	int screen_width = 1920;
+	int screen_height = 1080;
+	int refresh_hz = 60;
+
+	bool h264_hw = true;
+	std::string h264_codec;
+	bool h264_surface = true;
+	bool h264_cbr = true;
+	bool h264_vbr = true;
+	int h264_max_w = 1920;
+	int h264_max_h = 1080;
+	int h264_max_bitrate_kbps = 25000;
+	bool h264_2160p60 = false;
+	bool h264_2160p30 = false;
+	bool h264_1440p60 = false;
+	bool h264_1440p30 = false;
+	bool h264_1080p60 = true;
+	bool h264_1080p30 = true;
+	bool h264_720p60 = true;
+	bool h264_720p30 = true;
+
+	bool hevc_hw = false;
+	std::string hevc_codec;
+	bool hevc_surface = false;
+	bool hevc_cbr = false;
+	bool hevc_vbr = true;
+	int hevc_max_w = 1920;
+	int hevc_max_h = 1080;
+	int hevc_max_bitrate_kbps = 25000;
+	bool hevc_2160p60 = false;
+	bool hevc_2160p30 = false;
+	bool hevc_1440p60 = false;
+	bool hevc_1440p30 = false;
+	bool hevc_1080p60 = false;
+	bool hevc_1080p30 = false;
+
+	std::string aac_codec;
+	bool aac_hw = false;
+
+	int thermal_status = 0;
+	bool power_save = false;
+	int battery_pct = -1;
+	double battery_temp_c = 0.0;
+	bool charging = false;
+
+	std::string network_type{"Wi-Fi"};
+	int net_up_kbps = 0;
+	int net_down_kbps = 0;
+	bool net_metered = false;
+
+	int tier = 3;
+	std::string tier_label{"Gama Media-Alta"};
+
+	bool SupportsHardwareEncode(bool hevc, int w, int h, int fps) const
+	{
+		const int longSide = w >= h ? w : h;
+		const int shortSide = w >= h ? h : w;
+		if (hevc) {
+			if (!hevc_hw)
+				return false;
+			if (longSide > hevc_max_w || shortSide > hevc_max_h)
+				return false;
+			if (shortSide > 1440)
+				return fps > 30 ? hevc_2160p60 : (hevc_2160p30 || hevc_2160p60);
+			if (shortSide > 1080)
+				return fps > 30 ? hevc_1440p60 : (hevc_1440p30 || hevc_1440p60);
+			if (shortSide > 720)
+				return fps > 30 ? hevc_1080p60 : (hevc_1080p30 || hevc_1080p60);
+			return true;
+		}
+		if (!h264_hw)
+			return false;
+		if (longSide > h264_max_w || shortSide > h264_max_h)
+			return false;
+		if (shortSide > 1440)
+			return fps > 30 ? h264_2160p60 : (h264_2160p30 || h264_2160p60);
+		if (shortSide > 1080)
+			return fps > 30 ? h264_1440p60 : (h264_1440p30 || h264_1440p60);
+		if (shortSide > 720)
+			return fps > 30 ? h264_1080p60 : (h264_1080p30 || h264_1080p60);
+		if (shortSide > 540)
+			return fps > 30 ? h264_720p60 : (h264_720p30 || h264_720p60);
+		return true;
+	}
+};
+
+AndroidHardwareProfile QueryAndroidHardwareProfile();
