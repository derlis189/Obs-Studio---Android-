+void EnsureVisibleRecordingFolder()
+{
+	OBSBasic *main = OBSBasic::Get();
+	if (!main || !main->Config())
+		return;
+	std::string target = GetDefaultVideoSavePath();
+	if (target.empty())
+		target = "/storage/emulated/0/Movies/OBS Studio";
+	QDir().mkpath(QString::fromStdString(target));
+
+	auto isBadPath = [](const char *p) {
+		if (!p || !*p)
+			return true;
+		std::string s(p);
+		while (s.size() > 1 && s.back() == '/')
+			s.pop_back();
+		if (s == "/" || s == "/storage/emulated/0" || s == "/sdcard")
+			return true;
+		if (s.rfind("/data/", 0) == 0)
+			return true;
+		if (s.find("/Android/data/") != std::string::npos || s.find("/Android/media/") != std::string::npos)
+			return true;
+		return false;
+	};
+
+	bool changed = false;
+	const char *simPath = config_get_string(main->Config(), "SimpleOutput", "FilePath");
+	if (isBadPath(simPath)) {
+		config_set_string(main->Config(), "SimpleOutput", "FilePath", target.c_str());
+		changed = true;
+	}
+	const char *advPath = config_get_string(main->Config(), "AdvOut", "RecFilePath");
+	if (isBadPath(advPath)) {
+		config_set_string(main->Config(), "AdvOut", "RecFilePath", target.c_str());
+		changed = true;
+	}
+	const char *ffPath = config_get_string(main->Config(), "AdvOut", "FFFilePath");
+	if (isBadPath(ffPath)) {
+		config_set_string(main->Config(), "AdvOut", "FFFilePath", target.c_str());
+		changed = true;
+	}
+	if (changed) {
+		config_save_safe(main->Config(), "tmp", nullptr);
+	}
+}
