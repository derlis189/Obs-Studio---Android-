+QWidget *CreateBibleDockWidget()
+{
+	auto *w = new QWidget();
+	auto *v = new QVBoxLayout(w);
+	v->setContentsMargins(6, 6, 6, 6);
+	v->setSpacing(5);
+
+	// Fixed-height read-only preview avoids QLabel(wordWrap) horizontal layout explosion inside QScrollArea
+	auto *verseView = new QPlainTextEdit(w);
+	verseView->setReadOnly(true);
+	verseView->setFrameShape(QFrame::NoFrame);
+	verseView->setFixedHeight(74);
+	verseView->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	verseView->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	verseView->setWordWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+	verseView->setStyleSheet(QStringLiteral(
+		"QPlainTextEdit { background:rgba(15,23,42,0.55); color:#f8fafc; padding:5px; border-radius:6px; font-size:12px; }"));
+	verseView->setPlainText(QStringLiteral("Juan 3:16"));
+	v->addWidget(verseView);
+
+	auto *nav = new QGridLayout();
+	nav->setSpacing(4);
+	auto *bPrev = new QPushButton(QStringLiteral("Anterior"), w);
+	auto *bNext = new QPushButton(QStringLiteral("Siguiente"), w);
+	auto *bVis = new QPushButton(QStringLiteral("Ocultar"), w);
+	auto *bShow = new QPushButton(QStringLiteral("Mostrar cita"), w);
+	bPrev->setMinimumWidth(0);
+	bNext->setMinimumWidth(0);
+	bVis->setMinimumWidth(0);
+	bShow->setMinimumWidth(0);
+	nav->addWidget(bPrev, 0, 0);
+	nav->addWidget(bNext, 0, 1);
+	nav->addWidget(bShow, 1, 0);
+	nav->addWidget(bVis, 1, 1);
+	v->addLayout(nav);
+
+	auto *cbBook = new QComboBox(w);
+	StyleCompactCombo(cbBook);
+
+	auto *cvRow = new QGridLayout();
+	cvRow->setSpacing(4);
+	auto *spCh = new QSpinBox(w);
+	spCh->setRange(1, 150);
+	spCh->setValue(3);
+	spCh->setPrefix(QStringLiteral("C:"));
+	spCh->setMinimumWidth(0);
+	spCh->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	auto *spV1 = new QSpinBox(w);
+	spV1->setRange(1, 176);
+	spV1->setValue(16);
+	spV1->setPrefix(QStringLiteral("V:"));
+	spV1->setMinimumWidth(0);
+	spV1->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	auto *spV2 = new QSpinBox(w);
+	spV2->setRange(1, 176);
+	spV2->setValue(16);
+	spV2->setPrefix(QStringLiteral("a:"));
+	spV2->setMinimumWidth(0);
+	spV2->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	cvRow->addWidget(spCh, 0, 0);
+	cvRow->addWidget(spV1, 0, 1);
+	cvRow->addWidget(spV2, 0, 2);
+
+	auto *cbStyle = new QComboBox(w);
+	cbStyle->addItem(QStringLiteral("Zocalo Inferior Elegante"), 0);
+	cbStyle->addItem(QStringLiteral("Tarjeta Centrada Lectura"), 1);
+	cbStyle->addItem(QStringLiteral("Clasico Iglesia / Dorado"), 2);
+	cbStyle->addItem(QStringLiteral("Moderno Minimalista Lateral"), 3);
+	cbStyle->addItem(QStringLiteral("Pantalla Completa Predica"), 4);
+	StyleCompactCombo(cbStyle);
+
+	v->addWidget(cbBook);
+	v->addLayout(cvRow);
+	v->addWidget(cbStyle);
+
+	auto *sRow = new QHBoxLayout();
+	sRow->setSpacing(4);
+	auto *edSearch = new QLineEdit(w);
+	edSearch->setPlaceholderText(QStringLiteral("Buscar texto o cita..."));
+	StyleCompactEdit(edSearch);
+	auto *bSearch = new QPushButton(QStringLiteral("Buscar"), w);
+	bSearch->setMinimumWidth(0);
+	sRow->addWidget(edSearch, 1);
+	sRow->addWidget(bSearch);
+	v->addLayout(sRow);
+
+	auto *resList = new QListWidget(w);
+	resList->setFixedHeight(120);
+	resList->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	resList->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	resList->setTextElideMode(Qt::ElideRight);
+	resList->setUniformItemSizes(true);
+	v->addWidget(resList);
+	v->addStretch();
+
+	auto searchResults = std::make_shared<nlohmann::json>(nlohmann::json::array());
+	auto lastVerseText = std::make_shared<std::string>();
+	auto initialized = std::make_shared<bool>(false);
+	auto ensureBooks = [=]() {
+		if (cbBook->count() > 0)
+			return;
+		auto books = BibleGetBooks();
+		if (books.is_array() && !books.empty()) {
+			cbBook->blockSignals(true);
+			for (const auto &b : books)
+				if (b.is_string())
+					cbBook->addItem(QString::fromStdString(b.get<std::string>()));
+			cbBook->blockSignals(false);
+		}
+	};
+
+	auto syncUi = [=](bool fillControls) {
+		ensureBooks();
+		auto st = GfxGetState();
+		if (!st.contains("bible"))
+			return;
+		const auto &bb = st["bible"];
+		std::string fullVerse = bb.value("ref", "") + "\n" + bb.value("text", "");
+		if (fullVerse != *lastVerseText) {
+			*lastVerseText = fullVerse;
+			verseView->setPlainText(QString::fromStdString(fullVerse));
+		}
+		bVis->setText(bb.value("visible", true) ? QStringLiteral("Ocultar") : QStringLiteral("Mostrar"));
+		if (fillControls || !(*initialized)) {
+			*initialized = true;
+			if (cbBook->count() > 0) {
+				cbBook->blockSignals(true);
+				cbBook->setCurrentIndex(std::clamp(bb.value("book", 42), 0, cbBook->count() - 1));
+				cbBook->blockSignals(false);
+			}
+			spCh->setValue(std::max(1, bb.value("chapter", 3)));
+			spV1->setValue(std::max(1, bb.value("verse", 16)));
+			spV2->setValue(std::max(1, bb.value("verseEnd", 16)));
+			cbStyle->blockSignals(true);
+			cbStyle->setCurrentIndex(std::clamp(bb.value("style", 0), 0, 4));
+			cbStyle->blockSignals(false);
+		}
+	};
+
+	QObject::connect(bPrev, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "bb_step"}, {"delta", -1}});
+		syncUi(true);
+	});
+	QObject::connect(bNext, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "bb_step"}, {"delta", 1}});
+		syncUi(true);
+	});
+	QObject::connect(bVis, &QPushButton::clicked, w, [=]() {
+		GfxExecute({{"action", "bb_toggle"}});
+		syncUi(false);
+	});
+	QObject::connect(cbStyle, qOverload<int>(&QComboBox::currentIndexChanged), w, [=](int idx) {
+		GfxExecute({{"action", "bb_style"}, {"style", idx}});
+	});
+	QObject::connect(bShow, &QPushButton::clicked, w, [=]() {
+		int v1 = spV1->value();
+		int v2 = std::max(v1, spV2->value());
+		GfxExecute({{"action", "bb_set"},
+			    {"book", std::max(0, cbBook->currentIndex())},
+			    {"chapter", spCh->value()},
+			    {"verse", v1},
+			    {"verseEnd", v2},
+			    {"style", cbStyle->currentIndex()},
+			    {"visible", true}});
+		syncUi(false);
+	});
+	auto doSearch = [=]() {
+		std::string q = edSearch->text().trimmed().toStdString();
+		if (q.empty())
+			return;
+		*searchResults = BibleSearch(q);
+		resList->blockSignals(true);
+		resList->clear();
+		for (const auto &it : *searchResults) {
+			resList->addItem(QString::fromStdString(it.value("ref", "") + " - " + it.value("text", "")));
+		}
+		resList->blockSignals(false);
+	};
+	QObject::connect(bSearch, &QPushButton::clicked, w, doSearch);
+	QObject::connect(edSearch, &QLineEdit::returnPressed, w, doSearch);
+	QObject::connect(resList, &QListWidget::itemClicked, w, [=](QListWidgetItem *) {
+		int idx = resList->currentRow();
+		if (idx < 0 || idx >= int(searchResults->size()))
+			return;
+		const auto &it = (*searchResults)[idx];
+		GfxExecute({{"action", "bb_set"},
+			    {"book", it.value("book", 42)},
+			    {"chapter", it.value("chapter", 1)},
+			    {"verse", it.value("verse", 1)},
+			    {"verseEnd", it.value("verse", 1)},
+			    {"visible", true}});
+		syncUi(true);
+	});
+
+	auto *tmr = new QTimer(w);
+	tmr->setInterval(1200);
+	QObject::connect(tmr, &QTimer::timeout, w, [=]() {
+		if (w->isVisible())
+			syncUi(false);
+	});
+	tmr->start();
+	ensureBooks();
+	QTimer::singleShot(800, w, [=]() { syncUi(true); });
+	return WrapDockScroll(w);
+}
