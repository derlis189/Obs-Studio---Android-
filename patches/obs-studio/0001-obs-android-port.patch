+	edStreamId->setPlaceholderText(QStringLiteral("Opcional (ej: #!::r=live/stream,m=publish)"));
+
+	auto *edPass = new QLineEdit(QString::fromStdString(cfg.value("passphrase", "")), inner);
+	edPass->setEchoMode(QLineEdit::Password);
+	edPass->setPlaceholderText(QStringLiteral("Opcional (10 a 79 caracteres para cifrado AES)"));
+
+	auto *urlsBox = new QPlainTextEdit(inner);
+	urlsBox->setReadOnly(true);
+	urlsBox->setFixedHeight(78);
+	urlsBox->setPlaceholderText(QStringLiteral("Direcciones locales SRT disponibles (Wi-Fi / Hotspot / USB / VPN / Datos)"));
+
+	form->addRow(QStringLiteral("Modo SRT:"), cbMode);
+	form->addRow(QStringLiteral("Destino (Caller):"), edHost);
+	form->addRow(QStringLiteral("Puerto SRT:"), spPort);
+	form->addRow(QStringLiteral("Latencia (200 Wi-Fi / 400 datos):"), spLat);
+	form->addRow(QStringLiteral("Bitrate video:"), spBitrate);
+	form->addRow(QStringLiteral("Stream ID:"), edStreamId);
+	form->addRow(QStringLiteral("Contrasena AES:"), edPass);
