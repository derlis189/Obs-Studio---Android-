+            .type = OBS_MODULE_TYPE_CORE,
+            .name = "obs-android-jni"
+        };
+        callback(data, &bridge_info);
+    }
+    bfree(bridge_bin);
+
+    char *omt_bin = obs_android_join_path(obs_android_libraries_path(), "libomtplugin.so");
+    if (omt_bin && os_file_exists(omt_bin)) {
+        struct obs_module_info2 omt_info = {
+            .bin_path = omt_bin,
+            .data_path = obs_android_files_path() ? obs_android_files_path() : "",
+            .type = OBS_MODULE_TYPE_CORE,
+            .name = "omtplugin"
+        };
+        callback(data, &omt_info);
+    }
+    bfree(omt_bin);
+
+    char *switcher_bin = obs_android_join_path(obs_android_libraries_path(), "libadvanced-scene-switcher.so");
+    if (switcher_bin && os_file_exists(switcher_bin)) {
