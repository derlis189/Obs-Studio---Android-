diff --git a/libobs/obs-android.c b/libobs/obs-android.c
new file mode 100644
index 0000000..98fcac3
--- /dev/null
+++ b/libobs/obs-android.c
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "obs-internal.h"
+#include "util/platform-android.h"
+#include <android/keycodes.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+
+static volatile long android_preview_fps = 15;
+static volatile long android_app_foreground = 1;
+
+void obs_android_set_preview_fps(int fps)
+{
+    if (fps < 5) fps = 5;
+    if (fps > 30) fps = 30;
+    os_atomic_set_long(&android_preview_fps, fps);
+}
+
+int obs_android_get_preview_fps(void)
+{
+    return (int)os_atomic_load_long(&android_preview_fps);
+}
+
+void obs_android_set_app_foreground(bool foreground)
+{
+    os_atomic_set_long(&android_app_foreground, foreground ? 1 : 0);
+}
+
+bool obs_android_is_app_foreground(void)
+{
+    return os_atomic_load_long(&android_app_foreground) != 0;
+}
+
+const char *get_module_extension(void) { return ".so"; }
+char *find_libobs_data_file(const char *file)
+{
+    char *path = obs_android_join_path(obs_android_data_path(), file);
+    if (path && !os_file_exists(path)) {
+        bfree(path);
+        path = NULL;
+    }
+    return path;
+}
+void log_system_info(void)
+{
+    struct utsname info;
+    if (uname(&info) == 0)
+        blog(LOG_INFO, "Android %s %s / %s, online CPUs: %ld", info.sysname, info.release, info.machine,
+             sysconf(_SC_NPROCESSORS_ONLN));
+}
+bool obs_hotkeys_platform_init(struct obs_core_hotkeys *hotkeys)
+{
+    hotkeys->platform_context = NULL;
+    blog(LOG_INFO, "Android hotkeys: explicit event injection available; global physical polling unavailable");
+    return true;
+}
+void obs_hotkeys_platform_free(struct obs_core_hotkeys *hotkeys) { hotkeys->platform_context = NULL; }
+bool obs_hotkeys_platform_is_pressed(obs_hotkeys_platform_t *context, obs_key_t key)
+{
+    UNUSED_PARAMETER(context);
+    UNUSED_PARAMETER(key);
+    return false;
+}
+void obs_key_to_str(obs_key_t key, struct dstr *str)
+{
+    const char *name = obs_key_to_name(key);
+    dstr_copy(str, name ? name : "");
+}
+obs_key_t obs_key_from_virtual_key(int key)
+{
+    if (key >= AKEYCODE_A && key <= AKEYCODE_Z)
+        return OBS_KEY_A + (key - AKEYCODE_A);
+    if (key >= AKEYCODE_0 && key <= AKEYCODE_9)
+        return OBS_KEY_0 + (key - AKEYCODE_0);
+    switch (key) {
+    case AKEYCODE_SPACE: return OBS_KEY_SPACE;
+    case AKEYCODE_ENTER: return OBS_KEY_RETURN;
+    case AKEYCODE_ESCAPE: return OBS_KEY_ESCAPE;
+    case AKEYCODE_TAB: return OBS_KEY_TAB;
+    case AKEYCODE_DEL: return OBS_KEY_BACKSPACE;
+    case AKEYCODE_SHIFT_LEFT: case AKEYCODE_SHIFT_RIGHT: return OBS_KEY_SHIFT;
+    case AKEYCODE_CTRL_LEFT: case AKEYCODE_CTRL_RIGHT: return OBS_KEY_CONTROL;
+    case AKEYCODE_ALT_LEFT: case AKEYCODE_ALT_RIGHT: return OBS_KEY_ALT;
+    default: return OBS_KEY_NONE;
+    }
+}
+int obs_key_to_virtual_key(obs_key_t key)
+{
+    if (key >= OBS_KEY_A && key <= OBS_KEY_Z)
+        return AKEYCODE_A + (key - OBS_KEY_A);
+    if (key >= OBS_KEY_0 && key <= OBS_KEY_9)
+        return AKEYCODE_0 + (key - OBS_KEY_0);
+    switch (key) {
+    case OBS_KEY_SPACE: return AKEYCODE_SPACE;
+    case OBS_KEY_RETURN: return AKEYCODE_ENTER;
+    case OBS_KEY_ESCAPE: return AKEYCODE_ESCAPE;
+    case OBS_KEY_TAB: return AKEYCODE_TAB;
+    case OBS_KEY_BACKSPACE: return AKEYCODE_DEL;
+    case OBS_KEY_SHIFT: return AKEYCODE_SHIFT_LEFT;
+    case OBS_KEY_CONTROL: return AKEYCODE_CTRL_LEFT;
+    case OBS_KEY_ALT: return AKEYCODE_ALT_LEFT;
+    default: return AKEYCODE_UNKNOWN;
+    }
+}
+void obs_key_combination_to_str(obs_key_combination_t combination, struct dstr *str)
+{
+    dstr_resize(str, 0);
+    if (combination.modifiers & INTERACT_CONTROL_KEY) dstr_cat(str, "Ctrl + ");
+    if (combination.modifiers & INTERACT_ALT_KEY) dstr_cat(str, "Alt + ");
+    if (combination.modifiers & INTERACT_SHIFT_KEY) dstr_cat(str, "Shift + ");
+    if (combination.modifiers & INTERACT_COMMAND_KEY) dstr_cat(str, "Meta + ");
+    struct dstr key = {0};
+    obs_key_to_str(combination.key, &key);
+    dstr_cat_dstr(str, &key);
+    dstr_free(&key);
+}
