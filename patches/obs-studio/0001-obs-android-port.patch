+nlohmann::json GfxGetState()
+{
+	void *h = FindAndroidJni();
+	if (!h)
+		return nlohmann::json::object();
+	using Fn = bool (*)(char *, size_t);
+	auto fn = reinterpret_cast<Fn>(dlsym(h, "obs_android_graphics_get_state"));
+	if (!fn)
+		return nlohmann::json::object();
+	std::string buf(65536, '\0');
+	if (!fn(buf.data(), buf.size()))
+		return nlohmann::json::object();
+	try {
+		return nlohmann::json::parse(buf.c_str());
+	} catch (...) {
+		return nlohmann::json::object();
+	}
+}
+
+nlohmann::json GfxExecute(const nlohmann::json &action)
+{
+	void *h = FindAndroidJni();
+	if (!h)
+		return nlohmann::json::object();
+	using Fn = bool (*)(const char *, char *, size_t);
+	auto fn = reinterpret_cast<Fn>(dlsym(h, "obs_android_graphics_execute"));
+	if (!fn)
+		return nlohmann::json::object();
+	std::string req = action.dump();
+	std::string buf(65536, '\0');
+	if (!fn(req.c_str(), buf.data(), buf.size()))
+		return nlohmann::json::object();
+	try {
+		return nlohmann::json::parse(buf.c_str());
+	} catch (...) {
+		return nlohmann::json::object();
+	}
+}
+
