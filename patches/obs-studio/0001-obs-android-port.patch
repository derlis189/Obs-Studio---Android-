+bool ToggleVerticalBacktrack(QWidget *parent)
+{
+	void *jni = FindAndroidJni();
+	if (!jni)
+		return false;
+	using StartFn = bool (*)(int, int, int, const char *, int, int);
+	using StopFn = bool (*)();
+	auto fnStart = reinterpret_cast<StartFn>(dlsym(jni, "obs_android_vertical_start_backtrack"));
+	auto fnStop = reinterpret_cast<StopFn>(dlsym(jni, "obs_android_vertical_stop_backtrack"));
+	if (IsVerticalBacktrackActive()) {
+		if (fnStop)
+			fnStop();
+		SyncBroadcastKeepalive();
+		return true;
+	}
+	auto cfg = LoadMultiConfig();
+	SyncVerticalRuntimeFromConfig(cfg);
+	SyncVerticalToCurrentMainScene();
+	const auto &vc = cfg["vertical"];
+	const int w = vc.value("res", 0) == 1 ? 1080 : 720;
+	const int h = vc.value("res", 0) == 1 ? 1920 : 1280;
+	const int bitrate = vc.value("bitrate", 3500);
+	const int secs = std::clamp(vc.value("backtrackSecs", 30), 15, 120);
+	const std::string backendScene = ResolveVerticalBackendSceneName(g_verticalFollowScene);
+	PushVerticalParamsToBackend();
+	const bool ok = fnStart && fnStart(w, h, bitrate, backendScene.c_str(), g_verticalFitMode, secs);
+	SyncBroadcastKeepalive();
+	if (!ok && parent) {
+		OBSMessageBox::warning(parent, QStringLiteral("Backtrack Vertical 9:16"),
+				       QStringLiteral("No se pudo iniciar el buffer de clips verticales."));
+	}
+	return ok;
+}
