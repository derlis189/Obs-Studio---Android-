+	bVis->setMinimumWidth(0);
+	bSave->setMinimumWidth(0);
+	bLaunchP->setMinimumWidth(0);
+	btnGrid->addWidget(bApply, 0, 0);
+	btnGrid->addWidget(bVis, 0, 1);
+	btnGrid->addWidget(bSave, 1, 0);
+	btnGrid->addWidget(bLaunchP, 1, 1);
+
+	auto *lblPresets = new QLabel(QStringLiteral("Presets guardados:"), w);
+	lblPresets->setStyleSheet(QStringLiteral("font-size:11px; color:#94a3b8;"));
+
+	auto *presetsList = new QListWidget(w);
+	presetsList->setFixedHeight(112);
+	presetsList->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	presetsList->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	presetsList->setTextElideMode(Qt::ElideRight);
