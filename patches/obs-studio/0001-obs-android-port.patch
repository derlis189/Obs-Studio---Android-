+std::string SrtConfigPath()
+{
+	const char *files = obs_android_files_path();
+	std::string dir = (files && *files) ? (std::string(files) + "/obs-studio") : "/data/local/tmp";
+	QDir().mkpath(QString::fromStdString(dir));
+	return dir + "/android-srt-output.json";
+}
+
+nlohmann::json LoadSrtConfig()
+{
+	nlohmann::json j = {{"mode", "caller"}, {"host", ""}, {"port", 9999}, {"latency_ms", 250},
+			    {"bitrate_kbps", 3500}, {"streamid", ""}, {"passphrase", ""}};
+	std::ifstream in(SrtConfigPath());
+	if (in.is_open()) {
+		try {
+			nlohmann::json loaded;
+			in >> loaded;
+			if (loaded.is_object()) {
+				for (auto it = loaded.begin(); it != loaded.end(); ++it)
+					j[it.key()] = it.value();
+			}
+		} catch (...) {}
+	}
+	return j;
+}
+
+void SaveSrtConfig(const nlohmann::json &j)
+{
+	if (!WriteConfigAtomically(SrtConfigPath(), j))
+		blog(LOG_WARNING, "Could not save Android SRT configuration");
+}
