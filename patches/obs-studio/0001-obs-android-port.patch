diff --git a/cmake/android/helpers.cmake b/cmake/android/helpers.cmake
new file mode 100644
index 0000000..f754e21
--- /dev/null
+++ b/cmake/android/helpers.cmake
@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+include_guard(GLOBAL)
+include(helpers_common)
+function(set_target_properties_obs target)
+  cmake_parse_arguments(PARSE_ARGV 1 ANDROID_TARGET "" "" "PROPERTIES")
+  while(ANDROID_TARGET_PROPERTIES)
+    list(POP_FRONT ANDROID_TARGET_PROPERTIES key value)
+    set_property(TARGET ${target} PROPERTY "${key}" "${value}")
+  endwhile()
+  # Android packages unversioned lib*.so files. Keep exports, drop desktop SONAMEs.
+  get_target_property(android_output_name ${target} OUTPUT_NAME)
+  if(NOT android_output_name)
+    set(android_output_name "${target}")
+  endif()
+  if(android_output_name MATCHES "^lib")
+    set(android_prefix "")
+  else()
+    set(android_prefix "lib")
+  endif()
+  set_target_properties(${target} PROPERTIES VERSION "" SOVERSION "" PREFIX "${android_prefix}")
+  install(TARGETS ${target} LIBRARY DESTINATION lib RUNTIME DESTINATION bin)
+endfunction()
