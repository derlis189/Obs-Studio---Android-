+			return;
+		if (preset == 0) {
+			RemoveAudioFilterByName(src, "[Pro] Supresor de ruido");
+			RemoveAudioFilterByName(src, "[Pro] Puerta de ruido");
+			RemoveAudioFilterByName(src, "[Pro] Compresor");
+			RemoveAudioFilterByName(src, "[Pro] Limitador");
+			SaveAllObsStateOnGuiThread();
+			statusLbl->setText(QStringLiteral("Filtros Pro quitados de '%1'.").arg(QString::fromStdString(nm)));
+			return;
+		}
+		if (preset == 2) {
+			OBSDataAutoRelease ns = obs_data_create();
+			obs_data_set_string(ns, "method", "speex");
+			obs_data_set_int(ns, "suppress_level", -30);
+			UpsertAudioFilter(src, "noise_suppress_filter", "[Pro] Supresor de ruido", ns);
+		} else {
+			RemoveAudioFilterByName(src, "[Pro] Supresor de ruido");
+		}
+		{
+			OBSDataAutoRelease ng = obs_data_create();
+			obs_data_set_double(ng, "close_threshold", preset == 2 ? -38.0 : -44.0);
+			obs_data_set_double(ng, "open_threshold", preset == 2 ? -30.0 : -36.0);
+			obs_data_set_int(ng, "attack_time", 25);
+			obs_data_set_int(ng, "hold_time", 200);
+			obs_data_set_int(ng, "release_time", 150);
+			UpsertAudioFilter(src, "noise_gate_filter", "[Pro] Puerta de ruido", ng);
+		}
+		{
+			OBSDataAutoRelease cmp = obs_data_create();
+			obs_data_set_double(cmp, "ratio", preset == 2 ? 5.0 : 4.0);
+			obs_data_set_double(cmp, "threshold", preset == 2 ? -20.0 : -18.0);
+			obs_data_set_int(cmp, "attack_time", 6);
+			obs_data_set_int(cmp, "release_time", 60);
+			obs_data_set_double(cmp, "output_gain", preset == 2 ? 5.0 : 4.0);
+			UpsertAudioFilter(src, "compressor_filter", "[Pro] Compresor", cmp);
+		}
+		{
+			OBSDataAutoRelease lim = obs_data_create();
+			obs_data_set_double(lim, "threshold", -1.5);
+			obs_data_set_int(lim, "release_time", 60);
+			UpsertAudioFilter(src, "limiter_filter", "[Pro] Limitador", lim);
+		}
+		SaveAllObsStateOnGuiThread();
+		statusLbl->setText(QStringLiteral("Preset '%1' aplicado y guardado en '%2'.")
+					   .arg(preset == 2 ? QStringLiteral("Podcast / Exteriores")
+							    : QStringLiteral("Voz Limpia / Streaming"),
+						QString::fromStdString(nm)));
+	};
+
+	QObject::connect(btnVoice, &QPushButton::clicked, &dlg, [&]() { applyPreset(1); });
+	QObject::connect(btnOutdoor, &QPushButton::clicked, &dlg, [&]() { applyPreset(2); });
+	QObject::connect(btnRaw, &QPushButton::clicked, &dlg, [&]() { applyPreset(0); });
+	dlg.exec();
+}
