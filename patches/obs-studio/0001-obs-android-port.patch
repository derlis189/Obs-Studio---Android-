+void InstallBugBar(QMainWindow *window)
+{
+	auto *container = new QWidget(window);
+	container->setObjectName(QStringLiteral("androidBugBar"));
+	auto *lay = new QHBoxLayout(container);
+	lay->setContentsMargins(4, 0, 8, 0);
+	lay->setSpacing(3);
+
+	auto *lbl = new QLabel(QStringLiteral("Moscas"), container);
+	lbl->setStyleSheet(QStringLiteral("font-size: 11px; font-weight: bold; color: #cbd5e1; padding-right: 2px;"));
+	lay->addWidget(lbl);
+
+	const QString btnCss = QStringLiteral(
+		"QPushButton { min-width: 28px; max-width: 30px; min-height: 22px; max-height: 24px;"
+		" padding: 0px 4px; font-size: 11px; font-weight: bold; border-radius: 4px;"
+		" border: 1px solid rgba(148, 163, 184, 0.25); background: rgba(30, 41, 59, 0.55); color: #94a3b8; }"
+		"QPushButton[bugAssigned=\"true\"] { border: 1px solid rgba(148, 163, 184, 0.65); color: #f8fafc; }"
+		"QPushButton:checked { background: #167653; border: 1px solid #22c55e; color: white; }");
+
+	for (size_t i = 0; i < bugButtons.size(); ++i) {
+		auto *button = new QPushButton(QString::number(i + 1), container);
+		button->setCheckable(true);
+		button->setStyleSheet(btnCss);
+		bugButtons[i] = button;
+		lay->addWidget(button);
+		auto *timer = new QTimer(button);
+		timer->setSingleShot(true);
+		timer->setInterval(QApplication::doubleClickInterval());
+		QObject::connect(timer, &QTimer::timeout, button, [=] {
+			auto &slot = bugSlots[i];
+			if (!slot.hasContent()) {
+				ConfigureBugSlot(window, i);
+				return;
+			}
+			slot.visible = !slot.visible;
+			if (!ApplyBugSlot(i))
+				slot.visible = false;
+			RefreshBugButtons();
+			SaveBugConfigFile();
+			SaveAllObsStateOnGuiThread();
+		});
+		QObject::connect(button, &QPushButton::clicked, container, [=] {
+			RefreshBugButtons();
+			if (timer->isActive()) {
+				timer->stop();
+				ConfigureBugSlot(window, i);
+			} else {
+				timer->start();
+			}
+		});
+	}
+
+	if (QStatusBar *sb = window->statusBar()) {
+		sb->insertPermanentWidget(0, container, 0);
+	} else {
+		auto *bar = new QToolBar(QStringLiteral("Moscas"), window);
+		bar->setObjectName(QStringLiteral("androidBugBarToolbar"));
+		bar->setMovable(false);
+		bar->setFloatable(false);
+		window->addToolBar(Qt::BottomToolBarArea, bar);
+		bar->addWidget(container);
+	}
+	RefreshBugButtons();
+}
+
+void ClampMainWindowToScreen(QWidget *mainWindow)
+{
+	auto *mw = qobject_cast<QMainWindow *>(mainWindow);
+	if (!mw)
+		return;
+	QScreen *scr = mw->screen() ? mw->screen() : QGuiApplication::primaryScreen();
+	if (!scr)
+		return;
+	const QRect avail = scr->availableGeometry();
+	if (!avail.isValid() || avail.width() < 320 || avail.height() < 200)
+		return;
+
+	mw->setMinimumSize(0, 0);
+	if (mw->maximumSize() != avail.size()) {
+		mw->setMaximumSize(avail.size());
+	}
+	if (mw->geometry() != avail) {
+		mw->setGeometry(avail);
+	}
+}
