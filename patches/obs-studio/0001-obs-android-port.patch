+struct VerticalProgramRect {
+	float x = 0.0f;
+	float y = 0.0f;
+	float w = 1.0f;
+	float h = 0.3164f;
+	float maxDx = 0.0f;
+	float maxDy = 0.3418f;
+};
+
+VerticalProgramRect ComputeVerticalProgramRect(int posX, int posY, int scalePct)
+{
+	float sw = 16.0f;
+	float sh = 9.0f;
+	obs_video_info ovi{};
+	if (obs_get_video_info(&ovi) && ovi.base_width > 0 && ovi.base_height > 0) {
+		sw = float(ovi.base_width);
+		sh = float(ovi.base_height);
+	}
+	constexpr float cw = 9.0f;
+	constexpr float ch = 16.0f;
+	const float s = std::clamp(scalePct, 25, 180) / 100.0f;
+	const float scale = std::min(cw / sw, ch / sh) * s;
+	const float rw = sw * scale;
+	const float rh = sh * scale;
+	const float maxDxPx = std::fabs(cw - rw) * 0.5f;
+	const float maxDyPx = std::fabs(ch - rh) * 0.5f;
+	const float tx = (cw - rw) * 0.5f + (std::clamp(posX, -100, 100) / 100.0f) * maxDxPx;
+	const float ty = (ch - rh) * 0.5f + (std::clamp(posY, -100, 100) / 100.0f) * maxDyPx;
+
+	VerticalProgramRect r;
+	r.x = tx / cw;
+	r.y = ty / ch;
+	r.w = rw / cw;
+	r.h = rh / ch;
+	r.maxDx = maxDxPx / cw;
+	r.maxDy = maxDyPx / ch;
+	return r;
+}
+
+struct VerticalMonitor {
+	std::mutex mutex;
+	OBSSource source;
+
+	~VerticalMonitor()
+	{
+		if (source)
+			obs_source_dec_showing(source);
+	}
+
+	void SetSource(obs_source_t *next)
+	{
+		const std::lock_guard<std::mutex> lock(mutex);
+		if (source.Get() == next)
+			return;
+		if (source)
+			obs_source_dec_showing(source);
+		source = next;
+		if (source)
+			obs_source_inc_showing(source);
+	}
+
+	bool fill = true;
+	bool guides = false;
+	bool interactive = false;
+	bool selected = true;
+	bool customScene = false;
+	int mode = 1;
+	int posX = 0;
+	int posY = 0;
+	int scale = 100;
+	float pixelRatio = 2.0f;
+	vec4 selColor{{{1.0f, 0.0f, 0.0f, 1.0f}}};
+
+	static void DrawFilledRect(float x0, float y0, float x1, float y1)
+	{
+		gs_render_start(true);
+		gs_vertex2f(x0, y0);
+		gs_vertex2f(x1, y0);
+		gs_vertex2f(x1, y1);
+		gs_vertex2f(x0, y0);
+		gs_vertex2f(x1, y1);
+		gs_vertex2f(x0, y1);
+		gs_render_stop(GS_TRIS);
+	}
+
+	static void DrawOutlineRect(float x0, float y0, float x1, float y1)
+	{
+		gs_render_start(true);
+		gs_vertex2f(x0, y0);
+		gs_vertex2f(x1, y0);
+		gs_vertex2f(x1, y1);
+		gs_vertex2f(x0, y1);
+		gs_vertex2f(x0, y0);
+		gs_render_stop(GS_LINESTRIP);
+	}
+
+	static void Draw(void *data, uint32_t width, uint32_t height)
+	{
+		auto &monitor = *static_cast<VerticalMonitor *>(data);
+		OBSSource frame;
+		bool fill, guides, interactive, selected, customScene;
+		int mode, posX, posY, scalePct;
+		float pixelRatio;
+		vec4 selColor;
+		{
+			const std::lock_guard<std::mutex> lock(monitor.mutex);
+			frame = monitor.source;
+			fill = monitor.fill;
+			guides = monitor.guides;
+			interactive = monitor.interactive;
+			selected = monitor.selected;
+			customScene = monitor.customScene;
+			mode = monitor.mode;
+			posX = monitor.posX;
+			posY = monitor.posY;
+			scalePct = monitor.scale;
+			pixelRatio = monitor.pixelRatio;
+			selColor = monitor.selColor;
+		}
+		if (!frame || width < 9 || height < 16)
+			return;
+		const float sw = float(obs_source_get_width(frame));
+		const float sh = float(obs_source_get_height(frame));
+		if (sw <= 0 || sh <= 0)
+			return;
+
+		const float units = std::min(float(width) / 9.0f, float(height) / 16.0f);
+		const int w = int(units * 9.0f);
+		const int h = int(units * 16.0f);
+		const float scale = fill ? std::max(float(w) / sw, float(h) / sh)
+					 : std::min(float(w) / sw, float(h) / sh);
+		const float vw = float(w) / scale;
+		const float vh = float(h) / scale;
+		const float x = (sw - vw) / 2.0f;
+		const float y = (sh - vh) / 2.0f;
+		gs_viewport_push();
+		gs_projection_push();
+		gs_set_viewport((int(width) - w) / 2, (int(height) - h) / 2, w, h);
+		gs_ortho(x, x + vw, y, y + vh, -100.0f, 100.0f);
+		obs_source_video_render(frame);
+
+		const bool drawTransformBox = interactive && selected && !customScene && (mode == 2 || mode == 3);
+		if (guides || drawTransformBox) {
+			gs_ortho(0, 1, 0, 1, -100.0f, 100.0f);
+			gs_matrix_push();
+			gs_matrix_identity();
+			gs_blend_state_push();
+			gs_enable_blending(true);
+			gs_blend_function(GS_BLEND_SRCALPHA, GS_BLEND_INVSRCALPHA);
+			auto *solid = obs_get_base_effect(OBS_EFFECT_SOLID);
+			if (solid) {
+				auto *colorParam = gs_effect_get_param_by_name(solid, "color");
+				if (guides) {
+					vec4 color{0.26f, 0.86f, 1.0f, 0.65f};
+					gs_effect_set_vec4(colorParam, &color);
+					while (gs_effect_loop(solid, "Solid"))
+						DrawOutlineRect(0.08f, 0.10f, 0.84f, 0.78f);
+				}
+				if (drawTransformBox) {
+					// Match OBSBasicPreview::DrawSelectedItem exactly:
+					// HANDLE_RADIUS = 4.0f, border thickness = HANDLE_RADIUS * pixelRatio / 2,
+					// 8 solid square handles (4 corners + 4 midpoints) of half-size HANDLE_RADIUS * pixelRatio.
+					constexpr float kObsHandleRadius = 4.0f;
+					const float dpr = std::max(1.0f, pixelRatio);
+					const float pxW = 1.0f / std::max(1.0f, float(w));
+					const float pxH = 1.0f / std::max(1.0f, float(h));
+					const float tx = (kObsHandleRadius * dpr * 0.5f) * pxW;
+					const float ty = (kObsHandleRadius * dpr * 0.5f) * pxH;
+					const float hx = (kObsHandleRadius * dpr) * pxW;
+					const float hy = (kObsHandleRadius * dpr) * pxH;
+
+					const VerticalProgramRect pr = ComputeVerticalProgramRect(posX, posY, scalePct);
+					const float x0 = std::clamp(pr.x, tx * 0.5f, 1.0f - tx * 0.5f);
+					const float y0 = std::clamp(pr.y, ty * 0.5f, 1.0f - ty * 0.5f);
+					const float x1 = std::clamp(pr.x + pr.w, tx * 0.5f, 1.0f - tx * 0.5f);
+					const float y1 = std::clamp(pr.y + pr.h, ty * 0.5f, 1.0f - ty * 0.5f);
+					const float xm = (x0 + x1) * 0.5f;
+					const float ym = (y0 + y1) * 0.5f;
+
+					const float handles[8][2] = {
+						{x0, y0}, {x0, y1}, {x1, y0}, {x1, y1},
+						{xm, y0}, {x0, ym}, {xm, y1}, {x1, ym},
+					};
+
+					gs_effect_set_vec4(colorParam, &selColor);
+					while (gs_effect_loop(solid, "Solid")) {
+						// 4 solid border edges (identical to OBSBasicPreview::DrawRect)
+						DrawFilledRect(x0 - tx * 0.5f, y0 - ty * 0.5f, x1 + tx * 0.5f, y0 + ty * 0.5f);
+						DrawFilledRect(x0 - tx * 0.5f, y1 - ty * 0.5f, x1 + tx * 0.5f, y1 + ty * 0.5f);
+						DrawFilledRect(x0 - tx * 0.5f, y0 - ty * 0.5f, x0 + tx * 0.5f, y1 + ty * 0.5f);
+						DrawFilledRect(x1 - tx * 0.5f, y0 - ty * 0.5f, x1 + tx * 0.5f, y1 + ty * 0.5f);
+
+						// 8 solid square handles (identical to OBSBasicPreview::DrawSquareAtPos)
+						for (const auto &pt : handles) {
+							const float cx = std::clamp(pt[0], hx, 1.0f - hx);
+							const float cy = std::clamp(pt[1], hy, 1.0f - hy);
+							DrawFilledRect(cx - hx, cy - hy, cx + hx, cy + hy);
+						}
+					}
+				}
+			}
+			gs_blend_state_pop();
+			gs_matrix_pop();
+		}
+		gs_projection_pop();
+		gs_viewport_pop();
+	}
+};
+
+class InteractiveVerticalDisplay : public OBSQTDisplay {
+public:
+	std::shared_ptr<VerticalMonitor> monitor;
+	std::function<void()> onLiveChanged;
+	std::function<void()> onCommitted;
+
+	explicit InteractiveVerticalDisplay(QWidget *parent = nullptr) : OBSQTDisplay(parent)
+	{
+		setAttribute(Qt::WA_AcceptTouchEvents, true);
+		setCursor(Qt::OpenHandCursor);
+	}
+
+protected:
+	enum class DragMode { None, Move, ResizeCorner, ResizeHoriz, ResizeVert, PanCrop };
+	DragMode dragMode = DragMode::None;
+	bool selected = true;
+	bool pinchActive = false;
+	float startPressX = 0.0f;
+	float startPressY = 0.0f;
+	float startBoxCx = 0.5f;
+	float startBoxCy = 0.5f;
+	float startHandleDist = 0.1f;
+	int startScale = 100;
+	int startCropX = 0;
+	float pinchStartDist = 1.0f;
+	int pinchStartScale = 100;
+	float pinchBoxCx = 0.5f;
+	float pinchBoxCy = 0.5f;
+
+	struct CanvasMetrics {
+		float vx = 0.0f, vy = 0.0f, vw = 1.0f, vh = 1.0f;
+		bool valid = false;
+	};
+
+	CanvasMetrics getCanvasMetrics() const
+	{
+		CanvasMetrics m;
+		const float ww = float(width());
+		const float wh = float(height());
+		if (ww < 9.0f || wh < 16.0f)
+			return m;
+		const float units = std::min(ww / 9.0f, wh / 16.0f);
+		m.vw = units * 9.0f;
+		m.vh = units * 16.0f;
+		m.vx = (ww - m.vw) * 0.5f;
+		m.vy = (wh - m.vh) * 0.5f;
+		m.valid = true;
+		return m;
+	}
+
+	bool canEditTransform() const
+	{
+		if (g_verticalFitMode == 1)
+			return !ShouldUseCustomVerticalScene(g_verticalFollowScene);
+		return g_verticalFitMode == 2 || g_verticalFitMode == 3;
+	}
+
+	void syncMonitorState()
+	{
+		if (!monitor)
+			return;
+		vec4 selCol{{{1.0f, 0.0f, 0.0f, 1.0f}}};
+		const float dpr = float(devicePixelRatioF());
+		if (OBSBasic *main = OBSBasic::Get()) {
+			const QColor c = main->GetSelectionColor();
+			vec4_set(&selCol, float(c.redF()), float(c.greenF()), float(c.blueF()), 1.0f);
+		}
+		const std::lock_guard<std::mutex> lock(monitor->mutex);
+		monitor->interactive = true;
+		monitor->selected = selected;
+		monitor->mode = g_verticalFitMode;
+		monitor->customScene = ShouldUseCustomVerticalScene(g_verticalFollowScene);
+		monitor->posX = g_verticalPosX;
+		monitor->posY = g_verticalPosY;
+		monitor->scale = g_verticalScale;
+		monitor->pixelRatio = std::max(1.0f, dpr);
+		monitor->selColor = selCol;
+	}
+
+	void applyScaleKeepingCenter(int nextScale, float anchorCx, float anchorCy)
+	{
+		g_verticalScale = std::clamp(nextScale, 25, 180);
+		const VerticalProgramRect nr = ComputeVerticalProgramRect(0, 0, g_verticalScale);
+		if (nr.maxDx > 0.001f)
+			g_verticalPosX = std::clamp(int(std::lround(((anchorCx - 0.5f) / nr.maxDx) * 100.0f)), -100, 100);
+		else
+			g_verticalPosX = 0;
+		if (nr.maxDy > 0.001f)
+			g_verticalPosY = std::clamp(int(std::lround(((anchorCy - 0.5f) / nr.maxDy) * 100.0f)), -100, 100);
+		else
+			g_verticalPosY = 0;
+	}
+
+	bool event(QEvent *e) override
+	{
+		if (e->type() == QEvent::TouchBegin || e->type() == QEvent::TouchUpdate ||
+		    e->type() == QEvent::TouchEnd || e->type() == QEvent::TouchCancel) {
+			auto *te = static_cast<QTouchEvent *>(e);
+			const auto &pts = te->points();
+			if (pts.size() >= 2 && (g_verticalFitMode == 2 || g_verticalFitMode == 3)) {
+				const QPointF p0 = pts[0].position();
+				const QPointF p1 = pts[1].position();
+				const float dist = float(std::hypot(p1.x() - p0.x(), p1.y() - p0.y()));
+				if (!pinchActive) {
+					pinchActive = true;
+					selected = true;
+					dragMode = DragMode::None;
+					pinchStartDist = std::max(dist, 20.0f);
+					pinchStartScale = g_verticalScale;
+					const VerticalProgramRect pr =
+						ComputeVerticalProgramRect(g_verticalPosX, g_verticalPosY, g_verticalScale);
+					pinchBoxCx = pr.x + pr.w * 0.5f;
+					pinchBoxCy = pr.y + pr.h * 0.5f;
+				}
+				if (e->type() == QEvent::TouchEnd || e->type() == QEvent::TouchCancel) {
+					pinchActive = false;
+					syncMonitorState();
+					if (onCommitted)
+						onCommitted();
+				} else {
+					const int nextScale = int(std::lround(pinchStartScale * (dist / pinchStartDist)));
+					applyScaleKeepingCenter(nextScale, pinchBoxCx, pinchBoxCy);
+					syncMonitorState();
+					if (onLiveChanged)
+						onLiveChanged();
+				}
+				e->accept();
+				return true;
+			}
+			if (pinchActive && (e->type() == QEvent::TouchEnd || e->type() == QEvent::TouchCancel ||
+					    pts.size() < 2)) {
+				pinchActive = false;
+				syncMonitorState();
+				if (onCommitted)
+					onCommitted();
+				e->accept();
+				return true;
+			}
+		}
+		return OBSQTDisplay::event(e);
+	}
+
+	void mousePressEvent(QMouseEvent *e) override
+	{
+		if (e->button() != Qt::LeftButton || pinchActive || !canEditTransform()) {
+			OBSQTDisplay::mousePressEvent(e);
+			return;
+		}
+		const CanvasMetrics cm = getCanvasMetrics();
+		if (!cm.valid)
+			return;
+		const float px = float(e->position().x());
+		const float py = float(e->position().y());
+		const float nx = (px - cm.vx) / cm.vw;
+		const float ny = (py - cm.vy) / cm.vh;
+		startPressX = nx;
+		startPressY = ny;
+
+		if (g_verticalFitMode == 1) {
+			dragMode = DragMode::PanCrop;
+			startCropX = g_verticalCropX;
+			setCursor(Qt::ClosedHandCursor);
+			syncMonitorState();
+			e->accept();
+			return;
+		}
+
+		const VerticalProgramRect pr = ComputeVerticalProgramRect(g_verticalPosX, g_verticalPosY, g_verticalScale);
+		startBoxCx = pr.x + pr.w * 0.5f;
+		startBoxCy = pr.y + pr.h * 0.5f;
+		startScale = g_verticalScale;
+
+		// Match OBSBasicPreview's 8 handles (4 corners + 4 midpoints) with HANDLE_SEL_RADIUS = 18.0f
+		const float x0 = cm.vx + std::clamp(pr.x, 0.0f, 1.0f) * cm.vw;
+		const float y0 = cm.vy + std::clamp(pr.y, 0.0f, 1.0f) * cm.vh;
+		const float x1 = cm.vx + std::clamp(pr.x + pr.w, 0.0f, 1.0f) * cm.vw;
+		const float y1 = cm.vy + std::clamp(pr.y + pr.h, 0.0f, 1.0f) * cm.vh;
+		const float xm = (x0 + x1) * 0.5f;
+		const float ym = (y0 + y1) * 0.5f;
+
+		struct HandleSpec {
+			float x, y;
+			DragMode mode;
+		};
+		const HandleSpec handles[8] = {
+			{x0, y0, DragMode::ResizeCorner}, {x1, y0, DragMode::ResizeCorner},
+			{x1, y1, DragMode::ResizeCorner}, {x0, y1, DragMode::ResizeCorner},
+			{xm, y0, DragMode::ResizeVert},   {xm, y1, DragMode::ResizeVert},
+			{x0, ym, DragMode::ResizeHoriz},  {x1, ym, DragMode::ResizeHoriz},
+		};
+
+		constexpr float kHandleHitPx = 18.0f;
+		int hitIdx = -1;
+		float bestDist = kHandleHitPx + 1.0f;
+		if (selected) {
+			for (int i = 0; i < 8; ++i) {
+				const float d = std::hypot(px - handles[i].x, py - handles[i].y);
+				if (d < bestDist) {
+					bestDist = d;
+					hitIdx = i;
+				}
+			}
+		}
+
+		const float cxPx = cm.vx + startBoxCx * cm.vw;
+		const float cyPx = cm.vy + startBoxCy * cm.vh;
+
+		if (hitIdx >= 0) {
+			selected = true;
+			dragMode = handles[hitIdx].mode;
+			if (dragMode == DragMode::ResizeCorner) {
+				startHandleDist = std::max(std::hypot(px - cxPx, py - cyPx), 12.0f);
+				setCursor(Qt::SizeFDiagCursor);
+			} else if (dragMode == DragMode::ResizeVert) {
+				startHandleDist = std::max(std::fabs(py - cyPx), 10.0f);
+				setCursor(Qt::SizeVerCursor);
+			} else {
+				startHandleDist = std::max(std::fabs(px - cxPx), 10.0f);
+				setCursor(Qt::SizeHorCursor);
+			}
+		} else {
+			const bool insideBox = (px >= x0 - 8.0f && px <= x1 + 8.0f && py >= y0 - 8.0f && py <= y1 + 8.0f);
+			if (insideBox) {
+				selected = true;
+				dragMode = DragMode::Move;
+				setCursor(Qt::ClosedHandCursor);
+			} else {
+				// Clicking empty background deselects the red OBS box just like OBSBasicPreview
+				selected = false;
+				dragMode = DragMode::None;
+				setCursor(Qt::ArrowCursor);
+			}
+		}
+		syncMonitorState();
+		e->accept();
+	}
+
+	void mouseMoveEvent(QMouseEvent *e) override
+	{
+		if (dragMode == DragMode::None || pinchActive) {
+			OBSQTDisplay::mouseMoveEvent(e);
+			return;
+		}
+		const CanvasMetrics cm = getCanvasMetrics();
+		if (!cm.valid)
+			return;
+		const float px = float(e->position().x());
+		const float py = float(e->position().y());
+		const float nx = (px - cm.vx) / cm.vw;
+		const float ny = (py - cm.vy) / cm.vh;
+
+		if (dragMode == DragMode::PanCrop) {
+			int nextCrop = std::clamp(int(std::lround(startCropX - (nx - startPressX) * 180.0f)), -100, 100);
+			if (std::abs(nextCrop) <= 4)
+				nextCrop = 0;
+			g_verticalCropX = nextCrop;
+		} else if (dragMode == DragMode::ResizeCorner || dragMode == DragMode::ResizeHoriz ||
+			   dragMode == DragMode::ResizeVert) {
+			const float cxPx = cm.vx + startBoxCx * cm.vw;
+			const float cyPx = cm.vy + startBoxCy * cm.vh;
+			float curDist = startHandleDist;
+			if (dragMode == DragMode::ResizeCorner)
+				curDist = std::hypot(px - cxPx, py - cyPx);
+			else if (dragMode == DragMode::ResizeVert)
+				curDist = std::fabs(py - cyPx);
+			else
+				curDist = std::fabs(px - cxPx);
+			int nextScale = std::clamp(int(std::lround(startScale * (curDist / startHandleDist))), 25, 180);
+			if (std::abs(nextScale - 100) <= 3)
+				nextScale = 100;
+			applyScaleKeepingCenter(nextScale, startBoxCx, startBoxCy);
+		} else if (dragMode == DragMode::Move) {
+			const VerticalProgramRect pr = ComputeVerticalProgramRect(0, 0, g_verticalScale);
+			float targetCx = startBoxCx + (nx - startPressX);
+			float targetCy = startBoxCy + (ny - startPressY);
+			if (std::fabs(targetCx - 0.5f) < 0.020f)
+				targetCx = 0.5f;
+			if (std::fabs(targetCy - 0.5f) < 0.016f)
+				targetCy = 0.5f;
+			if (pr.maxDx > 0.001f)
+				g_verticalPosX = std::clamp(int(std::lround(((targetCx - 0.5f) / pr.maxDx) * 100.0f)), -100, 100);
+			else
+				g_verticalPosX = 0;
+			if (pr.maxDy > 0.001f)
+				g_verticalPosY = std::clamp(int(std::lround(((targetCy - 0.5f) / pr.maxDy) * 100.0f)), -100, 100);
+			else
+				g_verticalPosY = 0;
+		}
+
+		syncMonitorState();
+		if (onLiveChanged)
+			onLiveChanged();
+		e->accept();
+	}
+
+	void mouseReleaseEvent(QMouseEvent *e) override
+	{
+		if (dragMode != DragMode::None) {
+			dragMode = DragMode::None;
+			setCursor(Qt::OpenHandCursor);
+			syncMonitorState();
+			if (onCommitted)
+				onCommitted();
+			e->accept();
+			return;
+		}
+		OBSQTDisplay::mouseReleaseEvent(e);
+	}
+
+	void mouseDoubleClickEvent(QMouseEvent *e) override
+	{
+		if (e->button() != Qt::LeftButton || !canEditTransform()) {
+			OBSQTDisplay::mouseDoubleClickEvent(e);
+			return;
+		}
+		dragMode = DragMode::None;
+		selected = true;
+		if (g_verticalFitMode == 1) {
+			g_verticalCropX = 0;
+		} else {
+			g_verticalPosX = 0;
+			g_verticalPosY = 0;
+			g_verticalScale = 100;
+		}
+		syncMonitorState();
+		if (onLiveChanged)
+			onLiveChanged();
+		if (onCommitted)
+			onCommitted();
+		e->accept();
+	}
+};
+
+void SaveAllObsStateOnGuiThread()
+{
+	if (!obs_initialized())
+		return;
+	obs_frontend_save();
+	if (auto *mainWin = OBSBasic::Get()) {
+		mainWin->SaveProject();
+		mainWin->SaveService();
+		if (config_t *bc = mainWin->Config())
+			config_save_safe(bc, "tmp", nullptr);
+	}
+	if (App()) {
+		if (config_t *ac = App()->GetAppConfig())
+			config_save_safe(ac, "tmp", nullptr);
+		if (config_t *uc = App()->GetUserConfig()) {
+			config_set_bool(uc, "General", "FirstRun", false);
+			config_save_safe(uc, "tmp", nullptr);
+		}
+	}
+}
+
+void SaveAllObsStateBridge()
+{
+	QCoreApplication *app = QCoreApplication::instance();
+	if (!app)
+		return;
+	if (QThread::currentThread() == app->thread()) {
+		SaveAllObsStateOnGuiThread();
+	} else {
+		QMetaObject::invokeMethod(app, []() { SaveAllObsStateOnGuiThread(); }, Qt::QueuedConnection);
+	}
+}
+
+std::string BuildStateJsonOnGuiThread()
+{
+	nlohmann::json j;
+	j["streaming"] = obs_frontend_streaming_active();
+	j["recording"] = obs_frontend_recording_active();
+	j["studioMode"] = obs_frontend_preview_program_mode_active();
+	j["fps"] = obs_get_active_fps();
+	auto *mainWin = OBSBasic::Get();
+	j["cpu"] = mainWin ? mainWin->GetCPUUsage() : 0.0;
+
+	obs_source_t *prog = obs_frontend_get_current_scene();
+	j["programScene"] = prog ? (obs_source_get_name(prog) ? obs_source_get_name(prog) : "") : "";
+
+	obs_source_t *prev = obs_frontend_preview_program_mode_active() ? obs_frontend_get_current_preview_scene() : nullptr;
+	j["previewScene"] = prev ? (obs_source_get_name(prev) ? obs_source_get_name(prev) : "") : j["programScene"];
+
+	nlohmann::json scenesArr = nlohmann::json::array();
+	nlohmann::json vertScenesArr = nlohmann::json::array();
+	struct obs_frontend_source_list sl = {};
+	obs_frontend_get_scenes(&sl);
+	for (size_t i = 0; i < sl.sources.num; ++i) {
+		const char *nm = obs_source_get_name(sl.sources.array[i]);
+		if (nm && *nm) {
+			std::string s(nm);
+			if (IsVerticalSceneName(s))
+				vertScenesArr.push_back(s);
+			else
+				scenesArr.push_back(s);
+		}
+	}
+	obs_frontend_source_list_free(&sl);
+	j["scenes"] = scenesArr;
+	j["verticalScenes"] = vertScenesArr;
+	j["verticalActiveScene"] = g_verticalFollowScene;
+
+	nlohmann::json srcArr = nlohmann::json::array();
+	obs_source_t *activeSceneSrc = prev ? prev : prog;
+	if (activeSceneSrc) {
+		obs_scene_t *scene = obs_scene_from_source(activeSceneSrc);
+		if (scene) {
+			obs_scene_enum_items(
+				scene,
+				[](obs_scene_t *, obs_sceneitem_t *item, void *param) -> bool {
+					auto *arr = static_cast<nlohmann::json *>(param);
+					obs_source_t *s = obs_sceneitem_get_source(item);
+					if (s) {
+						const char *nm = obs_source_get_name(s);
+						arr->push_back({{"id", obs_sceneitem_get_id(item)},
+								{"name", nm ? nm : ""},
+								{"visible", obs_sceneitem_visible(item)}});
+					}
+					return true;
+				},
+				&srcArr);
+		}
+	}
+	j["sources"] = srcArr;
+	if (prev)
+		obs_source_release(prev);
+	if (prog)
+		obs_source_release(prog);
+
+	nlohmann::json audioArr = nlohmann::json::array();
+	obs_enum_sources(
+		[](void *param, obs_source_t *src) -> bool {
+			auto *arr = static_cast<nlohmann::json *>(param);
+			uint32_t flags = obs_source_get_output_flags(src);
+			if ((flags & OBS_SOURCE_AUDIO) != 0) {
+				const char *nm = obs_source_get_name(src);
+				if (nm && *nm) {
+					arr->push_back({{"name", nm},
+							{"volume", obs_source_get_volume(src)},
+							{"muted", obs_source_muted(src)}});
+				}
+			}
+			return true;
+		},
+		&audioArr);
+	j["audio"] = audioArr;
+	return j.dump();
+}
+
+std::string ExecuteActionJsonOnGuiThread(const std::string &body)
+{
+	nlohmann::json resp = {{"ok", false}};
+	try {
+		auto req = nlohmann::json::parse(body);
+		std::string act = req.value("action", "");
+		if (act == "switch_scene") {
+			std::string name = req.value("scene", "");
+			if (!name.empty()) {
+				obs_source_t *s = obs_get_source_by_name(name.c_str());
+				if (s) {
+					if (obs_frontend_preview_program_mode_active())
+						obs_frontend_set_current_preview_scene(s);
+					else
+						obs_frontend_set_current_scene(s);
+					obs_source_release(s);
+					resp["ok"] = true;
+				}
+			}
+		} else if (act == "switch_vertical_scene") {
+			std::string name = req.value("scene", "");
+			if (!name.empty()) {
+				auto config = LoadMultiConfig();
+				config["vertical"]["scene"] = name;
+				config["vertical"]["autoLinks"] = false;
+				SaveMultiConfig(config);
+				g_verticalFollowScene = name;
+				ApplyVerticalSceneByName(name);
+				resp["ok"] = true;
+			}
+		} else if (act == "transition") {
+			obs_frontend_preview_program_trigger_transition();
+			resp["ok"] = true;
+		} else if (act == "toggle_studio") {
+			obs_frontend_set_preview_program_mode(!obs_frontend_preview_program_mode_active());
+			resp["ok"] = true;
+		} else if (act == "toggle_stream") {
+			if (obs_frontend_streaming_active())
+				obs_frontend_streaming_stop();
+			else
+				obs_frontend_streaming_start();
+			resp["ok"] = true;
+		} else if (act == "toggle_record") {
+			if (obs_frontend_recording_active())
+				obs_frontend_recording_stop();
+			else
+				obs_frontend_recording_start();
+			resp["ok"] = true;
+		} else if (act == "set_source_visible") {
+			int64_t id = req.value("id", int64_t(-1));
+			bool vis = req.value("visible", true);
+			obs_source_t *sc = obs_frontend_preview_program_mode_active()
+						   ? obs_frontend_get_current_preview_scene()
+						   : obs_frontend_get_current_scene();
+			if (sc) {
+				obs_scene_t *scene = obs_scene_from_source(sc);
+				if (scene) {
+					obs_sceneitem_t *it = obs_scene_find_sceneitem_by_id(scene, id);
+					if (it) {
+						obs_sceneitem_set_visible(it, vis);
+						resp["ok"] = true;
+					}
+				}
+				obs_source_release(sc);
+			}
+		} else if (act == "set_volume") {
+			std::string nm = req.value("source", "");
+			double vol = req.value("volume", 1.0);
+			obs_source_t *s = obs_get_source_by_name(nm.c_str());
+			if (s) {
+				obs_source_set_volume(s, float(std::max(0.0, std::min(1.0, vol))));
+				obs_source_release(s);
+				resp["ok"] = true;
+			}
+		} else if (act == "set_mute") {
+			std::string nm = req.value("source", "");
+			bool muted = req.value("muted", false);
+			obs_source_t *s = obs_get_source_by_name(nm.c_str());
+			if (s) {
+				obs_source_set_muted(s, muted);
+				obs_source_release(s);
+				resp["ok"] = true;
+			}
+		}
+	} catch (...) {
+	}
+	return resp.dump();
+}
+
+bool RemoteGetStateBridge(char *outBuf, size_t outCap)
+{
+	if (!outBuf || outCap == 0)
+		return false;
+	QCoreApplication *app = QCoreApplication::instance();
+	if (!app)
+		return false;
+	std::string res;
+	if (QThread::currentThread() == app->thread()) {
+		res = BuildStateJsonOnGuiThread();
+	} else {
+		QMetaObject::invokeMethod(
+			app, [&res]() { res = BuildStateJsonOnGuiThread(); }, Qt::BlockingQueuedConnection);
+	}
+	std::snprintf(outBuf, outCap, "%s", res.c_str());
+	return true;
+}
+
+bool RemoteExecuteActionBridge(const char *body, char *outBuf, size_t outCap)
+{
+	if (!outBuf || outCap == 0)
+		return false;
+	QCoreApplication *app = QCoreApplication::instance();
+	if (!app)
+		return false;
+	std::string in = body ? body : "{}";
+	std::string res;
+	if (QThread::currentThread() == app->thread()) {
+		res = ExecuteActionJsonOnGuiThread(in);
+	} else {
+		QMetaObject::invokeMethod(
+			app, [&in, &res]() { res = ExecuteActionJsonOnGuiThread(in); }, Qt::BlockingQueuedConnection);
+	}
+	std::snprintf(outBuf, outCap, "%s", res.c_str());
+	return true;
+}
