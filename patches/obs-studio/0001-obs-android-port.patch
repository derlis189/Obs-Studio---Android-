diff --git a/libobs/util/android-preview-pacing.h b/libobs/util/android-preview-pacing.h
new file mode 100644
index 0000000..8417742
--- /dev/null
+++ b/libobs/util/android-preview-pacing.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+static inline bool obs_android_preview_due(unsigned long long now, unsigned long long deadline, bool urgent)
+{
+	return urgent || deadline == 0 || now >= deadline;
+}
+
+static inline unsigned long long obs_android_preview_next(unsigned long long now, unsigned long long deadline,
+							 unsigned long long interval)
+{
+	/* Retain phase across normal scheduling jitter; don't replay missed frames. */
+	return deadline != 0 && deadline + interval > now ? deadline + interval : now + interval;
+}
diff --git a/libobs/util/platform-android.c b/libobs/util/platform-android.c
new file mode 100644
index 0000000..9210b7a
--- /dev/null
+++ b/libobs/util/platform-android.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "platform-android.h"
+#include "bmem.h"
+#include "dstr.h"
+#include "platform.h"
+#include <errno.h>
+#include <sys/random.h>
+
+static char *files_path;
+static char *data_path;
+static char *libraries_path;
+
+bool obs_android_set_paths(const char *files, const char *data, const char *libraries)
+{
+    if (!files || files[0] != '/' || !data || data[0] != '/' || !libraries || libraries[0] != '/')
+        return false;
+    char *new_files = bstrdup(files);
+    char *new_data = bstrdup(data);
+    char *new_libraries = bstrdup(libraries);
+    bfree(files_path);
+    bfree(data_path);
+    bfree(libraries_path);
+    files_path = new_files;
+    data_path = new_data;
+    libraries_path = new_libraries;
+    return true;
+}
+const char *obs_android_files_path(void) { return files_path; }
+const char *obs_android_data_path(void) { return data_path; }
+const char *obs_android_libraries_path(void) { return libraries_path; }
+
+char *obs_android_join_path(const char *base, const char *name)
+{
+    if (!base)
+        return NULL;
+    struct dstr path = {0};
+    dstr_copy(&path, base);
+    if (name && *name) {
+        if (dstr_end(&path) != '/')
+            dstr_cat(&path, "/");
+        dstr_cat(&path, name);
+    }
+    return path.array;
+}
+
+char *os_generate_uuid(void)
+{
+    unsigned char bytes[16];
+    size_t done = 0;
+    while (done < sizeof(bytes)) {
+        ssize_t amount = getrandom(bytes + done, sizeof(bytes) - done, 0);
+        if (amount < 0 && errno == EINTR)
+            continue;
+        if (amount <= 0)
+            bcrash("Android secure UUID generation failed: %d", errno);
+        done += (size_t)amount;
+    }
+    bytes[6] = (bytes[6] & 0x0f) | 0x40;
+    bytes[8] = (bytes[8] & 0x3f) | 0x80;
+    struct dstr uuid = {0};
+    dstr_printf(&uuid, "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7],
+        bytes[8], bytes[9], bytes[10], bytes[11], bytes[12], bytes[13], bytes[14], bytes[15]);
+    return uuid.array;
+}
+
+/* Android wake locks are managed by the foreground service, not xdg-screensaver. */
+os_inhibit_t *os_inhibit_sleep_create(const char *reason)
+{
+    UNUSED_PARAMETER(reason);
+    blog(LOG_INFO, "Sleep inhibition requires the Android service wake lock");
+    return NULL;
+}
+bool os_inhibit_sleep_set_active(os_inhibit_t *info, bool active)
+{
+    UNUSED_PARAMETER(info);
+    UNUSED_PARAMETER(active);
+    return false;
+}
+void os_inhibit_sleep_destroy(os_inhibit_t *info) { UNUSED_PARAMETER(info); }
