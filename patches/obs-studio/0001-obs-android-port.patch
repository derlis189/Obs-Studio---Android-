+class AndroidTouchHelper : public QObject {
+	QTimer longPressTimer;
+	QPointer<QWidget> pressTarget;
+	QPoint pressLocalPos;
+	QPoint pressGlobalPos;
+
+	static void FitDialogToScreen(QDialog *dialog)
+	{
+		if (!dialog || !dialog->isVisible())
+			return;
+		QScreen *screen = dialog->screen();
+		if (!screen)
+			screen = QGuiApplication::primaryScreen();
+		if (!screen)
+			return;
+
+		const QRect avail = screen->availableGeometry();
+		const int maxW = std::max(360, avail.width() - 24);
+		const int maxH = std::max(320, avail.height() - 48);
+
+		if (dialog->minimumWidth() > maxW)
+			dialog->setMinimumWidth(std::min(480, maxW));
+		if (dialog->minimumHeight() > maxH)
+			dialog->setMinimumHeight(std::min(320, maxH));
+		dialog->setMaximumSize(maxW, maxH);
+
+		QSize target = dialog->size();
+		if (!target.isValid() || target.width() <= 0 || target.height() <= 0)
+			target = dialog->sizeHint();
+		target = target.boundedTo(QSize(maxW, maxH));
+		if (target != dialog->size())
+			dialog->resize(target);
+
+		const int x = avail.x() + std::max(0, (avail.width() - dialog->width()) / 2);
+		const int y = avail.y() + std::max(8, (avail.height() - dialog->height() - 24) / 2);
+		dialog->move(x, y);
+	}
+
+	static void SetupKineticScroller(QAbstractScrollArea *area)
+	{
+		if (!area || !area->viewport())
+			return;
+		if (area->property("_obs_android_scroller").toBool())
+			return;
+		if (area->inherits("OBSQTDisplay") || area->viewport()->inherits("OBSQTDisplay"))
+			return;
+		area->setProperty("_obs_android_scroller", true);
+
+		QScroller::grabGesture(area->viewport(), QScroller::LeftMouseButtonGesture);
+		QScroller *scroller = QScroller::scroller(area->viewport());
+		QScrollerProperties props = scroller->scrollerProperties();
+		props.setScrollMetric(QScrollerProperties::DragStartDistance, 0.012);
+		props.setScrollMetric(QScrollerProperties::MousePressEventDelay, 0.0);
+		props.setScrollMetric(QScrollerProperties::OvershootDragResistanceFactor, 0.35);
+		props.setScrollMetric(QScrollerProperties::OvershootScrollTime, 0.25);
+		scroller->setScrollerProperties(props);
+	}
+
+	static bool LaunchNativeEditorForLineEdit(QLineEdit *le)
+	{
+		if (!le || !le->isEnabled() || le->isReadOnly() || !g_requestTextInput || g_textDialogOpen)
+			return false;
+		if (qobject_cast<QAbstractSpinBox *>(le->parentWidget()))
+			return false;
+
+		if (auto *im = QGuiApplication::inputMethod())
+			im->hide();
+
+		QString title = le->accessibleName();
+		if (title.isEmpty())
+			title = le->placeholderText();
+		if (title.isEmpty())
+			title = le->objectName();
+		if (title.isEmpty())
+			title = QStringLiteral("Editar texto");
+
+		int64_t reqId = ++g_textReqSeq;
+		g_activeReqId = reqId;
+		g_activeLineEdit = le;
+		g_textDialogOpen = true;
+
+		QByteArray titleUtf8 = title.toUtf8();
+		QByteArray initUtf8 = le->text().toUtf8();
+		bool isPassword = (le->echoMode() != QLineEdit::Normal);
+		if (!g_requestTextInput(reqId, titleUtf8.constData(), initUtf8.constData(), isPassword,
+					&OnNativeTextInputCallback)) {
+			g_textDialogOpen = false;
+			g_activeLineEdit = nullptr;
+			return false;
+		}
+		return true;
+	}
+
+public:
+	static bool HandleAndroidBack()
+	{
+		if (QWidget *popup = QApplication::activePopupWidget()) {
+			popup->close();
+			return true;
+		}
+		if (auto *modalDialog = qobject_cast<QDialog *>(QApplication::activeModalWidget())) {
+			modalDialog->reject();
+			return true;
+		}
+		if (auto *activeDialog = qobject_cast<QDialog *>(QApplication::activeWindow())) {
+			activeDialog->reject();
+			return true;
+		}
+		for (QWidget *top : QApplication::topLevelWidgets()) {
+			if (auto *dialog = qobject_cast<QDialog *>(top)) {
+				if (dialog->isVisible()) {
+					dialog->reject();
+					return true;
+				}
+			}
+		}
+		if (auto *im = QGuiApplication::inputMethod(); im && im->isVisible()) {
+			im->hide();
+			return true;
+		}
+		return false;
+	}
+
+	explicit AndroidTouchHelper(QObject *parent = nullptr) : QObject(parent)
+	{
+		longPressTimer.setSingleShot(true);
+		longPressTimer.setInterval(550);
+		connect(&longPressTimer, &QTimer::timeout, this, [this]() {
+			if (!pressTarget || !pressTarget->isVisible())
+				return;
+			QApplication::postEvent(
+				pressTarget,
+				new QContextMenuEvent(QContextMenuEvent::Mouse, pressLocalPos, pressGlobalPos));
+			pressTarget = nullptr;
+		});
+	}
+
+	bool eventFilter(QObject *watched, QEvent *event) override
+	{
+		switch (event->type()) {
+		case QEvent::KeyPress:
+		case QEvent::KeyRelease: {
+			auto *ke = static_cast<QKeyEvent *>(event);
+			if (ke->key() == Qt::Key_Back) {
+				if (event->type() == QEvent::KeyPress) {
+					if (HandleAndroidBack()) {
+						ke->accept();
+						return true;
+					}
+				} else {
+					ke->accept();
+					return true;
+				}
+			}
+			break;
+		}
+		case QEvent::Show: {
+			if (auto *dialog = qobject_cast<QDialog *>(watched)) {
+				FitDialogToScreen(dialog);
+				QPointer<QDialog> guard(dialog);
+				QTimer::singleShot(0, dialog, [guard]() {
+					if (guard)
+						FitDialogToScreen(guard);
+				});
+			} else if (auto *area = qobject_cast<QAbstractScrollArea *>(watched)) {
+				SetupKineticScroller(area);
+			}
+			break;
+		}
+		case QEvent::RequestSoftwareInputPanel: {
+			if (auto *le = qobject_cast<QLineEdit *>(watched)) {
+				if (LaunchNativeEditorForLineEdit(le)) {
+					return true;
+				}
+			}
+			break;
+		}
+		case QEvent::MouseButtonPress: {
+			auto *me = static_cast<QMouseEvent *>(event);
+			auto *w = qobject_cast<QWidget *>(watched);
+			if (auto *le = qobject_cast<QLineEdit *>(w)) {
+				if (me->button() == Qt::LeftButton && LaunchNativeEditorForLineEdit(le)) {
+					return true;
+				}
+			}
+			if (w && me->button() == Qt::LeftButton && !qobject_cast<QAbstractButton *>(w) &&
+			    !qobject_cast<QAbstractSlider *>(w) && !qobject_cast<QComboBox *>(w) &&
+			    !qobject_cast<QMenu *>(w) && !qobject_cast<QLineEdit *>(w)) {
+				pressTarget = w;
+				pressLocalPos = me->position().toPoint();
+				pressGlobalPos = me->globalPosition().toPoint();
+				longPressTimer.start();
+			} else {
+				longPressTimer.stop();
+				pressTarget = nullptr;
+			}
+			break;
+		}
+		case QEvent::MouseMove: {
+			if (longPressTimer.isActive()) {
+				auto *me = static_cast<QMouseEvent *>(event);
+				if ((me->globalPosition().toPoint() - pressGlobalPos).manhattanLength() > 14) {
+					longPressTimer.stop();
+					pressTarget = nullptr;
+				}
+			}
+			break;
+		}
+		case QEvent::MouseButtonRelease:
+		case QEvent::MouseButtonDblClick:
+		case QEvent::ContextMenu: {
+			longPressTimer.stop();
+			pressTarget = nullptr;
+			break;
+		}
+		default:
+			break;
+		}
+		return QObject::eventFilter(watched, event);
+	}
+};
+} // namespace
+
+static bool HandleAndroidBackFromJNI()
+{
+	QCoreApplication *app = QCoreApplication::instance();
+	if (!app)
+		return false;
+	bool handled = false;
+	if (QThread::currentThread() == app->thread()) {
+		handled = AndroidTouchHelper::HandleAndroidBack();
+	} else {
+		QMetaObject::invokeMethod(
+			app, [&handled]() { handled = AndroidTouchHelper::HandleAndroidBack(); },
+			Qt::BlockingQueuedConnection);
+	}
+	return handled;
+}
+
+void InstallAndroidTouchHelper(QCoreApplication *app)
+{
+	if (!app)
+		return;
+	app->installEventFilter(new AndroidTouchHelper(app));
+	void *jniHandle = FindAndroidJniHandle();
+	using RegisterBackFn = void (*)(bool (*)());
+	auto reg = reinterpret_cast<RegisterBackFn>(dlsym(jniHandle, "obs_android_register_back_handler"));
+	if (reg)
+		reg(&HandleAndroidBackFromJNI);
+	g_requestTextInput =
+		reinterpret_cast<RequestTextInputFn>(dlsym(jniHandle, "obs_android_request_text_input"));
+	blog(LOG_INFO, "AndroidTouchHelper initialized: back_handler=%d text_input=%d", reg != nullptr,
+	     g_requestTextInput != nullptr);
+}
