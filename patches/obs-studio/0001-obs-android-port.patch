+		if (fn) {
+			char outBuf[2048] = {};
+			QByteArray uriUtf8 = input.toUtf8();
+			if (fn(uriUtf8.constData(), outBuf, sizeof(outBuf)) && outBuf[0]) {
+				return QString::fromUtf8(outBuf);
+			}
+		}
+	}
+
