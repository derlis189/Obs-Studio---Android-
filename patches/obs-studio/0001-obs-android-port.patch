+void AutoConfigStartPage::initializePage()
+{
+#ifdef __ANDROID__
+	if (!wiz || !hwSummaryLabel)
+		return;
+	wiz->androidHw = QueryAndroidHardwareProfile();
+	const auto &hw = wiz->androidHw;
+
+	QString codecsText;
+	if (hw.h264_hw) {
+		codecsText += QStringLiteral("H.264 GPU%1 (%2)")
+				      .arg(hw.h264_surface ? QStringLiteral(" Zero-Copy") : QString(),
+					   QString::fromStdString(hw.h264_codec.empty() ? "MediaCodec" : hw.h264_codec));
+	}
+	if (hw.hevc_hw) {
+		if (!codecsText.isEmpty())
+			codecsText += QStringLiteral(" · ");
+		codecsText += QStringLiteral("HEVC/H.265 (%1)")
+				      .arg(QString::fromStdString(hw.hevc_codec.empty() ? "MediaCodec" : hw.hevc_codec));
+	}
+	if (codecsText.isEmpty())
+		codecsText = QStringLiteral("MediaCodec estándar");
+
+	QString thermalStr = hw.thermal_status >= 3   ? QStringLiteral("<span style='color:#f87171;'>Calor alto (ajuste protector activo)</span>")
+			     : hw.thermal_status == 2 ? QStringLiteral("<span style='color:#fbbf24;'>Templado (moderado)</span>")
+						      : QStringLiteral("<span style='color:#4ade80;'>Óptimo</span>");
+	QString batStr;
+	if (hw.battery_pct >= 0) {
+		batStr = QStringLiteral(" · Bat %1%%2").arg(hw.battery_pct).arg(hw.charging ? QStringLiteral(" (cargando)") : QString());
+	}
+	if (hw.battery_temp_c > 0.5) {
+		batStr += QStringLiteral(" · %1°C").arg(QString::number(hw.battery_temp_c, 'f', 1));
+	}
+	if (hw.power_save) {
+		batStr += QStringLiteral(" · Ahorro de energía activo");
+	}
+
+	QString netStr = QString::fromStdString(hw.network_type);
+	if (hw.net_up_kbps >= 500) {
+		netStr += QStringLiteral(" (~%1 Mbps subida)")
+				  .arg(QString::number(hw.net_up_kbps / 1000.0, 'f', 1));
+	}
+
+	const QString ramGb = QString::number(hw.ram_total_mb / 1024.0, 'f', 1);
+	const QString freeGb = QString::number(hw.ram_avail_mb / 1024.0, 'f', 1);
+
+	const QString html = QStringLiteral(
+		"<b style='color:#38bdf8;'>Hardware detectado automáticamente:</b><br>"
+		"• <b>Celular:</b> %1 · Android %2 (API %3)<br>"
+		"• <b>Procesador:</b> %4 · %5<br>"
+		"• <b>GPU y RAM:</b> %6 · %7 GB RAM (%8 GB libres)<br>"
+		"• <b>Codificadores HW:</b> %9<br>"
+		"• <b>Red y Térmica:</b> %10 · Estado térmico: %11%12<br>"
+		"• <b>Perfil recomendado:</b> <span style='color:#93c5fd;'><b>%13</b></span>")
+				     .arg(QString::fromStdString(hw.device_name).toHtmlEscaped(),
+					  QString::fromStdString(hw.android_release).toHtmlEscaped(),
+					  QString::number(hw.sdk_int),
+					  QString::fromStdString(hw.soc_name).toHtmlEscaped(),
+					  QString::fromStdString(hw.cpu_clusters).toHtmlEscaped(),
+					  QString::fromStdString(hw.gpu_renderer).toHtmlEscaped(),
+					  ramGb,
+					  freeGb,
+					  codecsText.toHtmlEscaped(),
+					  netStr.toHtmlEscaped(),
+					  thermalStr,
+					  batStr.toHtmlEscaped(),
+					  QString::fromStdString(hw.tier_label).toHtmlEscaped());
+	hwSummaryLabel->setText(html);
+#endif
+}
