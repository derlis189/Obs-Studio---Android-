+class DockScrollArea : public QScrollArea {
+public:
+	explicit DockScrollArea(QWidget *parent = nullptr) : QScrollArea(parent)
+	{
+		setWidgetResizable(true);
+		setFrameShape(QFrame::NoFrame);
+		setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+		setVerticalScrollBarPolicy(Qt::ScrollBarAsNeeded);
+		setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Expanding);
+		setMinimumSize(64, 48);
+	}
+
+	QSize sizeHint() const override { return QSize(210, 220); }
+	QSize minimumSizeHint() const override { return QSize(64, 48); }
+
+protected:
+	void syncInnerWidth()
+	{
+		if (horizontalScrollBarPolicy() != Qt::ScrollBarAlwaysOff)
+			return;
+		if (QWidget *w = widget()) {
+			int vw = viewport() ? viewport()->width() : width();
+			if (vw > 40) {
+				w->setMinimumWidth(0);
+				w->setMaximumWidth(vw);
+			}
+		}
+	}
+
+	void resizeEvent(QResizeEvent *e) override
+	{
+		QScrollArea::resizeEvent(e);
+		syncInnerWidth();
+	}
+
+	void showEvent(QShowEvent *e) override
+	{
+		QScrollArea::showEvent(e);
+		syncInnerWidth();
+	}
+};
