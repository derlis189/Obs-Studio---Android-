+void SaveAndroidCustomBrowserDocks()
+{
+	nlohmann::json arr = nlohmann::json::array();
+	for (const auto &e : g_browserDocks) {
+		arr.push_back({{"title", e.title.toStdString()},
+			       {"url", e.url.toStdString()},
+			       {"uuid", e.uuid.toStdString()},
+			       {"desktop", e.desktopMode}});
+	}
+	const std::string dump = arr.dump();
+	config_set_string(App()->GetUserConfig(), "BasicWindow", "ExtraBrowserDocks", dump.c_str());
+	config_save_safe(App()->GetUserConfig(), "tmp", nullptr);
+}
+
+void SyncAllAndroidBrowserDocks()
+{
+	if (g_browserDocks.empty())
+		return;
+
+	bool anyBlockingOverlay = g_browserDockDragSuspended ||
+				  (QGuiApplication::applicationState() != Qt::ApplicationActive) ||
+				  (QApplication::activePopupWidget() != nullptr) ||
+				  (QApplication::activeModalWidget() != nullptr);
+
+	if (!anyBlockingOverlay && g_browserDockMainWin) {
+		if (auto *mw = qobject_cast<QMainWindow *>(g_browserDockMainWin.data())) {
+			if (QMenuBar *mb = mw->menuBar()) {
+				if (mb->activeAction() != nullptr)
+					anyBlockingOverlay = true;
+			}
+		}
+	}
+
+	if (!anyBlockingOverlay && g_browserDockMainWin) {
+		for (QWidget *tlw : QApplication::topLevelWidgets()) {
+			if (!tlw || !tlw->isVisible() || tlw == g_browserDockMainWin)
+				continue;
+			const Qt::WindowType wt = tlw->windowType();
+			if (wt == Qt::Dialog || wt == Qt::Popup || wt == Qt::Sheet || wt == Qt::Drawer) {
+				anyBlockingOverlay = true;
+				break;
+			}
+		}
+	}
+
+	if (anyBlockingOverlay != g_lastBrowserDocksSuspended) {
+		g_lastBrowserDocksSuspended = anyBlockingOverlay;
+		BrowserDockCallSuspended(anyBlockingOverlay);
+	}
+
+	QRect winGlobalRect;
+	if (g_browserDockMainWin) {
+		winGlobalRect = QRect(g_browserDockMainWin->mapToGlobal(QPoint(0, 0)), g_browserDockMainWin->size());
+	}
+
+	for (auto &e : g_browserDocks) {
+		if (!e.webSlot)
+			continue;
+		QDockWidget *dock = nullptr;
+		for (QWidget *p = e.webSlot->parentWidget(); p; p = p->parentWidget()) {
+			if (auto *d = qobject_cast<QDockWidget *>(p)) {
+				dock = d;
+				break;
+			}
+		}
+		QRect logicalRect(e.webSlot->mapToGlobal(QPoint(0, 0)), e.webSlot->size());
+		if (winGlobalRect.isValid()) {
+			logicalRect = logicalRect.intersected(winGlobalRect);
+		}
+		const bool visible = !anyBlockingOverlay && e.webSlot->isVisible() && (!dock || dock->isVisible()) &&
+				     !e.webSlot->visibleRegion().isEmpty() && logicalRect.width() >= 32 &&
+				     logicalRect.height() >= 32;
+		QRect phys;
+		if (visible) {
+			const qreal dpr = e.webSlot->devicePixelRatioF();
+			const QPoint origin = winGlobalRect.isValid() ? winGlobalRect.topLeft() : QPoint(0, 0);
+			phys = QRect(qRound((logicalRect.x() - origin.x()) * dpr),
+				     qRound((logicalRect.y() - origin.y()) * dpr),
+				     qRound(logicalRect.width() * dpr), qRound(logicalRect.height() * dpr));
+		}
+		if (visible != e.lastVisible || (visible && phys != e.lastPhysicalRect)) {
+			e.lastVisible = visible;
+			e.lastPhysicalRect = phys;
+			BrowserDockCallBounds(e.nativeId, phys.x(), phys.y(), phys.width(), phys.height(), visible);
+		}
+	}
+}
+
+void SuspendAndroidBrowserDocksForDrag(bool suspend)
+{
+	g_browserDockDragSuspended = suspend;
+	if (suspend) {
+		g_lastBrowserDocksSuspended = true;
+		BrowserDockCallSuspended(true);
+	} else {
+		SyncAllAndroidBrowserDocks();
+	}
+}
