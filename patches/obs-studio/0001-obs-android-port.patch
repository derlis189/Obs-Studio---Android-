diff --git a/libobs-opengl/gl-android-egl.c b/libobs-opengl/gl-android-egl.c
new file mode 100644
index 0000000..d49c06a
--- /dev/null
+++ b/libobs-opengl/gl-android-egl.c
@@ -0,0 +1,468 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gl-subsystem.h"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <android/hardware_buffer.h>
+#include <android/native_window.h>
+
+typedef EGLClientBuffer(EGLAPIENTRYP PFN_eglGetNativeClientBufferANDROID)(const struct AHardwareBuffer *buffer);
+typedef EGLImageKHR(EGLAPIENTRYP PFN_eglCreateImageKHR)(EGLDisplay dpy, EGLContext ctx, EGLenum target,
+							EGLClientBuffer buffer, const EGLint *attrib_list);
+typedef EGLBoolean(EGLAPIENTRYP PFN_eglDestroyImageKHR)(EGLDisplay dpy, EGLImageKHR image);
+typedef void (*PFN_glEGLImageTargetTexture2DOES)(GLenum target, void *image);
+typedef EGLSyncKHR(EGLAPIENTRYP PFN_eglCreateSyncKHR)(EGLDisplay dpy, EGLenum type, const EGLint *attrib_list);
+typedef EGLBoolean(EGLAPIENTRYP PFN_eglDestroySyncKHR)(EGLDisplay dpy, EGLSyncKHR sync);
+typedef EGLint(EGLAPIENTRYP PFN_eglClientWaitSyncKHR)(EGLDisplay dpy, EGLSyncKHR sync, EGLint flags, EGLTimeKHR timeout);
+
+struct ahb_slot {
+	AHardwareBuffer *buffer;
+	EGLImageKHR image;
+	EGLSyncKHR fence;
+	GLuint tex;
+	GLuint fbo;
+	uint32_t cx;
+	uint32_t cy;
+};
+
+struct gl_platform {
+	EGLDisplay display;
+	EGLContext context;
+	EGLConfig config;
+	EGLSurface pbuffer;
+	PFN_eglGetNativeClientBufferANDROID get_native_client_buffer;
+	PFN_eglCreateImageKHR create_image;
+	PFN_eglDestroyImageKHR destroy_image;
+	PFN_glEGLImageTargetTexture2DOES image_target_tex2d;
+	PFN_eglCreateSyncKHR create_sync;
+	PFN_eglDestroySyncKHR destroy_sync;
+	PFN_eglClientWaitSyncKHR client_wait_sync;
+	bool ahb_supported;
+};
+struct gl_windowinfo {
+	ANativeWindow *window;
+	EGLSurface surface;
+	void (*present_cb)(void *opaque, const uint8_t *rgba, uint32_t width, uint32_t height);
+	void (*present_ahb_cb)(void *opaque, void *ahb, uint32_t width, uint32_t height);
+	void *present_opaque;
+	uint32_t pbuf_cx;
+	uint32_t pbuf_cy;
+	uint8_t *readback_buf;
+	size_t readback_cap;
+	struct ahb_slot ahb[3];
+	int ahb_idx;
+	bool ahb_failed;
+};
+extern bool gl_android_load(void);
+
+static bool make_current(struct gl_platform *platform, EGLSurface surface)
+{
+	if (!eglMakeCurrent(platform->display, surface, surface, platform->context)) {
+		blog(LOG_ERROR, "Android eglMakeCurrent failed: 0x%x", eglGetError());
+		return false;
+	}
+	return true;
+}
+
+static void ahb_slot_destroy(struct gl_platform *platform, struct ahb_slot *slot)
+{
+	if (slot->fence != EGL_NO_SYNC_KHR && platform && platform->destroy_sync) {
+		platform->destroy_sync(platform->display, slot->fence);
+		slot->fence = EGL_NO_SYNC_KHR;
+	}
+	if (slot->fbo) {
+		glDeleteFramebuffers(1, &slot->fbo);
+		slot->fbo = 0;
+	}
+	if (slot->tex) {
+		glDeleteTextures(1, &slot->tex);
+		slot->tex = 0;
+	}
+	if (slot->image != EGL_NO_IMAGE_KHR && platform && platform->destroy_image) {
+		platform->destroy_image(platform->display, slot->image);
+		slot->image = EGL_NO_IMAGE_KHR;
+	}
+	if (slot->buffer) {
+		AHardwareBuffer_release(slot->buffer);
+		slot->buffer = NULL;
+	}
+	slot->cx = 0;
+	slot->cy = 0;
+}
+
+static bool ahb_slot_ensure(struct gl_platform *platform, struct ahb_slot *slot, uint32_t cx, uint32_t cy)
+{
+	if (slot->buffer && slot->fbo && slot->cx == cx && slot->cy == cy)
+		return true;
+
+	ahb_slot_destroy(platform, slot);
+
+	AHardwareBuffer_Desc desc = {0};
+	desc.width = cx;
+	desc.height = cy;
+	desc.layers = 1;
+	desc.format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+	desc.usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE | AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER;
+	if (AHardwareBuffer_allocate(&desc, &slot->buffer) != 0 || !slot->buffer) {
+		blog(LOG_WARNING, "Android AHardwareBuffer_allocate(%ux%u) failed", cx, cy);
+		return false;
+	}
+
+	EGLClientBuffer client_buf = platform->get_native_client_buffer(slot->buffer);
+	if (!client_buf) {
+		blog(LOG_WARNING, "Android eglGetNativeClientBufferANDROID failed");
+		ahb_slot_destroy(platform, slot);
+		return false;
+	}
+
+	const EGLint attrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+	slot->image = platform->create_image(platform->display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, client_buf,
+					     attrs);
+	if (slot->image == EGL_NO_IMAGE_KHR) {
+		blog(LOG_WARNING, "Android eglCreateImageKHR failed: 0x%x", eglGetError());
+		ahb_slot_destroy(platform, slot);
+		return false;
+	}
+
+	glGenTextures(1, &slot->tex);
+	glBindTexture(GL_TEXTURE_2D, slot->tex);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	platform->image_target_tex2d(GL_TEXTURE_2D, slot->image);
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	glGenFramebuffers(1, &slot->fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, slot->fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, slot->tex, 0);
+	GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	if (status != GL_FRAMEBUFFER_COMPLETE) {
+		blog(LOG_WARNING, "Android AHB FBO incomplete: 0x%x", status);
+		ahb_slot_destroy(platform, slot);
+		return false;
+	}
+
+	slot->cx = cx;
+	slot->cy = cy;
+	return true;
+}
+
+void gl_platform_destroy(struct gl_platform *platform)
+{
+	if (!platform)
+		return;
+	if (platform->display != EGL_NO_DISPLAY) {
+		eglMakeCurrent(platform->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+		if (platform->context != EGL_NO_CONTEXT)
+			eglDestroyContext(platform->display, platform->context);
+		if (platform->pbuffer != EGL_NO_SURFACE)
+			eglDestroySurface(platform->display, platform->pbuffer);
+		eglTerminate(platform->display);
+	}
+	bfree(platform);
+}
+struct gl_platform *gl_platform_create(gs_device_t *device, uint32_t adapter)
+{
+	UNUSED_PARAMETER(device);
+	if (adapter != 0)
+		return NULL;
+	struct gl_platform *platform = bzalloc(sizeof(*platform));
+	platform->display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (platform->display == EGL_NO_DISPLAY || !eglInitialize(platform->display, NULL, NULL))
+		goto fail;
+	if (!eglBindAPI(EGL_OPENGL_ES_API))
+		goto fail;
+	const EGLint attributes[] = {EGL_SURFACE_TYPE,
+				     EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
+				     EGL_RENDERABLE_TYPE,
+				     EGL_OPENGL_ES3_BIT_KHR,
+				     EGL_RED_SIZE,
+				     8,
+				     EGL_GREEN_SIZE,
+				     8,
+				     EGL_BLUE_SIZE,
+				     8,
+				     EGL_ALPHA_SIZE,
+				     8,
+				     EGL_NONE};
+	EGLint count = 0;
+	if (!eglChooseConfig(platform->display, attributes, &platform->config, 1, &count) || count != 1)
+		goto fail;
+	const EGLint context_attributes[] = {EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE};
+	platform->context = eglCreateContext(platform->display, platform->config, EGL_NO_CONTEXT, context_attributes);
+	if (platform->context == EGL_NO_CONTEXT)
+		goto fail;
+	const EGLint surface_attributes[] = {EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE};
+	platform->pbuffer = eglCreatePbufferSurface(platform->display, platform->config, surface_attributes);
+	if (platform->pbuffer == EGL_NO_SURFACE || !make_current(platform, platform->pbuffer))
+		goto fail;
+	if (!gl_android_load())
+		goto fail;
+
+	platform->get_native_client_buffer =
+		(PFN_eglGetNativeClientBufferANDROID)eglGetProcAddress("eglGetNativeClientBufferANDROID");
+	platform->create_image = (PFN_eglCreateImageKHR)eglGetProcAddress("eglCreateImageKHR");
+	platform->destroy_image = (PFN_eglDestroyImageKHR)eglGetProcAddress("eglDestroyImageKHR");
+	platform->image_target_tex2d = (PFN_glEGLImageTargetTexture2DOES)eglGetProcAddress("glEGLImageTargetTexture2DOES");
+	platform->create_sync = (PFN_eglCreateSyncKHR)eglGetProcAddress("eglCreateSyncKHR");
+	platform->destroy_sync = (PFN_eglDestroySyncKHR)eglGetProcAddress("eglDestroySyncKHR");
+	platform->client_wait_sync = (PFN_eglClientWaitSyncKHR)eglGetProcAddress("eglClientWaitSyncKHR");
+	platform->ahb_supported = platform->get_native_client_buffer && platform->create_image &&
+				  platform->destroy_image && platform->image_target_tex2d;
+	blog(LOG_INFO, "Android zero-copy AHardwareBuffer presentation: %s",
+	     platform->ahb_supported ? "enabled" : "unavailable (using readback fallback)");
+	return platform;
+fail:
+	blog(LOG_ERROR, "Android EGL creation failed: 0x%x", eglGetError());
+	gl_platform_destroy(platform);
+	return NULL;
+}
+struct gl_windowinfo *gl_windowinfo_create(const struct gs_init_data *info)
+{
+	if (!info->window.android_window && !info->window.present_cb && !info->window.present_ahb_cb)
+		return NULL;
+	struct gl_windowinfo *window = bzalloc(sizeof(*window));
+	window->window = info->window.android_window;
+	window->present_cb = info->window.present_cb;
+	window->present_ahb_cb = info->window.present_ahb_cb;
+	window->present_opaque = info->window.present_opaque;
+	if (window->window)
+		ANativeWindow_acquire(window->window);
+	return window;
+}
+void gl_windowinfo_destroy(struct gl_windowinfo *window)
+{
+	if (!window)
+		return;
+	if (window->window)
+		ANativeWindow_release(window->window);
+	bfree(window->readback_buf);
+	bfree(window);
+}
+static EGLSurface create_pbuffer_swap(struct gl_platform *platform, uint32_t cx, uint32_t cy)
+{
+	EGLint w = cx > 0 ? (EGLint)cx : 16;
+	EGLint h = cy > 0 ? (EGLint)cy : 16;
+	const char *extensions = eglQueryString(platform->display, EGL_EXTENSIONS);
+	if (extensions && strstr(extensions, "EGL_KHR_gl_colorspace")) {
+		const EGLint srgb_attrs[] = {
+			EGL_WIDTH, w, EGL_HEIGHT, h, EGL_GL_COLORSPACE_KHR, EGL_GL_COLORSPACE_SRGB_KHR, EGL_NONE};
+		EGLSurface surf = eglCreatePbufferSurface(platform->display, platform->config, srgb_attrs);
+		if (surf != EGL_NO_SURFACE)
+			return surf;
+	}
+	const EGLint attrs[] = {EGL_WIDTH, w, EGL_HEIGHT, h, EGL_NONE};
+	return eglCreatePbufferSurface(platform->display, platform->config, attrs);
+}
+bool gl_platform_init_swapchain(struct gs_swap_chain *swap)
+{
+	struct gl_platform *platform = swap->device->plat;
+	if (!swap->wi->window) {
+		uint32_t cx = swap->info.cx > 0 ? swap->info.cx : 16;
+		uint32_t cy = swap->info.cy > 0 ? swap->info.cy : 16;
+		swap->wi->surface = create_pbuffer_swap(platform, cx, cy);
+		if (swap->wi->surface == EGL_NO_SURFACE) {
+			blog(LOG_ERROR, "Android pbuffer swapchain failed: 0x%x", eglGetError());
+			return false;
+		}
+		swap->wi->pbuf_cx = cx;
+		swap->wi->pbuf_cy = cy;
+		return true;
+	}
+	EGLint visual;
+	if (!eglGetConfigAttrib(platform->display, platform->config, EGL_NATIVE_VISUAL_ID, &visual))
+		return false;
+	if (ANativeWindow_setBuffersGeometry(swap->wi->window, 0, 0, visual) != 0)
+		return false;
+	const char *extensions = eglQueryString(platform->display, EGL_EXTENSIONS);
+	if (!extensions || !strstr(extensions, "EGL_KHR_gl_colorspace")) {
+		blog(LOG_ERROR, "Android EGL window requires sRGB colorspace support");
+		return false;
+	}
+	const EGLint attributes[] = {EGL_GL_COLORSPACE_KHR, EGL_GL_COLORSPACE_SRGB_KHR, EGL_NONE};
+	swap->wi->surface = eglCreateWindowSurface(platform->display, platform->config, swap->wi->window, attributes);
+	if (swap->wi->surface == EGL_NO_SURFACE) {
+		blog(LOG_ERROR, "Android window surface failed: 0x%x", eglGetError());
+		return false;
+	}
+	return true;
+}
+void gl_platform_cleanup_swapchain(struct gs_swap_chain *swap)
+{
+	if (!swap->wi)
+		return;
+	struct gl_platform *platform = swap->device->plat;
+	for (int i = 0; i < 3; ++i) {
+		ahb_slot_destroy(platform, &swap->wi->ahb[i]);
+	}
+	if (swap->wi->surface != EGL_NO_SURFACE) {
+		eglDestroySurface(platform->display, swap->wi->surface);
+		swap->wi->surface = EGL_NO_SURFACE;
+	}
+}
+void device_enter_context(gs_device_t *device)
+{
+	make_current(device->plat, device->plat->pbuffer);
+}
+void device_leave_context(gs_device_t *device)
+{
+	device->cur_render_target = NULL;
+	device->cur_zstencil_buffer = NULL;
+	device->cur_vertex_buffer = NULL;
+	device->cur_index_buffer = NULL;
+	device->cur_swap = NULL;
+	device->cur_fbo = NULL;
+	eglMakeCurrent(device->plat->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+}
+void device_load_swapchain(gs_device_t *device, gs_swapchain_t *swap)
+{
+	if (device->cur_swap == swap)
+		return;
+	if (!make_current(device->plat, swap ? swap->wi->surface : device->plat->pbuffer))
+		return;
+	device->cur_swap = swap;
+	device->cur_fbo = NULL;
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+}
+void gl_getclientsize(const struct gs_swap_chain *swap, uint32_t *width, uint32_t *height)
+{
+	EGLint w = 0, h = 0;
+	eglQuerySurface(swap->device->plat->display, swap->wi->surface, EGL_WIDTH, &w);
+	eglQuerySurface(swap->device->plat->display, swap->wi->surface, EGL_HEIGHT, &h);
+	*width = w > 0 ? (uint32_t)w : 0;
+	*height = h > 0 ? (uint32_t)h : 0;
+}
+void gl_update(gs_device_t *device)
+{
+	if (!device->cur_swap)
+		return;
+	struct gl_windowinfo *wi = device->cur_swap->wi;
+	if (!wi->window) {
+		uint32_t cx = device->cur_swap->info.cx > 0 ? device->cur_swap->info.cx : 16;
+		uint32_t cy = device->cur_swap->info.cy > 0 ? device->cur_swap->info.cy : 16;
+		if (cx != wi->pbuf_cx || cy != wi->pbuf_cy) {
+			EGLSurface next = create_pbuffer_swap(device->plat, cx, cy);
+			if (next != EGL_NO_SURFACE) {
+				make_current(device->plat, next);
+				if (wi->surface != EGL_NO_SURFACE)
+					eglDestroySurface(device->plat->display, wi->surface);
+				wi->surface = next;
+				wi->pbuf_cx = cx;
+				wi->pbuf_cy = cy;
+			}
+		}
+		return;
+	}
+	gl_getclientsize(device->cur_swap, &device->cur_swap->info.cx, &device->cur_swap->info.cy);
+}
+void gl_clear_context(gs_device_t *device)
+{
+	UNUSED_PARAMETER(device);
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+}
+bool device_is_present_ready(gs_device_t *device)
+{
+	return device->cur_swap != NULL;
+}
+void device_present(gs_device_t *device)
+{
+	if (!device->cur_swap)
+		return;
+	struct gl_windowinfo *wi = device->cur_swap->wi;
+	if (!wi->window) {
+		if (wi->present_ahb_cb && device->plat->ahb_supported && !wi->ahb_failed && wi->pbuf_cx > 0 &&
+		    wi->pbuf_cy > 0) {
+			uint32_t ahb_cx = wi->pbuf_cx;
+			uint32_t ahb_cy = wi->pbuf_cy;
+			const uint32_t max_preview_edge = 960;
+			if (ahb_cx > max_preview_edge || ahb_cy > max_preview_edge) {
+				if (ahb_cx >= ahb_cy) {
+					ahb_cy = (uint32_t)(((uint64_t)ahb_cy * max_preview_edge + ahb_cx / 2) / ahb_cx);
+					ahb_cx = max_preview_edge;
+				} else {
+					ahb_cx = (uint32_t)(((uint64_t)ahb_cx * max_preview_edge + ahb_cy / 2) / ahb_cy);
+					ahb_cy = max_preview_edge;
+				}
+				if (ahb_cx < 16) ahb_cx = 16;
+				if (ahb_cy < 16) ahb_cy = 16;
+				ahb_cx &= ~1u;
+				ahb_cy &= ~1u;
+			}
+			struct ahb_slot *slot = &wi->ahb[wi->ahb_idx];
+			if (ahb_slot_ensure(device->plat, slot, ahb_cx, ahb_cy)) {
+				// Wait only on the fence from 3 frames ago (already signaled -> zero pipeline stall)
+				if (slot->fence != EGL_NO_SYNC_KHR && device->plat->client_wait_sync &&
+				    device->plat->destroy_sync) {
+					device->plat->client_wait_sync(device->plat->display, slot->fence, 0,
+								       50000000ULL);
+					device->plat->destroy_sync(device->plat->display, slot->fence);
+					slot->fence = EGL_NO_SYNC_KHR;
+				}
+				GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+				GLboolean srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+				if (scissor)
+					glDisable(GL_SCISSOR_TEST);
+				if (srgb)
+					glDisable(GL_FRAMEBUFFER_SRGB);
+				glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+				glBindFramebuffer(GL_DRAW_FRAMEBUFFER, slot->fbo);
+				const GLenum blit_filter =
+					(ahb_cx == wi->pbuf_cx && ahb_cy == wi->pbuf_cy) ? GL_NEAREST : GL_LINEAR;
+				glBlitFramebuffer(0, 0, (GLint)wi->pbuf_cx, (GLint)wi->pbuf_cy, 0, 0,
+						  (GLint)ahb_cx, (GLint)ahb_cy, GL_COLOR_BUFFER_BIT, blit_filter);
+				glBindFramebuffer(GL_FRAMEBUFFER, 0);
+				if (srgb)
+					glEnable(GL_FRAMEBUFFER_SRGB);
+				if (scissor)
+					glEnable(GL_SCISSOR_TEST);
+				if (device->plat->create_sync) {
+					slot->fence = device->plat->create_sync(device->plat->display,
+										EGL_SYNC_FENCE_KHR, NULL);
+				}
+				glFlush();
+				AHardwareBuffer_acquire(slot->buffer);
+				wi->present_ahb_cb(wi->present_opaque, slot->buffer, ahb_cx, ahb_cy);
+				wi->ahb_idx = (wi->ahb_idx + 1) % 3;
+				return;
+			}
+			wi->ahb_failed = true;
+		}
+		if (wi->present_cb && wi->pbuf_cx > 0 && wi->pbuf_cy > 0) {
+			size_t needed = (size_t)wi->pbuf_cx * (size_t)wi->pbuf_cy * 4;
+			if (needed > wi->readback_cap) {
+				wi->readback_buf = brealloc(wi->readback_buf, needed);
+				wi->readback_cap = needed;
+			}
+			glBindFramebuffer(GL_FRAMEBUFFER, 0);
+			glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+			glPixelStorei(GL_PACK_ALIGNMENT, 4);
+			glReadPixels(0, 0, (GLsizei)wi->pbuf_cx, (GLsizei)wi->pbuf_cy, GL_RGBA, GL_UNSIGNED_BYTE,
+				     wi->readback_buf);
+			wi->present_cb(wi->present_opaque, wi->readback_buf, wi->pbuf_cx, wi->pbuf_cy);
+		}
+		return;
+	}
+	eglSwapInterval(device->plat->display, 0);
+	if (!eglSwapBuffers(device->plat->display, device->cur_swap->wi->surface))
+		blog(LOG_ERROR, "Android eglSwapBuffers failed: 0x%x", eglGetError());
+}
+void *device_get_device_obj(gs_device_t *device)
+{
+	return device->plat->context;
+}
+bool device_enum_adapters(gs_device_t *device, bool (*callback)(void *, const char *, uint32_t), void *param)
+{
+	UNUSED_PARAMETER(device);
+	return callback(param, (const char *)glGetString(GL_RENDERER), 0);
+}
+uint32_t gs_get_adapter_count(void)
+{
+	return 1;
+}
+bool device_is_monitor_hdr(gs_device_t *device, void *monitor)
+{
+	UNUSED_PARAMETER(device);
+	UNUSED_PARAMETER(monitor);
+	return false; /* HDR display negotiation is not implemented. */
+}
