+			EndPinch();
+			pinchCooldownUntilRelease = true;
+			return true;
+		}
+		if (pinchCooldownUntilRelease)
+			return true;
+
+		const QEventPoint &pt = active[0];
+		if (!touchSingleActive) {
+			touchSingleActive = true;
+			QMouseEvent me(QEvent::MouseButtonPress, pt.position(), pt.globalPosition(), Qt::LeftButton,
+				       Qt::LeftButton, Qt::NoModifier);
+			mousePressEvent(&me);
+		} else {
+			QMouseEvent me(QEvent::MouseMove, pt.position(), pt.globalPosition(), Qt::NoButton,
+				       Qt::LeftButton, Qt::NoModifier);
+			mouseMoveEvent(&me);
+		}
+		return true;
+	}
+	return OBSQTDisplay::event(ev);
