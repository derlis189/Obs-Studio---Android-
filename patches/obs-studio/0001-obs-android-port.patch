diff --git a/frontend/plugin-manager/PluginModuleLoader_Android.cpp b/frontend/plugin-manager/PluginModuleLoader_Android.cpp
new file mode 100644
index 0000000..1cea4e8
--- /dev/null
+++ b/frontend/plugin-manager/PluginModuleLoader_Android.cpp
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "PluginModuleLoader.hpp"
+#include "PluginManager.hpp"
+
+#include <util/platform-android.h>
+#include <string>
+
+namespace {
+OBS::PluginManager::State pluginLoadHelper(const ModuleLoadInfo &info, ModuleList &failedModules)
+{
+	int failedModuleCount = loadPluginsByInfo(info, failedModules);
+	return (failedModuleCount > 0) ? OBS::PluginManager::State::PartialFailure
+				       : OBS::PluginManager::State::Success;
+}
+} // namespace
+
+namespace OBS {
+PluginManager::State PluginManager::loadPlugins(bool)
+{
+	State overall = State::Success;
+
+	std::string envPluginPath = getEnvironmentVariable(kPathVariable);
+	if (!envPluginPath.empty()) {
+		std::string binPath = envPluginPath + "/%module%/";
+		std::string dataPath = envPluginPath + "/%module%/data/";
+		ModuleLoadInfo info = {.path_info = {.binary = binPath.c_str(), .data = dataPath.c_str()},
+				       .type = OBS_MODULE_TYPE_PLUGIN,
+				       .name = nullptr};
+		if (pluginLoadHelper(info, failedModules_) != State::Success)
+			overall = State::PartialFailure;
+	}
+
+	const char *filesDir = obs_android_files_path();
+	if (!filesDir || !*filesDir)
+		filesDir = getenv("OBS_ANDROID_FILES_PATH");
+	if (filesDir && *filesDir) {
+		std::string root = std::string(filesDir) + "/obs-studio/plugins";
+
+		/* Modern plugin layout: <files>/obs-studio/plugins/<name>/[lib]<name>.so */
+		std::string binModern = root + "/%module%/";
+		std::string dataModern = root + "/%module%/data/";
+		ModuleLoadInfo modernInfo = {.path_info = {.binary = binModern.c_str(), .data = dataModern.c_str()},
+					     .type = OBS_MODULE_TYPE_PLUGIN,
+					     .name = nullptr};
+		if (pluginLoadHelper(modernInfo, failedModules_) != State::Success)
+			overall = State::PartialFailure;
+
+		/* Multi-ABI bundle layout: <files>/obs-studio/plugins/<name>/bin/arm64-v8a/[lib]<name>.so */
+		std::string binAbi = root + "/%module%/bin/arm64-v8a/";
+		ModuleLoadInfo abiInfo = {.path_info = {.binary = binAbi.c_str(), .data = dataModern.c_str()},
+					  .type = OBS_MODULE_TYPE_PLUGIN,
+					  .name = nullptr};
+		if (pluginLoadHelper(abiInfo, failedModules_) != State::Success)
+			overall = State::PartialFailure;
+	}
+
+	return overall;
+}
+
+PluginManager::State PluginManager::loadLegacyPlugins(bool)
+{
+	const char *filesDir = obs_android_files_path();
+	if (!filesDir || !*filesDir)
+		filesDir = getenv("OBS_ANDROID_FILES_PATH");
+	if (!filesDir || !*filesDir)
+		return State::Success;
+
+	/* Flat drop-in .so plugins: <files>/obs-studio/plugins/*.so */
+	std::string binFlat = std::string(filesDir) + "/obs-studio/plugins";
+	std::string dataFlat = std::string(filesDir) + "/obs-studio/plugins/%module%/data/";
+	ModuleLoadInfo info = {.path_info = {.binary = binFlat.c_str(), .data = dataFlat.c_str()},
+			       .type = OBS_MODULE_TYPE_LEGACY_PLUGIN,
+			       .name = nullptr};
+	return pluginLoadHelper(info, failedModules_);
+}
+} // namespace OBS
