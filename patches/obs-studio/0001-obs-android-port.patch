+void UpsertAudioFilter(obs_source_t *target, const char *filterId, const char *filterName, obs_data_t *settings)
+{
+	if (!target || !filterId || !filterName)
+		return;
+	OBSSourceAutoRelease existing = obs_source_get_filter_by_name(target, filterName);
+	if (existing) {
+		obs_source_update(existing, settings);
+		obs_source_set_enabled(existing, true);
+		return;
+	}
+	OBSSourceAutoRelease created = obs_source_create(filterId, filterName, settings, nullptr);
+	if (created)
+		obs_source_filter_add(target, created);
+}
+
+void RemoveAudioFilterByName(obs_source_t *target, const char *filterName)
+{
+	if (!target || !filterName)
+		return;
+	OBSSourceAutoRelease existing = obs_source_get_filter_by_name(target, filterName);
+	if (existing)
+		obs_source_filter_remove(target, existing);
+}
