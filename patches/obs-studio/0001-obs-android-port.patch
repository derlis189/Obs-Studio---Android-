+vec2 OBSBasicPreview::WidgetPosToCanvas(const QPointF &qtPos)
+{
+	OBSBasic *main = OBSBasic::Get();
+	float pixelRatio = main->GetDevicePixelRatio();
+	float pScale = (main->previewScale > 1e-4f) ? main->previewScale : 1.0f;
+	float scale = pixelRatio / pScale;
+	vec2 pos;
+	vec2_set(&pos, (float(qtPos.x()) - main->previewX / pixelRatio) * scale,
+		 (float(qtPos.y()) - main->previewY / pixelRatio) * scale);
+	return pos;
+}
+
+void OBSBasicPreview::CancelSingleTouchDrag()
+{
+	if (!touchSingleActive)
+		return;
+	if (stretchGroup) {
+		obs_sceneitem_defer_group_resize_end(stretchGroup);
+	}
+	if (mouseDown && wrapper && changed) {
+		const char *json = obs_data_get_json(wrapper);
+		if (json && *json)
+			obs_scene_load_transform_states(json);
+	}
+	stretchItem = nullptr;
+	stretchHandle = ItemHandle::None;
+	stretchGroup = nullptr;
+	mouseDown = false;
+	mouseMoved = false;
+	cropping = false;
+	selectionBox = false;
+	wrapper = nullptr;
+	changed = false;
+	touchSingleActive = false;
+	{
+		std::lock_guard<std::mutex> lock(selectMutex);
+		hoveredPreviewItems.clear();
+		selectedItems.clear();
+		snapGuides.clear();
+	}
+	unsetCursor();
+}
+
+void OBSBasicPreview::BeginPinch(const QPointF &p0, const QPointF &p1)
+{
+	pinchItems.clear();
+	pinchActive = false;
+
+	OBSBasic *main = OBSBasic::Get();
+	OBSScene scene = main ? main->GetCurrentScene() : OBSScene();
+	if (!scene || locked)
+		return;
+
+	QPointF midQt = (p0 + p1) * 0.5;
+	vec2 midCanvas = WidgetPosToCanvas(midQt);
+
+	auto collectSelected = [&](std::vector<OBSSceneItem> &out) {
+		struct CollectCtx {
+			std::vector<OBSSceneItem> *list;
+		} ctx{&out};
+		obs_scene_enum_items(
+			scene,
+			[](obs_scene_t *, obs_sceneitem_t *item, void *param) {
+				auto *c = static_cast<CollectCtx *>(param);
+				if (obs_sceneitem_selected(item) && !obs_sceneitem_locked(item) &&
+				    obs_sceneitem_visible(item)) {
+					c->list->emplace_back(item);
+				}
+				return true;
+			},
+			&ctx);
+	};
+
+	std::vector<OBSSceneItem> items;
+	collectSelected(items);
+
+	// If nothing is selected yet, automatically select the source under the two fingers
+	if (items.empty()) {
+		OBSSceneItem hit = GetItemAtPos(midCanvas, false);
+		if (hit && !obs_sceneitem_locked(hit)) {
+			obs_scene_enum_items(
+				scene,
+				[](obs_scene_t *, obs_sceneitem_t *it, void *p) {
+					obs_sceneitem_select(it, it == static_cast<obs_sceneitem_t *>(p));
+					return true;
+				},
+				(obs_sceneitem_t *)hit);
+			items.push_back(hit);
+		}
+	}
+
+	if (items.empty())
+		return;
+
+	wrapper = obs_scene_save_transform_states(scene, true);
+	changed = false;
+
+	for (const OBSSceneItem &it : items) {
+		PinchItemState st;
+		st.item = it;
+		obs_sceneitem_get_scale(it, &st.startScale);
+		st.boundsType = obs_sceneitem_get_bounds_type(it);
+		obs_sceneitem_get_bounds(it, &st.startBounds);
+		matrix4 bt;
+		obs_sceneitem_get_box_transform(it, &bt);
+		st.startCenter.x = bt.t.x + 0.5f * (bt.x.x + bt.y.x);
+		st.startCenter.y = bt.t.y + 0.5f * (bt.x.y + bt.y.y);
+		pinchItems.push_back(st);
+	}
+
+	float dx = float(p1.x() - p0.x());
+	float dy = float(p1.y() - p0.y());
+	pinchStartDist = std::max(12.0f, std::hypot(dx, dy));
+	pinchStartMidCanvas = midCanvas;
+	pinchActive = true;
+}
+
+void OBSBasicPreview::UpdatePinch(const QPointF &p0, const QPointF &p1)
+{
+	if (!pinchActive || pinchItems.empty())
+		return;
+
+	float dx = float(p1.x() - p0.x());
+	float dy = float(p1.y() - p0.y());
+	float curDist = std::max(4.0f, std::hypot(dx, dy));
+	float factor = std::clamp(curDist / std::max(12.0f, pinchStartDist), 0.08f, 12.0f);
+
+	vec2 curMidCanvas = WidgetPosToCanvas((p0 + p1) * 0.5);
+	vec2 midDelta;
+	midDelta.x = curMidCanvas.x - pinchStartMidCanvas.x;
+	midDelta.y = curMidCanvas.y - pinchStartMidCanvas.y;
+
+	for (const PinchItemState &st : pinchItems) {
+		if (!st.item || obs_sceneitem_locked(st.item))
+			continue;
+
+		const bool scaled = st.boundsType == OBS_BOUNDS_NONE;
+		const vec2 start = scaled ? st.startScale : st.startBounds;
+		const float minimum = scaled ? 0.03f : 24.0f;
+		const float maximum = scaled ? 20.0f : 16000.0f;
+		const float shortest = std::min(std::fabs(start.x), std::fabs(start.y));
+		const float longest = std::max(std::fabs(start.x), std::fabs(start.y));
+		if (shortest <= 0.0f)
+			continue;
+		const float upper = maximum / longest;
+		const float lower = std::min(minimum / shortest, upper);
+		const float proportional = std::clamp(factor, lower, upper);
+		vec2 size{start.x * proportional, start.y * proportional};
+		if (scaled)
+			obs_sceneitem_set_scale(st.item, &size);
+		else
+			obs_sceneitem_set_bounds(st.item, &size);
+
+		// Keep the visual center anchored smoothly at startCenter + two-finger pan delta
+		matrix4 bt;
+		obs_sceneitem_get_box_transform(st.item, &bt);
+		float curCx = bt.t.x + 0.5f * (bt.x.x + bt.y.x);
+		float curCy = bt.t.y + 0.5f * (bt.x.y + bt.y.y);
+		vec2 pos;
+		obs_sceneitem_get_pos(st.item, &pos);
+		pos.x += (st.startCenter.x + midDelta.x) - curCx;
+		pos.y += (st.startCenter.y + midDelta.y) - curCy;
+		obs_sceneitem_set_pos(st.item, &pos);
+	}
+	changed = true;
+}
+
+void OBSBasicPreview::EndPinch()
+{
+	if (!pinchActive)
+		return;
+
+	OBSBasic *main = OBSBasic::Get();
+	if (main && wrapper && changed) {
+		OBSDataAutoRelease rwrapper = obs_scene_save_transform_states(main->GetCurrentScene(), true);
+		auto undo_redo = [](const std::string &data) {
+			OBSDataAutoRelease dat = obs_data_create_from_json(data.c_str());
+			OBSSourceAutoRelease source = obs_get_source_by_uuid(obs_data_get_string(dat, "scene_uuid"));
+			OBSBasic::Get()->SetCurrentScene(source.Get(), true);
+			obs_scene_load_transform_states(data.c_str());
+		};
+		if (rwrapper) {
+			std::string undo_data(obs_data_get_json(wrapper));
+			std::string redo_data(obs_data_get_json(rwrapper));
+			if (undo_data.compare(redo_data) != 0) {
+				main->undo_s.add_action(
+					QTStr("Undo.Transform").arg(obs_source_get_name(main->GetCurrentSceneSource())),
+					undo_redo, undo_redo, undo_data, redo_data);
+			}
+		}
+	}
+
+	pinchItems.clear();
+	wrapper = nullptr;
+	changed = false;
+	pinchActive = false;
+}
+
+bool OBSBasicPreview::event(QEvent *ev)
+{
+	if (ev && (ev->type() == QEvent::TouchBegin || ev->type() == QEvent::TouchUpdate ||
+		   ev->type() == QEvent::TouchEnd || ev->type() == QEvent::TouchCancel)) {
+		auto *te = static_cast<QTouchEvent *>(ev);
+		te->accept();
+
+		QList<QEventPoint> active;
+		for (const QEventPoint &pt : te->points()) {
+			if (pt.state() != QEventPoint::Released)
+				active.push_back(pt);
+		}
+
+		if (ev->type() == QEvent::TouchCancel) {
+			CancelSingleTouchDrag();
+			if (pinchActive) {
+				if (wrapper && changed) {
+					const char *json = obs_data_get_json(wrapper);
+					if (json && *json)
+						obs_scene_load_transform_states(json);
+				}
+				pinchItems.clear();
+				wrapper = nullptr;
+				changed = false;
+				pinchActive = false;
+			}
+			pinchCooldownUntilRelease = false;
+			return true;
+		}
+
+		if (active.isEmpty()) {
+			if (pinchActive)
+				EndPinch();
+			if (touchSingleActive && !te->points().isEmpty()) {
+				const QEventPoint &pt = te->points().first();
+				QMouseEvent me(QEvent::MouseButtonRelease, pt.position(), pt.globalPosition(),
+					       Qt::LeftButton, Qt::NoButton, Qt::NoModifier);
+				touchSingleActive = false;
+				mouseReleaseEvent(&me);
+			} else {
+				touchSingleActive = false;
+			}
+			pinchCooldownUntilRelease = false;
+			return true;
+		}
+
+		if (active.size() >= 2) {
+			if (touchSingleActive)
+				CancelSingleTouchDrag();
+			if (!pinchActive) {
+				BeginPinch(active[0].position(), active[1].position());
+			} else {
