+QWidget *CreateVerticalDockWidget(QWidget *mainWindow)
+{
+	auto *w = new QWidget();
+	auto *v = new QVBoxLayout(w);
+	v->setContentsMargins(6, 6, 6, 6);
+	v->setSpacing(5);
+
+	auto *preview = new InteractiveVerticalDisplay(w);
+	preview->setMinimumSize(96, 170);
+	preview->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+	preview->SetDisplayBackgroundColor(QColor(15, 18, 24));
+	v->addWidget(preview, 1);
+
+	auto monitor = std::make_shared<VerticalMonitor>();
+	auto previewCache = std::make_shared<VerticalPreviewCache>();
+	preview->monitor = monitor;
+	QObject::connect(preview, &OBSQTDisplay::DisplayCreated, preview, [monitor, previewCache](OBSQTDisplay *display) {
+		obs_display_add_draw_callback(display->GetDisplay(), &VerticalMonitor::Draw, monitor.get());
+		obs_display_set_enabled(display->GetDisplay(), false);
+	});
+
+	auto *cbMode = new QComboBox(w);
+	cbMode->addItem(QStringLiteral("1 · Recorte 9:16"), 1);
+	cbMode->addItem(QStringLiteral("2 · Programa + Imagen"), 2);
+	cbMode->addItem(QStringLiteral("3 · Programa + Borroso"), 3);
+	StyleCompactCombo(cbMode);
+	v->addWidget(cbMode);
+
+	auto *auxRow = new QHBoxLayout();
+	auxRow->setSpacing(4);
+	auto *btnBg = new QPushButton(QStringLiteral("Fondo…"), w);
+	btnBg->setMinimumWidth(0);
+	auto *chkGuides = new QCheckBox(QStringLiteral("Zona segura"), w);
+	auxRow->addWidget(btnBg);
+	auxRow->addWidget(chkGuides, 1);
+	v->addLayout(auxRow);
+
+	auto *actRow = new QHBoxLayout();
+	actRow->setSpacing(4);
+	auto *btnLive = new QPushButton(QStringLiteral("En vivo"), w);
+	auto *btnRec = new QPushButton(QStringLiteral("Grabar"), w);
+	auto *btnClip = new QPushButton(QStringLiteral("Clip"), w);
+	auto *btnCfg = new QPushButton(QStringLiteral("Ajustes"), w);
+	btnLive->setMinimumWidth(0);
+	btnRec->setMinimumWidth(0);
+	btnClip->setMinimumWidth(0);
+	btnCfg->setMinimumWidth(0);
+	actRow->addWidget(btnLive, 1);
+	actRow->addWidget(btnRec, 1);
+	actRow->addWidget(btnClip, 1);
+	actRow->addWidget(btnCfg, 1);
+	v->addLayout(actRow);
+
+	auto syncDock = [=]() {
+		const bool vis = w->isVisible() && preview->isVisible();
+		if (cbMode->currentData().toInt() != g_verticalFitMode) {
+			const QSignalBlocker sb(cbMode);
+			cbMode->setCurrentIndex(std::max(0, cbMode->findData(g_verticalFitMode)));
+		}
+		btnBg->setVisible(g_verticalFitMode == 2);
+
+		const auto vStats = GetVerticalStatsJson();
+		const bool st = vStats.value("streaming", IsVerticalStreamingActive());
+		const bool stRecon = vStats.value("stream_reconnecting", false);
+		const bool rc = vStats.value("recording", IsVerticalRecordingActive());
+		const bool bt = vStats.value("backtrack", IsVerticalBacktrackActive());
+		btnLive->setText(stRecon ? QStringLiteral("Reconect.") : (st ? QStringLiteral("Detener") : QStringLiteral("En vivo")));
+		btnLive->setStyleSheet(
+			stRecon ? QStringLiteral("QPushButton { background: #d97706; color: white; font-weight: bold; }")
+				: (st ? QStringLiteral("QPushButton { background: #dc2626; color: white; font-weight: bold; }")
+				      : QStringLiteral("QPushButton { background: #1d4ed8; color: white; font-weight: bold; }")));
+		btnRec->setText(rc ? QStringLiteral("Parar") : QStringLiteral("Grabar"));
+		btnRec->setStyleSheet(
+			rc ? QStringLiteral("QPushButton { background: #dc2626; color: white; font-weight: bold; }")
