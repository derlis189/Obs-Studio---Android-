+		if (preview->GetDisplay())
+			obs_display_set_enabled(preview->GetDisplay(), vis);
+	};
+
+	preview->onLiveChanged = [=]() {
+		PushVerticalParamsToBackend();
+		previewCache->Resolve(w->isVisible() && preview->isVisible());
+	};
+	preview->onCommitted = [=]() {
