+			}
+			if (!holder) {
+				const QByteArray wrapperName = QByteArray("3D · ") + obs_source_get_name(obs_sceneitem_get_source(item));
+				auto *group = obs_scene_insert_group2(scene, wrapperName.constData(), &item, 1, true);
+				if (!group) return;
+				item = group;
+				OBSDataAutoRelease privateSettings = obs_sceneitem_get_private_settings(group);
+				obs_data_set_bool(privateSettings, "android_vertical_perspective", true);
+				holder = obs_sceneitem_get_source(group);
+			}
+			obs_source_filter_add(holder, filter);
+		} else {
+			obs_source_update(filter, values);
+		}
+		obs_source_set_enabled(filter, enabled->isChecked());
+		SaveAllObsStateOnGuiThread();
+		refresh(obs_sceneitem_get_id(item));
+	});
+	refresh(0);
+	updateActions();
+	dialog.exec();
+}
