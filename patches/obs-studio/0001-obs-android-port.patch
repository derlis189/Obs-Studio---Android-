+		btnClip->setStyleSheet(
+			bt ? QStringLiteral("QPushButton { background: #0d9488; color: white; font-weight: bold; }")
+			   : QString());
+
+		OBSSource source = previewCache->Resolve(vis);
+		monitor->SetSource(source.Get());
+		{
+			vec4 selCol{{{1.0f, 0.0f, 0.0f, 1.0f}}};
+			const float dpr = float(preview->devicePixelRatioF());
+			if (OBSBasic *main = OBSBasic::Get()) {
+				const QColor c = main->GetSelectionColor();
+				vec4_set(&selCol, float(c.redF()), float(c.greenF()), float(c.blueF()), 1.0f);
+			}
+			const std::lock_guard<std::mutex> lock(monitor->mutex);
+			monitor->fill = true;
+			monitor->guides = chkGuides->isChecked();
+			monitor->interactive = true;
