+void StyleCompactCombo(QComboBox *cb)
+{
+	if (!cb)
+		return;
+	cb->setSizeAdjustPolicy(QComboBox::AdjustToMinimumContentsLengthWithIcon);
+	cb->setMinimumContentsLength(6);
+	cb->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+	cb->setMaxVisibleItems(8);
+	cb->setStyleSheet(QStringLiteral("QComboBox { combobox-popup: 0; }"));
+}
+
+void StyleCompactEdit(QLineEdit *ed)
+{
+	if (!ed)
+		return;
+	ed->setMinimumWidth(0);
+	ed->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Fixed);
+}
+
+QScrollArea *WrapDockScroll(QWidget *inner)
+{
+	inner->setMinimumWidth(0);
+	inner->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Preferred);
+	auto *sa = new DockScrollArea();
+	sa->setWidget(inner);
+	return sa;
+}
