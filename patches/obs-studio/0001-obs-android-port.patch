+bool PickAndSaveVerticalBackground(QWidget *parent, QString &outPath)
+{
+	const QString path = OpenFile(parent, QStringLiteral("Imagen de fondo vertical"), QString(),
+				      QStringLiteral("Imágenes (*.png *.jpg *.jpeg *.webp *.bmp)"));
+	if (path.isEmpty())
+		return false;
+	const char *files = obs_android_files_path();
+	const QString folder = files ? QString::fromUtf8(files) + "/obs-studio/vertical" : QString();
+	QString ext = QFileInfo(path).suffix();
+	if (ext.isEmpty())
+		ext = QStringLiteral("png");
+	const QString destination = folder + "/" + QUuid::createUuid().toString(QUuid::WithoutBraces) + "." + ext;
+	if (folder.isEmpty() || !QDir().mkpath(folder) || !QFile::copy(path, destination)) {
+		OBSMessageBox::warning(parent, QStringLiteral("Fondo vertical"),
+				       QStringLiteral("No se pudo guardar la imagen seleccionada."));
+		return false;
+	}
+	outPath = destination;
+	return true;
+}
