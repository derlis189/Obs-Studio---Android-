+
+void load_core_modules(obs_find_module_callback2_t callback, void *data)
+{
+    for (unsigned int i = 0; i < obs_core_modules_count; ++i) {
+        struct dstr relative = {0};
+        dstr_printf(&relative, "lib%s.so", obs_core_modules[i]);
+        char *binary = obs_android_join_path(obs_android_libraries_path(), relative.array);
+        dstr_printf(&relative, "obs-modules/core/%s", obs_core_modules[i]);
+        char *assets = obs_android_join_path(obs_android_files_path(), relative.array);
+        struct obs_module_info2 info = {
+            .bin_path = binary ? binary : "",
+            .data_path = assets ? assets : "",
+            .type = OBS_MODULE_TYPE_CORE,
+            .name = obs_core_modules[i]
+        };
+        /* Pass exact APK library paths to the original loader. It records open/
+         * init failures; discovery must not report success for a missing module. */
+        callback(data, &info);
+        bfree(binary);
+        bfree(assets);
+        dstr_free(&relative);
+    }
+    char *bridge_bin = obs_android_join_path(obs_android_libraries_path(), "libobs-android-jni.so");
+    if (bridge_bin && os_file_exists(bridge_bin)) {
+        struct obs_module_info2 bridge_info = {
