+
+void PopulateNativeFallbacks(AndroidHardwareProfile &p)
+{
+	const int lcores = std::max(1, os_get_logical_cores());
+	p.cpu_cores = lcores;
+	p.ram_total_mb = static_cast<int64_t>(os_get_sys_total_size() / (1024ULL * 1024ULL));
+	p.ram_avail_mb = static_cast<int64_t>(os_get_sys_free_size() / (1024ULL * 1024ULL));
+
+	std::string mfg = GetSysProp("ro.product.manufacturer");
+	std::string model = GetSysProp("ro.product.model");
+	std::string rel = GetSysProp("ro.build.version.release");
+	std::string sdk = GetSysProp("ro.build.version.sdk");
+	std::string socMfg = GetSysProp("ro.soc.manufacturer");
+	std::string socMod = GetSysProp("ro.soc.model");
+	if (socMod.empty())
+		socMod = GetSysProp("ro.board.platform");
+
+	if (!mfg.empty())
+		p.manufacturer = mfg;
+	if (!model.empty())
+		p.model = model;
+	if (!mfg.empty() && !model.empty())
+		p.device_name = mfg + " " + model;
+	else if (!model.empty())
+		p.device_name = model;
+	if (!rel.empty())
+		p.android_release = rel;
+	if (!sdk.empty())
+		p.sdk_int = std::atoi(sdk.c_str());
+	if (!socMod.empty())
+		p.soc_name = (!socMfg.empty() ? (socMfg + " " + socMod) : socMod);
+
+	int peakMhz = 0;
+	int big = 0;
+	int perf = 0;
+	for (int i = 0; i < 16; ++i) {
+		char path[128];
+		std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", i);
+		std::ifstream f(path);
+		if (!f.is_open())
+			continue;
+		long khz = 0;
+		f >> khz;
+		if (khz > 0) {
+			int mhz = static_cast<int>((khz + 500) / 1000);
+			if (mhz > peakMhz)
+				peakMhz = mhz;
+			if (mhz >= 2500)
+				big++;
+			if (mhz >= 2000)
+				perf++;
+		}
+	}
+	if (peakMhz > 0) {
+		p.max_freq_mhz = peakMhz;
+		p.big_cores = big;
+		p.perf_cores = perf;
+		char cbuf[96];
+		std::snprintf(cbuf, sizeof(cbuf), "%d núcleos (máx %.2f GHz)", p.cpu_cores, peakMhz / 1000.0);
+		p.cpu_clusters = cbuf;
+	}
+
+	if (obs_initialized()) {
+		obs_enter_graphics();
+		const char *ren = reinterpret_cast<const char *>(glGetString(GL_RENDERER));
+		const char *ven = reinterpret_cast<const char *>(glGetString(GL_VENDOR));
+		const char *ver = reinterpret_cast<const char *>(glGetString(GL_VERSION));
+		if (ren && *ren)
+			p.gpu_renderer = ren;
+		if (ven && *ven)
+			p.gpu_vendor = ven;
+		if (ver && *ver)
+			p.gles_version = ver;
+		obs_leave_graphics();
+	}
+
+	if (p.ram_total_mb >= 7200 && p.max_freq_mhz >= 2800) {
+		p.tier = 4;
+		p.tier_label = "Gama Alta (Ultra · 1080p60 GPU Zero-Copy)";
+	} else if (p.ram_total_mb >= 5200 && p.max_freq_mhz >= 2200) {
+		p.tier = 3;
+		p.tier_label = "Gama Media-Alta (1080p30 / 720p60 GPU)";
+	} else if (p.ram_total_mb >= 3500) {
+		p.tier = 2;
+		p.tier_label = "Gama Media (720p30 Equilibrado)";
+	} else {
+		p.tier = 1;
+		p.tier_label = "Modo Ligero / Ahorro (540p/720p 30 FPS)";
+	}
+}
