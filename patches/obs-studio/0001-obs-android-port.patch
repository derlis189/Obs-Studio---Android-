+
+static inline bool check_path(const char *data, const char *base_path, string &output)
+{
+	if (!base_path || !*base_path || !data)
+		return false;
+
+	ostringstream str;
+	str << base_path;
+	if (base_path[strlen(base_path) - 1] != '/')
+		str << '/';
+	str << data;
+	output = str.str();
+
+	blog(LOG_DEBUG, "Attempted path: %s", output.c_str());
+
+	return (access(output.c_str(), R_OK) == 0);
+}
+
+bool GetDataFilePath(const char *data, string &output)
+{
+	const char *env_data_path = getenv("OBS_DATA_PATH");
+	if (env_data_path && check_path(data, env_data_path, output))
+		return true;
+
+	const char *files_dir = obs_android_files_path();
+	if (files_dir) {
+		string frontend_dir = string(files_dir) + "/obs-studio";
+		if (check_path(data, frontend_dir.c_str(), output))
+			return true;
+		if (check_path(data, files_dir, output))
+			return true;
+	}
+
+	const char *data_dir = obs_android_data_path();
+	if (data_dir) {
+		string frontend_dir = string(data_dir) + "/obs-studio";
+		if (check_path(data, frontend_dir.c_str(), output))
+			return true;
+		if (check_path(data, data_dir, output))
+			return true;
+	}
+
+	return false;
+}
+
+string GetDefaultVideoSavePath()
+{
+	void *h = FindAndroidJniHandle();
+	using DefaultRecFn = bool (*)(char *, size_t);
+	auto fn = reinterpret_cast<DefaultRecFn>(dlsym(h, "obs_android_get_default_recording_path"));
+	if (fn) {
+		char buf[1024] = {};
+		if (fn(buf, sizeof(buf)) && buf[0])
+			return string(buf);
+	}
+	const char *files_dir = obs_android_files_path();
+	if (files_dir && *files_dir)
+		return string(files_dir);
+	const char *home = getenv("HOME");
+	return home ? string(home) : string("/data/local/tmp");
+}
