+		if (PickAndSaveVerticalBackground(mainWindow ? mainWindow : w, picked)) {
+			auto cfg = LoadMultiConfig();
+			cfg["vertical"]["background"] = picked.toStdString();
+			SaveMultiConfig(cfg);
+			SyncVerticalToCurrentMainScene();
+			syncDock();
+		}
+	});
+	QObject::connect(chkGuides, &QCheckBox::toggled, w, [=]() { syncDock(); });
+	QObject::connect(btnLive, &QPushButton::clicked, w, [=]() {
+		ToggleVerticalStream(mainWindow ? mainWindow : w, true);
+		syncDock();
+	});
+	QObject::connect(btnRec, &QPushButton::clicked, w, [=]() {
+		ToggleVerticalRecord(mainWindow ? mainWindow : w);
+		syncDock();
+	});
+	QObject::connect(btnClip, &QPushButton::clicked, w, [=]() {
+		if (!IsVerticalBacktrackActive()) {
+			ToggleVerticalBacktrack(mainWindow ? mainWindow : w);
+		} else {
+			SaveVerticalBacktrackClip(mainWindow ? mainWindow : w);
+		}
+		syncDock();
+	});
+	QObject::connect(btnCfg, &QPushButton::clicked, w, [=]() {
+		OpenMultistreamAndVerticalDialog(mainWindow ? mainWindow : w, false);
+	});
+
+	auto *tmr = new QTimer(w);
+	tmr->setInterval(500);
+	QObject::connect(tmr, &QTimer::timeout, w, [=, wasVis = false]() mutable {
+		const bool vis = w->isVisible();
+		if (vis || wasVis) {
+			wasVis = vis;
+			syncDock();
+		}
+	});
+	tmr->start();
+	return w;
+}
+
+struct BugSlot {
+	QString uuid;
+	QString sourceName;
+	QString filePath;
+	bool isVideo = false;
+	int x = 86;
+	int y = 12;
+	int width = 20;
+	int height = 20;
+	bool visible = false;
+
+	bool hasContent() const { return !uuid.isEmpty() || !sourceName.isEmpty() || !filePath.isEmpty(); }
+};
+
+// The main canvas renders channels in order. Channels 1–6 are reserved for global audio.
+constexpr uint32_t kBugOutputChannel = 63;
+std::array<BugSlot, 4> bugSlots;
+std::array<OBSSource, 4> bugPrivateSources;
+std::array<QString, 4> bugPrivateSourcePaths;
+std::array<QPointer<QPushButton>, 4> bugButtons;
+OBSScene bugScene;
+
+std::string BugConfigFilePath()
+{
+	const char *files = obs_android_files_path();
+	if (!files || !*files)
+		files = getenv("OBS_ANDROID_FILES_PATH");
+	std::string dir = files ? (std::string(files) + "/obs-studio") : "/data/local/tmp";
+	QDir().mkpath(QString::fromStdString(dir));
+	return dir + "/android-bugs.json";
+}
+
+void SaveBugConfigFile()
+{
+	nlohmann::json arr = nlohmann::json::array();
+	for (const auto &slot : bugSlots) {
+		arr.push_back({{"source", slot.uuid.toStdString()},
+			       {"sourceName", slot.sourceName.toStdString()},
+			       {"filePath", slot.filePath.toStdString()},
+			       {"isVideo", slot.isVideo},
+			       {"x", slot.x},
+			       {"y", slot.y},
+			       {"width", slot.width},
+			       {"height", slot.height},
+			       {"visible", slot.visible}});
+	}
+	WriteConfigAtomically(BugConfigFilePath(), nlohmann::json{{"slots", arr}});
+}
+
+bool LoadBugSlotsFromDisk()
+{
+	std::ifstream f(BugConfigFilePath());
+	if (!f.is_open())
+		return false;
+	try {
+		auto parsed = nlohmann::json::parse(f);
+		if (!parsed.contains("slots") || !parsed["slots"].is_array())
+			return false;
+		const auto &arr = parsed["slots"];
+		bool anyLoaded = false;
+		for (size_t i = 0; i < bugSlots.size() && i < arr.size(); ++i) {
+			if (!arr[i].is_object())
+				continue;
+			auto &slot = bugSlots[i];
+			slot = {};
+			slot.uuid = QString::fromStdString(arr[i].value("source", ""));
+			slot.sourceName = QString::fromStdString(arr[i].value("sourceName", ""));
+			slot.filePath = QString::fromStdString(arr[i].value("filePath", ""));
+			slot.isVideo = arr[i].value("isVideo", false);
+			slot.x = std::clamp(arr[i].value("x", 86), 0, 100);
+			slot.y = std::clamp(arr[i].value("y", 12), 0, 100);
+			slot.width = std::clamp(arr[i].value("width", 20), 1, 100);
+			slot.height = std::clamp(arr[i].value("height", 20), 1, 100);
+			slot.visible = arr[i].value("visible", false);
+			if (slot.hasContent())
+				anyLoaded = true;
+		}
+		return anyLoaded;
+	} catch (...) {
+		return false;
+	}
+}
+
+OBSSource ResolveBugSource(size_t index, bool allowCreate)
+{
+	if (index >= bugSlots.size())
+		return {};
+	const auto &slot = bugSlots[index];
+	if (!slot.uuid.isEmpty()) {
+		OBSSourceAutoRelease byUuid = obs_get_source_by_uuid(QT_TO_UTF8(slot.uuid));
+		if (byUuid)
+			return OBSSource(byUuid.Get());
+	}
+	if (!slot.sourceName.isEmpty()) {
+		OBSSourceAutoRelease byName = obs_get_source_by_name(QT_TO_UTF8(slot.sourceName));
+		if (byName)
+			return OBSSource(byName.Get());
+	}
+	if (!slot.filePath.isEmpty() && QFile::exists(slot.filePath)) {
+		if (bugPrivateSources[index] && bugPrivateSourcePaths[index] == slot.filePath)
+			return bugPrivateSources[index];
+		if (!allowCreate)
+			return {};
+		OBSDataAutoRelease settings = obs_data_create();
+		obs_data_set_string(settings, slot.isVideo ? "local_file" : "file", QT_TO_UTF8(slot.filePath));
+		if (slot.isVideo) {
+			obs_data_set_bool(settings, "is_local_file", true);
+			obs_data_set_bool(settings, "looping", true);
+			obs_data_set_bool(settings, "restart_on_activate", true);
+			obs_data_set_bool(settings, "close_when_inactive", true);
+		} else {
+			obs_data_set_bool(settings, "unload", false);
+		}
+		const QString title = QStringLiteral("Mosca %1").arg(index + 1);
+		OBSSourceAutoRelease created;
+		if (slot.isVideo) {
+			created = obs_source_create_private("android_hw_video", QT_TO_UTF8(title), settings);
+			if (!created)
+				created = obs_source_create_private("ffmpeg_source", QT_TO_UTF8(title), settings);
+			if (created)
+				obs_source_set_muted(created, true);
+		} else {
+			created = obs_source_create_private("image_source", QT_TO_UTF8(title), settings);
+		}
+		if (created) {
+			bugPrivateSources[index] = created.Get();
+			bugPrivateSourcePaths[index] = slot.filePath;
+			return bugPrivateSources[index];
+		}
+	}
+	return {};
+}
+
+void RefreshBugButtons()
+{
+	for (size_t i = 0; i < bugButtons.size(); ++i) {
+		auto *button = bugButtons[i].data();
+		if (!button)
+			continue;
+		const auto &slot = bugSlots[i];
+		OBSSource src = ResolveBugSource(i, false);
+		const bool assigned = (src != nullptr) || (!slot.filePath.isEmpty() && QFile::exists(slot.filePath));
+		button->setChecked(assigned && slot.visible);
+		button->setProperty("bugAssigned", assigned);
+		button->style()->unpolish(button);
+		button->style()->polish(button);
+		QString title = QStringLiteral("Sin asignar");
+		if (src)
+			title = QString::fromUtf8(obs_source_get_name(src));
+		else if (!slot.filePath.isEmpty())
+			title = QFileInfo(slot.filePath).fileName();
+		button->setToolTip(QStringLiteral("%1 · Un toque: mostrar/ocultar. Doble toque: ajustar.").arg(title));
+		button->setAccessibleName(QStringLiteral("Mosca %1 · %2").arg(i + 1).arg(title));
+	}
+}
+
+obs_sceneitem_t *FindBugItem(obs_scene_t *scene, size_t index)
+{
+	struct Lookup {
+		int64_t key;
+		obs_sceneitem_t *item{};
+	} lookup{int64_t(index) + 1};
+	obs_scene_enum_items(scene, [](obs_scene_t *, obs_sceneitem_t *item, void *opaque) {
+		auto &lookup = *static_cast<Lookup *>(opaque);
+		OBSDataAutoRelease info = obs_sceneitem_get_private_settings(item);
+		if (obs_data_get_int(info, "android_bug_slot") != lookup.key)
+			return true;
+		lookup.item = item;
+		return false;
+	}, &lookup);
+	return lookup.item;
+}
+
+void ClearBugLayer()
+{
+	if (bugScene) {
+		obs_set_output_source(kBugOutputChannel, nullptr);
+		bugScene = nullptr;
+	}
+	for (size_t i = 0; i < bugPrivateSources.size(); ++i) {
+		bugPrivateSources[i] = nullptr;
+		bugPrivateSourcePaths[i].clear();
+	}
+}
+
+bool ApplyBugSlot(size_t index)
+{
+	const auto &slot = bugSlots[index];
+	OBSSource content = ResolveBugSource(index, true);
+	if (slot.hasContent() && !content)
+		return false;
+	if (!bugScene && content) {
+		OBSSceneAutoRelease created = obs_scene_create_private("OBS Android · Moscas");
+		if (!created)
+			return false;
+		bugScene = created.Get();
+		obs_set_output_source(kBugOutputChannel, obs_scene_get_source(bugScene));
+	}
+	if (!bugScene)
+		return true;
+
+	auto *oldItem = FindBugItem(bugScene, index);
+	auto *item = oldItem;
+	if (content && (!oldItem || obs_sceneitem_get_source(oldItem) != content.Get())) {
+		item = obs_scene_add(bugScene, content);
+		if (!item)
+			return false;
+		OBSDataAutoRelease info = obs_sceneitem_get_private_settings(item);
+		obs_data_set_int(info, "android_bug_slot", int64_t(index) + 1);
+	}
+	if (oldItem && (oldItem != item || !content))
+		obs_sceneitem_remove(oldItem);
+	if (!content) {
+		bugPrivateSources[index] = nullptr;
+		bugPrivateSourcePaths[index].clear();
+		return true;
+	}
+
+	struct obs_video_info video{};
+	if (obs_get_video_info(&video)) {
+		const float w = float(video.base_width);
+		const float h = float(video.base_height);
+		obs_transform_info frame{};
+		vec2_set(&frame.pos, w * slot.x / 100.0f, h * slot.y / 100.0f);
+		vec2_set(&frame.bounds, w * slot.width / 100.0f, h * slot.height / 100.0f);
+		vec2_set(&frame.scale, 1, 1);
+		frame.alignment = OBS_ALIGN_CENTER;
+		frame.bounds_alignment = OBS_ALIGN_CENTER;
+		frame.bounds_type = OBS_BOUNDS_SCALE_INNER;
+		obs_sceneitem_set_info2(item, &frame);
+	}
+	obs_sceneitem_set_visible(item, slot.visible);
+	// Higher numbers always appear above lower ones.
+	for (size_t i = 0; i < bugSlots.size(); ++i)
+		if (auto *ordered = FindBugItem(bugScene, i))
+			obs_sceneitem_set_order(ordered, OBS_ORDER_MOVE_TOP);
+	return true;
+}
+
+void RestoreAllBugSlots()
+{
+	ClearBugLayer();
+	for (size_t i = 0; i < bugSlots.size(); ++i)
+		if (bugSlots[i].hasContent())
+			ApplyBugSlot(i);
+	RefreshBugButtons();
+}
+
+void SaveBugSlots(obs_data_t *document, bool saving, void *)
+{
+	if (saving) {
+		OBSDataArrayAutoRelease entries = obs_data_array_create();
+		for (const auto &slot : bugSlots) {
+			OBSDataAutoRelease entry = obs_data_create();
+			obs_data_set_string(entry, "source", QT_TO_UTF8(slot.uuid));
+			obs_data_set_string(entry, "sourceName", QT_TO_UTF8(slot.sourceName));
+			obs_data_set_string(entry, "filePath", QT_TO_UTF8(slot.filePath));
+			obs_data_set_bool(entry, "isVideo", slot.isVideo);
+			obs_data_set_int(entry, "x", slot.x);
+			obs_data_set_int(entry, "y", slot.y);
+			obs_data_set_int(entry, "width", slot.width);
+			obs_data_set_int(entry, "height", slot.height);
+			obs_data_set_bool(entry, "visible", slot.visible);
+			obs_data_array_push_back(entries, entry);
+		}
+		obs_data_set_array(document, "android_bug_slots", entries);
+		SaveBugConfigFile();
+		return;
+	}
+	bool docHasAny = false;
+	std::array<BugSlot, 4> docSlots;
+	OBSDataArrayAutoRelease entries = obs_data_get_array(document, "android_bug_slots");
+	for (size_t i = 0; i < docSlots.size(); ++i) {
+		auto &slot = docSlots[i];
+		slot = {};
+		if (i >= obs_data_array_count(entries))
+			continue;
+		OBSDataAutoRelease entry = obs_data_array_item(entries, i);
+		slot.uuid = QString::fromUtf8(obs_data_get_string(entry, "source"));
+		slot.sourceName = QString::fromUtf8(obs_data_get_string(entry, "sourceName"));
+		slot.filePath = QString::fromUtf8(obs_data_get_string(entry, "filePath"));
+		slot.isVideo = obs_data_get_bool(entry, "isVideo");
+		slot.x = int(std::clamp<int64_t>(obs_data_get_int(entry, "x"), 0, 100));
+		slot.y = int(std::clamp<int64_t>(obs_data_get_int(entry, "y"), 0, 100));
+		slot.width = int(std::clamp<int64_t>(obs_data_get_int(entry, "width"), 1, 100));
+		slot.height = int(std::clamp<int64_t>(obs_data_get_int(entry, "height"), 1, 100));
+		slot.visible = obs_data_get_bool(entry, "visible");
+		if (slot.hasContent())
+			docHasAny = true;
+	}
+	if (docHasAny) {
+		bugSlots = docSlots;
+		SaveBugConfigFile();
+	} else {
+		LoadBugSlotsFromDisk();
+	}
+	RestoreAllBugSlots();
+}
+
+void ConfigureBugSlot(QWidget *parent, size_t index)
+{
+	auto &slot = bugSlots[index];
+	QDialog dialog(parent);
+	dialog.setWindowTitle(QStringLiteral("Mosca global %1").arg(index + 1));
+	auto *form = new QFormLayout(&dialog);
+	auto *sourcePicker = new QComboBox(&dialog);
+	sourcePicker->addItem(QStringLiteral("Sin asignar"));
+	obs_enum_sources([](void *data, obs_source_t *source) {
+		auto *picker = static_cast<QComboBox *>(data);
+		const auto flags = obs_source_get_output_flags(source);
+		if ((flags & OBS_SOURCE_VIDEO) && !obs_scene_from_source(source) && !obs_group_from_source(source))
+			picker->addItem(QString::fromUtf8(obs_source_get_name(source)), QString::fromUtf8(obs_source_get_uuid(source)));
+		return true;
+	}, sourcePicker);
+	sourcePicker->setCurrentIndex(std::max(0, sourcePicker->findData(slot.uuid)));
+	form->addRow(QStringLiteral("Contenido"), sourcePicker);
+	auto *filters = new QPushButton(QStringLiteral("Filtros del contenido"), &dialog);
+	filters->setEnabled(sourcePicker->currentIndex() > 0 || !slot.filePath.isEmpty());
+	QObject::connect(sourcePicker, &QComboBox::currentIndexChanged, filters,
+			 [filters, &slot](int selected) { filters->setEnabled(selected > 0 || !slot.filePath.isEmpty()); });
+	QObject::connect(filters, &QPushButton::clicked, &dialog, [&] {
+		OBSSource content;
+		if (sourcePicker->currentIndex() > 0) {
+			OBSSourceAutoRelease s = obs_get_source_by_uuid(QT_TO_UTF8(sourcePicker->currentData().toString()));
+			content = s.Get();
+		} else {
+			content = ResolveBugSource(index, true);
+		}
+		if (content) {
+			OBSBasicFilters popup(&dialog, content.Get());
+			popup.exec();
+		}
+	});
+	form->addRow(filters);
+	auto *load = new QPushButton(
+		slot.filePath.isEmpty() ? QStringLiteral("Cargar imagen o video…")
+					: QStringLiteral("Archivo: %1 (Cambiar…)").arg(QFileInfo(slot.filePath).fileName()),
+		&dialog);
+	QString path;
+	bool clearFile = false;
+	QObject::connect(load, &QPushButton::clicked, &dialog, [&] {
+		const QString picked = OpenFile(&dialog, QStringLiteral("Cargar mosca"), QString(),
+						QStringLiteral("Imagen o video (*.png *.webp *.jpg *.jpeg *.bmp *.mp4 *.mov *.webm *.mkv)"));
+		if (picked.isEmpty())
+			return;
+		path = picked;
+		clearFile = false;
+		sourcePicker->setCurrentIndex(0);
+		load->setText(QFileInfo(path).fileName());
+	});
+	QObject::connect(sourcePicker, &QComboBox::activated, &dialog, [&] {
+		path.clear();
+		clearFile = true;
+		load->setText(QStringLiteral("Cargar imagen o video…"));
+	});
+	form->addRow(load);
+	auto spin = [&](const QString &text, int low, int value) {
+		auto *control = new QSpinBox(&dialog);
+		control->setRange(low, 100);
+		control->setSuffix(QStringLiteral(" %"));
+		control->setValue(value);
+		form->addRow(text, control);
+		return control;
+	};
+	auto *x = spin(QStringLiteral("Centro X"), 0, slot.x);
+	auto *y = spin(QStringLiteral("Centro Y"), 0, slot.y);
+	auto *w = spin(QStringLiteral("Ancho"), 1, slot.width);
+	auto *h = spin(QStringLiteral("Alto"), 1, slot.height);
+	auto *buttons = new QDialogButtonBox(QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
+	QObject::connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+	QObject::connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+	form->addRow(buttons);
+	if (dialog.exec() != QDialog::Accepted)
+		return;
+
+	const BugSlot previous = slot;
+	BugSlot next = slot;
+	next.x = x->value();
+	next.y = y->value();
+	next.width = w->value();
+	next.height = h->value();
+
+	if (!path.isEmpty()) {
+		const auto suffix = QFileInfo(path).suffix().toLower();
+		const bool video = suffix == "mp4" || suffix == "mov" || suffix == "webm" || suffix == "mkv";
+		const char *files = obs_android_files_path();
+		const QString folder = files ? QString::fromUtf8(files) + "/obs-studio/overlay-media" : QString();
+		const QString tag = QUuid::createUuid().toString(QUuid::WithoutBraces);
+		const QString permanent = folder + "/" + tag + "." + suffix;
+		if (folder.isEmpty() || !QDir().mkpath(folder) || !QFile::copy(path, permanent)) {
+			OBSMessageBox::warning(parent, QStringLiteral("Mosca"), QStringLiteral("No se pudo guardar el archivo seleccionado."));
+			return;
+		}
+		next.uuid.clear();
+		next.sourceName.clear();
+		next.filePath = permanent;
+		next.isVideo = video;
+		next.visible = previous.hasContent() ? previous.visible : true;
+	} else if (sourcePicker->currentIndex() > 0) {
+		next.uuid = sourcePicker->currentData().toString();
+		next.sourceName = sourcePicker->currentText();
+		next.filePath.clear();
+		next.isVideo = false;
+		next.visible = previous.hasContent() ? previous.visible : true;
+	} else if (clearFile) {
+		next.uuid.clear();
+		next.sourceName.clear();
+		next.filePath.clear();
+		next.isVideo = false;
+		next.visible = false;
+	} else {
+		next.visible = previous.visible && next.hasContent();
+	}
+
+	slot = next;
+	if (!ApplyBugSlot(index)) {
+		slot = previous;
+		OBSMessageBox::warning(parent, QStringLiteral("Mosca"),
+				       QStringLiteral("No se pudo agregar el contenido al Programa."));
+		return;
+	}
+	RefreshBugButtons();
+	SaveBugConfigFile();
+	SaveAllObsStateOnGuiThread();
+}
