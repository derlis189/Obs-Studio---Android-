+	if (baseDir.isEmpty())
+		baseDir = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+	QDir cacheDir(baseDir + QStringLiteral("/obs-media-cache"));
+	cacheDir.mkpath(QStringLiteral("."));
