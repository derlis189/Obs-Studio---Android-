+void InstallUndoButtonAndTouchDocks(QWidget *mainWindow)
+{
+	if (!mainWindow)
+		return;
+
+	// 1) Touch-friendly dock separators, splitters & docked tab bars
+	const QString touchCss = QStringLiteral(
+		"\nQMainWindow::separator { width: 9px; height: 9px; background: rgba(148, 163, 184, 0.24); border-radius: 4px; }"
+		"\nQMainWindow::separator:hover, QMainWindow::separator:pressed { background: rgba(59, 130, 246, 0.78); }"
+		"\nQSplitter::handle { width: 9px; height: 9px; background: rgba(148, 163, 184, 0.24); border-radius: 4px; }"
+		"\nQSplitter::handle:pressed { background: rgba(59, 130, 246, 0.78); }"
+		"\nQTabBar::tab { min-height: 24px; padding: 3px 10px; }\n");
+	if (qApp) {
+		qApp->setStyleSheet(qApp->styleSheet() + touchCss);
+	}
+
+	// Protect the central Preview/Program canvas and hard-clamp QMainWindow to physical screen bounds
+	if (auto *mw = qobject_cast<QMainWindow *>(mainWindow)) {
+		if (QWidget *cw = mw->centralWidget()) {
+			cw->setMinimumSize(40, 40);
+			cw->setSizePolicy(QSizePolicy::Ignored, QSizePolicy::Ignored);
+		}
+		mw->installEventFilter(new AndroidScreenClampFilter(mw));
+		if (QScreen *scr = QGuiApplication::primaryScreen()) {
+			QObject::connect(scr, &QScreen::availableGeometryChanged, mw,
+					 [mw](const QRect &) { ClampMainWindowToScreen(mw); });
+			QObject::connect(scr, &QScreen::geometryChanged, mw,
+					 [mw](const QRect &) { ClampMainWindowToScreen(mw); });
+		}
+		ClampMainWindowToScreen(mw);
+	}
+
+	// 2) Add "Deshacer" button right below "Ajustes" in the Controls dock
+	QTimer::singleShot(450, mainWindow, [mainWindow]() {
+		QDockWidget *ctrlDock = mainWindow->findChild<QDockWidget *>(QStringLiteral("controlsDock"));
+		QAction *undoAct = mainWindow->findChild<QAction *>(QStringLiteral("actionMainUndo"));
+		if (ctrlDock && ctrlDock->widget() && undoAct) {
+			QWidget *ctrlW = ctrlDock->widget();
+			if (!ctrlW->findChild<QPushButton *>(QStringLiteral("androidUndoButton"))) {
+				auto *btnUndo = new QPushButton(QStringLiteral("Deshacer"), ctrlW);
+				btnUndo->setObjectName(QStringLiteral("androidUndoButton"));
+				btnUndo->setEnabled(undoAct->isEnabled());
+				QObject::connect(btnUndo, &QPushButton::clicked, undoAct, &QAction::trigger);
+				QObject::connect(undoAct, &QAction::changed, btnUndo, [btnUndo, undoAct]() {
+					btnUndo->setEnabled(undoAct->isEnabled());
+				});
+				if (auto *vbox = qobject_cast<QVBoxLayout *>(ctrlW->layout())) {
+					QPushButton *settingsBtn = ctrlW->findChild<QPushButton *>(QStringLiteral("settingsButton"));
+					int insertIdx = settingsBtn ? (vbox->indexOf(settingsBtn) + 1) : vbox->count();
+					if (insertIdx < 0 || insertIdx > vbox->count())
+						insertIdx = vbox->count();
+					vbox->insertWidget(insertIdx, btnUndo);
+				}
+			}
+		}
+
+		// 3) Unlock docks so panels can be shrunk/enlarged with touch, and relax dock minimum sizes
+		if (QAction *lockAct = mainWindow->findChild<QAction *>(QStringLiteral("lockDocks"))) {
+			if (lockAct->isChecked())
+				lockAct->trigger();
+		}
+		for (QDockWidget *dock : mainWindow->findChildren<QDockWidget *>()) {
+			HardenAndroidDock(dock);
+		}
+		ClampMainWindowToScreen(mainWindow);
+	});
+}
