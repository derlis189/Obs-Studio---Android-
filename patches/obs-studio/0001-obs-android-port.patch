+void *FindAndroidJniHandle()
+{
+	void *h = dlopen("libobs-android-jni.so", RTLD_NOW | RTLD_NOLOAD);
+	if (!h) {
+		const char *libs = obs_android_libraries_path();
+		if (!libs || !*libs)
+			libs = getenv("OBS_ANDROID_LIBRARIES_PATH");
+		if (libs && *libs) {
+			string full = string(libs) + "/libobs-android-jni.so";
+			h = dlopen(full.c_str(), RTLD_NOW | RTLD_NOLOAD);
+			if (!h)
+				h = dlopen(full.c_str(), RTLD_NOW | RTLD_LOCAL);
+		}
+	}
+	if (!h)
+		h = dlopen("libobs-android-jni.so", RTLD_NOW | RTLD_LOCAL);
+	return h ? h : RTLD_DEFAULT;
+}
+
+void OnNativeTextInputCallback(int64_t reqId, bool accepted, const char *textUtf8)
+{
+	QString value = QString::fromUtf8(textUtf8 ? textUtf8 : "");
+	QCoreApplication *app = QCoreApplication::instance();
+	if (!app)
+		return;
+	QMetaObject::invokeMethod(
+		app,
+		[reqId, accepted, value]() {
+			if (reqId != g_activeReqId)
+				return;
+			g_textDialogOpen = false;
+			if (accepted && g_activeLineEdit) {
+				g_activeLineEdit->setText(value);
+				emit g_activeLineEdit->textEdited(value);
+				emit g_activeLineEdit->editingFinished();
+			}
+			g_activeLineEdit = nullptr;
+		},
+		Qt::QueuedConnection);
+}
