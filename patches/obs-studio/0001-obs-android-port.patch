+bool CopyDirRecursive(const QString &srcPath, const QString &dstPath)
+{
+	QDir srcDir(srcPath);
+	if (!srcDir.exists())
+		return false;
+	if (!QDir().mkpath(dstPath))
+		return false;
+	const auto entries = srcDir.entryInfoList(QDir::NoDotAndDotDot | QDir::AllEntries | QDir::Hidden);
+	for (const QFileInfo &fi : entries) {
+		const QString dstItem = dstPath + "/" + fi.fileName();
+		if (fi.isDir()) {
+			if (!CopyDirRecursive(fi.absoluteFilePath(), dstItem))
+				return false;
+		} else if (fi.isFile()) {
+			if (QFile::exists(dstItem))
+				QFile::remove(dstItem);
+			if (!QFile::copy(fi.absoluteFilePath(), dstItem))
+				return false;
+		}
+	}
+	return true;
+}
