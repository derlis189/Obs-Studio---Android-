+void OBSQTDisplay::CleanupAndroidGL()
+{
+	if (glTex) {
+		glBindTexture(GL_TEXTURE_2D, 0);
+	}
+	if (!eglImageCache.empty()) {
+		for (auto &kv : eglImageCache) {
+			if (kv.second && eglDisplay && g_destroyImage) {
+				g_destroyImage(static_cast<EGLDisplay>(eglDisplay), static_cast<EGLImageKHR>(kv.second));
+			}
+			if (kv.first) {
+				AHardwareBuffer_release(kv.first);
+			}
+		}
+		eglImageCache.clear();
+	}
+	if (glTex) {
+		glDeleteTextures(1, &glTex);
+		glTex = 0;
+	}
+	delete glProgram;
+	glProgram = nullptr;
+}
