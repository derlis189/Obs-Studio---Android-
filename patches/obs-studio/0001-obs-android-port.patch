+void OBSBasicProperties::SetupMovePreview()
+{
+	auto *panel = new QWidget(this);
+	auto *layout = new QGridLayout(panel);
+	layout->setContentsMargins(0, 4, 0, 4);
+	moveSceneA = new QComboBox(panel);
+	moveSceneB = new QComboBox(panel);
+	movePreviewDuration = new QSpinBox(panel);
+	movePreviewDuration->setRange(50, 20000);
+	movePreviewDuration->setSuffix(QStringLiteral(" ms"));
+	movePreviewDuration->setValue(900);
+	for (auto *combo : {moveSceneA, moveSceneB}) {
+		combo->addItem(QStringLiteral("Demostración"), QString());
+		combo->setSizeAdjustPolicy(QComboBox::AdjustToMinimumContentsLengthWithIcon);
+		combo->setMinimumContentsLength(8);
+		combo->setMinimumWidth(0);
+		obs_enum_scenes([](void *param, obs_source_t *scene) {
+			auto *combo = static_cast<QComboBox *>(param);
+			combo->addItem(QT_UTF8(obs_source_get_name(scene)), QT_UTF8(obs_source_get_uuid(scene)));
+			return true;
+		}, combo);
+	}
+	layout->addWidget(new QLabel(QStringLiteral("Desde"), panel), 0, 0);
+	layout->addWidget(moveSceneA, 0, 1);
+	layout->addWidget(new QLabel(QStringLiteral("Hacia"), panel), 0, 2);
+	layout->addWidget(moveSceneB, 0, 3);
+	layout->addWidget(new QLabel(QStringLiteral("Prueba"), panel), 1, 0);
+	layout->addWidget(movePreviewDuration, 1, 1);
+	auto *help = new QLabel(QStringLiteral("La prueba se muestra aquí. El Programa conserva su escena."), panel);
+	help->setWordWrap(true);
+	layout->addWidget(help, 1, 2, 1, 2);
+	moveMatches = new QLabel(panel);
+	moveMatches->setTextFormat(Qt::PlainText);
+	moveMatches->setWordWrap(true);
+	moveMatches->setMaximumHeight(90);
+	moveMatches->setToolTip(QStringLiteral("Usa Agregar existente en las dos escenas para compartir una fuente."));
+	layout->addWidget(moveMatches, 2, 0, 1, 4);
+	ui->propertiesLayout->insertWidget(0, panel);
+
+	// A shared colored tile makes the demonstration show real geometry motion.
+	OBSDataAutoRelease tileSettings = obs_data_create();
+	obs_data_set_int(tileSettings, "width", 320);
+	obs_data_set_int(tileSettings, "height", 180);
+	obs_data_set_int(tileSettings, "color", 0xff40b8ff);
+	OBSSourceAutoRelease tile = obs_source_create_private("color_source_v3", "Move: fuente compartida", tileSettings);
+	if (tile) {
+		auto *a = obs_scene_add(obs_scene_from_source(sourceA), tile);
+		auto *b = obs_scene_add(obs_scene_from_source(sourceB), tile);
+		vec2 posA{}, posB{}, scaleA{}, scaleB{};
+		vec2_set(&posA, 80.0f, 80.0f);
+		vec2_set(&posB, float(obs_source_get_width(sourceB)) * 0.65f,
+			 float(obs_source_get_height(sourceB)) * 0.65f);
+		vec2_set(&scaleA, 1.5f, 1.5f);
+		vec2_set(&scaleB, 0.6f, 0.6f);
+		obs_sceneitem_set_pos(a, &posA);
+		obs_sceneitem_set_pos(b, &posB);
+		obs_sceneitem_set_scale(a, &scaleA);
+		obs_sceneitem_set_scale(b, &scaleB);
+	}
+	connect(moveSceneA, &QComboBox::currentIndexChanged, this, [this]() { RefreshMovePreview(); });
+	connect(moveSceneB, &QComboBox::currentIndexChanged, this, [this]() { RefreshMovePreview(); });
+	ui->transitionButton->setText(QStringLiteral("Probar Move"));
+	RefreshMovePreview();
+}
+
+void OBSBasicProperties::RefreshMovePreview()
+{
+	// The demo sources remain owned by sourceA/B; real scene references are
+	// resolved by UUID on each click so deleted/renamed scenes cannot dangle.
+	OBSSourceAutoRelease a = obs_get_source_by_uuid(QT_TO_UTF8(moveSceneA->currentData().toString()));
+	OBSSourceAutoRelease b = obs_get_source_by_uuid(QT_TO_UTF8(moveSceneB->currentData().toString()));
+	if (!a) a = obs_source_get_ref(sourceA);
+	if (!b) b = obs_source_get_ref(sourceB);
+	calldata_t cd{};
+	calldata_set_ptr(&cd, "scene_a", a);
+	calldata_set_ptr(&cd, "scene_b", b);
+	const bool described = proc_handler_call(obs_source_get_proc_handler(sourceClone), "describe_matches", &cd);
+	if (described) {
+		auto names = [&cd](const char *key) {
+			const char *text = calldata_string(&cd, key);
+			return text && *text ? QT_UTF8(text) : QStringLiteral("ninguna");
+		};
+		const QString detail = QStringLiteral("Compartidas: %1\nSalen: %2\nEntran: %3")
+			.arg(names("shared"), names("outgoing"), names("incoming"));
+		moveMatches->setText(detail);
+		moveMatches->setToolTip(detail);
+	}
+	calldata_free(&cd);
+	direction = true;
+	obs_transition_clear(sourceClone);
+	obs_transition_set(sourceClone, a);
+	obs_transition_force_stop(sourceClone);
+}
