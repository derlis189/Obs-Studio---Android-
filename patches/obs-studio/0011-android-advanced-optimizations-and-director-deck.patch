+	auto *hdr = new QLabel(QStringLiteral("DIRECTOR DECK · Botones táctiles en vivo (≥48dp)"), rootW);
+	hdr->setStyleSheet(QStringLiteral("background:#0f172a; color:#e2e8f0; font-weight:bold; padding:8px; border-radius:6px; font-size:12px;"));
+	root->addWidget(hdr);
+
+	// Primary Broadcast Actions (all >=48px tall for one-thumb live operation)
+	auto *actGrid = new QGridLayout();
+	actGrid->setSpacing(8);
+
+	auto makeBigBtn = [rootW](const QString &label, const QString &bg) -> QPushButton * {
+		auto *b = new QPushButton(label, rootW);
+		b->setMinimumHeight(50);
+		b->setStyleSheet(QStringLiteral(
+			"QPushButton { background:%1; color:white; font-weight:bold; font-size:12px; border-radius:8px; padding:6px; }"
+			"QPushButton:pressed { opacity:0.85; }").arg(bg));
+		return b;
+	};
+
+	auto *btnStream = makeBigBtn(QStringLiteral("TRANSMITIR"), QStringLiteral("#1d4ed8"));
+	auto *btnRecord = makeBigBtn(QStringLiteral("GRABAR"), QStringLiteral("#334155"));
+	auto *btnCut = makeBigBtn(QStringLiteral("TRANSICIÓN / CORTE"), QStringLiteral("#0f766e"));
+	auto *btnReplay = makeBigBtn(QStringLiteral("REPLAY 15s (0.5x)"), QStringLiteral("#b45309"));
+	auto *btnTitle = makeBigBtn(QStringLiteral("TÍTULO AL AIRE"), QStringLiteral("#6d28d9"));
+	auto *btnMic = makeBigBtn(QStringLiteral("MIC ACTIVO"), QStringLiteral("#15803d"));
+
+	actGrid->addWidget(btnStream, 0, 0);
+	actGrid->addWidget(btnRecord, 0, 1);
+	actGrid->addWidget(btnCut, 1, 0);
+	actGrid->addWidget(btnReplay, 1, 1);
+	actGrid->addWidget(btnTitle, 2, 0);
+	actGrid->addWidget(btnMic, 2, 1);
+	root->addLayout(actGrid);
+
+	auto *sceneHdr = new QLabel(QStringLiteral("ESCENAS EN VIVO (toca para cambiar):"), rootW);
+	sceneHdr->setStyleSheet(QStringLiteral("color:#94a3b8; font-weight:bold; font-size:11px; margin-top:4px;"));
+	root->addWidget(sceneHdr);
+
+	auto *sceneHost = new QWidget(rootW);
+	auto *sceneGrid = new QGridLayout(sceneHost);
+	sceneGrid->setContentsMargins(0, 0, 0, 0);
+	sceneGrid->setSpacing(8);
+	root->addWidget(sceneHost);
+
+	auto *statusLbl = new QLabel(QStringLiteral("Listo para producción en vivo."), rootW);
+	statusLbl->setWordWrap(true);
+	statusLbl->setStyleSheet(QStringLiteral("color:#cbd5e1; font-size:11px;"));
+	root->addWidget(statusLbl);
+	root->addStretch(1);
+	scroll->setWidget(rootW);
+
+	auto findPrimaryMic = []() -> obs_source_t * {
+		obs_source_t *found = nullptr;
+		obs_enum_sources(
+			[](void *param, obs_source_t *src) {
+				auto **out = static_cast<obs_source_t **>(param);
+				if (*out) return false;
+				const char *id = obs_source_get_unversioned_id(src);
+				if (id && std::strcmp(id, "android_microphone") == 0) {
+					*out = obs_source_get_ref(src);
+					return false;
+				}
+				return true;
+			},
+			&found);
+		return found;
+	};
+
+	auto lastSceneKey = std::make_shared<QString>();
+	auto sceneButtons = std::make_shared<std::vector<std::pair<QString, QPushButton *>>>();
+
+	auto rebuildScenesIfNeeded = [sceneHost, sceneGrid, lastSceneKey, sceneButtons, statusLbl]() {
+		const auto names = GetAllObsSceneNames(false, true);
+		QString key;
+		for (const auto &n : names) key += QString::fromStdString(n) + QChar('\n');
+		if (key == *lastSceneKey) return;
+		*lastSceneKey = key;
+		sceneButtons->clear();
+		while (QLayoutItem *li = sceneGrid->takeAt(0)) {
+			if (QWidget *w = li->widget()) w->deleteLater();
+			delete li;
+		}
+		int idx = 0;
+		for (const auto &n : names) {
+			const QString qn = QString::fromStdString(n);
+			auto *b = new QPushButton(qn, sceneHost);
+			b->setMinimumHeight(52);
+			b->setStyleSheet(QStringLiteral(
+				"QPushButton { background:#1e293b; color:#f8fafc; font-weight:bold; font-size:12px; border:2px solid #334155; border-radius:8px; padding:6px; }"));
+			QObject::connect(b, &QPushButton::clicked, sceneHost, [qn, statusLbl]() {
+				OBSSourceAutoRelease s = obs_get_source_by_name(qn.toUtf8().constData());
+				if (!s) return;
+				if (obs_frontend_preview_program_mode_active()) {
+					obs_frontend_set_current_preview_scene(s);
+					statusLbl->setText(QStringLiteral("Vista previa: %1 (pulsa TRANSICIÓN para mandar al aire)").arg(qn));
