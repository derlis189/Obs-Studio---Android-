+					if (!j.is_discarded()) {
+						badge += QStringLiteral(" · %1°C · Bat %2%")
+							.arg(j.value("temp_c", 0.0), 0, 'f', 1)
+							.arg(j.value("battery", 0));
+					}
+				}
+			}
+		}
+		hdr->setText(badge);
+		hdr->setStyleSheet(live
+			? QStringLiteral("background:#991b1b; color:white; font-weight:bold; padding:8px; border-radius:6px; font-size:12px;")
+			: QStringLiteral("background:#0f172a; color:#e2e8f0; font-weight:bold; padding:8px; border-radius:6px; font-size:12px;"));
+	};
+
+	QObject::connect(btnStream, &QPushButton::clicked, rootW, [refreshDeck]() {
+		if (obs_frontend_streaming_active()) obs_frontend_streaming_stop();
+		else obs_frontend_streaming_start();
+		refreshDeck();
+	});
+	QObject::connect(btnRecord, &QPushButton::clicked, rootW, [refreshDeck]() {
+		if (obs_frontend_recording_active()) obs_frontend_recording_stop();
+		else obs_frontend_recording_start();
+		refreshDeck();
+	});
+	QObject::connect(btnCut, &QPushButton::clicked, rootW, [refreshDeck, statusLbl]() {
+		if (obs_frontend_preview_program_mode_active()) {
+			obs_frontend_preview_program_trigger_transition();
+			statusLbl->setText(QStringLiteral("Transición ejecutada al Programa."));
+		} else {
+			obs_frontend_set_preview_program_mode(true);
+			statusLbl->setText(QStringLiteral("Modo Estudio activado: selecciona vista previa y pulsa TRANSICIÓN."));
+		}
+		refreshDeck();
+	});
+	QObject::connect(btnReplay, &QPushButton::clicked, rootW, [rootW, btnReplay, statusLbl]() {
+		void *jni = FindAndroidJni();
+		if (!jni) return;
+		using SaveFn = bool (*)(int, const char *);
+		auto fn = reinterpret_cast<SaveFn>(dlsym(jni, "obs_android_replay_save_clip"));
+		if (!fn) return;
+		QString dirPath = GetAndroidRecordingsRootDir() + QStringLiteral("/Replays");
+		QDir().mkpath(dirPath);
+		QString outFile = dirPath + QStringLiteral("/Replay_") +
+			QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd_HH-mm-ss")) + QStringLiteral(".mp4");
+		btnReplay->setEnabled(false);
+		statusLbl->setText(QStringLiteral("Guardando repetición de 15s..."));
+		QPointer<QWidget> guard(rootW);
+		QPointer<QPushButton> pBtn(btnReplay);
+		QPointer<QLabel> pSt(statusLbl);
+		std::thread([fn, outFile, guard, pBtn, pSt]() {
+			const bool ok = fn(15, outFile.toUtf8().constData());
+			if (!guard) return;
+			QMetaObject::invokeMethod(guard.data(), [guard, pBtn, pSt, ok, outFile]() {
+				if (!guard) return;
+				if (pBtn) pBtn->setEnabled(true);
+				if (ok) {
+					LaunchReplayFileOnAir(outFile, 50, false);
+					if (pSt) pSt->setText(QStringLiteral("REPETICIÓN 15s (0.5x) AL AIRE"));
+				} else if (pSt) {
+					pSt->setText(QStringLiteral("Activa primero el Búfer de Repetición en Producción en Vivo."));
+				}
+			}, Qt::QueuedConnection);
+		}).detach();
+	});
+	QObject::connect(btnTitle, &QPushButton::clicked, rootW, [refreshDeck, statusLbl]() {
+		auto gfx = GfxGetState();
+		const bool curOn = gfx.contains("advancedTitle") && gfx["advancedTitle"].value("onAir", false);
+		GfxExecute({{"action", "at_update"}, {"onAir", !curOn}});
+		statusLbl->setText(!curOn ? QStringLiteral("Título animado EN AIRE.") : QStringLiteral("Título animado retirado."));
+		refreshDeck();
+	});
+	QObject::connect(btnMic, &QPushButton::clicked, rootW, [findPrimaryMic, refreshDeck, statusLbl]() {
+		if (obs_source_t *mic = findPrimaryMic()) {
+			const bool nextMute = !obs_source_muted(mic);
+			obs_source_set_muted(mic, nextMute);
+			obs_source_release(mic);
+			statusLbl->setText(nextMute ? QStringLiteral("Micrófono silenciado.") : QStringLiteral("Micrófono activado."));
+		} else {
+			statusLbl->setText(QStringLiteral("No hay fuente de Micrófono (Android) en la colección actual."));
+		}
+		refreshDeck();
+	});
+
+	auto *timer = new QTimer(scroll);
+	timer->setInterval(1000);
+	QObject::connect(timer, &QTimer::timeout, scroll, [scroll, refreshDeck]() {
+		if (scroll->isVisible()) refreshDeck();
+	});
+	timer->start();
+	refreshDeck();
+	return scroll;
+}
