+					obs_frontend_set_current_scene(s);
+					statusLbl->setText(QStringLiteral("En vivo: %1").arg(qn));
+				}
+			});
+			sceneGrid->addWidget(b, idx / 2, idx % 2);
+			sceneButtons->emplace_back(qn, b);
+			++idx;
+		}
+	};
+
+	auto refreshDeck = [hdr, btnStream, btnRecord, btnCut, btnTitle, btnMic, rebuildScenesIfNeeded, sceneButtons, findPrimaryMic]() {
+		rebuildScenesIfNeeded();
+		const bool live = obs_frontend_streaming_active();
+		const bool rec = obs_frontend_recording_active();
+		const bool studio = obs_frontend_preview_program_mode_active();
+
+		btnStream->setText(live ? QStringLiteral("EN VIVO · DETENER") : QStringLiteral("TRANSMITIR"));
+		btnStream->setStyleSheet(live
+			? QStringLiteral("QPushButton { background:#dc2626; color:white; font-weight:bold; font-size:12px; border-radius:8px; }")
+			: QStringLiteral("QPushButton { background:#1d4ed8; color:white; font-weight:bold; font-size:12px; border-radius:8px; }"));
+
+		btnRecord->setText(rec ? QStringLiteral("GRABANDO · DETENER") : QStringLiteral("GRABAR"));
+		btnRecord->setStyleSheet(rec
+			? QStringLiteral("QPushButton { background:#dc2626; color:white; font-weight:bold; font-size:12px; border-radius:8px; }")
+			: QStringLiteral("QPushButton { background:#334155; color:white; font-weight:bold; font-size:12px; border-radius:8px; }"));
+
+		btnCut->setText(studio ? QStringLiteral("TRANSICIÓN AL AIRE") : QStringLiteral("ACTIVAR MODO ESTUDIO"));
+
+		QString progName, prevName;
+		if (OBSSourceAutoRelease cur = obs_frontend_get_current_scene()) {
+			if (const char *nm = obs_source_get_name(cur)) progName = QString::fromUtf8(nm);
+		}
+		if (studio) {
+			if (OBSSourceAutoRelease pv = obs_frontend_get_current_preview_scene()) {
+				if (const char *nm = obs_source_get_name(pv)) prevName = QString::fromUtf8(nm);
+			}
+		}
+		for (auto &pair : *sceneButtons) {
+			const bool isProg = (!progName.isEmpty() && pair.first == progName);
+			const bool isPrev = (!isProg && !prevName.isEmpty() && pair.first == prevName);
+			if (isProg) {
+				pair.second->setStyleSheet(QStringLiteral(
+					"QPushButton { background:#16a34a; color:white; font-weight:bold; font-size:12px; border:2px solid #86efac; border-radius:8px; padding:6px; }"));
+			} else if (isPrev) {
+				pair.second->setStyleSheet(QStringLiteral(
+					"QPushButton { background:#ca8a04; color:white; font-weight:bold; font-size:12px; border:2px solid #fde047; border-radius:8px; padding:6px; }"));
+			} else {
+				pair.second->setStyleSheet(QStringLiteral(
+					"QPushButton { background:#1e293b; color:#f8fafc; font-weight:bold; font-size:12px; border:2px solid #334155; border-radius:8px; padding:6px; }"));
+			}
+		}
+
+		if (obs_source_t *mic = findPrimaryMic()) {
+			const bool muted = obs_source_muted(mic);
+			obs_source_release(mic);
+			btnMic->setText(muted ? QStringLiteral("MIC SILENCIADO") : QStringLiteral("MIC ACTIVO"));
+			btnMic->setStyleSheet(muted
+				? QStringLiteral("QPushButton { background:#b91c1c; color:white; font-weight:bold; font-size:12px; border-radius:8px; }")
+				: QStringLiteral("QPushButton { background:#15803d; color:white; font-weight:bold; font-size:12px; border-radius:8px; }"));
+		}
+
+		auto gfx = GfxGetState();
+		const bool titleOn = gfx.contains("advancedTitle") && gfx["advancedTitle"].value("onAir", false);
+		btnTitle->setText(titleOn ? QStringLiteral("TÍTULO: EN AIRE ✓") : QStringLiteral("TÍTULO AL AIRE"));
+		btnTitle->setStyleSheet(titleOn
+			? QStringLiteral("QPushButton { background:#dc2626; color:white; font-weight:bold; font-size:12px; border-radius:8px; }")
+			: QStringLiteral("QPushButton { background:#6d28d9; color:white; font-weight:bold; font-size:12px; border-radius:8px; }"));
+
+		QString badge = live ? QStringLiteral("● EN VIVO") : (rec ? QStringLiteral("● GRABANDO") : QStringLiteral("DIRECTOR DECK"));
+		if (void *jni = FindAndroidJni()) {
