+bool RunRemoteOnGuiThread(std::function<std::string()> action, char *out, size_t capacity)
+{
+    if (!out || !capacity || androidFrontendClosing.load()) return false;
+    auto *app = QCoreApplication::instance();
+    if (!app) return false;
+    std::string text;
+    if (QThread::currentThread() == app->thread()) text = action();
+    else {
+        struct Reply { std::mutex mutex; std::condition_variable ready; std::string text; bool done{}, cancelled{}; };
+        auto reply = std::make_shared<Reply>();
+        QMetaObject::invokeMethod(app, [reply, action = std::move(action)]() {
+            {
+                std::lock_guard<std::mutex> lock(reply->mutex);
+                if (reply->cancelled || androidFrontendClosing.load()) return;
+            }
+            auto text = action();
+            std::lock_guard<std::mutex> lock(reply->mutex);
+            if (reply->cancelled) return;
+            reply->text = std::move(text); reply->done = true;
+            reply->ready.notify_one();
+        }, Qt::QueuedConnection);
+        std::unique_lock<std::mutex> lock(reply->mutex);
+        if (!reply->ready.wait_for(lock, std::chrono::milliseconds(750), [&] { return reply->done; })) {
+            reply->cancelled = true;
+            return false;
+        }
+        text = std::move(reply->text);
+    }
+    if (text.size() >= capacity) return false;
+    std::memcpy(out, text.c_str(), text.size() + 1);
+    return true;
+}
+bool RemoteGetStateBridge(char *out, size_t capacity)
+{
+    return RunRemoteOnGuiThread([] { return BuildStateJsonOnGuiThread(); }, out, capacity);
+}
+bool RemoteExecuteActionBridge(const char *body, char *out, size_t capacity)
+{
+    const std::string input = body ? body : "{}";
+    return RunRemoteOnGuiThread([input] { return ExecuteActionJsonOnGuiThread(input); }, out, capacity);
 }
 
