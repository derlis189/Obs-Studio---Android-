+		server->setText(QString::fromStdString(target.value("server", "")));
+		key->setText(QString::fromStdString(target.value("key", "")));
+		format->setCurrentIndex(target.value("vertical", false) ? 1 : 0);
+		bitrate->setValue(target.value("bitrate", 4000));
