+QStringList AndroidPickStartDestinations(QWidget *parent)
+{
+	const auto cfg = LoadMultiConfig();
+	QDialog picker(parent);
+	picker.setWindowTitle(QStringLiteral("Elegir destinos de transmisión"));
+	auto *layout = new QVBoxLayout(&picker);
+	layout->addWidget(new QLabel(QStringLiteral("Selecciona dónde quieres transmitir:"), &picker));
+	auto *choices = new QListWidget(&picker);
+	choices->setSelectionMode(QAbstractItemView::NoSelection);
+	auto addChoice = [choices](const QString &label, const QString &id, bool active) {
+		auto *item = new QListWidgetItem(label, choices);
+		item->setData(Qt::UserRole, id);
+		item->setFlags(item->flags() | Qt::ItemIsUserCheckable);
+		item->setCheckState(active ? Qt::Checked : Qt::Unchecked);
+		if (active)
+			item->setFlags(item->flags() & ~Qt::ItemIsEnabled);
+	};
+	addChoice(QStringLiteral("Emisión principal (Ajustes → Emisión)"), QStringLiteral("@main"),
+		  obs_frontend_streaming_active());
+	const bool verticalActive = IsVerticalStreamingActive();
+	addChoice(QStringLiteral("Transmisión vertical 9:16"), QStringLiteral("@vertical"), verticalActive);
+	void *jni = FindAndroidJni();
+	using IsMultiActiveFn = bool (*)(const char *);
+	auto fnIsMulti = jni ? reinterpret_cast<IsMultiActiveFn>(dlsym(jni, "obs_android_multistream_is_active")) : nullptr;
+	if (cfg.contains("targets") && cfg["targets"].is_array()) {
+		for (const auto &target : cfg["targets"]) {
+			const std::string id = target.value("id", "");
+			if (id.empty())
+				continue;
+			QString label = QString::fromStdString(target.value("name", "Destino"));
+			label += target.value("vertical", false) ? QStringLiteral(" · Vertical 9:16")
+							 : QStringLiteral(" · Horizontal 16:9");
+			const bool active = fnIsMulti && fnIsMulti(id.c_str());
+			if (active)
+				label += QStringLiteral(" · EN VIVO");
+			addChoice(label, QString::fromStdString(id), active);
+		}
+	}
+	layout->addWidget(choices, 1);
+	auto *buttons = new QDialogButtonBox(QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &picker);
+	buttons->button(QDialogButtonBox::Ok)->setText(QStringLiteral("Iniciar seleccionados"));
+	QObject::connect(buttons, &QDialogButtonBox::accepted, &picker, &QDialog::accept);
+	QObject::connect(buttons, &QDialogButtonBox::rejected, &picker, &QDialog::reject);
+	layout->addWidget(buttons);
+	if (picker.exec() != QDialog::Accepted)
+		return {};
+	QStringList selected;
+	for (int i = 0; i < choices->count(); ++i) {
+		const auto *item = choices->item(i);
+		if (item->checkState() == Qt::Checked && item->flags().testFlag(Qt::ItemIsEnabled))
+			selected << item->data(Qt::UserRole).toString();
+	}
+	return selected;
+}
+
+bool AndroidStartSelectedDestination(const QString &destination, QWidget *parent)
+{
+	if (destination == QStringLiteral("@vertical"))
+		return ToggleVerticalStream(parent, true);
+	if (destination == QStringLiteral("@main"))
+		return false;
+	const auto cfg = LoadMultiConfig();
+	const std::string id = destination.toStdString();
+	if (!cfg.contains("targets") || !cfg["targets"].is_array())
+		return false;
+	for (const auto &target : cfg["targets"]) {
+		if (target.value("id", "") != id)
+			continue;
+		void *jni = FindAndroidJni();
+		using StartMultiExFn = bool (*)(const char *, const char *, const char *, int, bool, int, int, const char *, int);
+		using IsMultiActiveFn = bool (*)(const char *);
+		auto fnStart = jni ? reinterpret_cast<StartMultiExFn>(dlsym(jni, "obs_android_multistream_start_target_ex")) : nullptr;
+		auto fnIsActive = jni ? reinterpret_cast<IsMultiActiveFn>(dlsym(jni, "obs_android_multistream_is_active")) : nullptr;
+		if (fnIsActive && fnIsActive(id.c_str()))
+			return true;
+		if (!fnStart)
+			break;
+		const auto &vcfg = cfg["vertical"];
+		const int width = vcfg.value("res", 0) == 1 ? 1080 : 720;
+		const int height = vcfg.value("res", 0) == 1 ? 1920 : 1280;
+		SyncVerticalRuntimeFromConfig(cfg);
+		PushVerticalParamsToBackend();
+		const std::string scene = ResolveVerticalBackendSceneName(g_verticalFollowScene);
+		return fnStart(id.c_str(), target.value("server", "").c_str(), target.value("key", "").c_str(),
+			       target.value("bitrate", 4000), target.value("vertical", false), width, height,
+			       scene.c_str(), g_verticalFitMode);
+	}
+	if (parent)
+		OBSMessageBox::warning(parent, QStringLiteral("Multistreaming"),
+				       QStringLiteral("No se pudo iniciar el destino seleccionado."));
+	return false;
+}
