+	root->addWidget(form);
+
+	auto editIndex = std::make_shared<int>(-1);
+	auto refresh = [=]() {
+		*cfg = LoadMultiConfig();
+		list->clear();
+		using IsMultiActiveFn = bool (*)(const char *);
+		void *jni = FindAndroidJni();
+		auto isActive = jni ? reinterpret_cast<IsMultiActiveFn>(dlsym(jni, "obs_android_multistream_is_active")) : nullptr;
+		int activeCount = 0;
+		for (size_t i = 0; i < (*cfg)["targets"].size(); ++i) {
+			const auto &target = (*cfg)["targets"][i];
+			const std::string id = target.value("id", "");
