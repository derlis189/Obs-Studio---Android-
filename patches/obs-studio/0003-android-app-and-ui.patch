+QWidget *CreateAndroidMultistreamSettingsSection(QWidget *parent)
+{
+	auto cfg = std::make_shared<nlohmann::json>(LoadMultiConfig());
+	auto *section = new QWidget(parent);
+	auto *root = new QVBoxLayout(section);
+	root->setContentsMargins(4, 0, 4, 0);
+	root->setSpacing(5);
+	auto *sectionTitle = new QLabel(QStringLiteral("OTRAS SALIDAS"), section);
+	sectionTitle->setStyleSheet(QStringLiteral("font-weight: 600; color: palette(text); padding-top: 4px;"));
+	root->addWidget(sectionTitle);
+	auto *description = new QLabel(
+		QStringLiteral("Añade redes adicionales. Se pueden iniciar junto con la emisión principal o vertical."), section);
+	description->setWordWrap(true);
+	root->addWidget(description);
+
+	auto *list = new QListWidget(section);
+	list->setSelectionMode(QAbstractItemView::SingleSelection);
+	list->setWordWrap(false);
+	list->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	list->setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	root->addWidget(list);
+
+	auto *status = new QLabel(section);
+	status->setWordWrap(true);
+	root->addWidget(status);
+
+	auto *actions = new QHBoxLayout();
+	auto *addButton = new QPushButton(QStringLiteral("＋ Agregar destino"), section);
+	auto *editButton = new QPushButton(QStringLiteral("Editar"), section);
+	auto *removeButton = new QPushButton(QStringLiteral("Eliminar"), section);
+	actions->addWidget(addButton, 1);
+	actions->addWidget(editButton);
+	actions->addWidget(removeButton);
+	root->addLayout(actions);
+
+	auto *form = new QWidget(section);
+	auto *formLayout = new QFormLayout(form);
+	formLayout->setContentsMargins(0, 4, 0, 0);
+	formLayout->setVerticalSpacing(8);
+	formLayout->setFieldGrowthPolicy(QFormLayout::AllNonFixedFieldsGrow);
+	auto *name = new QLineEdit(form);
+	name->setMinimumHeight(48);
+	name->setPlaceholderText(QStringLiteral("Ej. YouTube, Twitch o TikTok"));
+	auto *server = new QLineEdit(form);
+	server->setMinimumHeight(48);
+	server->setPlaceholderText(QStringLiteral("rtmps://servidor/live"));
+	auto *key = new QLineEdit(form);
+	key->setMinimumHeight(48);
+	key->setEchoMode(QLineEdit::Password);
+	key->setPlaceholderText(QStringLiteral("Clave de transmisión"));
+	auto *format = new QComboBox(form);
+	format->setMinimumHeight(48);
+	format->addItem(QStringLiteral("Programa horizontal · 16:9"), false);
+	format->addItem(QStringLiteral("Lienzo vertical · 9:16"), true);
+	auto *bitrate = new QSpinBox(form);
+	bitrate->setMinimumHeight(48);
+	bitrate->setRange(500, 12000);
+	bitrate->setSingleStep(500);
+	bitrate->setValue(4000);
+	bitrate->setSuffix(QStringLiteral(" kbps"));
+	formLayout->addRow(QStringLiteral("Nombre:"), name);
+	formLayout->addRow(QStringLiteral("Servidor:"), server);
+	formLayout->addRow(QStringLiteral("Clave:"), key);
+	formLayout->addRow(QStringLiteral("Formato:"), format);
+	formLayout->addRow(QStringLiteral("Bitrate:"), bitrate);
+
+	auto *formActions = new QHBoxLayout();
+	formActions->addStretch();
+	auto *cancelButton = new QPushButton(QStringLiteral("Cancelar"), form);
+	auto *saveButton = new QPushButton(QStringLiteral("Guardar destino"), form);
+	cancelButton->setMinimumHeight(46);
+	saveButton->setMinimumHeight(46);
+	formActions->addWidget(cancelButton);
+	formActions->addWidget(saveButton);
+	formLayout->addRow(formActions);
