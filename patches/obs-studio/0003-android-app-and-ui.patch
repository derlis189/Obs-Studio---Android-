+	QObject::connect(removeButton, &QPushButton::clicked, section, [=]() {
+		const int row = list->currentRow();
+		if (row < 0 || row >= int((*cfg)["targets"].size()))
+			return;
+		const std::string id = (*cfg)["targets"][size_t(row)].value("id", "");
+		if (!id.empty()) {
+			if (void *jni = FindAndroidJni()) {
+				using StopFn = bool (*)(const char *);
+				if (auto stop = reinterpret_cast<StopFn>(dlsym(jni, "obs_android_multistream_stop_target")))
+					stop(id.c_str());
+			}
+		}
+		(*cfg)["targets"].erase((*cfg)["targets"].begin() + row);
+		SaveMultiConfig(*cfg);
+		refresh();
+	});
+	QObject::connect(cancelButton, &QPushButton::clicked, section, [=]() { resetForm(); });
+	QObject::connect(saveButton, &QPushButton::clicked, section, [=]() {
+		const QString srv = server->text().trimmed();
+		if (srv.isEmpty()) {
+			status->setText(QStringLiteral("Escribe la dirección del servidor RTMP/RTMPS."));
+			server->setFocus();
+			return;
+		}
+		QString nm = name->text().trimmed();
+		if (nm.isEmpty())
+			nm = QStringLiteral("Destino %1").arg(*editIndex >= 0 ? *editIndex + 1 : (*cfg)["targets"].size() + 1);
+		nlohmann::json target = {{"name", nm.toStdString()},
+					 {"server", srv.toStdString()},
+					 {"key", key->text().trimmed().toStdString()},
+					 {"vertical", format->currentData().toBool()},
+					 {"bitrate", bitrate->value()}};
+		if (*editIndex >= 0 && *editIndex < int((*cfg)["targets"].size())) {
+			const auto &old = (*cfg)["targets"][size_t(*editIndex)];
+			const std::string id = old.value("id", "");
+			if (!id.empty()) {
+				if (void *jni = FindAndroidJni()) {
+					using IsActiveFn = bool (*)(const char *);
+					if (auto active = reinterpret_cast<IsActiveFn>(dlsym(jni, "obs_android_multistream_is_active"));
+					    active && active(id.c_str())) {
+						status->setText(QStringLiteral("Detén este destino antes de editarlo."));
+						return;
+					}
+				}
+				target["id"] = id;
+			}
+			(*cfg)["targets"][size_t(*editIndex)] = std::move(target);
+		} else {
+			target["id"] = "ms_" + std::to_string(QDateTime::currentMSecsSinceEpoch());
+			(*cfg)["targets"].push_back(std::move(target));
+		}
+		SaveMultiConfig(*cfg);
+		resetForm();
+		refresh();
+	});
+	refresh();
+	return section;
+}
