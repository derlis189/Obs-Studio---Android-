+		nlohmann::json req = {
+			{"action", "at_update"},
+			{"template", cbTpl->currentIndex()},
+			{"animIn", cbAnimIn->currentIndex()},
+			{"animOut", cbAnimOut->currentIndex()},
+			{"align", cbAlign->currentIndex()},
+			{"badge", edBadge->text().toStdString()},
+			{"title", edTitle->text().toStdString()},
+			{"subtitle", edSub->text().toStdString()},
+			{"ticker", edTicker->text().toStdString()},
+			{"accentColor", edAccent->text().trimmed().toStdString()},
+			{"bgColor", edBg->text().trimmed().toStdString()},
+			{"inMs", spInMs->value()},
+			{"outMs", spOutMs->value()},
+			{"autoHideSec", spAuto->value()},
+			{"shimmer", cbShimmer->isChecked()}
+		};
+		if (setOnAir) req["onAir"] = onAirVal;
+		return GfxExecute(req);
+	};
+
+	QObject::connect(btnAddSrc, &QPushButton::clicked, rootW, []() {
+		const char *kName = "Títulos Avanzados (Animados)";
+		OBSSourceAutoRelease existing = obs_get_source_by_name(kName);
+		obs_source_t *src = existing.Get();
+		if (!src) {
+			obs_data_t *s = obs_data_create();
+			obs_data_set_bool(s, "at_local_mode", false);
+			obs_data_set_int(s, "width", 1280);
+			obs_data_set_int(s, "height", 360);
+			src = obs_source_create("android_advanced_title_source", kName, s, nullptr);
+			obs_data_release(s);
+		}
+		if (!src) return;
+		OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+		obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+		if (scene && !obs_scene_find_source(scene, kName)) {
+			obs_scene_add(scene, src);
+		}
+		if (!existing) obs_source_release(src);
+	});
+	QObject::connect(btnAir, &QPushButton::clicked, rootW, [isOnAir, pushCurrent, syncFromState]() {
+		auto resp = pushCurrent(true, !(*isOnAir));
+		if (resp.contains("graphics")) syncFromState(resp["graphics"]);
+	});
+	QObject::connect(btnApply, &QPushButton::clicked, rootW, [pushCurrent, syncFromState]() {
+		auto resp = pushCurrent(false, false);
+		if (resp.contains("graphics")) syncFromState(resp["graphics"]);
+	});
+	QObject::connect(btnSavePr, &QPushButton::clicked, rootW, [pushCurrent, syncFromState]() {
+		pushCurrent(false, false);
+		auto resp = GfxExecute({{"action", "at_save_preset"}});
+		if (resp.contains("graphics")) syncFromState(resp["graphics"]);
+	});
+	QObject::connect(btnLaunchPr, &QPushButton::clicked, rootW, [presetList, syncFromState]() {
+		int row = presetList->currentRow();
+		if (row < 0) return;
+		auto resp = GfxExecute({{"action", "at_apply_preset"}, {"index", row}, {"launch", true}});
+		if (resp.contains("graphics")) syncFromState(resp["graphics"]);
+	});
+	QObject::connect(btnDelPr, &QPushButton::clicked, rootW, [presetList, syncFromState]() {
+		int row = presetList->currentRow();
+		if (row < 0) return;
+		auto resp = GfxExecute({{"action", "at_delete_preset"}, {"index", row}});
+		if (resp.contains("graphics")) syncFromState(resp["graphics"]);
+	});
+
+	syncFromState(GfxGetState());
+	return scroll;
+}
