+// 3. Instant Replay (Repetición Instantánea con Cámara Lenta)
+// =========================================================================
+static bool LaunchReplayFileOnAir(const QString &filePath, int speedPct, bool loop)
+{
+	if (filePath.isEmpty() || !QFile::exists(filePath)) return false;
+	const char *kReplayName = "Repetición Instantánea";
+	OBSSourceAutoRelease existing = obs_get_source_by_name(kReplayName);
+	obs_data_t *settings = obs_data_create();
+	obs_data_set_bool(settings, "is_local_file", true);
+	obs_data_set_string(settings, "local_file", filePath.toUtf8().constData());
+	obs_data_set_int(settings, "speed_percent", std::clamp(speedPct, 10, 200));
+	obs_data_set_bool(settings, "looping", loop);
+	obs_data_set_bool(settings, "restart_on_activate", true);
+	obs_data_set_bool(settings, "close_when_inactive", false);
+	obs_data_set_bool(settings, "hw_decode", true);
+
+	obs_source_t *src = existing.Get();
+	if (src) {
+		obs_source_update(src, settings);
+	} else {
+		src = obs_source_create("ffmpeg_source", kReplayName, settings, nullptr);
+	}
+	obs_data_release(settings);
+	if (!src) return false;
+
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (scene) {
+		obs_sceneitem_t *item = obs_scene_find_source(scene, kReplayName);
+		if (!item) {
+			item = obs_scene_add(scene, src);
+			if (item) {
+				obs_video_info ovi{};
+				if (obs_get_video_info(&ovi)) {
+					vec2 pos{0.0f, 0.0f};
+					vec2 bounds{float(ovi.base_width), float(ovi.base_height)};
+					obs_sceneitem_set_alignment(item, OBS_ALIGN_TOP | OBS_ALIGN_LEFT);
+					obs_sceneitem_set_pos(item, &pos);
+					obs_sceneitem_set_bounds_type(item, OBS_BOUNDS_SCALE_INNER);
+					obs_sceneitem_set_bounds_alignment(item, OBS_ALIGN_CENTER);
+					obs_sceneitem_set_bounds(item, &bounds);
+				}
+			}
+		}
+		if (item) {
+			obs_sceneitem_set_order(item, OBS_ORDER_MOVE_TOP);
+			obs_sceneitem_set_visible(item, true);
+		}
+	}
+	obs_source_media_restart(src);
+	if (!existing) obs_source_release(src);
+	return true;
+}
+
+static void HideReplayOnAir()
+{
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (!scene) return;
+	if (obs_sceneitem_t *item = obs_scene_find_source(scene, "Repetición Instantánea")) {
+		obs_sceneitem_set_visible(item, false);
+	}
+}
