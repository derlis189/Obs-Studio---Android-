+	cbRes->addItem(QStringLiteral("1280×720 (Recomendado)"), QStringLiteral("1280x720"));
+	cbRes->addItem(QStringLiteral("1920×1080 (Full HD)"), QStringLiteral("1920x1080"));
+	cbRes->addItem(QStringLiteral("854×480 (Ligero)"), QStringLiteral("854x480"));
+	auto *cbBr = new QComboBox(rootW);
+	cbBr->addItem(QStringLiteral("2500 kbps"), 2500);
+	cbBr->addItem(QStringLiteral("4000 kbps"), 4000);
+	cbBr->addItem(QStringLiteral("6000 kbps"), 6000);
+	cbBr->addItem(QStringLiteral("8000 kbps"), 8000);
+	optRow->addWidget(cbRes, 1);
+	optRow->addWidget(cbBr, 1);
+	root->addLayout(optRow);
+
+	auto *cbAudio = new QCheckBox(QStringLiteral("Incluir mezcla de audio en cada archivo ISO"), rootW);
+	auto *cbSync = new QCheckBox(QStringLiteral("Iniciar/detener automáticamente con la Grabación principal"), rootW);
+	root->addWidget(cbAudio);
+	root->addWidget(cbSync);
+
+	auto *btnRow = new QHBoxLayout();
+	auto *btnStart = new QPushButton(QStringLiteral("Iniciar Grabación ISO"), rootW);
+	btnStart->setStyleSheet(QStringLiteral("background:#dc2626; color:white; font-weight:bold; padding:8px; border-radius:6px;"));
+	auto *btnStop = new QPushButton(QStringLiteral("Detener ISO"), rootW);
+	btnStop->setStyleSheet(QStringLiteral("background:#334155; color:white; font-weight:bold; padding:8px; border-radius:6px;"));
