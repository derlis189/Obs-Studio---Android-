+static void OpenAdvancedTitlesDialog(QWidget *parent)
+{
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Generador Avanzado de Títulos y Animaciones"));
+	auto *lay = new QVBoxLayout(&dlg);
+	lay->addWidget(CreateAdvancedTitlesWidget(&dlg), 1);
+	auto *btnClose = new QPushButton(QStringLiteral("Cerrar"), &dlg);
+	QObject::connect(btnClose, &QPushButton::clicked, &dlg, &QDialog::accept);
+	lay->addWidget(btnClose);
+	dlg.resize(560, 560);
+	dlg.exec();
+}
