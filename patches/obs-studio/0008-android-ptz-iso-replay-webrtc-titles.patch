+static std::string IsoConfigFilePath()
+{
+	const char *files = obs_android_files_path();
+	if (!files || !*files)
+		files = getenv("OBS_ANDROID_FILES_PATH");
+	std::string dir = files ? (std::string(files) + "/obs-studio") : "/data/local/tmp";
+	QDir().mkpath(QString::fromStdString(dir));
+	return dir + "/android-iso.json";
+}
+
+static nlohmann::json LoadIsoConfig()
+{
+	nlohmann::json cfg = {{"sources", nlohmann::json::array()},
+			      {"width", 1280},
+			      {"height", 720},
+			      {"bitrate", 4000},
+			      {"includeAudio", true},
+			      {"syncMainRec", false}};
+	std::ifstream f(IsoConfigFilePath());
+	if (f.is_open()) {
+		try {
+			auto parsed = nlohmann::json::parse(f);
+			if (parsed.is_object())
+				cfg.update(parsed);
+		} catch (...) {
+		}
+	}
+	return cfg;
+}
+
+static void SaveIsoConfig(const nlohmann::json &cfg)
+{
+	WriteConfigAtomically(IsoConfigFilePath(), cfg);
+}
+
+static QString GetAndroidRecordingsRootDir()
+{
+	if (void *jni = FindAndroidJni()) {
+		using Fn = bool (*)(char *, size_t);
+		if (auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_get_default_recording_path"))) {
+			char buf[512] = {};
+			if (fn(buf, sizeof(buf)) && buf[0])
+				return QString::fromUtf8(buf);
+		}
+	}
+	return QStringLiteral("/storage/emulated/0/Movies/OBS Studio");
+}
+
+static bool StartIsoRecordingWithConfig(const nlohmann::json &cfg)
+{
+	void *jni = FindAndroidJni();
+	if (!jni)
+		return false;
+	using Fn = bool (*)(const char *);
+	auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_iso_start"));
+	if (!fn)
+		return false;
+	nlohmann::json req = cfg;
+	req["dir"] = (GetAndroidRecordingsRootDir() + QStringLiteral("/ISO")).toStdString();
+	return fn(req.dump().c_str());
+}
+
+static void StopIsoRecordingNow()
+{
+	if (void *jni = FindAndroidJni()) {
+		if (auto fn = reinterpret_cast<void (*)()>(dlsym(jni, "obs_android_iso_stop")))
+			fn();
+	}
+}
