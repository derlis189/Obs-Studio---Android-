+class PtzTouchPadWidget : public QWidget {
+public:
+	std::function<void(float, float)> onMove;
+	explicit PtzTouchPadWidget(QWidget *parent = nullptr) : QWidget(parent)
+	{
+		setMinimumSize(148, 148);
+		setMaximumSize(180, 180);
+		setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Fixed);
+	}
+
+protected:
+	void paintEvent(QPaintEvent *) override
+	{
+		QPainter p(this);
+		p.setRenderHint(QPainter::Antialiasing, true);
+		const int sz = std::min(width(), height()) - 8;
+		const QRectF ring((width() - sz) * 0.5, (height() - sz) * 0.5, sz, sz);
+		p.setBrush(QColor(22, 27, 38));
+		p.setPen(QPen(QColor(71, 85, 105), 2));
+		p.drawEllipse(ring);
+		p.setPen(QPen(QColor(51, 65, 85), 1, Qt::DashLine));
+		p.drawLine(QPointF(ring.center().x(), ring.top() + 8), QPointF(ring.center().x(), ring.bottom() - 8));
+		p.drawLine(QPointF(ring.left() + 8, ring.center().y()), QPointF(ring.right() - 8, ring.center().y()));
+
+		const double r = sz * 0.36;
+		const QPointF knob(ring.center().x() + m_pan * r, ring.center().y() - m_tilt * r);
+		p.setPen(QPen(QColor(59, 130, 246), 2));
+		p.drawLine(ring.center(), knob);
+		p.setBrush(m_dragging ? QColor(37, 99, 235) : QColor(59, 130, 246));
+		p.setPen(QPen(Qt::white, 2));
+		p.drawEllipse(knob, 18, 18);
+	}
+
+	void mousePressEvent(QMouseEvent *ev) override
+	{
+		m_dragging = true;
+		updateFromPos(ev->position(), true);
+	}
+	void mouseMoveEvent(QMouseEvent *ev) override
+	{
+		if (m_dragging)
+			updateFromPos(ev->position(), false);
+	}
+	void mouseReleaseEvent(QMouseEvent *) override
+	{
+		m_dragging = false;
+		m_pan = 0.0f;
+		m_tilt = 0.0f;
+		update();
+		if (onMove) onMove(0.0f, 0.0f);
+	}
+
+private:
+	void updateFromPos(const QPointF &pos, bool force)
+	{
+		const double r = std::max(20.0, (std::min(width(), height()) - 8) * 0.36);
+		double dx = (pos.x() - width() * 0.5) / r;
+		double dy = -(pos.y() - height() * 0.5) / r;
+		const double len = std::hypot(dx, dy);
+		if (len > 1.0) { dx /= len; dy /= len; }
+		m_pan = float(dx);
+		m_tilt = float(dy);
+		update();
+		auto now = std::chrono::steady_clock::now();
+		if (force || std::chrono::duration_cast<std::chrono::milliseconds>(now - m_lastSent).count() >= 55) {
+			m_lastSent = now;
+			if (onMove) onMove(m_pan, m_tilt);
+		}
+	}
+	bool m_dragging{false};
+	float m_pan{0.0f};
+	float m_tilt{0.0f};
+	std::chrono::steady_clock::time_point m_lastSent{};
+};
