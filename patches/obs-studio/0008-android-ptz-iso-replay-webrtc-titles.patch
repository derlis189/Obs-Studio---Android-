+static std::string WebRtcConfigFilePath()
+{
+	const char *files = obs_android_files_path();
+	if (!files || !*files) files = getenv("OBS_ANDROID_FILES_PATH");
+	std::string dir = files ? (std::string(files) + "/obs-studio") : "/data/local/tmp";
+	QDir().mkpath(QString::fromStdString(dir));
+	return dir + "/android-webrtc-guests.json";
+}
+
+static std::string GenerateShortRoomToken(int len)
+{
+	QString u = QUuid::createUuid().toString(QUuid::Id128);
+	return u.left(len).toLower().toStdString();
+}
+
+static nlohmann::json LoadWebRtcConfig()
+{
+	nlohmann::json cfg;
+	std::ifstream f(WebRtcConfigFilePath());
+	if (f.is_open()) {
+		try { cfg = nlohmann::json::parse(f); } catch (...) {}
+	}
+	bool dirty = false;
+	if (!cfg.is_object()) { cfg = nlohmann::json::object(); dirty = true; }
+	if (!cfg.contains("baseUrl") || !cfg["baseUrl"].is_string() || cfg["baseUrl"].get<std::string>().empty()) {
+		cfg["baseUrl"] = "https://vdo.ninja";
+		dirty = true;
+	}
+	if (!cfg.contains("room") || !cfg["room"].is_string() || cfg["room"].get<std::string>().empty()) {
+		cfg["room"] = "obs" + GenerateShortRoomToken(8);
+		dirty = true;
+	}
+	if (!cfg.contains("guests") || !cfg["guests"].is_array() || cfg["guests"].size() < 6) {
+		nlohmann::json arr = nlohmann::json::array();
+		for (int i = 1; i <= 6; ++i) {
+			arr.push_back({{"name", "Invitado " + std::to_string(i)},
+				       {"streamId", "inv" + std::to_string(i) + "_" + GenerateShortRoomToken(5)}});
+		}
+		cfg["guests"] = arr;
+		dirty = true;
+	}
+	if (dirty) WriteConfigAtomically(WebRtcConfigFilePath(), cfg);
+	return cfg;
+}
+
+static void AddWebRtcGuestBrowserSource(const QString &sourceName, const QString &viewUrl)
+{
+	obs_data_t *s = obs_data_create();
+	obs_data_set_string(s, "url", viewUrl.toUtf8().constData());
+	obs_data_set_int(s, "width", 1280);
+	obs_data_set_int(s, "height", 720);
+	obs_data_set_int(s, "fps", 30);
+	obs_data_set_bool(s, "transparent", true);
+	obs_data_set_bool(s, "capture_audio", true);
+	obs_data_set_bool(s, "pause_when_hidden", false);
+
+	OBSSourceAutoRelease existing = obs_get_source_by_name(sourceName.toUtf8().constData());
+	obs_source_t *src = existing.Get();
+	if (src) {
+		obs_source_update(src, s);
+	} else {
+		src = obs_source_create("android_browser_source", sourceName.toUtf8().constData(), s, nullptr);
+	}
+	obs_data_release(s);
+	if (!src) return;
+
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (scene && !obs_scene_find_source(scene, sourceName.toUtf8().constData())) {
+		obs_scene_add(scene, src);
+	}
+	if (!existing) obs_source_release(src);
+}
