+static nlohmann::json PtzGetState()
+{
+	if (void *jni = FindAndroidJni()) {
+		using Fn = bool (*)(char *, size_t);
+		if (auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_ptz_get_state"))) {
+			std::string buf(32768, '\0');
+			if (fn(buf.data(), buf.size()) && buf[0]) {
+				try { return nlohmann::json::parse(buf.c_str()); } catch (...) {}
+			}
+		}
+	}
+	return nlohmann::json::object();
+}
+
+static nlohmann::json PtzExec(const nlohmann::json &req)
+{
+	if (void *jni = FindAndroidJni()) {
+		using Fn = bool (*)(const char *, char *, size_t);
+		if (auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_ptz_execute"))) {
+			std::string s = req.dump();
+			std::string buf(32768, '\0');
+			if (fn(s.c_str(), buf.data(), buf.size()) && buf[0]) {
+				try { return nlohmann::json::parse(buf.c_str()); } catch (...) {}
+			}
+		}
+	}
+	return nlohmann::json::object();
+}
