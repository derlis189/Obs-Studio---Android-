+	auto *statusLbl = new QLabel(QStringLiteral("Estado ISO: detenido"), rootW);
+	statusLbl->setWordWrap(true);
+	statusLbl->setStyleSheet(QStringLiteral("background:#1e293b; color:#e2e8f0; border-radius:6px; padding:6px; font-size:11px;"));
+	root->addWidget(statusLbl);
+	root->addStretch(1);
+	scroll->setWidget(rootW);
+
+	auto collectCfg = [srcList, cbRes, cbBr, cbAudio, cbSync]() -> nlohmann::json {
+		nlohmann::json arr = nlohmann::json::array();
+		for (int i = 0; i < srcList->count(); ++i) {
+			auto *it = srcList->item(i);
+			if (it && it->checkState() == Qt::Checked)
+				arr.push_back(it->text().toStdString());
+		}
+		int w = 1280, h = 720;
+		const QString r = cbRes->currentData().toString();
+		if (r == "1920x1080") { w = 1920; h = 1080; }
+		else if (r == "854x480") { w = 854; h = 480; }
+		return {{"sources", arr},
+			{"width", w},
+			{"height", h},
+			{"bitrate", cbBr->currentData().toInt()},
+			{"includeAudio", cbAudio->isChecked()},
+			{"syncMainRec", cbSync->isChecked()}};
+	};
+
+	auto populateSources = [srcList, cbRes, cbBr, cbAudio, cbSync]() {
+		const auto cfg = LoadIsoConfig();
+		std::vector<std::string> saved;
+		if (cfg.contains("sources") && cfg["sources"].is_array()) {
+			for (const auto &s : cfg["sources"]) if (s.is_string()) saved.push_back(s.get<std::string>());
+		}
+		srcList->clear();
+		for (const auto &nm : EnumVideoSourceNames()) {
+			auto *it = new QListWidgetItem(QString::fromStdString(nm), srcList);
+			it->setFlags(it->flags() | Qt::ItemIsUserCheckable);
+			bool checked = std::find(saved.begin(), saved.end(), nm) != saved.end();
+			it->setCheckState(checked ? Qt::Checked : Qt::Unchecked);
+		}
+		for (const auto &sc : GetAllObsSceneNames(false, true)) {
+			auto *it = new QListWidgetItem(QString::fromStdString(sc), srcList);
+			it->setFlags(it->flags() | Qt::ItemIsUserCheckable);
+			bool checked = std::find(saved.begin(), saved.end(), sc) != saved.end();
+			it->setCheckState(checked ? Qt::Checked : Qt::Unchecked);
+		}
+		int w = cfg.value("width", 1280);
+		cbRes->setCurrentIndex(w >= 1920 ? 1 : (w <= 900 ? 2 : 0));
+		int brIdx = cbBr->findData(cfg.value("bitrate", 4000));
+		if (brIdx >= 0) cbBr->setCurrentIndex(brIdx);
+		cbAudio->setChecked(cfg.value("includeAudio", true));
+		cbSync->setChecked(cfg.value("syncMainRec", false));
+	};
+
+	auto pollStats = [statusLbl]() {
+		if (void *jni = FindAndroidJni()) {
+			using Fn = bool (*)(char *, size_t);
+			if (auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_iso_get_stats"))) {
+				char buf[4096] = {};
+				if (fn(buf, sizeof(buf)) && buf[0]) {
+					try {
+						auto j = nlohmann::json::parse(buf);
+						if (j.value("active", false)) {
+							int sec = j.value("elapsedSec", 0);
+							QString msg = QStringLiteral("GRABANDO ISO · %1:%2\n")
+								.arg(sec / 60, 2, 10, QChar('0')).arg(sec % 60, 2, 10, QChar('0'));
+							for (const auto &t : j["tracks"]) {
+								msg += QStringLiteral("• %1 (%2 frames)\n")
+									.arg(QString::fromStdString(t.value("source", "")))
+									.arg(t.value("frames", 0));
+							}
+							statusLbl->setText(msg.trimmed());
+							statusLbl->setStyleSheet(QStringLiteral("background:#7f1d1d; color:#fee2e2; border-radius:6px; padding:6px; font-weight:bold; font-size:11px;"));
+							return;
+						}
+					} catch (...) {}
+				}
+			}
+		}
+		statusLbl->setText(QStringLiteral("Estado ISO: detenido"));
+		statusLbl->setStyleSheet(QStringLiteral("background:#1e293b; color:#e2e8f0; border-radius:6px; padding:6px; font-size:11px;"));
+	};
+
+	QObject::connect(btnRefresh, &QPushButton::clicked, rootW, populateSources);
+	QObject::connect(cbSync, &QCheckBox::toggled, rootW, [collectCfg](bool) { SaveIsoConfig(collectCfg()); });
+	QObject::connect(btnStart, &QPushButton::clicked, rootW, [collectCfg, statusLbl, pollStats]() {
+		auto cfg = collectCfg();
+		SaveIsoConfig(cfg);
+		if (cfg["sources"].empty()) {
+			statusLbl->setText(QStringLiteral("Selecciona al menos una fuente o cámara para grabar en ISO."));
+			return;
+		}
+		if (!StartIsoRecordingWithConfig(cfg)) {
+			statusLbl->setText(QStringLiteral("No se pudo iniciar la grabación ISO. Verifica las fuentes seleccionadas."));
+		} else {
+			pollStats();
+		}
+	});
+	QObject::connect(btnStop, &QPushButton::clicked, rootW, [pollStats]() {
+		StopIsoRecordingNow();
+		pollStats();
+	});
+
+	auto *timer = new QTimer(scroll);
+	timer->setInterval(1000);
+	QObject::connect(timer, &QTimer::timeout, scroll, [scroll, pollStats]() {
+		if (scroll->isVisible()) pollStats();
+	});
+	timer->start();
+	populateSources();
+	pollStats();
+	return scroll;
+}
