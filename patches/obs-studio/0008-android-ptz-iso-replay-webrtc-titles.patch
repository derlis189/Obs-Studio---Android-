+	root->addWidget(btnPlaySel);
+	root->addStretch(1);
+	scroll->setWidget(rootW);
+
+	auto populateSrcs = [cbSource]() {
+		QString prev = cbSource->currentData().toString();
+		cbSource->clear();
+		cbSource->addItem(QStringLiteral("Programa (Salida principal)"), QStringLiteral("__PROGRAM__"));
+		for (const auto &nm : EnumVideoSourceNames()) {
+			if (nm == "Repetición Instantánea") continue;
+			cbSource->addItem(QString::fromStdString(nm), QString::fromStdString(nm));
+		}
+		int idx = cbSource->findData(prev);
+		if (idx >= 0) cbSource->setCurrentIndex(idx);
+	};
+
+	auto refreshClips = [clipsList]() {
+		QDir dir(GetAndroidRecordingsRootDir() + QStringLiteral("/Replays"));
+		clipsList->clear();
+		if (!dir.exists()) return;
+		const auto files = dir.entryInfoList(QStringList{QStringLiteral("*.mp4")}, QDir::Files, QDir::Time);
+		for (int i = 0; i < files.size() && i < 20; ++i) {
+			auto *it = new QListWidgetItem(files[i].fileName(), clipsList);
+			it->setData(Qt::UserRole, files[i].absoluteFilePath());
+		}
+	};
+
+	auto isReplayActive = std::make_shared<bool>(false);
+	auto pollStats = [bufStatus, btnToggleBuf, isReplayActive]() {
+		bool active = false;
+		double bufSec = 0.0;
+		int maxSec = 30;
+		std::string srcName = "__PROGRAM__";
+		if (void *jni = FindAndroidJni()) {
+			using Fn = bool (*)(char *, size_t);
+			if (auto fn = reinterpret_cast<Fn>(dlsym(jni, "obs_android_replay_get_stats"))) {
+				char buf[1024] = {};
+				if (fn(buf, sizeof(buf)) && buf[0]) {
+					try {
+						auto j = nlohmann::json::parse(buf);
+						active = j.value("active", false);
+						bufSec = j.value("bufferedSec", 0.0);
+						maxSec = j.value("maxSec", 30);
+						srcName = j.value("source", std::string("__PROGRAM__"));
+					} catch (...) {}
+				}
+			}
+		}
+		*isReplayActive = active;
+		if (active) {
+			QString srcLabel = (srcName == "__PROGRAM__") ? QStringLiteral("Programa") : QString::fromStdString(srcName);
+			bufStatus->setText(QStringLiteral("BÚFER ACTIVO (%1) · %2 s / %3 s listos")
+				.arg(srcLabel).arg(bufSec, 0, 'f', 1).arg(maxSec));
+			bufStatus->setStyleSheet(QStringLiteral("background:#14532d; color:#dcfce7; border-radius:6px; padding:6px; font-weight:bold; font-size:11px;"));
+			btnToggleBuf->setText(QStringLiteral("Detener Búfer de Repetición"));
+			btnToggleBuf->setStyleSheet(QStringLiteral("background:#475569; color:white; font-weight:bold; padding:8px; border-radius:6px;"));
+		} else {
+			bufStatus->setText(QStringLiteral("Búfer detenido (actívalo antes de marcar jugadas)"));
+			bufStatus->setStyleSheet(QStringLiteral("background:#1e293b; color:#cbd5e1; border-radius:6px; padding:6px; font-size:11px;"));
+			btnToggleBuf->setText(QStringLiteral("Activar Búfer de Repetición"));
+			btnToggleBuf->setStyleSheet(QStringLiteral("background:#2563eb; color:white; font-weight:bold; padding:8px; border-radius:6px;"));
+		}
+	};
+
+	auto saveClipNow = [cbClipSec, bufStatus, refreshClips]() -> QString {
+		void *jni = FindAndroidJni();
+		if (!jni) return {};
+		using SaveFn = bool (*)(int, const char *);
+		auto fn = reinterpret_cast<SaveFn>(dlsym(jni, "obs_android_replay_save_clip"));
+		if (!fn) return {};
+		QString dirPath = GetAndroidRecordingsRootDir() + QStringLiteral("/Replays");
+		QDir().mkpath(dirPath);
+		QString outFile = dirPath + QStringLiteral("/Replay_") +
+			QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd_HH-mm-ss")) + QStringLiteral(".mp4");
+		if (!fn(cbClipSec->currentData().toInt(), outFile.toUtf8().constData())) {
+			bufStatus->setText(QStringLiteral("No hay suficientes fotogramas en el búfer aún. Activa el búfer y espera 2 segundos."));
+			return {};
+		}
+		refreshClips();
+		return outFile;
+	};
+
+	QObject::connect(btnRefSrc, &QPushButton::clicked, rootW, populateSrcs);
+	QObject::connect(btnToggleBuf, &QPushButton::clicked, rootW, [isReplayActive, cbSource, cbBufSec, cbRes, pollStats, bufStatus]() {
+		void *jni = FindAndroidJni();
+		if (!jni) return;
+		if (*isReplayActive) {
+			if (auto fn = reinterpret_cast<void (*)()>(dlsym(jni, "obs_android_replay_stop"))) fn();
+		} else {
+			using StartFn = bool (*)(const char *, int, int, int, int);
+			if (auto fn = reinterpret_cast<StartFn>(dlsym(jni, "obs_android_replay_start"))) {
+				const int h = cbRes->currentData().toInt();
+				const int w = (h == 1080) ? 1920 : 1280;
+				const int br = (h == 1080) ? 6000 : 4000;
+				if (!fn(cbSource->currentData().toString().toUtf8().constData(),
+					cbBufSec->currentData().toInt(), w, h, br)) {
+					bufStatus->setText(QStringLiteral("Error al iniciar el búfer de repetición."));
+				}
+			}
+		}
+		pollStats();
+	});
+	QObject::connect(btnLaunch, &QPushButton::clicked, rootW, [saveClipNow, cbSpeed, cbLoop, bufStatus]() {
+		QString clip = saveClipNow();
+		if (!clip.isEmpty()) {
+			LaunchReplayFileOnAir(clip, cbSpeed->currentData().toInt(), cbLoop->isChecked());
+			bufStatus->setText(QStringLiteral("REPETICIÓN AL AIRE (%1%)").arg(cbSpeed->currentData().toInt()));
+		}
+	});
+	QObject::connect(btnSaveOnly, &QPushButton::clicked, rootW, [saveClipNow, bufStatus]() {
+		QString clip = saveClipNow();
+		if (!clip.isEmpty()) bufStatus->setText(QStringLiteral("Clip guardado: ") + QFileInfo(clip).fileName());
+	});
+	QObject::connect(btnHide, &QPushButton::clicked, rootW, [bufStatus]() {
+		HideReplayOnAir();
+		bufStatus->setText(QStringLiteral("Repetición retirada del aire"));
+	});
+	QObject::connect(btnPlaySel, &QPushButton::clicked, rootW, [clipsList, cbSpeed, cbLoop, bufStatus]() {
+		auto *it = clipsList->currentItem();
+		if (!it) return;
+		QString path = it->data(Qt::UserRole).toString();
+		if (LaunchReplayFileOnAir(path, cbSpeed->currentData().toInt(), cbLoop->isChecked())) {
+			bufStatus->setText(QStringLiteral("Reproduciendo: %1 (%2%)").arg(it->text()).arg(cbSpeed->currentData().toInt()));
+		}
+	});
+
+	auto *timer = new QTimer(scroll);
+	timer->setInterval(1000);
+	QObject::connect(timer, &QTimer::timeout, scroll, [scroll, pollStats]() {
+		if (scroll->isVisible()) pollStats();
+	});
+	timer->start();
+	populateSrcs();
+	refreshClips();
+	pollStats();
+	return scroll;
+}
