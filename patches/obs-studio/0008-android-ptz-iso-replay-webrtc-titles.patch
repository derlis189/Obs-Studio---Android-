+static std::vector<std::string> EnumVideoSourceNames()
+{
+	std::vector<std::string> out;
+	obs_enum_sources(
+		[](void *param, obs_source_t *src) {
+			auto *vec = static_cast<std::vector<std::string> *>(param);
+			if (!src) return true;
+			const uint32_t flags = obs_source_get_output_flags(src);
+			if ((flags & OBS_SOURCE_VIDEO) == 0) return true;
+			const char *nm = obs_source_get_name(src);
+			if (nm && *nm) vec->emplace_back(nm);
+			return true;
+		},
+		&out);
+	return out;
+}
