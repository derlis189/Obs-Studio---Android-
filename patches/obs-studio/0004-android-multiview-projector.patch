+
+static void CreateAndroidLabelTex(const char *name, size_t h, gs_texture_t **outTex, uint32_t *outW, uint32_t *outH)
+{
+	*outTex = nullptr;
+	*outW = 0;
+	*outH = 0;
+	QString text = QString::fromUtf8(name ? name : "").trimmed();
+	if (text.isEmpty())
+		return;
+	int pxSize = std::clamp(int(h / 9.5), 18, 64);
+	QFont font(QStringLiteral("sans-serif"));
+	font.setPixelSize(pxSize);
+	font.setBold(true);
+	QFontMetrics fm(font);
+	int padX = std::max(14, pxSize / 2);
+	int padY = std::max(6, pxSize / 4);
+	int textW = fm.horizontalAdvance(text);
+	int textH = fm.height();
+	int w = std::min(1200, textW + padX * 2);
+	int hh = std::max(24, textH + padY * 2);
+
+	QImage img(w, hh, QImage::Format_RGBA8888);
+	img.fill(Qt::transparent);
+	QPainter p(&img);
+	p.setRenderHint(QPainter::Antialiasing, true);
+	p.setRenderHint(QPainter::TextAntialiasing, true);
+	p.setPen(QPen(QColor(255, 255, 255, 70), 2));
+	p.setBrush(QColor(15, 23, 42, 205));
+	p.drawRoundedRect(QRectF(1, 1, w - 2, hh - 2), 8, 8);
+	p.setFont(font);
+	p.setPen(Qt::white);
+	p.drawText(QRect(padX, 0, w - padX * 2, hh), Qt::AlignCenter | Qt::TextSingleLine,
+		   fm.elidedText(text, Qt::ElideRight, w - padX * 2));
+	p.end();
+
+	const uint8_t *bits = img.constBits();
+	*outTex = gs_texture_create(uint32_t(w), uint32_t(hh), GS_RGBA, 1, &bits, 0);
+	if (*outTex) {
+		*outW = uint32_t(w);
+		*outH = uint32_t(hh);
+	}
+}
+
+void Multiview::DrawAndroidLabel(size_t idx, float tileX, float tileY, float tileW, float tileH, float scaleX,
+				 float scaleY)
+{
+	if (idx >= androidLabels.size() || !androidLabels[idx].tex)
+		return;
+	const auto &lbl = androidLabels[idx];
+	float drawW = float(lbl.cx) * scaleX;
+	float drawH = float(lbl.cy) * scaleY;
+	if (drawW > tileW - thicknessx2 * 2) {
+		float fit = (tileW - thicknessx2 * 2) / std::max(1.0f, drawW);
+		drawW *= fit;
+		drawH *= fit;
+	}
+	float lx = tileX + (tileW - drawW) * 0.5f;
+	float ly = tileY + tileH - drawH - thickness * 2.5f;
+
+	gs_effect_t *def = obs_get_base_effect(OBS_EFFECT_DEFAULT);
+	gs_eparam_t *image = gs_effect_get_param_by_name(def, "image");
+	gs_blend_state_push();
+	gs_enable_blending(true);
+	gs_blend_function(GS_BLEND_SRCALPHA, GS_BLEND_INVSRCALPHA);
+	gs_matrix_push();
+	gs_matrix_translate3f(lx, ly, 0.0f);
+	gs_matrix_scale3f(drawW / float(lbl.cx), drawH / float(lbl.cy), 1.0f);
+	gs_effect_set_texture(image, lbl.tex);
+	while (gs_effect_loop(def, "Draw")) {
+		gs_draw_sprite(lbl.tex, 0, lbl.cx, lbl.cy);
+	}
+	gs_matrix_pop();
+	gs_blend_state_pop();
+}
