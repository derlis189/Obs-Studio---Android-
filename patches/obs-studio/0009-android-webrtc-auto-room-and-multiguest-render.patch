+static void SetCallModeExclusivity(bool useAutoRoom)
+{
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (!scene) return;
+	obs_scene_enum_items(
+		scene,
+		[](obs_scene_t *, obs_sceneitem_t *item, void *param) {
+			const bool wantAuto = *static_cast<bool *>(param);
+			obs_source_t *s = obs_sceneitem_get_source(item);
+			if (!s) return true;
+			const char *nm = obs_source_get_name(s);
+			if (!nm) return true;
+			const bool isAuto = (std::strncmp(nm, "Llamada Autom", 13) == 0);
+			const bool isIndiv = (std::strncmp(nm, "Llamada: ", 9) == 0 || std::strncmp(nm, "WebRTC: ", 8) == 0);
+			if (wantAuto && isIndiv) {
+				obs_sceneitem_set_visible(item, false);
+			} else if (!wantAuto && isAuto) {
+				obs_sceneitem_set_visible(item, false);
+			}
+			return true;
+		},
+		&useAutoRoom);
+}
+
+static bool HasAnyVisibleCallSourceInScene()
+{
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (!scene) return false;
+	bool found = false;
+	obs_scene_enum_items(
+		scene,
+		[](obs_scene_t *, obs_sceneitem_t *item, void *param) {
+			auto *f = static_cast<bool *>(param);
+			if (*f || !obs_sceneitem_visible(item)) return true;
+			obs_source_t *s = obs_sceneitem_get_source(item);
+			const char *nm = s ? obs_source_get_name(s) : nullptr;
+			if (nm && (std::strncmp(nm, "Llamada Autom", 13) == 0 ||
+				   std::strncmp(nm, "Llamada: ", 9) == 0 ||
+				   std::strncmp(nm, "WebRTC: ", 8) == 0)) {
+				*f = true;
+			}
+			return true;
+		},
+		&found);
+	return found;
+}
