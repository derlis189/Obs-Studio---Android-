+static QString ArrangeWebRtcLayout(int mode)
+{
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	obs_video_info ovi{};
+	if (!scene || !obs_get_video_info(&ovi))
+		return QStringLiteral("No hay una escena activa.");
+
+	const float W = float(ovi.base_width);
+	const float H = float(ovi.base_height);
+
+	struct Collected {
+		std::vector<obs_sceneitem_t *> guests;
+		obs_sceneitem_t *hostCam{nullptr};
+	} col;
+
+	obs_scene_enum_items(
+		scene,
+		[](obs_scene_t *, obs_sceneitem_t *item, void *param) {
+			auto *c = static_cast<Collected *>(param);
+			obs_source_t *s = obs_sceneitem_get_source(item);
+			if (!s || !obs_sceneitem_visible(item)) return true;
+			const char *nm = obs_source_get_name(s);
+			const char *id = obs_source_get_unversioned_id(s);
+			if (nm && (std::strncmp(nm, "Llamada Autom", 13) == 0 ||
+				   std::strncmp(nm, "Llamada: ", 9) == 0 ||
+				   std::strncmp(nm, "WebRTC: ", 8) == 0)) {
+				c->guests.push_back(item);
+			} else if (!c->hostCam && id &&
+				   (std::strcmp(id, "android_camera_source") == 0 ||
+				    std::strcmp(id, "android_uvc_source") == 0 ||
+				    std::strcmp(id, "android_screen_source") == 0)) {
+				c->hostCam = item;
+			}
+			return true;
+		},
+		&col);
+
+	if (col.guests.empty())
+		return QStringLiteral("Primero toca 'Mostrar en pantalla' en al menos un invitado.");
+
+	const float pad = 16.0f;
+	if (mode == 0) {
+		// Pantalla completa: 1280x720 nitido
+		UpdateBrowserSourceRenderProfile(col.guests[0], 1280, 720, 30, false);
+		SetSceneItemBox(col.guests[0], 0.0f, 0.0f, W, H, false);
+		obs_sceneitem_set_order(col.guests[0], OBS_ORDER_MOVE_TOP);
+		return QStringLiteral("Listo: invitado en pantalla completa (720p).");
+	}
+	if (mode == 1) {
+		// 2 Lado a lado (Entrevista): 640x720 por invitado -> mitad de carga GPU + encuadre broadcast sin bordes
+		std::vector<obs_sceneitem_t *> pair;
+		if (col.guests.size() >= 2) {
+			pair = {col.guests[0], col.guests[1]};
+		} else if (col.hostCam) {
+			pair = {col.hostCam, col.guests[0]};
+		} else {
+			UpdateBrowserSourceRenderProfile(col.guests[0], 1280, 720, 30, false);
+			SetSceneItemBox(col.guests[0], 0.0f, 0.0f, W, H, false);
+			return QStringLiteral("Solo hay 1 invitado en pantalla (se ajustó centrado).");
+		}
+		const float cellW = (W - pad * 3.0f) * 0.5f;
+		const float cellH = H - pad * 2.0f;
+		UpdateBrowserSourceRenderProfile(pair[0], 640, 720, 30, true);
+		UpdateBrowserSourceRenderProfile(pair[1], 640, 720, 30, true);
+		SetSceneItemBox(pair[0], pad, pad, cellW, cellH, false);
+		SetSceneItemBox(pair[1], pad * 2.0f + cellW, pad, cellW, cellH, false);
+		obs_sceneitem_set_order(pair[0], OBS_ORDER_MOVE_TOP);
+		obs_sceneitem_set_order(pair[1], OBS_ORDER_MOVE_TOP);
+		return QStringLiteral("Listo: lado a lado optimizado (640×720 por cuadro, sin bordes).");
+	}
+	if (mode == 2) {
+		// Cuadrícula 2x2: 640x360 @ 25fps por invitado -> 4x más liviano para 3-4 personas
+		std::vector<obs_sceneitem_t *> items;
+		if (col.hostCam && col.guests.size() <= 3) items.push_back(col.hostCam);
+		for (auto *g : col.guests) {
+			if (items.size() < 4) items.push_back(g);
+		}
+		const float cellW = (W - pad * 3.0f) * 0.5f;
+		const float cellH = (H - pad * 3.0f) * 0.5f;
+		for (size_t i = 0; i < items.size(); ++i) {
+			UpdateBrowserSourceRenderProfile(items[i], 640, 360, 25, true);
+			float cx = pad + float(i % 2) * (cellW + pad);
+			float cy = pad + float(i / 2) * (cellH + pad);
+			SetSceneItemBox(items[i], cx, cy, cellW, cellH, false);
+			obs_sceneitem_set_order(items[i], OBS_ORDER_MOVE_TOP);
+		}
+		return QStringLiteral("Listo: cuadrícula 2×2 optimizada (4× más ligera para varios invitados).");
+	}
+	// mode == 3: Esquina PIP (tu cámara grande + invitado ligero 640x360 en esquina inferior derecha)
+	if (col.hostCam) {
+		SetSceneItemBox(col.hostCam, 0.0f, 0.0f, W, H, false);
+	}
+	UpdateBrowserSourceRenderProfile(col.guests[0], 640, 360, 30, true);
+	const float pipW = W * 0.34f;
+	const float pipH = pipW * 9.0f / 16.0f;
+	SetSceneItemBox(col.guests[0], W - pipW - 24.0f, H - pipH - 24.0f, pipW, pipH, false);
+	obs_sceneitem_set_order(col.guests[0], OBS_ORDER_MOVE_TOP);
+	return QStringLiteral("Listo: invitado en esquina (PIP) optimizado.");
 }
 
