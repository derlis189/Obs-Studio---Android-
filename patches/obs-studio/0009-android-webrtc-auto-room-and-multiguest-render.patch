+static bool IsWebRtcGuestVisibleInCurrentScene(const QString &sourceName)
+{
+	OBSSourceAutoRelease curSceneSrc = obs_frontend_get_current_scene();
+	obs_scene_t *scene = curSceneSrc ? obs_scene_from_source(curSceneSrc) : nullptr;
+	if (!scene) return false;
+	obs_sceneitem_t *item = obs_scene_find_source(scene, sourceName.toUtf8().constData());
+	return item && obs_sceneitem_visible(item);
+}
