+static void SetSceneItemBox(obs_sceneitem_t *item, float x, float y, float w, float h, bool cropFill)
+{
+	if (!item) return;
+	vec2 pos{x, y};
+	vec2 bounds{std::max(64.0f, w), std::max(64.0f, h)};
+	obs_sceneitem_set_alignment(item, OBS_ALIGN_TOP | OBS_ALIGN_LEFT);
+	obs_sceneitem_set_rot(item, 0.0f);
+	obs_sceneitem_set_pos(item, &pos);
+	obs_sceneitem_set_bounds_type(item, cropFill ? OBS_BOUNDS_SCALE_OUTER : OBS_BOUNDS_SCALE_INNER);
+	obs_sceneitem_set_bounds_alignment(item, OBS_ALIGN_CENTER);
+	obs_sceneitem_set_bounds(item, &bounds);
+	obs_sceneitem_set_visible(item, true);
+}
+
+static void UpdateBrowserSourceRenderProfile(obs_sceneitem_t *item, int width, int height, int fps, bool roundedCoverCss)
+{
+	if (!item) return;
+	obs_source_t *src = obs_sceneitem_get_source(item);
+	if (!src) return;
+	const char *uid = obs_source_get_unversioned_id(src);
+	if (!uid || std::strcmp(uid, "browser_source") != 0) return;
+
+	obs_data_t *cur = obs_source_get_settings(src);
+	if (!cur) return;
+	const int curW = int(obs_data_get_int(cur, "width"));
+	const int curH = int(obs_data_get_int(cur, "height"));
+	const int curFps = int(obs_data_get_int(cur, "fps"));
+	const char *targetCss = roundedCoverCss
+		? "body { background-color: rgba(0,0,0,0); margin: 0; overflow: hidden; } "
+		  "video { object-fit: cover !important; border-radius: 16px !important; }"
+		: "body { background-color: rgba(0,0,0,0); margin: 0; overflow: hidden; } "
+		  "video { object-fit: cover !important; }";
+	const char *curCss = obs_data_get_string(cur, "css");
+	if (curW != width || curH != height || curFps != fps || !curCss || std::strcmp(curCss, targetCss) != 0) {
+		obs_data_set_int(cur, "width", width);
+		obs_data_set_int(cur, "height", height);
+		obs_data_set_int(cur, "fps", fps);
+		obs_data_set_string(cur, "css", targetCss);
+		obs_source_update(src, cur);
+	}
+	obs_data_release(cur);
+}
