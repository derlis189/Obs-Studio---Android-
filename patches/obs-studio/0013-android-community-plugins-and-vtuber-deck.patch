diff --git a/libobs/obs-core-modules-loader-android.c b/libobs/obs-core-modules-loader-android.c
index 6378e8eb0..6fb286488 100644
--- a/libobs/obs-core-modules-loader-android.c
+++ b/libobs/obs-core-modules-loader-android.c
@@ -61,4 +61,28 @@ void load_core_modules(obs_find_module_callback2_t callback, void *data)
         bfree(switcher_data);
     }
     bfree(switcher_bin);
+
+    static const char *const extra_plugins[] = {
+        "source-clone",
+        "downstream-keyer",
+    };
+    for (unsigned int i = 0; i < sizeof(extra_plugins) / sizeof(extra_plugins[0]); ++i) {
+        struct dstr rel = {0};
+        dstr_printf(&rel, "lib%s.so", extra_plugins[i]);
+        char *p_bin = obs_android_join_path(obs_android_libraries_path(), rel.array);
+        if (p_bin && os_file_exists(p_bin)) {
+            dstr_printf(&rel, "obs-modules/core/%s", extra_plugins[i]);
+            char *p_data = obs_android_join_path(obs_android_files_path(), rel.array);
+            struct obs_module_info2 p_info = {
+                .bin_path = p_bin,
+                .data_path = p_data ? p_data : "",
+                .type = OBS_MODULE_TYPE_CORE,
+                .name = extra_plugins[i]
+            };
+            callback(data, &p_info);
+            bfree(p_data);
+        }
+        bfree(p_bin);
+        dstr_free(&rel);
+    }
 }
