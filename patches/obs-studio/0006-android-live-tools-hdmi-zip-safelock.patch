+static void OpenExternalDisplayDialog(QWidget *parent)
+{
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Salida HDMI / Pantalla Wi-Fi (Miracast / Smart View)"));
+	dlg.resize(560, 360);
+
+	auto *root = new QVBoxLayout(&dlg);
+	auto *desc = new QLabel(
+		QStringLiteral("Envía el Programa limpio (sin controles) a un monitor/proyector por cable USB-C/HDMI o por pantalla inalámbrica Wi-Fi (Miracast, Smart View, Cast). Conecta primero tu TV/proyector Wi-Fi y aparecerá automáticamente abajo."),
+		&dlg);
+	desc->setWordWrap(true);
+	root->addWidget(desc);
+
+	auto *list = new QListWidget(&dlg);
+	root->addWidget(list, 1);
+
+	auto *status = new QLabel(QStringLiteral("Buscando pantallas HDMI / Wi-Fi conectadas..."), &dlg);
+	status->setWordWrap(true);
+	root->addWidget(status);
+
+	auto *wifiBtn = new QPushButton(QStringLiteral("Conectar pantalla Wi-Fi (Miracast / Smart View)"), &dlg);
+	wifiBtn->setMinimumHeight(36);
+	wifiBtn->setStyleSheet(QStringLiteral("QPushButton { background: #0f766e; color: white; font-weight: bold; border-radius: 6px; padding: 6px 12px; }"));
+	root->addWidget(wifiBtn);
+
+	auto *btns = new QHBoxLayout();
+	auto *btnRefresh = new QPushButton(QStringLiteral("Actualizar"), &dlg);
+	auto *btnStart = new QPushButton(QStringLiteral("Iniciar salida"), &dlg);
+	btnStart->setStyleSheet(QStringLiteral("QPushButton { background: #1d4ed8; color: white; font-weight: bold; border-radius: 6px; padding: 6px 12px; }"));
+	auto *btnStop = new QPushButton(QStringLiteral("Detener"), &dlg);
+	auto *btnClose = new QPushButton(QStringLiteral("Cerrar"), &dlg);
+	btns->addWidget(btnRefresh);
+	btns->addWidget(btnStart);
+	btns->addWidget(btnStop);
+	btns->addWidget(btnClose);
+	root->addLayout(btns);
+
+	auto refreshDisplays = [&]() {
+		const int prevId = list->currentItem() ? list->currentItem()->data(Qt::UserRole).toInt() : -1;
+		list->clear();
+		void *jni = FindAndroidJni();
+		if (!jni) {
+			status->setText(QStringLiteral("Puente JNI no disponible."));
+			btnStart->setEnabled(false);
+			return;
+		}
+		using ListFn = bool (*)(char *, size_t);
+		auto fn = reinterpret_cast<ListFn>(dlsym(jni, "obs_android_list_external_displays"));
+		char buf[4096] = {};
+		if (!fn || !fn(buf, sizeof(buf))) {
+			status->setText(QStringLiteral("No se pudieron consultar las pantallas externas."));
+			btnStart->setEnabled(false);
+			return;
+		}
+		auto arr = nlohmann::json::parse(buf, nullptr, false);
+		if (arr.is_discarded() || !arr.is_array() || arr.empty()) {
+			status->setText(QStringLiteral("No hay pantallas HDMI ni Wi-Fi (Miracast/Smart View) conectadas todavía."));
+			btnStart->setEnabled(false);
+			return;
+		}
+		int selRow = 0;
+		for (const auto &d : arr) {
+			const int id = d.value("id", -1);
+			const QString name = QString::fromStdString(d.value("name", std::string("Pantalla externa")));
+			const int w = d.value("width", 0);
+			const int h = d.value("height", 0);
+			const bool active = d.value("active", false);
+			auto *item = new QListWidgetItem(
+				QStringLiteral("%1 (%2×%3)%4").arg(name).arg(w).arg(h).arg(active ? " [ACTIVA]" : ""),
+				list);
+			item->setData(Qt::UserRole, id);
+			if (id == prevId)
+				selRow = list->count() - 1;
+		}
+		list->setCurrentRow(selRow);
+		btnStart->setEnabled(true);
+		status->setText(QStringLiteral("Se detectó %1 pantalla(s) externa(s) HDMI / Wi-Fi.").arg(list->count()));
+	};
+
+	QObject::connect(wifiBtn, &QPushButton::clicked, &dlg, [&]() {
+		if (void *jni = FindAndroidJni()) {
+			if (auto fn = reinterpret_cast<void (*)()>(dlsym(jni, "obs_android_open_wireless_display_settings"))) {
+				fn();
+			}
+		}
+	});
+	QObject::connect(btnRefresh, &QPushButton::clicked, &dlg, refreshDisplays);
+	QObject::connect(btnStart, &QPushButton::clicked, &dlg, [&]() {
+		auto *it = list->currentItem();
+		if (!it) return;
+		const int id = it->data(Qt::UserRole).toInt();
+		bool ok = false;
+		if (void *jni = FindAndroidJni()) {
+			using StartFn = bool (*)(int);
+			if (auto fn = reinterpret_cast<StartFn>(dlsym(jni, "obs_android_start_external_display"))) {
+				ok = fn(id);
+			}
+		}
+		refreshDisplays();
+		status->setText(ok ? QStringLiteral("Salida limpia de Programa activa en la pantalla externa.")
+				   : QStringLiteral("No se pudo iniciar la salida en esa pantalla externa."));
+	});
+	QObject::connect(btnStop, &QPushButton::clicked, &dlg, [&]() {
+		if (void *jni = FindAndroidJni()) {
+			if (auto fn = reinterpret_cast<void (*)()>(dlsym(jni, "obs_android_stop_external_display"))) {
+				fn();
+			}
+		}
+		refreshDisplays();
+		status->setText(QStringLiteral("Salida externa detenida."));
+	});
+	QObject::connect(btnClose, &QPushButton::clicked, &dlg, &QDialog::accept);
+
+	auto *pollTimer = new QTimer(&dlg);
+	pollTimer->setInterval(2000);
+	QObject::connect(pollTimer, &QTimer::timeout, &dlg, refreshDisplays);
+	pollTimer->start();
+
+	refreshDisplays();
+	dlg.exec();
+}
