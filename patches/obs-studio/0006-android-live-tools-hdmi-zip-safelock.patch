+			auto *lbl = new QLabel(QString::fromLatin1(ch), box);
+			lbl->setStyleSheet(QStringLiteral("color: %1; font-weight: bold;").arg(QString::fromLatin1(colorHex)));
+			auto *s = new QSlider(Qt::Horizontal, box);
+			s->setRange(minV, maxV);
+			s->setValue(defV);
+			auto *v = new QLabel(QString::number(defV / 100.0, 'f', 2), box);
+			v->setMinimumWidth(38);
+			v->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+			form->addWidget(lbl, row, 0);
+			form->addWidget(s, row, 1);
+			form->addWidget(v, row, 2);
+			*outS = s;
+			*outL = v;
+		};
+		addCh(0, "R", "#f87171", &bg.r, &bg.lr);
+		addCh(1, "G", "#4ade80", &bg.g, &bg.lg);
+		addCh(2, "B", "#60a5fa", &bg.b, &bg.lb);
+		addCh(3, "Y", "#f8fafc", &bg.y, &bg.ly);
+		barsRow->addWidget(box, 1);
+		return bg;
+	};
+
+	BarGroup bgLift = makeBarsColumn(QStringLiteral("Lift (Sombras)"), -50, 50, 0);
+	BarGroup bgGamma = makeBarsColumn(QStringLiteral("Gamma (Medios)"), -80, 80, 0);
+	BarGroup bgGain = makeBarsColumn(QStringLiteral("Gain (Altas luces)"), 0, 200, 100);
+	controlsLayout->addWidget(barsPage);
+
+	// Global sliders: Hue, Saturation, Temperature, Tint
+	auto *globalBox = new QGroupBox(QStringLiteral("Matiz, Saturación y Balance de Blancos"), controlsHost);
+	auto *globalGrid = new QGridLayout(globalBox);
+	globalGrid->setContentsMargins(8, 6, 8, 6);
+	globalGrid->setHorizontalSpacing(10);
+	globalGrid->setVerticalSpacing(4);
+
+	auto makeGlobalSlider = [&](int row, int colBase, const QString &lblText, int minV, int maxV, int defV,
+				    QSlider **outS, QLabel **outVal) {
+		auto *l = new QLabel(lblText, globalBox);
