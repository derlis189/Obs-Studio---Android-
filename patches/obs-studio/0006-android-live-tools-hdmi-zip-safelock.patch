+class VmixColorWheelWidget : public QWidget {
+public:
+	std::function<void(double, double)> onChanged;
+
+	explicit VmixColorWheelWidget(const QString &title, QWidget *parent = nullptr)
+		: QWidget(parent), m_title(title)
+	{
+		setMinimumSize(136, 136);
+		setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Expanding);
+	}
+
+	void setPos(double nx, double ny)
+	{
+		double len = std::hypot(nx, ny);
+		if (len > 1.0) {
+			nx /= len;
+			ny /= len;
+		}
+		m_nx = nx;
+		m_ny = ny;
+		update();
+	}
+
+	double normX() const { return m_nx; }
+	double normY() const { return m_ny; }
+
+protected:
+	void paintEvent(QPaintEvent *) override
+	{
+		QPainter p(this);
+		p.setRenderHint(QPainter::Antialiasing, true);
+		const int side = std::max(40, std::min(width(), height()) - 8);
+		const int cx = width() / 2;
+		const int cy = height() / 2;
+		const int r = side / 2;
+
+		if (m_cache.width() != side || m_cache.height() != side) {
+			m_cache = QImage(side, side, QImage::Format_ARGB32_Premultiplied);
+			m_cache.fill(Qt::transparent);
+			const double half = side * 0.5;
+			for (int y = 0; y < side; ++y) {
+				auto *scan = reinterpret_cast<QRgb *>(m_cache.scanLine(y));
+				const double dy = (y + 0.5 - half) / half;
+				for (int x = 0; x < side; ++x) {
+					const double dx = (x + 0.5 - half) / half;
+					const double dist = std::hypot(dx, dy);
+					if (dist <= 1.0) {
+						double deg = std::atan2(-dy, dx) * 180.0 / 3.14159265358979323846;
+						if (deg < 0.0)
+							deg += 360.0;
+						// Soft dark center ring like vMix color wheels
+						QColor col = QColor::fromHsvF(deg / 360.0, std::pow(dist, 0.85), 0.25 + 0.72 * dist);
+						double edgeAlpha = dist > 0.96 ? std::clamp((1.0 - dist) / 0.04, 0.0, 1.0) : 1.0;
+						col.setAlphaF(edgeAlpha);
+						scan[x] = qPremultiply(col.rgba());
+					} else {
+						scan[x] = 0;
+					}
+				}
+			}
+		}
+
+		p.drawImage(cx - r, cy - r, m_cache);
+
+		// Subtle ring & crosshairs
+		p.setPen(QPen(QColor(255, 255, 255, 70), 1.2));
+		p.drawEllipse(QPointF(cx, cy), r - 1.0, r - 1.0);
+		p.setPen(QPen(QColor(255, 255, 255, 40), 1.0));
+		p.drawLine(cx - r + 6, cy, cx + r - 6, cy);
+		p.drawLine(cx, cy - r + 6, cx, cy + r - 6);
+
+		// Draggable dot
+		const double px = cx + m_nx * (r - 6);
+		const double py = cy + m_ny * (r - 6);
+		p.setPen(QPen(QColor(15, 23, 42, 230), 2.5));
+		p.setBrush(Qt::white);
+		p.drawEllipse(QPointF(px, py), 7.0, 7.0);
+	}
+
+	void mousePressEvent(QMouseEvent *e) override
+	{
+		if (e->button() == Qt::LeftButton) {
+			updateFromPoint(e->position());
+			e->accept();
+		}
+	}
+
+	void mouseMoveEvent(QMouseEvent *e) override
+	{
+		if (e->buttons() & Qt::LeftButton) {
+			updateFromPoint(e->position());
+			e->accept();
+		}
+	}
+
+	void mouseDoubleClickEvent(QMouseEvent *e) override
+	{
+		if (e->button() == Qt::LeftButton) {
+			setPos(0.0, 0.0);
+			if (onChanged)
+				onChanged(0.0, 0.0);
+			e->accept();
+		}
+	}
+
+private:
+	void updateFromPoint(const QPointF &pt)
+	{
+		const int side = std::max(40, std::min(width(), height()) - 8);
+		const double r = std::max(10.0, side * 0.5 - 6.0);
+		double nx = (pt.x() - width() * 0.5) / r;
+		double ny = (pt.y() - height() * 0.5) / r;
+		double len = std::hypot(nx, ny);
+		if (len > 1.0) {
+			nx /= len;
+			ny /= len;
+		}
+		m_nx = nx;
+		m_ny = ny;
+		update();
+		if (onChanged)
+			onChanged(m_nx, m_ny);
+	}
+
+	QString m_title;
+	QImage m_cache;
+	double m_nx = 0.0;
+	double m_ny = 0.0;
+};
+
+static void OpenVmixColorCorrectionDialog(QWidget *parent)
+{
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Ruedas de color (Lift / Gamma / Gain)"));
+	if (parent && parent->screen()) {
+		dlg.resize(QSize(860, 620).boundedTo(parent->screen()->availableGeometry().size()));
+	} else {
+		dlg.resize(820, 560);
+	}
+
+	auto *root = new QVBoxLayout(&dlg);
+	root->setContentsMargins(10, 8, 10, 8);
+	root->setSpacing(6);
+
+	// Top bar: source selector + Active + Split compare + View toggle (Wheels / RGB Bars)
+	auto *topRow = new QHBoxLayout();
+	auto *srcLabel = new QLabel(QStringLiteral("Fuente:"), &dlg);
+	auto *srcCombo = new QComboBox(&dlg);
+	srcCombo->setMinimumWidth(180);
+	auto *chkEnabled = new QCheckBox(QStringLiteral("Activo"), &dlg);
+	chkEnabled->setChecked(true);
+	auto *chkSplit = new QCheckBox(QStringLiteral("Comparar 50%"), &dlg);
+	auto *btnMode = new QPushButton(QStringLiteral("Vista: Ruedas"), &dlg);
+	btnMode->setCheckable(true);
+	btnMode->setStyleSheet(QStringLiteral("QPushButton { background: #1e293b; color: white; border: 1px solid #475569; border-radius: 5px; padding: 4px 10px; font-weight: bold; }"));
+	auto *presetCombo = new QComboBox(&dlg);
+	presetCombo->addItems({
+		QStringLiteral("Presets..."),
+		QStringLiteral("Neutral (Restablecer)"),
+		QStringLiteral("Cálido / Iglesia"),
+		QStringLiteral("Cine / Contraste"),
+		QStringLiteral("Broadcast Vivo"),
+		QStringLiteral("Corregir luz fría"),
+		QStringLiteral("Blanco y Negro"),
+	});
+	topRow->addWidget(srcLabel);
+	topRow->addWidget(srcCombo, 1);
+	topRow->addWidget(chkEnabled);
+	topRow->addWidget(chkSplit);
+	topRow->addWidget(btnMode);
+	topRow->addWidget(presetCombo);
+	root->addLayout(topRow);
+
+	// Collect all video sources (preferring selected item in current scene)
+	std::string preferredName;
+	if (obs_source_t *curSceneSrc = obs_frontend_get_current_scene()) {
+		if (obs_scene_t *scene = obs_scene_from_source(curSceneSrc)) {
+			obs_scene_enum_items(
+				scene,
+				[](obs_scene_t *, obs_sceneitem_t *item, void *param) {
+					auto *outName = static_cast<std::string *>(param);
+					if (!outName->empty())
+						return false;
+					if (obs_sceneitem_selected(item)) {
+						if (obs_source_t *s = obs_sceneitem_get_source(item)) {
+							if ((obs_source_get_output_flags(s) & OBS_SOURCE_VIDEO) != 0 &&
+							    obs_source_get_name(s)) {
+								*outName = obs_source_get_name(s);
+								return false;
+							}
+						}
+					}
+					return true;
+				},
+				&preferredName);
+		}
+		obs_source_release(curSceneSrc);
+	}
+
+	struct SrcListCtx {
+		QComboBox *combo;
+		int preferredIdx = -1;
+		std::string preferredName;
+	} listCtx{srcCombo, -1, preferredName};
+
+	obs_enum_sources(
+		[](void *param, obs_source_t *src) {
+			auto *ctx = static_cast<SrcListCtx *>(param);
+			if (!src || (obs_source_get_output_flags(src) & OBS_SOURCE_VIDEO) == 0)
+				return true;
+			const char *nm = obs_source_get_name(src);
+			if (!nm || !*nm)
+				return true;
+			if (!ctx->preferredName.empty() && ctx->preferredName == nm)
+				ctx->preferredIdx = ctx->combo->count();
+			ctx->combo->addItem(QString::fromUtf8(nm));
+			return true;
+		},
+		&listCtx);
+
+	if (srcCombo->count() == 0) {
+		QMessageBox::information(parent, QStringLiteral("Ruedas de color (LGG)"),
+					 QStringLiteral("Agrega primero una fuente de video (cámara, multimedia, navegador o captura) para corregir su color."));
+		return;
+	}
+	if (listCtx.preferredIdx >= 0)
+		srcCombo->setCurrentIndex(listCtx.preferredIdx);
+
+	// Live preview of the selected source
+	struct PreviewState {
+		std::mutex mutex;
+		OBSWeakSource weakSrc;
+	};
+	auto previewState = std::make_shared<PreviewState>();
+	auto *previewDisplay = new OBSQTDisplay(&dlg);
+	previewDisplay->setMinimumHeight(130);
+	previewDisplay->setMaximumHeight(200);
+	previewDisplay->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+	root->addWidget(previewDisplay);
+
+	auto drawPreview = [](void *data, uint32_t cx, uint32_t cy) {
+		auto *st = static_cast<PreviewState *>(data);
+		OBSSource src;
+		{
+			std::lock_guard<std::mutex> lock(st->mutex);
+			src = OBSGetStrongRef(st->weakSrc);
+		}
+		if (!src || !cx || !cy)
+			return;
+		const uint32_t sw = std::max(1u, obs_source_get_width(src));
+		const uint32_t sh = std::max(1u, obs_source_get_height(src));
+		const float srcAspect = float(sw) / float(sh);
+		const float dstAspect = float(cx) / float(cy);
+		int vx = 0, vy = 0, vw = int(cx), vh = int(cy);
+		if (srcAspect > dstAspect) {
+			vh = int(float(cx) / srcAspect);
+			vy = (int(cy) - vh) / 2;
+		} else {
+			vw = int(float(cy) * srcAspect);
+			vx = (int(cx) - vw) / 2;
+		}
+		gs_viewport_push();
+		gs_projection_push();
+		gs_set_viewport(vx, vy, std::max(1, vw), std::max(1, vh));
+		gs_ortho(0.0f, float(sw), 0.0f, float(sh), -100.0f, 100.0f);
+		obs_source_video_render(src);
+		gs_projection_pop();
+		gs_viewport_pop();
+	};
+	QObject::connect(previewDisplay, &OBSQTDisplay::DisplayCreated, &dlg, [previewDisplay, previewState, drawPreview]() {
+		if (obs_display_t *d = previewDisplay->GetDisplay()) {
+			obs_display_add_draw_callback(d, drawPreview, previewState.get());
+			obs_display_set_background_color(d, 0x0B1120);
+		}
+	});
+
+	// Scrollable controls container (wheels/bars + Hue/Sat/Temp/Tint)
+	auto *scroll = new QScrollArea(&dlg);
+	scroll->setWidgetResizable(true);
+	scroll->setFrameShape(QFrame::NoFrame);
+	auto *controlsHost = new QWidget(scroll);
+	auto *controlsLayout = new QVBoxLayout(controlsHost);
+	controlsLayout->setContentsMargins(2, 2, 2, 2);
+	controlsLayout->setSpacing(8);
+	scroll->setWidget(controlsHost);
+	root->addWidget(scroll, 1);
+
+	struct ColorParams {
+		double liftR = 0.0, liftG = 0.0, liftB = 0.0, liftY = 0.0;
+		double gammaR = 0.0, gammaG = 0.0, gammaB = 0.0, gammaY = 0.0;
+		double gainR = 1.0, gainG = 1.0, gainB = 1.0, gainY = 1.0;
+		double hue = 0.0, sat = 0.0, temp = 0.0, tint = 0.0;
+		bool split = false;
+	};
+	auto state = std::make_shared<ColorParams>();
+	auto currentSource = std::make_shared<OBSSource>();
+	auto currentFilter = std::make_shared<OBSSource>();
+	auto syncingUi = std::make_shared<bool>(false);
+
+	// Mode 1: 3 vMix Color Wheels (Lift, Gamma, Gain)
+	auto *wheelsPage = new QWidget(controlsHost);
+	auto *wheelsRow = new QHBoxLayout(wheelsPage);
+	wheelsRow->setContentsMargins(0, 0, 0, 0);
+	wheelsRow->setSpacing(10);
+
+	auto makeWheelColumn = [&](const QString &title, int yMin, int yMax, int yDef,
+				   VmixColorWheelWidget **outWheel, QSlider **outYSlider, QLabel **outYVal,
+				   QPushButton **outReset) {
+		auto *box = new QGroupBox(title, wheelsPage);
+		auto *v = new QVBoxLayout(box);
+		v->setContentsMargins(6, 6, 6, 6);
+		v->setSpacing(4);
+		auto *wheel = new VmixColorWheelWidget(title, box);
+		v->addWidget(wheel, 1);
+
+		auto *yRow = new QHBoxLayout();
+		auto *yLbl = new QLabel(QStringLiteral("Y:"), box);
+		auto *ySlider = new QSlider(Qt::Horizontal, box);
+		ySlider->setRange(yMin, yMax);
+		ySlider->setValue(yDef);
+		auto *yVal = new QLabel(QStringLiteral("0.00"), box);
+		yVal->setMinimumWidth(38);
+		yVal->setAlignment(Qt::AlignRight | Qt::AlignVCenter);
+		yRow->addWidget(yLbl);
+		yRow->addWidget(ySlider, 1);
+		yRow->addWidget(yVal);
+		v->addLayout(yRow);
+
+		auto *rst = new QPushButton(QStringLiteral("Reset"), box);
+		rst->setMaximumHeight(26);
+		v->addWidget(rst);
+
+		*outWheel = wheel;
+		*outYSlider = ySlider;
+		*outYVal = yVal;
+		*outReset = rst;
+		wheelsRow->addWidget(box, 1);
+	};
+
+	VmixColorWheelWidget *wLift = nullptr, *wGamma = nullptr, *wGain = nullptr;
+	QSlider *slLiftY = nullptr, *slGammaY = nullptr, *slGainY = nullptr;
+	QLabel *lbLiftY = nullptr, *lbGammaY = nullptr, *lbGainY = nullptr;
+	QPushButton *btLiftRst = nullptr, *btGammaRst = nullptr, *btGainRst = nullptr;
+
+	makeWheelColumn(QStringLiteral("Lift (Sombras)"), -50, 50, 0, &wLift, &slLiftY, &lbLiftY, &btLiftRst);
+	makeWheelColumn(QStringLiteral("Gamma (Medios)"), -80, 80, 0, &wGamma, &slGammaY, &lbGammaY, &btGammaRst);
+	makeWheelColumn(QStringLiteral("Gain (Altas luces)"), 0, 200, 100, &wGain, &slGainY, &lbGainY, &btGainRst);
+	controlsLayout->addWidget(wheelsPage);
+
+	// Mode 2: vMix RGB Colour Bars
+	auto *barsPage = new QWidget(controlsHost);
+	barsPage->setVisible(false);
+	auto *barsRow = new QHBoxLayout(barsPage);
+	barsRow->setContentsMargins(0, 0, 0, 0);
+	barsRow->setSpacing(10);
+
+	struct BarGroup {
+		QSlider *r = nullptr, *g = nullptr, *b = nullptr, *y = nullptr;
+		QLabel *lr = nullptr, *lg = nullptr, *lb = nullptr, *ly = nullptr;
+	};
+	auto makeBarsColumn = [&](const QString &title, int minV, int maxV, int defV) -> BarGroup {
+		BarGroup bg{};
+		auto *box = new QGroupBox(title, barsPage);
+		auto *form = new QGridLayout(box);
+		form->setContentsMargins(6, 6, 6, 6);
+		form->setSpacing(4);
