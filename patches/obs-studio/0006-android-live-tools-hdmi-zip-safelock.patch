+		*outS = s;
+		*outVal = v;
+	};
+
+	QSlider *slHue = nullptr, *slSat = nullptr, *slTemp = nullptr, *slTint = nullptr;
+	QLabel *lbHue = nullptr, *lbSat = nullptr, *lbTemp = nullptr, *lbTint = nullptr;
+	makeGlobalSlider(0, 0, QStringLiteral("Matiz (Hue)"), -180, 180, 0, &slHue, &lbHue);
+	makeGlobalSlider(0, 3, QStringLiteral("Saturación"), -100, 100, 0, &slSat, &lbSat);
+	makeGlobalSlider(1, 0, QStringLiteral("Temperatura"), -100, 100, 0, &slTemp, &lbTemp);
+	makeGlobalSlider(1, 3, QStringLiteral("Tinte"), -100, 100, 0, &slTint, &lbTint);
+	controlsLayout->addWidget(globalBox);
+
+	// Bottom bar: Reset All + Close
+	auto *bottomRow = new QHBoxLayout();
+	auto *btnResetAll = new QPushButton(QStringLiteral("Restablecer todo"), &dlg);
+	auto *btnClose = new QPushButton(QStringLiteral("Cerrar"), &dlg);
+	btnClose->setStyleSheet(QStringLiteral("QPushButton { background: #1d4ed8; color: white; font-weight: bold; border-radius: 6px; padding: 6px 18px; }"));
+	bottomRow->addWidget(btnResetAll);
+	bottomRow->addStretch(1);
+	bottomRow->addWidget(btnClose);
+	root->addLayout(bottomRow);
+
+	// Projection helpers between 2D color wheel and (R,G,B) offsets
+	auto wheelToRgb = [](double nx, double ny, double scale, double base, double &r, double &g, double &b) {
+		const double uy = -ny;
+		r = base + scale * nx;
+		g = base + scale * (-0.5 * nx + 0.8660254 * uy);
+		b = base + scale * (-0.5 * nx - 0.8660254 * uy);
+	};
+	auto rgbToWheel = [](double r, double g, double b, double scale, double &nx, double &ny) {
+		const double mean = (r + g + b) / 3.0;
+		const double cr = r - mean;
+		const double cg = g - mean;
+		const double cb = b - mean;
+		nx = cr / std::max(0.001, scale);
+		ny = -(cg - cb) / (1.7320508 * std::max(0.001, scale));
+	};
+
+	auto pushToFilter = [&]() {
+		if (!(*currentFilter))
+			return;
+		OBSDataAutoRelease s = obs_data_create();
+		obs_data_set_double(s, "lift_r", state->liftR);
+		obs_data_set_double(s, "lift_g", state->liftG);
+		obs_data_set_double(s, "lift_b", state->liftB);
+		obs_data_set_double(s, "lift_y", state->liftY);
+		obs_data_set_double(s, "gamma_r", state->gammaR);
+		obs_data_set_double(s, "gamma_g", state->gammaG);
+		obs_data_set_double(s, "gamma_b", state->gammaB);
+		obs_data_set_double(s, "gamma_y", state->gammaY);
+		obs_data_set_double(s, "gain_r", state->gainR);
+		obs_data_set_double(s, "gain_g", state->gainG);
+		obs_data_set_double(s, "gain_b", state->gainB);
+		obs_data_set_double(s, "gain_y", state->gainY);
+		obs_data_set_double(s, "hue", state->hue);
+		obs_data_set_double(s, "saturation", state->sat);
+		obs_data_set_double(s, "temperature", state->temp);
+		obs_data_set_double(s, "tint", state->tint);
+		obs_data_set_bool(s, "split_compare", state->split);
+		obs_source_update(*currentFilter, s);
+	};
+
+	auto refreshUiFromState = [&]() {
+		*syncingUi = true;
+		double nx = 0.0, ny = 0.0;
+		rgbToWheel(state->liftR, state->liftG, state->liftB, 0.35, nx, ny);
+		wLift->setPos(nx, ny);
+		rgbToWheel(state->gammaR, state->gammaG, state->gammaB, 0.55, nx, ny);
+		wGamma->setPos(nx, ny);
+		rgbToWheel(state->gainR, state->gainG, state->gainB, 0.65, nx, ny);
+		wGain->setPos(nx, ny);
+
+		slLiftY->setValue(int(std::lround(state->liftY * 100.0)));
+		lbLiftY->setText(QString::number(state->liftY, 'f', 2));
+		slGammaY->setValue(int(std::lround(state->gammaY * 100.0)));
+		lbGammaY->setText(QString::number(state->gammaY, 'f', 2));
+		slGainY->setValue(int(std::lround(state->gainY * 100.0)));
+		lbGainY->setText(QString::number(state->gainY, 'f', 2));
+
+		auto syncBar = [](BarGroup &bg, double r, double g, double b, double y) {
+			bg.r->setValue(int(std::lround(r * 100.0))); bg.lr->setText(QString::number(r, 'f', 2));
+			bg.g->setValue(int(std::lround(g * 100.0))); bg.lg->setText(QString::number(g, 'f', 2));
+			bg.b->setValue(int(std::lround(b * 100.0))); bg.lb->setText(QString::number(b, 'f', 2));
+			bg.y->setValue(int(std::lround(y * 100.0))); bg.ly->setText(QString::number(y, 'f', 2));
+		};
+		syncBar(bgLift, state->liftR, state->liftG, state->liftB, state->liftY);
+		syncBar(bgGamma, state->gammaR, state->gammaG, state->gammaB, state->gammaY);
+		syncBar(bgGain, state->gainR, state->gainG, state->gainB, state->gainY);
+
+		slHue->setValue(int(std::lround(state->hue)));
+		lbHue->setText(QStringLiteral("%1°").arg(int(std::lround(state->hue))));
+		slSat->setValue(int(std::lround(state->sat * 100.0)));
+		lbSat->setText(QStringLiteral("%1%").arg(int(std::lround((1.0 + state->sat) * 100.0))));
+		slTemp->setValue(int(std::lround(state->temp * 100.0)));
+		lbTemp->setText(QString::number(state->temp, 'f', 2));
+		slTint->setValue(int(std::lround(state->tint * 100.0)));
+		lbTint->setText(QString::number(state->tint, 'f', 2));
+		chkSplit->setChecked(state->split);
+		*syncingUi = false;
+	};
+
+	auto bindSourceByName = [&](const QString &name) {
+		if (*currentSource) {
+			obs_source_dec_showing(*currentSource);
+		}
+		*currentFilter = nullptr;
+		*currentSource = nullptr;
+		OBSSourceAutoRelease src = obs_get_source_by_name(name.toUtf8().constData());
+		if (!src)
+			return;
+		*currentSource = src.Get();
+		obs_source_inc_showing(*currentSource);
+		{
+			std::lock_guard<std::mutex> lock(previewState->mutex);
+			previewState->weakSrc = OBSGetWeakRef(*currentSource);
+		}
+
+		// Find existing android_vmix_color_filter or attach a new one
+		OBSSource found;
+		obs_source_enum_filters(
+			*currentSource,
+			[](obs_source_t *, obs_source_t *filter, void *param) {
+				auto *out = static_cast<OBSSource *>(param);
+				if (!(*out) && filter && obs_source_get_id(filter) &&
+				    std::strcmp(obs_source_get_id(filter), "android_vmix_color_filter") == 0) {
+					*out = filter;
+				}
+			},
+			&found);
+		if (!found) {
+			OBSSourceAutoRelease created =
+				obs_source_create("android_vmix_color_filter", "Corrección de color (Ruedas LGG)", nullptr, nullptr);
+			if (created) {
+				obs_source_filter_add(*currentSource, created);
+				found = created.Get();
+			}
+		}
+		*currentFilter = found;
+		if (*currentFilter) {
+			OBSDataAutoRelease s = obs_source_get_settings(*currentFilter);
+			state->liftR = obs_data_get_double(s, "lift_r");
+			state->liftG = obs_data_get_double(s, "lift_g");
+			state->liftB = obs_data_get_double(s, "lift_b");
+			state->liftY = obs_data_get_double(s, "lift_y");
+			state->gammaR = obs_data_get_double(s, "gamma_r");
+			state->gammaG = obs_data_get_double(s, "gamma_g");
+			state->gammaB = obs_data_get_double(s, "gamma_b");
+			state->gammaY = obs_data_get_double(s, "gamma_y");
+			state->gainR = obs_data_get_double(s, "gain_r");
+			state->gainG = obs_data_get_double(s, "gain_g");
+			state->gainB = obs_data_get_double(s, "gain_b");
+			state->gainY = obs_data_get_double(s, "gain_y");
+			state->hue = obs_data_get_double(s, "hue");
+			state->sat = obs_data_get_double(s, "saturation");
+			state->temp = obs_data_get_double(s, "temperature");
+			state->tint = obs_data_get_double(s, "tint");
+			state->split = obs_data_get_bool(s, "split_compare");
+			*syncingUi = true;
+			chkEnabled->setChecked(obs_source_enabled(*currentFilter));
+			*syncingUi = false;
+			refreshUiFromState();
+		}
+	};
+
+	// Wire color wheels
+	wLift->onChanged = [&](double nx, double ny) {
+		if (*syncingUi) return;
+		wheelToRgb(nx, ny, 0.35, 0.0, state->liftR, state->liftG, state->liftB);
+		refreshUiFromState();
+		pushToFilter();
+	};
+	wGamma->onChanged = [&](double nx, double ny) {
+		if (*syncingUi) return;
+		wheelToRgb(nx, ny, 0.55, 0.0, state->gammaR, state->gammaG, state->gammaB);
+		refreshUiFromState();
+		pushToFilter();
+	};
+	wGain->onChanged = [&](double nx, double ny) {
+		if (*syncingUi) return;
+		wheelToRgb(nx, ny, 0.65, 1.0, state->gainR, state->gainG, state->gainB);
+		refreshUiFromState();
+		pushToFilter();
+	};
+
+	// Wire wheel Y sliders & per-wheel Reset buttons
+	QObject::connect(slLiftY, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->liftY = v / 100.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(slGammaY, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->gammaY = v / 100.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(slGainY, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->gainY = v / 100.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(btLiftRst, &QPushButton::clicked, &dlg, [&]() {
+		state->liftR = state->liftG = state->liftB = state->liftY = 0.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(btGammaRst, &QPushButton::clicked, &dlg, [&]() {
+		state->gammaR = state->gammaG = state->gammaB = state->gammaY = 0.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(btGainRst, &QPushButton::clicked, &dlg, [&]() {
+		state->gainR = state->gainG = state->gainB = state->gainY = 1.0;
+		refreshUiFromState();
+		pushToFilter();
+	});
+
+	// Wire RGB Bars
+	auto wireBar = [&](BarGroup &bg, double *r, double *g, double *b, double *y) {
+		QObject::connect(bg.r, &QSlider::valueChanged, &dlg, [&, r](int v) {
+			if (*syncingUi) return;
+			*r = v / 100.0; refreshUiFromState(); pushToFilter();
+		});
+		QObject::connect(bg.g, &QSlider::valueChanged, &dlg, [&, g](int v) {
+			if (*syncingUi) return;
+			*g = v / 100.0; refreshUiFromState(); pushToFilter();
+		});
+		QObject::connect(bg.b, &QSlider::valueChanged, &dlg, [&, b](int v) {
+			if (*syncingUi) return;
+			*b = v / 100.0; refreshUiFromState(); pushToFilter();
+		});
+		QObject::connect(bg.y, &QSlider::valueChanged, &dlg, [&, y](int v) {
+			if (*syncingUi) return;
+			*y = v / 100.0; refreshUiFromState(); pushToFilter();
+		});
+	};
+	wireBar(bgLift, &state->liftR, &state->liftG, &state->liftB, &state->liftY);
+	wireBar(bgGamma, &state->gammaR, &state->gammaG, &state->gammaB, &state->gammaY);
+	wireBar(bgGain, &state->gainR, &state->gainG, &state->gainB, &state->gainY);
+
+	// Wire global sliders & toggles
+	QObject::connect(slHue, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->hue = double(v); refreshUiFromState(); pushToFilter();
+	});
+	QObject::connect(slSat, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->sat = v / 100.0; refreshUiFromState(); pushToFilter();
+	});
+	QObject::connect(slTemp, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->temp = v / 100.0; refreshUiFromState(); pushToFilter();
+	});
+	QObject::connect(slTint, &QSlider::valueChanged, &dlg, [&](int v) {
+		if (*syncingUi) return;
+		state->tint = v / 100.0; refreshUiFromState(); pushToFilter();
+	});
+	QObject::connect(chkSplit, &QCheckBox::toggled, &dlg, [&](bool on) {
+		if (*syncingUi) return;
+		state->split = on; pushToFilter();
+	});
+	QObject::connect(chkEnabled, &QCheckBox::toggled, &dlg, [&](bool on) {
+		if (*syncingUi || !(*currentFilter)) return;
+		obs_source_set_enabled(*currentFilter, on);
+	});
+	QObject::connect(btnMode, &QPushButton::toggled, &dlg, [&](bool showBars) {
+		wheelsPage->setVisible(!showBars);
+		barsPage->setVisible(showBars);
+		btnMode->setText(showBars ? QStringLiteral("Vista: Barras RGB") : QStringLiteral("Vista: Ruedas"));
+	});
+	QObject::connect(presetCombo, QOverload<int>::of(&QComboBox::currentIndexChanged), &dlg, [&](int idx) {
+		if (idx <= 0) return;
+		*state = ColorParams{};
+		state->split = chkSplit->isChecked();
+		if (idx == 2) { // Cálido / Iglesia
+			state->liftY = -0.02; state->gammaY = 0.06; state->gainY = 1.04;
+			state->temp = 0.22; state->sat = 0.12;
+		} else if (idx == 3) { // Cine / Contraste
+			state->liftY = -0.06; state->liftB = 0.03; state->gammaY = -0.04;
+			state->gainY = 1.08; state->gainR = 1.04; state->sat = -0.08;
+		} else if (idx == 4) { // Broadcast Vivo
+			state->liftY = -0.03; state->gammaY = 0.05; state->gainY = 1.06;
+			state->sat = 0.22;
+		} else if (idx == 5) { // Corregir luz fría
+			state->temp = 0.35; state->tint = 0.08; state->gammaY = 0.04;
+		} else if (idx == 6) { // Blanco y Negro
+			state->sat = -1.0; state->liftY = -0.04; state->gainY = 1.06;
+		}
+		refreshUiFromState();
+		pushToFilter();
+		presetCombo->setCurrentIndex(0);
+	});
+	QObject::connect(btnResetAll, &QPushButton::clicked, &dlg, [&]() {
+		*state = ColorParams{};
+		refreshUiFromState();
+		pushToFilter();
+	});
+	QObject::connect(srcCombo, &QComboBox::currentTextChanged, &dlg, bindSourceByName);
+	QObject::connect(btnClose, &QPushButton::clicked, &dlg, &QDialog::accept);
+
+	bindSourceByName(srcCombo->currentText());
+	dlg.exec();
+
+	// Clean up preview callback and showing reference safely
+	if (obs_display_t *d = previewDisplay->GetDisplay()) {
+		obs_display_remove_draw_callback(d, drawPreview, previewState.get());
+	}
+	{
+		std::lock_guard<std::mutex> lock(previewState->mutex);
+		previewState->weakSrc = nullptr;
+	}
+	if (*currentSource) {
+		obs_source_dec_showing(*currentSource);
+	}
+}
