+static void OpenSafeLiveModeDialog(QWidget *mainWindow)
+{
+	QDialog dlg(mainWindow, Qt::Dialog | Qt::FramelessWindowHint | Qt::WindowStaysOnTopHint);
+	dlg.setProperty("androidFullScreenLock", true);
+	dlg.setModal(true);
+	dlg.setStyleSheet(QStringLiteral(
+		"QDialog { background-color: #020617; border: none; }"
+		"QLabel { color: #e2e8f0; background: transparent; }"
+		"QCheckBox { color: #cbd5e1; font-size: 13px; background: transparent; }"));
+	QScreen *scr = (mainWindow && mainWindow->screen()) ? mainWindow->screen() : QGuiApplication::primaryScreen();
+	if (scr) {
+		const QRect full = scr->geometry();
+		dlg.setMinimumSize(full.size());
+		dlg.setMaximumSize(full.size());
+		dlg.setGeometry(full);
+	} else if (mainWindow) {
+		dlg.setGeometry(mainWindow->geometry());
+	}
+
+	const bool previewWasEnabled = obs_frontend_preview_enabled();
+	bool previewPausedByLock = false;
+
+	auto *root = new QVBoxLayout(&dlg);
+	root->setContentsMargins(28, 28, 28, 28);
+	root->setSpacing(14);
+	root->addStretch(1);
+
+	auto *badge = new QLabel(&dlg);
+	badge->setAlignment(Qt::AlignCenter);
+	root->addWidget(badge);
+
+	auto *clockLbl = new QLabel(&dlg);
+	clockLbl->setAlignment(Qt::AlignCenter);
+	clockLbl->setStyleSheet(QStringLiteral("font-size: 38px; font-weight: bold; color: #f8fafc;"));
+	root->addWidget(clockLbl);
+
+	auto *sceneLbl = new QLabel(&dlg);
+	sceneLbl->setAlignment(Qt::AlignCenter);
+	sceneLbl->setStyleSheet(QStringLiteral("font-size: 16px; color: #94a3b8;"));
+	root->addWidget(sceneLbl);
+
+	auto *healthLbl = new QLabel(&dlg);
+	healthLbl->setAlignment(Qt::AlignCenter);
+	healthLbl->setStyleSheet(QStringLiteral("font-size: 13px; color: #cbd5e1;"));
+	root->addWidget(healthLbl);
+
+	auto *pausePreviewChk = new QCheckBox(
+		QStringLiteral("Pausar vista previa principal para ahorrar batería y temperatura (la emisión y grabación siguen activas)"),
+		&dlg);
+	pausePreviewChk->setChecked(previewWasEnabled);
+	root->addWidget(pausePreviewChk, 0, Qt::AlignCenter);
+
+	auto applyPreviewPause = [&](bool pause) {
+		if (pause && previewWasEnabled) {
+			obs_frontend_set_preview_enabled(false);
+			previewPausedByLock = true;
+		} else if (!pause && previewPausedByLock) {
+			obs_frontend_set_preview_enabled(true);
+			previewPausedByLock = false;
+		}
+	};
+	applyPreviewPause(pausePreviewChk->isChecked());
+	QObject::connect(pausePreviewChk, &QCheckBox::toggled, &dlg, applyPreviewPause);
+
+	auto *unlockBtn = new QPushButton(QStringLiteral("Mantener pulsado 1.2 s para desbloquear"), &dlg);
+	unlockBtn->setMinimumSize(300, 56);
+	unlockBtn->setStyleSheet(QStringLiteral(
+		"QPushButton { background: rgba(30, 41, 59, 230); color: white; font-size: 15px; font-weight: bold; "
+		"border: 1px solid rgba(148, 163, 184, 120); border-radius: 28px; padding: 0 24px; }"
+		"QPushButton:pressed { background: rgba(29, 78, 216, 240); border-color: #60a5fa; }"));
+	root->addWidget(unlockBtn, 0, Qt::AlignCenter);
+	root->addStretch(1);
+
+	auto *holdTimer = new QTimer(&dlg);
+	holdTimer->setSingleShot(true);
+	holdTimer->setInterval(1200);
+	QObject::connect(holdTimer, &QTimer::timeout, &dlg, [&]() { dlg.accept(); });
+	QObject::connect(unlockBtn, &QPushButton::pressed, &dlg, [&]() {
+		unlockBtn->setText(QStringLiteral("Manteniendo... suelta para cancelar"));
+		holdTimer->start();
+	});
+	QObject::connect(unlockBtn, &QPushButton::released, &dlg, [&]() {
+		if (holdTimer->isActive()) {
+			holdTimer->stop();
+			unlockBtn->setText(QStringLiteral("Mantener pulsado 1.2 s para desbloquear"));
+		}
+	});
+
+	auto refresh = [&]() {
+		const bool live = obs_frontend_streaming_active();
+		const bool rec = obs_frontend_recording_active();
+		if (live && rec) {
+			badge->setText(QStringLiteral("● EN VIVO  ·  ● GRABANDO  ·  PANTALLA BLOQUEADA"));
+			badge->setStyleSheet(QStringLiteral("font-size: 14px; font-weight: bold; color: #f87171;"));
+		} else if (live) {
+			badge->setText(QStringLiteral("● EN VIVO  ·  PANTALLA BLOQUEADA"));
+			badge->setStyleSheet(QStringLiteral("font-size: 14px; font-weight: bold; color: #f87171;"));
+		} else if (rec) {
+			badge->setText(QStringLiteral("● GRABANDO  ·  PANTALLA BLOQUEADA"));
+			badge->setStyleSheet(QStringLiteral("font-size: 14px; font-weight: bold; color: #fbbf24;"));
+		} else {
+			badge->setText(QStringLiteral("MODO DIRECTO SEGURO  ·  TOQUES BLOQUEADOS"));
+			badge->setStyleSheet(QStringLiteral("font-size: 14px; font-weight: bold; color: #60a5fa;"));
+		}
+		clockLbl->setText(QTime::currentTime().toString(QStringLiteral("HH:mm:ss")));
+		if (obs_source_t *cur = obs_frontend_get_current_scene()) {
+			sceneLbl->setText(QStringLiteral("Escena activa: %1").arg(QString::fromUtf8(obs_source_get_name(cur))));
+			obs_source_release(cur);
+		}
+		if (void *h = FindAndroidJni()) {
+			using HealthFn = bool (*)(char *, size_t);
+			if (auto fn = reinterpret_cast<HealthFn>(dlsym(h, "obs_android_get_device_health"))) {
+				char buf[1024] = {};
+				if (fn(buf, sizeof(buf)) && buf[0]) {
+					auto j = nlohmann::json::parse(buf, nullptr, false);
+					if (!j.is_discarded()) {
+						healthLbl->setText(QStringLiteral("Batería: %1%%2  ·  Temperatura: %3 °C")
+									   .arg(j.value("battery", -1))
+									   .arg(j.value("charging", false) ? "+" : "")
+									   .arg(j.value("temp_c", 0.0), 0, 'f', 1));
+					}
+				}
+			}
+		}
+	};
+	auto *tick = new QTimer(&dlg);
+	tick->setInterval(1000);
+	QObject::connect(tick, &QTimer::timeout, &dlg, refresh);
+	tick->start();
+	refresh();
+
+	dlg.showFullScreen();
+	dlg.exec();
+	if (previewPausedByLock) {
+		obs_frontend_set_preview_enabled(true);
+	}
+}
