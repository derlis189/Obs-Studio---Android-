+if(NOT TARGET OBS::libobs)
+  find_package(libobs REQUIRED)
+endif()
+target_link_libraries(${PROJECT_NAME} PRIVATE OBS::libobs)
 
 if(ENABLE_FRONTEND_API)
   find_package(obs-frontend-api REQUIRED)
-  target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE OBS::obs-frontend-api)
+  target_link_libraries(${PROJECT_NAME} PRIVATE OBS::obs-frontend-api)
 endif()
 
 # Check if nlohmann_json exists
@@ -41,24 +51,24 @@ endif()
 
 find_package(CURL REQUIRED)
 
-target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE nlohmann_json CURL::libcurl)
+target_link_libraries(${PROJECT_NAME} PRIVATE nlohmann_json CURL::libcurl)
 
 if(APPLE)
   target_link_libraries(
-    ${CMAKE_PROJECT_NAME}
+    ${PROJECT_NAME}
     PRIVATE "$<LINK_LIBRARY:FRAMEWORK,Security.framework>" "$<LINK_LIBRARY:FRAMEWORK,CoreFoundation.framework>"
   )
 endif()
 
 if(ENABLE_QT)
   find_package(Qt6 COMPONENTS Widgets Core Svg Xml)
-  target_link_libraries(${CMAKE_PROJECT_NAME} PRIVATE Qt6::Core Qt6::Widgets Qt6::Svg Qt6::Xml)
+  target_link_libraries(${PROJECT_NAME} PRIVATE Qt6::Core Qt6::Widgets Qt6::Svg Qt6::Xml)
   target_compile_options(
-    ${CMAKE_PROJECT_NAME}
+    ${PROJECT_NAME}
     PRIVATE $<$<C_COMPILER_ID:Clang,AppleClang>:-Wno-quoted-include-in-framework-header -Wno-comma>
   )
   set_target_properties(
-    ${CMAKE_PROJECT_NAME}
+    ${PROJECT_NAME}
     PROPERTIES AUTOMOC ON AUTOUIC ON AUTORCC ON
   )
 endif()
@@ -98,4 +108,9 @@ target_sources(
     src/version.h
 )
 
-set_target_properties_plugin(${CMAKE_PROJECT_NAME} PROPERTIES OUTPUT_NAME ${_name})
+set_target_properties_plugin(${PROJECT_NAME} PROPERTIES OUTPUT_NAME ${_name})
+
+if(ANDROID)
+  # OBS Android's core module loader looks for lib<module>.so.
+  set_target_properties(${PROJECT_NAME} PROPERTIES PREFIX "lib")
+endif()
